// PART 99: ULTIMATE ANALYTICS & FINANCE DASHBOARDS (PREMIUM EDITION)
// ============================================================================

function dashboardLevenshtein_(a, b) {
  var m = a.length, n = b.length;
  if (!m) return n; if (!n) return m;
  var d = [];
  for (var i = 0; i <= m; i++) d[i] = [i];
  for (var j = 0; j <= n; j++) d[0][j] = j;
  for (var i = 1; i <= m; i++)
    for (var j = 1; j <= n; j++)
      d[i][j] = a[i-1] === b[j-1] ? d[i-1][j-1] : Math.min(d[i-1][j-1]+1, d[i][j-1]+1, d[i-1][j]+1);
  return d[m][n];
}

function dashboardNormalizeSchool_(s) {
  var str = String(s || "").trim().replace(/\s+/g, " ").toLowerCase();
  // Normalize diacritics (e.g., Las Piñas -> las pinas)
  return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

function dashboardClusterSchools_(entries) {
  var names = {};
  entries.forEach(function(e) {
    var n = dashboardNormalizeSchool_(e);
    if (n && n.length > 1) names[n] = (names[n] || 0) + 1;
  });
  var keys = Object.keys(names).sort(function(a,b){ return names[b]-names[a]; });
  var clusters = [], used = {};
  keys.forEach(function(k) {
    if (used[k]) return;
    var cluster = { canonical: k, count: names[k], variants: [k] };
    keys.forEach(function(k2) {
      if (k2 === k || used[k2]) return;
      var minLen = Math.min(k.length, k2.length);
      var threshold = minLen > 15 ? 4 : minLen > 8 ? 3 : 2;
      if (dashboardLevenshtein_(k.toLowerCase(), k2.toLowerCase()) <= threshold) {
        cluster.count += names[k2];
        cluster.variants.push(k2);
        used[k2] = true;
      }
    });
    used[k] = true;
    clusters.push(cluster);
  });
  clusters.sort(function(a,b){ return b.count - a.count; });
  return clusters;
}

function dashboardNormalizeRegion_(r) {
  var s = String(r || "").trim();
  if (!s) return "Unknown";
  if (/national\s*capital/i.test(s) || /NCR/i.test(s)) return "NCR";
  if (/cordillera/i.test(s) || /\bCAR\b/i.test(s)) return "CAR";
  if (/bangsamoro|armm|barmm/i.test(s)) return "BARMM";
  var m = s.match(/Region\s+([IVX]+[-\s]*[A-Z]?)/i);
  if (m) return "Region " + m[1].toUpperCase().replace(/\s+/g, "").replace(/-/g,"-");
  return s.substring(0, 30);
}

/** Server API: Analytics Data — FIXED for column detection */
function AdminDashboard_getAnalyticsData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  if (!sheet) return { error: "Registration sheet not found" };
  var data = sheet.getDataRange().getValues();
  if (data.length < 2) return { error: "No data" };
  var headers = data[0];
  var rows = data.slice(1);
  var C = SYSTEM_CONFIG.COLS.REG;

  // Auto-detect columns by header name as fallback
  var colMap = {};
  headers.forEach(function(h, i) {
    var hh = String(h).trim().toUpperCase();
    if ((/SCHOOL|UNIVERSITY|AFFILIATION/i.test(hh)) && !/PROOF/i.test(hh)) colMap.school = i;
    if (/^REGION$/i.test(hh) || /YOUR.*REGION/i.test(hh)) colMap.region = i;
    if (/GRADE.*LEVEL|YEAR.*LEVEL/i.test(hh)) colMap.grade = i;
    if (/^SEX$|^GENDER$/i.test(hh)) colMap.sex = i;
    if (/^AGE$/i.test(hh)) colMap.age = i;
    if (/COMPETITION/i.test(hh) && /WHICH|SELECT|CHOOSE/i.test(hh)) colMap.competition = i;
    if (/^FULL\s*NAME$/i.test(hh) || hh === "NAME") colMap.name = i;
    if (/PAYMENT.*STATUS|STATUS.*PAYMENT/i.test(hh)) colMap.payStatus = i;
    if (/TOTAL.*FEE|FINAL.*AMOUNT|TOTAL.*AMOUNT/i.test(hh)) colMap.totalFee = i;
    if (/BASE.*FEE/i.test(hh)) colMap.baseFee = i;
    if (/BUNDLE.*DISCOUNT/i.test(hh)) colMap.bundleDisc = i;
    if (/COUPON.*DISCOUNT/i.test(hh)) colMap.couponDisc = i;
    if (/REF.*DISCOUNT/i.test(hh)) colMap.refDisc = i;
    if (/CASHBACK|REF.*EARN/i.test(hh)) colMap.cashback = i;
    if (/MODE.*PAYMENT|PAYMENT.*MODE/i.test(hh)) colMap.payMode = i;
    if (/GEN.*ID/i.test(hh)) colMap.genId = i;
    if (/EMAIL/i.test(hh) && !/SENT/i.test(hh) && !/THREAD/i.test(hh)) colMap.email = colMap.email || i;
  });

  var ci = {
    name: colMap.name !== undefined ? colMap.name : C.NAME - 1,
    school: colMap.school !== undefined ? colMap.school : C.SCHOOL - 1,
    region: colMap.region !== undefined ? colMap.region : C.REGION - 1,
    grade: colMap.grade !== undefined ? colMap.grade : C.GRADE_LEVEL - 1,
    sex: colMap.sex !== undefined ? colMap.sex : C.SEX - 1,
    age: colMap.age !== undefined ? colMap.age : C.AGE - 1,
    comp: colMap.competition !== undefined ? colMap.competition : C.COMPETITION - 1,
    payStatus: colMap.payStatus !== undefined ? colMap.payStatus : C.PAYMENT_STATUS - 1,
    totalFee: colMap.totalFee !== undefined ? colMap.totalFee : C.TOTAL_FEE - 1,
    baseFee: colMap.baseFee !== undefined ? colMap.baseFee : C.BASE_FEE - 1,
    bundleDisc: colMap.bundleDisc !== undefined ? colMap.bundleDisc : C.BUNDLE_DISCOUNT - 1,
    couponDisc: colMap.couponDisc !== undefined ? colMap.couponDisc : C.COUPON_DISCOUNT - 1,
    refDisc: colMap.refDisc !== undefined ? colMap.refDisc : C.REF_DISCOUNT - 1,
    cashback: colMap.cashback !== undefined ? colMap.cashback : C.CASHBACK - 1,
    payMode: colMap.payMode !== undefined ? colMap.payMode : C.PAY_MODE - 1,
    genId: colMap.genId !== undefined ? colMap.genId : C.GEN_ID - 1,
    email: colMap.email !== undefined ? colMap.email : C.EMAIL - 1
  };

  var paidLookup = getPaidEmailLookup_();
  var totalRegs = 0, schools = [], regions = [], grades = [], sexes = [], ages = [];
  var competitions = {}, dailyCounts = {}, calendarData = {}, statusCounts = { paid: 0, unpaid: 0 };
  var regsWithDate = [];

  rows.forEach(function(row) {
    var name = String(row[ci.name] || "").trim();
    if (!name) return;
    totalRegs++;

    var ts = row[0]; // Timestamp is always col A
    var dateKey = "";
    if (ts) {
      var d = new Date(ts);
      if (!isNaN(d.getTime())) {
        dateKey = Utilities.formatDate(d, SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd");
        dailyCounts[dateKey] = (dailyCounts[dateKey] || 0) + 1;
        calendarData[dateKey] = (calendarData[dateKey] || 0) + 1;
      }
    }

    var school = String(row[ci.school] || "").trim();
    if (school) schools.push(school);

    var region = String(row[ci.region] || "").trim();
    if (region) regions.push(region);

    var grade = String(row[ci.grade] || "").trim();
    if (grade) grades.push(grade);

    var sex = String(row[ci.sex] || "").trim();
    if (sex) sexes.push(sex);

    var age = Number(row[ci.age] || 0);
    if (age > 0) ages.push(age);

    var comp = String(row[ci.comp] || "");
    comp.split(",").forEach(function(c) {
      var ct = c.trim();
      if (ct) competitions[ct] = (competitions[ct] || 0) + 1;
    });

    if (paidLookup.isPaid(row[ci.email], row[ci.payStatus])) statusCounts.paid++;
    else statusCounts.unpaid++;

    regsWithDate.push({ date: dateKey, school: school, region: region, comp: comp });
  });

  var schoolClusters = dashboardClusterSchools_(schools);
  var regionMap = {};
  regions.forEach(function(r) { var nr = dashboardNormalizeRegion_(r); regionMap[nr] = (regionMap[nr] || 0) + 1; });
  var gradeMap = {};
  grades.forEach(function(g) { gradeMap[g] = (gradeMap[g] || 0) + 1; });
  var sexMap = {};
  sexes.forEach(function(s) { var ns = s.charAt(0).toUpperCase() + s.slice(1).toLowerCase(); sexMap[ns] = (sexMap[ns] || 0) + 1; });
  var ageMap = {};
  ages.forEach(function(a) {
    var r = a < 13 ? "Under 13" : a < 16 ? "13-15" : a < 19 ? "16-18" : a < 22 ? "19-21" : "22+";
    ageMap[r] = (ageMap[r] || 0) + 1;
  });

  var dailyKeys = Object.keys(dailyCounts).sort();
  var dailyTrend = dailyKeys.map(function(k) { return { date: k, count: dailyCounts[k] }; });

  var now = new Date();
  var todayKey = Utilities.formatDate(now, SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd");
  var todayCount = dailyCounts[todayKey] || 0;

  var last7 = 0, prev7 = 0;
  dailyKeys.forEach(function(k) {
    var diff = (now.getTime() - new Date(k).getTime()) / 86400000;
    if (diff <= 7) last7 += dailyCounts[k];
    else if (diff <= 14) prev7 += dailyCounts[k];
  });
  var growthRate = prev7 > 0 ? Math.round(((last7 - prev7) / prev7) * 100) : (last7 > 0 ? 100 : 0);
  var avgPerDay = Math.round((totalRegs / (dailyKeys.length || 1)) * 10) / 10;

  return {
    totalRegs: totalRegs, uniqueSchools: schoolClusters.length,
    totalCompetitions: Object.keys(competitions).length,
    avgPerDay: avgPerDay, growthRate: growthRate, todayCount: todayCount,
    competitions: competitions, regionMap: regionMap,
    schoolClusters: schoolClusters.slice(0, 50),
    dailyTrend: dailyTrend, calendarData: calendarData,
    gradeMap: gradeMap, sexMap: sexMap, ageMap: ageMap,
    statusCounts: statusCounts, detectedCols: colMap
  };
}

/** Server API: Finance Data — FIXED with auto-detect columns */
function AdminDashboard_getFinanceData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  if (!sheet) return { error: "Registration sheet not found" };
  var data = sheet.getDataRange().getValues();
  if (data.length < 2) return { error: "No data" };
  var headers = data[0];
  var rows = data.slice(1);
  var C = SYSTEM_CONFIG.COLS.REG;

  // Auto-detect columns from headers
  var colMap = {};
  headers.forEach(function(h, i) {
    var hh = String(h).trim().toUpperCase();
    if ((/SCHOOL|UNIVERSITY|AFFILIATION/i.test(hh)) && !/PROOF/i.test(hh)) colMap.school = i;
    if (/COMPETITION/i.test(hh) && /WHICH|SELECT|CHOOSE/i.test(hh)) colMap.competition = i;
    if (/^FULL\s*NAME$/i.test(hh) || hh === "NAME") colMap.name = i;
    if (/PAYMENT.*STATUS|STATUS.*PAYMENT/i.test(hh)) colMap.payStatus = i;
    if (/TOTAL.*FEE|FINAL.*AMOUNT|TOTAL.*AMOUNT/i.test(hh)) colMap.totalFee = i;
    if (/BASE.*FEE/i.test(hh)) colMap.baseFee = i;
    if (/BUNDLE.*DISCOUNT/i.test(hh)) colMap.bundleDisc = i;
    if (/COUPON.*DISCOUNT/i.test(hh)) colMap.couponDisc = i;
    if (/REF.*DISCOUNT/i.test(hh) && !/EARN/i.test(hh)) colMap.refDisc = i;
    if (/CASHBACK|REF.*EARN/i.test(hh)) colMap.cashback = i;
    if (/MODE.*PAYMENT|PAYMENT.*MODE/i.test(hh)) colMap.payMode = i;
    if (/GEN.*ID/i.test(hh)) colMap.genId = i;
    if (/EMAIL/i.test(hh) && !/SENT/i.test(hh) && !/THREAD/i.test(hh)) colMap.email = colMap.email || i;
    if (/REMARKS|NOTES|ADMIN.*NOTES|MERGE.*DATA|SYS.*NOTES/i.test(hh)) colMap.remarks = i;
    if (/SYS_MERGE_GROUP_ID/i.test(hh)) colMap.groupId = i;
    if (/SYS_MERGE_MANUAL_TOTAL/i.test(hh)) colMap.mergeOverride = i;
    if (/SYS_MERGE_BUNDLE_INFO/i.test(hh)) colMap.mergePreset = i;
    if (/SYS_MERGE_ROLE/i.test(hh)) colMap.mergeRole = i;
    if (/^REGION$/i.test(hh) || /YOUR.*REGION/i.test(hh)) colMap.region = i;
  });

  var ci = {
    name: colMap.name !== undefined ? colMap.name : C.NAME - 1,
    school: colMap.school !== undefined ? colMap.school : C.SCHOOL - 1,
    comp: colMap.competition !== undefined ? colMap.competition : C.COMPETITION - 1,
    payStatus: colMap.payStatus !== undefined ? colMap.payStatus : C.PAYMENT_STATUS - 1,
    totalFee: colMap.totalFee !== undefined ? colMap.totalFee : C.TOTAL_FEE - 1,
    baseFee: colMap.baseFee !== undefined ? colMap.baseFee : C.BASE_FEE - 1,
    bundleDisc: colMap.bundleDisc !== undefined ? colMap.bundleDisc : C.BUNDLE_DISCOUNT - 1,
    couponDisc: colMap.couponDisc !== undefined ? colMap.couponDisc : C.COUPON_DISCOUNT - 1,
    refDisc: colMap.refDisc !== undefined ? colMap.refDisc : C.REF_DISCOUNT - 1,
    cashback: colMap.cashback !== undefined ? colMap.cashback : C.CASHBACK - 1,
    payMode: colMap.payMode !== undefined ? colMap.payMode : C.PAY_MODE - 1,
    genId: colMap.genId !== undefined ? colMap.genId : C.GEN_ID - 1,
    email: colMap.email !== undefined ? colMap.email : C.EMAIL - 1,
    remarks: colMap.remarks !== undefined ? colMap.remarks : -1,
    region: colMap.region !== undefined ? colMap.region : C.REGION - 1,
    groupId: colMap.groupId !== undefined ? colMap.groupId : -1,
    mergeOverride: colMap.mergeOverride !== undefined ? colMap.mergeOverride : -1,
    mergePreset: colMap.mergePreset !== undefined ? colMap.mergePreset : -1,
    mergeRole: colMap.mergeRole !== undefined ? colMap.mergeRole : -1
  };

  var paidLookup = getPaidEmailLookup_();
  var totalRevenue = 0, paidRevenue = 0, pendingAmount = 0;
  var bundleDiscount = 0, couponDiscount = 0, refDiscount = 0, cashbackTotal = 0;
  var paidCount = 0, unpaidCount = 0;
  var payModes = {}, revenueByComp = {}, revenueBySchool = {}, dailyRevenue = {};
  var payments = [], mergeGroups = {};

  rows.forEach(function(row) {
    var name = String(row[ci.name] || "").trim();
    if (!name) return;

    var totalFee = Number(row[ci.totalFee] || 0);
    var baseFee = Number(row[ci.baseFee] || 0);

    // Fallback: if totalFee is 0 but baseFee exists, use baseFee
    if (totalFee === 0 && baseFee > 0) totalFee = baseFee;

    // Fallback: calculate from competition pricing if no fee data
    if (totalFee === 0) {
      var compStr = String(row[ci.comp] || "");
      var comps = compStr.split(",").map(function(c) { return c.trim(); }).filter(Boolean);
      var PR = SYSTEM_CONFIG.PRICING;
      comps.forEach(function(c) {
        Object.keys(PR.SINGLE).forEach(function(k) {
          if (c.toLowerCase().indexOf(k.toLowerCase().substring(0, 8)) >= 0) {
            totalFee += PR.SINGLE[k];
          }
        });
      });
    }

    // --- MERGE ACCOUNTING FIX ---
    var gid = ci.groupId >= 0 ? String(row[ci.groupId] || "").trim().toUpperCase() : "";
    var remarks = ci.remarks >= 0 ? String(row[ci.remarks] || "") : "";
    var role = ci.mergeRole >= 0 ? String(row[ci.mergeRole] || "").trim().toUpperCase() : "";

    if (!gid) {
      var groupMatch = remarks.match(/(?:GROUP[_\s]*ID|MERGE[D]?|GROUP)[:\s]*([a-zA-Z0-9_-]+)/i);
      if (groupMatch && groupMatch[1].length > 3) gid = groupMatch[1].toUpperCase();
    }

    var ov = 0, pr = "";
    if (gid) {
      var ovR = ci.mergeOverride >= 0 ? row[ci.mergeOverride] : 0;
      if (ovR instanceof Date) {
        var diff = ovR.getTime() - new Date(Date.UTC(1899, 11, 30)).getTime();
        ov = Math.round(diff / 86400000);
        // Using Date.UTC to prevent local timezone shift bugs on epoch
      } else {
        ov = Number(ovR || 0);
      }
      if (!ov && remarks) {
        var ovMatch = remarks.match(/OVERRIDE[:\s]*([\d.-]+)/i);
        if (ovMatch) ov = Number(ovMatch[1]);
      }
      
      pr = ci.mergePreset >= 0 ? String(row[ci.mergePreset] || "").trim() : "";
      if (!pr && remarks) {
        var pm = remarks.match(/BUNDLE[_\s]*PRESET[:\s]*([^\s,;]+)/i);
        if (pm) pr = pm[1];
      }

      // Adjust totalFee BEFORE aggregating
      if (role === "PRIMARY") {
        if (ov > 0) totalFee = ov;
      } else if (role === "MEMBER") {
        totalFee = 0;
      } else if (!role && ov > 0 && totalFee !== 0) {
        // legacy override detection
        totalFee = ov;
        role = "PRIMARY";
      }
    }

    var bundleD = Math.abs(Number(row[ci.bundleDisc] || 0));
    var couponD = Math.abs(Number(row[ci.couponDisc] || 0));
    var refD = Math.abs(Number(row[ci.refDisc] || 0));
    var cashback = Math.abs(Number(row[ci.cashback] || 0));
    // Paid = Finance status, or the group's primary payer for a merged member
    var rawStatus = String(row[ci.payStatus] || "").trim().toUpperCase();
    var rowIsPaid = paidLookup.isPaid(row[ci.email], rawStatus);
    var status = rowIsPaid
      ? SYSTEM_CONFIG.ADMIN.TRIGGER_WORD
      : ((rawStatus && !Utils.isPaidStatus(rawStatus)) ? rawStatus : SYSTEM_CONFIG.ADMIN.NOT_YET_WORD);
    var payMode = String(row[ci.payMode] || "").trim() || "Unknown";
    var school = String(row[ci.school] || "").trim();
    var comp = String(row[ci.comp] || "");
    var genId = String(row[ci.genId] || "");
    var email = String(row[ci.email] || "");
    var ts = row[0]; // Timestamp always col A
    var region = String(row[ci.region] || "").trim();

    totalRevenue += totalFee;
    bundleDiscount += bundleD;
    couponDiscount += couponD;
    refDiscount += refD;
    cashbackTotal += cashback;

    if (rowIsPaid) { paidCount++; paidRevenue += totalFee; }
    else { unpaidCount++; pendingAmount += totalFee; }

    payModes[payMode] = (payModes[payMode] || 0) + 1;

    var compCount = comp.split(",").filter(function(c){return c.trim();}).length || 1;
    var perComp = Math.round(totalFee / compCount);
    comp.split(",").forEach(function(c) {
      var ct = c.trim();
      if (ct) revenueByComp[ct] = (revenueByComp[ct] || 0) + perComp;
    });

    if (school) {
      var ns = dashboardNormalizeSchool_(school);
      if (!revenueBySchool[ns]) revenueBySchool[ns] = { revenue: 0, count: 0, display: school };
      revenueBySchool[ns].revenue += totalFee;
      revenueBySchool[ns].count++;
    }

    var dateKey = "";
    if (ts) {
      var d = new Date(ts);
      if (!isNaN(d.getTime())) {
        dateKey = Utilities.formatDate(d, SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd");
        dailyRevenue[dateKey] = (dailyRevenue[dateKey] || 0) + totalFee;
      }
    }

    payments.push({ name: name, email: email, genId: genId, amount: totalFee,
      status: status, mode: payMode, school: school, region: region, date: dateKey });

    // Merge group push
    if (gid) {
      if (!mergeGroups[gid]) mergeGroups[gid] = { members: [], total: 0, preset: "", override: "" };
      mergeGroups[gid].members.push({ name: name, amount: totalFee, status: status, genId: genId });
