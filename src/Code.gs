// ============================================================================
// PART XX: COMPETITION SHEET GENERATOR
// ============================================================================
// Creates separate sheets for each competition type by extracting
// participant data from "Submission Form".
// Target sheets: the "sheet" names in SYSTEM_CONFIG.COMPETITIONS
// ============================================================================

/**
 * Main entry point — generates (or refreshes) the four competition sheets.
 * Can be run from the Script Editor or wired to a menu item.
 */
function generateCompetitionSheets() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);

    if (!subSheet) {
      SpreadsheetApp.getUi().alert("Sheet \"" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "\" not found.");
      return;
    }

    var allData = subSheet.getDataRange().getValues();
    if (allData.length < 2) {
      SpreadsheetApp.getUi().alert("No submission data found in \"" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "\".");
      return;
    }

    var headerRow = allData[0];
    var dataRows  = allData.slice(1);

    // --- Locate SYS_PARTICIPANT_NUM column dynamically -----------------------
    var participantNumCol = -1;
    for (var hi = 0; hi < headerRow.length; hi++) {
      if (String(headerRow[hi]).trim().toUpperCase() === "SYS_PARTICIPANT_NUM") {
        participantNumCol = hi;
        break;
      }
    }

    // --- Standardised headers ------------------------------------------------
    var OUTPUT_HEADERS = [
      "Timestamp",
      "Email Address",
      "SYS_Participant_NUM",
      "Full Name",
      "Region",
      "School/University",
      "Adviser",
      "Facebook or Messenger Link",
      "Contact Number of Participant",
      "Title (If possible)",
      "Upload Link 1",
      "Upload Link 2"
    ];

    // Output column indices (0-indexed)
    var IDX_FACEBOOK = 7;
    var IDX_LINK1    = 10;
    var IDX_LINK2    = 11;

    // --- BUG FIX #1: Safe cell accessor (prevents index-out-of-bounds crash) -
    function cellVal(row, colOneBased) {
      var idx = colOneBased - 1;
      if (idx < 0 || idx >= row.length) return "";
      var v = row[idx];
      return (v === null || v === undefined) ? "" : v;
    }

    // --- Competition config --------------------------------------------------
    var COMP = SYSTEM_CONFIG.COLS.SUB;

    var COMPETITION_SHEETS = [
      {
        sheetName:  getCompetitionByKey_("ESSAY").sheetName,
        matchValue: getCompetitionByKey_("ESSAY").submissionName,
        prefix:     getCompetitionByKey_("ESSAY").prefix,
        nameCol:    COMP.ESSAY_NAME,
        regionCol:  COMP.ESSAY_REGION,
        schoolCol:  COMP.ESSAY_SCHOOL,
        adviserCol: COMP.ESSAY_ADVISER,
        facebookCol:COMP.ESSAY_FACEBOOK,
        contactCol: COMP.ESSAY_CONTACT,
        titleCol:   COMP.ESSAY_TITLE,
        fileCols:   [COMP.ESSAY_FILE],
        linkLabels: ["Essay File", ""]
      },
      {
        sheetName:  getCompetitionByKey_("SPEECH").sheetName,
        matchValue: getCompetitionByKey_("SPEECH").submissionName,
        prefix:     getCompetitionByKey_("SPEECH").prefix,
        nameCol:    COMP.SPEECH_NAME,
        regionCol:  COMP.SPEECH_REGION,
        schoolCol:  COMP.SPEECH_SCHOOL,
        adviserCol: COMP.SPEECH_ADVISER,
        facebookCol:COMP.SPEECH_FACEBOOK,
        contactCol: COMP.SPEECH_CONTACT,
        titleCol:   null,
        fileCols:   [COMP.SPEECH_VIDEO, COMP.SPEECH_WRITTEN],
        linkLabels: ["Speech Video", "Written Copy"]
      },
      {
        sheetName:  getCompetitionByKey_("PHOTO").sheetName,
        matchValue: getCompetitionByKey_("PHOTO").submissionName,
        prefix:     getCompetitionByKey_("PHOTO").prefix,
        nameCol:    COMP.PHOTO_NAME,
        regionCol:  COMP.PHOTO_REGION,
        schoolCol:  COMP.PHOTO_SCHOOL,
        adviserCol: COMP.PHOTO_ADVISER,
        facebookCol:COMP.PHOTO_FACEBOOK,
        contactCol: COMP.PHOTO_CONTACT,
        titleCol:   COMP.PHOTO_TITLE,
        fileCols:   [COMP.PHOTO_FILE, COMP.PHOTO_EXPLANATION],
        linkLabels: ["Original Photo", "Photo + Explanation (A4)"]
      },
      {
        sheetName:  getCompetitionByKey_("FILM").sheetName,
        matchValue: getCompetitionByKey_("FILM").submissionName,
        prefix:     getCompetitionByKey_("FILM").prefix,
        nameCol:    COMP.FILM_MEMBERS,
        regionCol:  COMP.FILM_REGION,
        schoolCol:  COMP.FILM_SCHOOL,
        adviserCol: COMP.FILM_ADVISER,
        facebookCol:COMP.FILM_FACEBOOK,
        contactCol: COMP.FILM_CONTACT,
        titleCol:   COMP.FILM_TITLE,
        fileCols:   [COMP.FILM_FILE],
        linkLabels: ["Short Film File", ""]
      }
    ];

    var compTypeCol = COMP.COMPETITION_TYPE - 1;

    // --- Helper: extract participant number matching a prefix -----------------
    function extractPartNum(rawValue, prefix) {
      if (!rawValue) return "";
      // BUG FIX #2: Also split on whitespace in case values aren't comma-separated
      var parts = String(rawValue).split(/[,;\s]+/);
      var upper = prefix.toUpperCase() + "-";
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i].trim();
        if (p.toUpperCase().indexOf(upper) === 0) return p;
      }
      return "";
    }

    // --- BUG FIX #3: Competition matching with boundary check ----------------
    function competitionMatches(answer, matchValue) {
      if (!answer || !matchValue) return false;
      var idx = answer.indexOf(matchValue);
      if (idx === -1) return false;
      var afterIdx = idx + matchValue.length;
      if (afterIdx < answer.length) {
        var ch = answer.charAt(afterIdx);
        if (/[a-zA-Z]/.test(ch)) return false;
      }
      return true;
    }

    // --- BUG FIX #4: Format timestamp as string consistently -----------------
    function formatTimestamp(val) {
      if (!val) return "";
      if (Object.prototype.toString.call(val) === "[object Date]") {
        try {
          return Utilities.formatDate(val, SYSTEM_CONFIG.META.TIMEZONE, "M/d/yyyy HH:mm:ss");
        } catch (e) {
          return String(val);
        }
      }
      return String(val);
    }

    // --- BUG FIX #5: HYPERLINK formula with proper double-quote escaping -----
    function makeHyperlink(url, label) {
      if (!url) return "";
      var u = String(url).trim();
      if (u.indexOf("http") !== 0) return u;
      var dq = String.fromCharCode(34);
      var safeUrl   = u.replace(new RegExp(dq, "g"), dq + dq);
      var safeLabel = String(label || "Open Link").replace(new RegExp(dq, "g"), dq + dq);
      return "=HYPERLINK(" + dq + safeUrl + dq + "," + dq + safeLabel + dq + ")";
    }

    // --- Build output arrays for each competition ----------------------------
    var outputData = {};
    var seenKeys   = {};  // BUG FIX #6: Duplicate detection
    COMPETITION_SHEETS.forEach(function (cfg) {
      outputData[cfg.sheetName] = [];
      seenKeys[cfg.sheetName]   = {};
    });

    // BUG FIX #7: Use for-loop instead of forEach (avoids variable shadowing)
    for (var ri = 0; ri < dataRows.length; ri++) {
      var row = dataRows[ri];
      var compAnswer = String(cellVal(row, COMP.COMPETITION_TYPE)).trim();

      for (var ci = 0; ci < COMPETITION_SHEETS.length; ci++) {
        var cfg = COMPETITION_SHEETS[ci];

        // BUG FIX #8: try-catch per row so one bad row doesn't crash everything
        try {
          var compMatches = competitionMatches(compAnswer, cfg.matchValue);

          var nameVal = String(cellVal(row, cfg.nameCol)).trim();
          var hasName = nameVal !== "";
          var hasFile = false;
          for (var fi = 0; fi < cfg.fileCols.length; fi++) {
            if (String(cellVal(row, cfg.fileCols[fi])).trim() !== "") {
              hasFile = true;
              break;
            }
          }
          var hasData = hasName && hasFile;

          if (!compMatches && !hasData) continue;
          if (!hasName) continue;

          // Duplicate detection: keep latest entry per email + competition
          var emailRaw = String(cellVal(row, COMP.EMAIL)).trim().toLowerCase();
          var dedupKey = emailRaw + "|" + cfg.sheetName;
          if (seenKeys[cfg.sheetName][dedupKey] !== undefined) {
            var prevIdx = seenKeys[cfg.sheetName][dedupKey];
            outputData[cfg.sheetName][prevIdx] = null;
          }

          var timestamp = formatTimestamp(cellVal(row, COMP.TIMESTAMP));
          // participantNumCol is 0-indexed already, so add 1 for cellVal
          var rawPartNum = (participantNumCol >= 0) ? String(row[participantNumCol] || "").trim() : "";
          var partNum    = extractPartNum(rawPartNum, cfg.prefix);

          var fullName = nameVal;
          var region   = String(cellVal(row, cfg.regionCol)).trim();
          var school   = String(cellVal(row, cfg.schoolCol)).trim();
          var adviser  = String(cellVal(row, cfg.adviserCol)).trim();
          var facebook = String(cellVal(row, cfg.facebookCol)).trim();
          var contact  = String(cellVal(row, cfg.contactCol)).trim();
          var title    = cfg.titleCol ? String(cellVal(row, cfg.titleCol)).trim() : "";

          var link1 = cfg.fileCols.length >= 1 ? String(cellVal(row, cfg.fileCols[0])).trim() : "";
          var link2 = cfg.fileCols.length >= 2 ? String(cellVal(row, cfg.fileCols[1])).trim() : "";

          var newIdx = outputData[cfg.sheetName].length;
          outputData[cfg.sheetName].push([
            timestamp, emailRaw, partNum, fullName, region, school,
            adviser, facebook, contact, title, link1, link2
          ]);
          seenKeys[cfg.sheetName][dedupKey] = newIdx;

        } catch (rowErr) {
          Logger.log("Row " + (ri + 2) + " error for " + cfg.sheetName + ": " + rowErr);
        }
      }
    }

    // --- Remove null entries from duplicate replacement ----------------------
    COMPETITION_SHEETS.forEach(function (cfg) {
      outputData[cfg.sheetName] = outputData[cfg.sheetName].filter(function (entry) {
        return entry !== null;
      });
    });

    // --- Sort by participant number ascending --------------------------------
    COMPETITION_SHEETS.forEach(function (cfg) {
      outputData[cfg.sheetName].sort(function (a, b) {
        var numA = a[2] || "";
        var numB = b[2] || "";
        if (!numA && !numB) return 0;
        if (!numA) return 1;
        if (!numB) return -1;
        return numA.localeCompare(numB);
      });
    });

    // --- Write each competition sheet ----------------------------------------
    COMPETITION_SHEETS.forEach(function (cfg) {
      var target = ss.getSheetByName(cfg.sheetName);
      if (!target) {
        target = ss.insertSheet(cfg.sheetName);
      } else {
        target.clearContents();
        target.clearFormats();
      }

      var headers = OUTPUT_HEADERS.slice();
      if (cfg.linkLabels[0]) headers[IDX_LINK1] = cfg.linkLabels[0];
      if (cfg.linkLabels[1]) headers[IDX_LINK2] = cfg.linkLabels[1];
      var colCount = cfg.fileCols.length >= 2 ? headers.length : headers.length - 1;
      var visibleHeaders = headers.slice(0, colCount);

      target.getRange(1, 1, 1, colCount).setValues([visibleHeaders]);
      target.getRange(1, 1, 1, colCount)
        .setBackground("#1a73e8")
        .setFontColor("#ffffff")
        .setFontWeight("bold")
        .setHorizontalAlignment("center");

      var rows = outputData[cfg.sheetName];
      if (rows.length > 0) {
        var plainRows = rows.map(function (rw) { return rw.slice(0, colCount); });
        target.getRange(2, 1, plainRows.length, colCount).setValues(plainRows);

        // Overlay HYPERLINK formulas on link columns
        for (var rIdx = 0; rIdx < rows.length; rIdx++) {
          var rowNum = rIdx + 2;

          var fbUrl = String(rows[rIdx][IDX_FACEBOOK] || "").trim();
          if (fbUrl.indexOf("http") === 0) {
            target.getRange(rowNum, IDX_FACEBOOK + 1).setFormula(makeHyperlink(fbUrl, "Facebook"));
          }

          var l1Url = String(rows[rIdx][IDX_LINK1] || "").trim();
          if (l1Url.indexOf("http") === 0) {
            target.getRange(rowNum, IDX_LINK1 + 1).setFormula(makeHyperlink(l1Url, cfg.linkLabels[0] || "Upload"));
          }

          if (colCount > IDX_LINK2) {
            var l2Url = String(rows[rIdx][IDX_LINK2] || "").trim();
            if (l2Url.indexOf("http") === 0) {
              target.getRange(rowNum, IDX_LINK2 + 1).setFormula(makeHyperlink(l2Url, cfg.linkLabels[1] || "Upload 2"));
            }
          }
        }
      }

      target.setFrozenRows(1);

      for (var col = 1; col <= colCount; col++) {
        target.autoResizeColumn(col);
      }
    });

    // --- Summary toast -------------------------------------------------------
    var counts = COMPETITION_SHEETS.map(function (cfg) {
      return cfg.sheetName + ": " + outputData[cfg.sheetName].length;
    }).join(" | ");

    SpreadsheetApp.getActiveSpreadsheet().toast(
      "Competition sheets generated! " + counts, "Done", 8
    );

    AuditLogService.info("COMPETITION_SHEETS", "Generated - " + counts);

  } catch (err) {
    SpreadsheetApp.getUi().alert("Error generating competition sheets:\n" + err.message);
    AuditLogService.error("COMPETITION_SHEETS", "Failed: " + err.message);
  }
}


// ============================================================================
// PART XX: SYSTEM HEALTH CHECK
// ============================================================================
// Comprehensive validation of the entire admin system — checks config,
// sheets, columns, services, and key functions.
// ============================================================================

/**
 * Run a full system health check and display results in a dialog.
 */
function runSystemHealthCheck() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var results = [];
  var passCount = 0;
  var failCount = 0;
  var warnCount = 0;

  function pass(category, msg) {
    results.push({ status: "PASS", cat: category, msg: msg });
    passCount++;
  }
  function fail(category, msg) {
    results.push({ status: "FAIL", cat: category, msg: msg });
    failCount++;
  }
  function warn(category, msg) {
    results.push({ status: "WARN", cat: category, msg: msg });
    warnCount++;
  }

  // =========================================================================
  // 1. CONFIG INTEGRITY
  // =========================================================================
  try {
    if (typeof SYSTEM_CONFIG !== "undefined" && SYSTEM_CONFIG !== null) {
      pass("Config", "SYSTEM_CONFIG is defined");
    } else {
      fail("Config", "SYSTEM_CONFIG is missing or undefined");
    }
  } catch (e) {
    fail("Config", "SYSTEM_CONFIG error: " + e.message);
  }

  try {
    var meta = SYSTEM_CONFIG.META;
    if (meta && meta.NAME && meta.VERSION && meta.TIMEZONE) {
      pass("Config", "META section valid (v" + meta.VERSION + ", TZ: " + meta.TIMEZONE + ")");
    } else {
      fail("Config", "META section incomplete — NAME, VERSION, or TIMEZONE missing");
    }
  } catch (e) {
    fail("Config", "META check failed: " + e.message);
  }

  try {
    var pricing = SYSTEM_CONFIG.PRICING;
    if (pricing && pricing.SINGLE && pricing.BUNDLES) {
      var compCount = Object.keys(pricing.SINGLE).length;
      pass("Config", "PRICING valid (" + compCount + " competitions priced)");
    } else {
      fail("Config", "PRICING section missing SINGLE or BUNDLES");
    }
  } catch (e) {
    fail("Config", "PRICING check failed: " + e.message);
  }

  try {
    var dep = SYSTEM_CONFIG.DEPERSONALIZATION;
    if (dep && dep.PREFIXES && dep.COUNTER_DIGITS) {
      var prefixes = Object.keys(dep.PREFIXES).join(", ");
      pass("Config", "DEPERSONALIZATION valid (prefixes: " + prefixes + ", digits: " + dep.COUNTER_DIGITS + ")");
    } else {
      fail("Config", "DEPERSONALIZATION section incomplete");
    }
  } catch (e) {
    fail("Config", "DEPERSONALIZATION check failed: " + e.message);
  }

  // =========================================================================
  // 2. SHEET EXISTENCE
  // =========================================================================
  var sheetConfig = SYSTEM_CONFIG.SHEETS;
  // Every sheet named in the settings. Some only exist once a feature has been used.
  var optionalSheets = {
    SUBMISSIONS: "needed before entries open: link the submission form and rename its response sheet to this name",
    PARTICIPANT_DB: "created by " + getMenuPathText_("showSystemBuilder"),
    LOGS: "created by itself the first time something is logged",
    CASHBACK_REPORT: "created by " + getMenuPathText_("exportCashbackReport")
  };
  Object.keys(sheetConfig).forEach(function (sheetKey) {
    var sheetName = sheetConfig[sheetKey];
    try {
      var foundSheet = ss.getSheetByName(sheetName);
      if (foundSheet) {
        pass("Sheets", sheetKey + " - found \"" + sheetName + "\" (" + Math.max(0, foundSheet.getLastRow() - 1) + " data rows)");
      } else if (optionalSheets[sheetKey]) {
        warn("Sheets", sheetKey + " - sheet \"" + sheetName + "\" not found (" + optionalSheets[sheetKey] + ")");
      } else {
        fail("Sheets", sheetKey + " - sheet \"" + sheetName + "\" NOT FOUND. Run " + getMenuPathText_("showSystemBuilder"));
      }
    } catch (e) {
      fail("Sheets", sheetKey + " - error: " + e.message);
    }
  });

  // Check competition output sheets
  var compSheets = getCompetitions_().map(function (c) { return c.sheetName; });
  for (var i = 0; i < compSheets.length; i++) {
    var cs = ss.getSheetByName(compSheets[i]);
    if (cs) {
      pass("Sheets", "Competition sheet \"" + compSheets[i] + "\" exists (" + cs.getLastRow() + " rows)");
    } else {
      warn("Sheets", "Competition sheet \"" + compSheets[i] + "\" not found (created by " + getMenuPathText_("generateCompetitionSheets") + ")");
    }
  }

  // =========================================================================
  // 3. COLUMN MAPPING VALIDATION
  // =========================================================================
  try {
    var regSheet = ss.getSheetByName(sheetConfig.REGISTRATION);
    if (regSheet) {
      var regHeaders = regSheet.getRange(1, 1, 1, regSheet.getLastColumn()).getValues()[0];
      var regCols = SYSTEM_CONFIG.COLS.REG;

      // Check critical columns exist and are within range
      var criticalRegCols = {
        "TIMESTAMP": regCols.TIMESTAMP,
        "EMAIL": regCols.EMAIL,
        "COMPETITION": regCols.COMPETITION,
        "GEN_ID": regCols.GEN_ID,
        "PAYMENT_STATUS": regCols.PAYMENT_STATUS
      };

      var regColCount = regHeaders.length;
      var regIssues = 0;
      for (var colName in criticalRegCols) {
        var colIdx = criticalRegCols[colName];
        if (colIdx > regColCount) {
          fail("Columns", "REG." + colName + " (col " + colIdx + ") exceeds sheet width (" + regColCount + " cols)");
          regIssues++;
        }
      }
      if (regIssues === 0) {
        pass("Columns", "Registration column mapping valid (" + regColCount + " columns, all critical indices in range)");
      }

      // Check SYS columns have correct headers
      var sysHeaders = SYSTEM_CONFIG.SYS_REG_HEADERS;
      var headerMismatches = 0;
      var sysRegCols = SYSTEM_CONFIG.SYS_REG_COLS;
      var sysChecks = {
        "SYS_PAID_AT": sysRegCols.SYS_PAID_AT,
        "SYS_VERIFIER": sysRegCols.SYS_VERIFIER,
        "SYS_PROCESSED": SYSTEM_CONFIG.SYS_REG_COLS_END.SYS_PROCESSED
      };
      for (var sysName in sysChecks) {
        var sysIdx = sysChecks[sysName] - 1;
        if (sysIdx < regColCount) {
          var actual = String(regHeaders[sysIdx]).trim();
          var expected = sysHeaders[sysName.replace("SYS_", "")] || sysName;
          if (actual && actual !== expected && actual.toUpperCase() !== sysName.toUpperCase()) {
            warn("Columns", "REG header mismatch at col " + (sysIdx + 1) + ": expected \"" + sysName + "\" but got \"" + actual + "\"");
            headerMismatches++;
          }
        }
      }
      if (headerMismatches === 0) {
        pass("Columns", "Registration SYS_ column headers look correct");
      }
    }
  } catch (e) {
    fail("Columns", "Registration column check failed: " + e.message);
  }

  try {
    var subSheet = ss.getSheetByName(sheetConfig.SUBMISSIONS);
    if (subSheet) {
      var subHeaders = subSheet.getRange(1, 1, 1, subSheet.getLastColumn()).getValues()[0];
      var subCols = SYSTEM_CONFIG.COLS.SUB;
      var subColCount = subHeaders.length;

      // Check critical submission columns
      var criticalSubCols = {
        "TIMESTAMP": subCols.TIMESTAMP,
        "EMAIL": subCols.EMAIL,
        "COMPETITION_TYPE": subCols.COMPETITION_TYPE,
        "ESSAY_NAME": subCols.ESSAY_NAME,
        "SPEECH_NAME": subCols.SPEECH_NAME,
        "PHOTO_NAME": subCols.PHOTO_NAME,
        "FILM_MEMBERS": subCols.FILM_MEMBERS,
        "FILM_FILE": subCols.FILM_FILE
      };

      var subIssues = 0;
      for (var cn in criticalSubCols) {
        var ci = criticalSubCols[cn];
        if (ci > subColCount) {
          fail("Columns", "SUB." + cn + " (col " + ci + ") exceeds sheet width (" + subColCount + " cols)");
          subIssues++;
        }
      }
      if (subIssues === 0) {
        pass("Columns", "Submission column mapping valid (" + subColCount + " columns, all critical indices in range)");
      }

      // Check SYS_PARTICIPANT_NUM exists
      var hasPartNum = false;
      for (var si = 0; si < subHeaders.length; si++) {
        if (String(subHeaders[si]).trim().toUpperCase() === "SYS_PARTICIPANT_NUM") {
          hasPartNum = true;
          break;
        }
      }
      if (hasPartNum) {
        pass("Columns", "SYS_PARTICIPANT_NUM column found in Submission sheet");
      } else {
        warn("Columns", "SYS_PARTICIPANT_NUM column NOT found — depersonalization may not have run yet");
      }
    }
  } catch (e) {
    fail("Columns", "Submission column check failed: " + e.message);
  }

  // =========================================================================
  // 4. KEY SERVICES & FUNCTIONS EXIST
  // =========================================================================
  var criticalFunctions = [
    { name: "Utils", check: function() { return typeof Utils !== "undefined" && Utils !== null; } },
    { name: "Utils.safeString", check: function() { return typeof Utils !== "undefined" && typeof Utils.safeString === "function"; } },
    { name: "Utils.normalizeEmail", check: function() { return typeof Utils !== "undefined" && typeof Utils.normalizeEmail === "function"; } },
    { name: "TriggerGuard", check: function() { return typeof TriggerGuard !== "undefined" && TriggerGuard !== null; } },
    { name: "AuditLogService", check: function() { return typeof AuditLogService !== "undefined" && AuditLogService !== null; } },
    { name: "generateCompetitionSheets", check: function() { return typeof generateCompetitionSheets === "function"; } }
  ];

  for (var fi = 0; fi < criticalFunctions.length; fi++) {
    var fn = criticalFunctions[fi];
    try {
      if (fn.check()) {
        pass("Functions", fn.name + " is available");
      } else {
        fail("Functions", fn.name + " is MISSING or undefined");
      }
    } catch (e) {
      fail("Functions", fn.name + " check error: " + e.message);
    }
  }

  // =========================================================================
  // 5. GOOGLE SERVICES AVAILABILITY
  // =========================================================================
  try {
    SpreadsheetApp.getActiveSpreadsheet().getName();
    pass("Services", "SpreadsheetApp accessible");
  } catch (e) {
    fail("Services", "SpreadsheetApp error: " + e.message);
  }

  try {
    CacheService.getScriptCache();
    pass("Services", "CacheService accessible");
  } catch (e) {
    fail("Services", "CacheService error: " + e.message);
  }

  try {
    PropertiesService.getScriptProperties();
    pass("Services", "PropertiesService accessible");
  } catch (e) {
    fail("Services", "PropertiesService error: " + e.message);
  }

  try {
    var quota = MailApp.getRemainingDailyQuota();
    pass("Services", "MailApp accessible (remaining daily quota: " + quota + ")");
  } catch (e) {
    warn("Services", "MailApp not accessible: " + e.message);
  }

  try {
    DriveApp.getRootFolder();
    pass("Services", "DriveApp accessible");
  } catch (e) {
    warn("Services", "DriveApp not accessible: " + e.message);
  }

  // =========================================================================
  // 6. DATA INTEGRITY SPOT CHECKS
  // =========================================================================
  try {
    var regSheet2 = ss.getSheetByName(sheetConfig.REGISTRATION);
    if (regSheet2 && regSheet2.getLastRow() > 1) {
      var regData = regSheet2.getDataRange().getValues();
      var dataRows = regData.length - 1;
      var emptyEmails = 0;
      var emptyTimestamps = 0;
      for (var di = 1; di < regData.length; di++) {
        var emailVal = String(regData[di][SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
        var tsVal = regData[di][SYSTEM_CONFIG.COLS.REG.TIMESTAMP - 1];
        if (!emailVal) emptyEmails++;
        if (!tsVal) emptyTimestamps++;
      }
      pass("Data", "Registration has " + dataRows + " data rows");
      if (emptyEmails > 0) {
        warn("Data", emptyEmails + " registration rows have empty emails");
      } else {
        pass("Data", "All registration rows have email addresses");
      }
      if (emptyTimestamps > 0) {
        warn("Data", emptyTimestamps + " registration rows have empty timestamps");
      }
    }
  } catch (e) {
    warn("Data", "Registration data check failed: " + e.message);
  }

  try {
    var subSheet2 = ss.getSheetByName(sheetConfig.SUBMISSIONS);
    if (subSheet2 && subSheet2.getLastRow() > 1) {
      var subData = subSheet2.getDataRange().getValues();
      var subDataRows = subData.length - 1;
      pass("Data", "Submission sheet has " + subDataRows + " data rows");
    }
  } catch (e) {
    warn("Data", "Submission data check failed: " + e.message);
  }

  // =========================================================================
  // 7. AUTOMATION, MENU AND CROSS-FEATURE CHECKS
  // =========================================================================
  try {
    var installedHandlers = ScriptApp.getProjectTriggers().map(function (t) { return t.getHandlerFunction(); });
    ["onFormSubmit", "onEdit"].forEach(function (handler) {
      if (installedHandlers.indexOf(handler) >= 0) {
        pass("Automation", "Trigger " + handler + " is installed");
      } else {
        fail("Automation", "Trigger " + handler + " is NOT installed, so nothing runs by itself. Run " + getMenuPathText_("createTriggers"));
      }
    });
  } catch (e) {
    warn("Automation", "Triggers could not be read: " + e.message);
  }

  try {
    var rateNow = RateLimiter.getStatus();
    if (rateNow.emailsSentThisHour >= rateNow.maxPerHour) {
      warn("Automation", "Hourly email cap reached (" + rateNow.emailsSentThisHour + "/" + rateNow.maxPerHour + "). New emails are marked SKIPPED until it resets.");
    } else {
      pass("Automation", "Hourly email cap: " + rateNow.emailsSentThisHour + " of " + rateNow.maxPerHour + " used");
    }
  } catch (e) {
    warn("Automation", "Rate limiter could not be read: " + e.message);
  }

  try {
    var compList = getCompetitions_();
    var compProblems = [];
    var seenPrefix = {}, seenReg = {};
    compList.forEach(function (c) {
      if (!c.registrationNames.length) compProblems.push(c.key + " has no registration name");
      c.registrationNames.forEach(function (n) {
        seenReg[n] = true;
        if (SYSTEM_CONFIG.PRICING.SINGLE[n] == null) compProblems.push("\"" + n + "\" has no price in PRICING.SINGLE");
      });
      if (!c.map) compProblems.push(c.key + ": \"" + c.submissionName + "\" is not in SUBMISSION_COMPETITION_MAP");
      else if (c.map.key !== c.key) compProblems.push(c.key + ": SUBMISSION_COMPETITION_MAP says key " + c.map.key);
      if (!SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[c.key]) compProblems.push(c.key + " has no number prefix");
      else if (seenPrefix[c.prefix]) compProblems.push("prefix " + c.prefix + " is used twice");
      seenPrefix[c.prefix] = true;
    });
    Object.keys(SYSTEM_CONFIG.PRICING.SINGLE).forEach(function (n) {
      if (!seenReg[n]) compProblems.push("\"" + n + "\" is priced but not in COMPETITIONS");
    });
    PricingEngine.aliasTargets().forEach(function (n) {
      if (SYSTEM_CONFIG.PRICING.SINGLE[n] == null) compProblems.push("the spelling table points at \"" + n + "\", which has no price");
    });
    if (compProblems.length === 0) {
      pass("Config", "Competition list, prices, submission map and number prefixes agree (" + compList.length + " competitions)");
    } else {
      fail("Config", "Competition settings disagree: " + compProblems.join("; "));
    }
  } catch (e) {
    warn("Config", "Competition list check failed: " + e.message);
  }

  try {
    var menuItems = flattenAdminMenu_();
    var brokenItems = menuItems.filter(function (item) { return !isGlobalFunction_(item.fn); });
    if (brokenItems.length === 0) {
      pass("Menu", "All " + menuItems.length + " menu items point to an existing function");
    } else {
      fail("Menu", "Menu items without a function: " + brokenItems.map(function (item) { return item.label + " (" + item.fn + ")"; }).join(", "));
    }
  } catch (e) {
    warn("Menu", "Menu check failed: " + e.message);
  }

  try {
    var finSheetHc = ss.getSheetByName(sheetConfig.FINANCE);
    if (finSheetHc && finSheetHc.getLastColumn() > 0) {
      var finHeaderMapHc = ColumnManager.headerMap(finSheetHc);
      var finAliasesHc = SYSTEM_CONFIG.FINANCE_HEADERS.ALIASES || {};
      var finPresentHc = {};
      Object.keys(finHeaderMapHc).forEach(function (h) { finPresentHc[finAliasesHc[h] || h] = true; });
      var finMissingHc = SYSTEM_CONFIG.FINANCE_HEADERS.REQUIRED.filter(function (h) { return !finPresentHc[h]; });
      if (finMissingHc.length === 0) {
        pass("Columns", "Finance sheet has all " + SYSTEM_CONFIG.FINANCE_HEADERS.REQUIRED.length + " required headers");
      } else {
        fail("Columns", "Finance sheet is missing: " + finMissingHc.join(", ") + ". They are added again by " + getMenuPathText_("syncDashboard"));
      }
    }
  } catch (e) {
    warn("Columns", "Finance header check failed: " + e.message);
  }

  try {
    var foldersMissingHc = Object.keys(SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES).filter(function (k) { return !getAnonFolderId_(k); });
    if (foldersMissingHc.length === 0) {
      pass("Submissions", "Anonymized folders are set for every competition");
    } else {
      warn("Submissions", "No anonymized folder for: " + foldersMissingHc.join(", ") + ". Run " + getMenuPathText_("configureAnonFolders") + " before entries open");
    }
  } catch (e) {
    warn("Submissions", "Folder check failed: " + e.message);
  }

  try {
    var regSheetHc = ss.getSheetByName(sheetConfig.REGISTRATION);
    if (regSheetHc && regSheetHc.getLastRow() > 1 && regSheetHc.getLastColumn() >= SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS) {
      var paidLookupHc = getPaidEmailLookup_();
      var regValsHc = regSheetHc.getRange(2, 1, regSheetHc.getLastRow() - 1, regSheetHc.getLastColumn()).getValues();
      var disagreeHc = 0, noGenIdHc = 0;
      for (var hx = 0; hx < regValsHc.length; hx++) {
        var emailHc = String(regValsHc[hx][SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
        if (!emailHc) continue;
        if (!String(regValsHc[hx][SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "").trim()) noGenIdHc++;
        if (paidLookupHc.isPaid(emailHc, "") !== Utils.isPaidStatus(regValsHc[hx][SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS - 1])) disagreeHc++;
      }
      if (disagreeHc === 0) {
        pass("Data", "Payment Status in " + sheetConfig.REGISTRATION + " agrees with " + sheetConfig.FINANCE + " (" + paidLookupHc.paid + " of " + paidLookupHc.total + " paid)");
      } else {
        warn("Data", disagreeHc + " registration row(s) show a Payment Status that differs from " + sheetConfig.FINANCE + ". Run " + getMenuPathText_("syncDashboard"));
      }
      if (noGenIdHc === 0) {
        pass("Data", "Every registration has a Gen ID");
      } else {
        warn("Data", noGenIdHc + " registration row(s) have no Gen ID (they arrived while the triggers were off). Run " + getMenuPathText_("runSmartMigration"));
      }
    }
  } catch (e) {
    warn("Data", "Payment agreement check failed: " + e.message);
  }

  // =========================================================================
  // 8. Build HTML Report
  // =========================================================================
  var tones = { PASS: "ok", FAIL: "bad", WARN: "warn" };
  var now = new Date();
  var ts;
  try {
    ts = Utilities.formatDate(now, SYSTEM_CONFIG.META.TIMEZONE, "MMM d, yyyy h:mm:ss a");
  } catch (e) {
    ts = now.toString();
  }

  // problems first, then what passed
  var rank = { FAIL: 0, WARN: 1, PASS: 2 };
  var sorted = results.map(function (r, i) { return { r: r, i: i }; })
    .sort(function (a, b) { return (rank[a.r.status] - rank[b.r.status]) || (a.i - b.i); })
    .map(function (x) { return x.r; });
  var reportRows = sorted.map(function (r) {
    return [uiBadge_(r.status, tones[r.status] || ""), '<span class="ui-muted">' + Utils.escapeHtml(r.cat) + '</span>', Utils.escapeHtml(r.msg)];
  });

  var reportBody =
    '<div class="ui-grid" style="margin-bottom:14px;">' +
      uiStat_(passCount, "Passed", "ok") + uiStat_(failCount, "Failed", "bad") + uiStat_(warnCount, "Warnings", "warn") +
    '</div>' +
    (failCount === 0
      ? uiCallout_("ok", "&#x2705;", "<b>All critical checks passed.</b> " + (warnCount ? "The warnings are things to know, not errors." : "The system is healthy."))
      : uiCallout_("bad", "&#x274C;", "<b>" + failCount + " critical issue" + (failCount === 1 ? "" : "s") + " need attention.</b> They are listed first, each with the tool that fixes it.")) +
    uiCard_("Checks", uiTable_(["Result", "Area", "Details"], reportRows), String(results.length));

  var html = [buildAdminDialog_({
    icon: "&#x1FA7A;",
    title: "System health check",
    subtitle: "Run at " + ts + " \u00B7 v" + SYSTEM_CONFIG.META.VERSION,
    actions: '<button class="ui-btn" onclick="google.script.host.close()">Close</button>',
    body: reportBody
  })];

  var output = HtmlService.createHtmlOutput(withGuideLink_(html.join("\n"), "help"))
    .setWidth(850)
    .setHeight(600)
    .setTitle("System Health Check");
  ui.showModalDialog(output, "System Health Check");

  AuditLogService.info("HEALTH_CHECK", "Completed: " + passCount + " pass, " + failCount + " fail, " + warnCount + " warn");
}


// ============================================================================
// PARTICIPANT NUMBER AUDIT TOOL
// ============================================================================
// Scans all submission rows to find participant numbers assigned to competitions
// where the participant didn't actually fill in the corresponding form section.
// ============================================================================

/**
 * Audit all participant numbers across submission rows.
 * Finds mismatches where a number was assigned but no form data exists.
 * Shows an interactive HTML report with cleanup options.
 */
function auditParticipantNumbers() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  if (!subSheet) {
    ui.alert("Error", "Submission Form sheet not found.", ui.ButtonSet.OK);
    return;
  }

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var partNumCol = sysCols["SYS_PARTICIPANT_NUM"];
  if (!partNumCol) {
    ui.alert("Error", "SYS_PARTICIPANT_NUM column not found.", ui.ButtonSet.OK);
    return;
  }

  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) {
    ui.alert("Info", "No submission data found.", ui.ButtonSet.OK);
    return;
  }

  var allData = subSheet.getRange(2, 1, lastRow - 1, subSheet.getLastColumn()).getValues();
  var S = SYSTEM_CONFIG.COLS.SUB;
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP;
  var PREFIXES = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;

  // Build reverse map: prefix → { competitionName, nameCol, fileCols }
  var prefixMap = {};
  var compNames = Object.keys(compMap);
  for (var cm = 0; cm < compNames.length; cm++) {
    var entry = compMap[compNames[cm]];
    var prefix = PREFIXES[entry.key];
    if (prefix) {
      prefixMap[prefix] = {
        competitionName: compNames[cm],
        key: entry.key,
        nameCol: entry.nameCol,
        fileCols: entry.fileCols || []
      };
    }
  }

  var issues = []; // { row, email, participantNum, competition, hasName, hasFile, action }
  var okCount = 0;
  var totalNums = 0;

  for (var i = 0; i < allData.length; i++) {
    var rowVals = allData[i];
    var rowNum = i + 2;
    var email = String(rowVals[S.EMAIL - 1] || "").trim();
    var partNums = String(rowVals[partNumCol - 1] || "").trim();
    if (!partNums) continue;

    var nums = partNums.split(/\s*,\s*/).filter(function(n) { return n.length > 0; });
    for (var n = 0; n < nums.length; n++) {
      var num = nums[n].trim();
      var prefix = num.split("-")[0];
      var info = prefixMap[prefix];
      totalNums++;

      if (!info) {
        issues.push({ row: rowNum, email: email, num: num, comp: "Unknown (" + prefix + ")", hasName: false, hasFile: false, type: "UNKNOWN" });
        continue;
      }

      var nameColNum = info.nameCol ? S[info.nameCol] : null;
