    '    if(!confirm("Retry sending " + d.recipients.length + " failed email(s) now?")) return;',
    '    cachedRecipients = d.recipients; selectedCategory = d.category;',
    '    document.getElementById("emailSubject").value = d.subject;',
    '    document.getElementById("emailBody").innerHTML = d.body;',
