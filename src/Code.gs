}

/**
 * Server-side: Resend confirmation email from the dashboard.
 * Sends the email only — does NOT re-run depersonalization.
 */
function dashResendConfirmation(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;

  var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  if (!email) throw new Error("No email found for row " + rowIndex);

  var rawCompType  = String(rowVals[S.COMPETITION_TYPE - 1] || "").trim();
  var partNumRaw   = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var genId        = sysCols["SYS_MATCHED_GEN_ID"]  ? String(rowVals[sysCols["SYS_MATCHED_GEN_ID"]  - 1] || "").trim() : "";

  if (!partNumRaw) throw new Error("No participant number assigned for row " + rowIndex + ". Please reprocess first.");

  var competitionTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var participantNums  = partNumRaw.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });

  var numByPrefix = {};
  for (var pi = 0; pi < participantNums.length; pi++) {
    var pParts = participantNums[pi].split("-");
    if (pParts.length >= 1) numByPrefix[pParts[0]] = participantNums[pi];
  }

  var inlineImages;
  try { inlineImages = LogoService.getInlineImages(); } catch (e) { inlineImages = {}; }

  var emailsSent = 0;
  for (var ci = 0; ci < competitionTypes.length; ci++) {
    var compType = competitionTypes[ci].trim();
    var compMap  = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compType];
    if (!compMap) {
      var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
      for (var k = 0; k < keys.length; k++) {
        if (keys[k].toUpperCase() === compType.toUpperCase()) {
          compMap  = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]];
          compType = keys[k];
          break;
        }
      }
    }
    if (!compMap) continue;

    var partNum = numByPrefix[SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[compMap.key]] || participantNums[ci] || participantNums[0] || "";
    if (!partNum) continue;

    var participantName = "";
    if (compMap.nameCol) {
      var nc = S[compMap.nameCol];
      if (nc) participantName = String(rowVals[nc - 1] || "").trim();
    }

    var result = {
      participantNum: partNum,
      competitionType: compType,
      matchedGenId: genId,
      participantName: participantName,
      email: email,
      status: "PROCESSED",
      piiResult: { flagged: false, matches: [] },
      fileCount: 0
    };

    var emailSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + partNum + "]";
    var emailHtml    = buildSubmissionConfirmationHtml_(result);
    MailApp.sendEmail({
      to: email,
      subject: emailSubject,
      htmlBody: emailHtml,
      inlineImages: inlineImages,
      name: SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME
    });
    emailsSent++;
    if (ci < competitionTypes.length - 1) Utilities.sleep(1000);
  }

  // Mark as sent if not already
  if (sysCols["SYS_CONFIRMATION_SENT"] && emailsSent > 0) {
    subSheet.getRange(rowIndex, sysCols["SYS_CONFIRMATION_SENT"]).setValue("YES");
  }

  AuditLogService.info("DASH_RESEND_CONFIRM", "Row " + rowIndex + ": resent " + emailsSent + " confirmation(s) to " + email);
  return { success: true, count: emailsSent };
}

/**
 * Returns a preview of the submission acknowledgement email for a given row
 * WITHOUT sending it. Used by the dashboard to show the email before confirming.
 * @param {number} rowIndex - 1-based row index in Submission Form
 * @returns {{ html: string, subject: string, recipient: string, participantNum: string }}
 */
function dashGetResendPreview(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width   = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];
  var S       = SYSTEM_CONFIG.COLS.SUB;

  var email      = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  if (!email) throw new Error("No email found for row " + rowIndex);

  var rawCompType = String(rowVals[S.COMPETITION_TYPE - 1] || "").trim();
  var partNumRaw  = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var genId       = sysCols["SYS_MATCHED_GEN_ID"]  ? String(rowVals[sysCols["SYS_MATCHED_GEN_ID"]  - 1] || "").trim() : "";

  if (!partNumRaw) throw new Error("No participant number on row " + rowIndex + ". Reprocess first.");

  var competitionTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var participantNums  = partNumRaw.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });

  var numByPrefix = {};
  for (var pi = 0; pi < participantNums.length; pi++) {
    var pp = participantNums[pi].split("-");
    if (pp.length >= 1) numByPrefix[pp[0]] = participantNums[pi];
  }

  // Build preview for the FIRST valid competition (covers the most common single-comp case;
  // multi-comp will show a combined preview subject listing all numbers)
  var previewHtmlParts = [];
  var previewSubject = "";
  var previewPartNums = [];

  for (var ci = 0; ci < competitionTypes.length; ci++) {
    var compType = competitionTypes[ci].trim();
    var compMap  = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compType];
    if (!compMap) {
      var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
      for (var k = 0; k < keys.length; k++) {
        if (keys[k].toUpperCase() === compType.toUpperCase()) { compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]]; compType = keys[k]; break; }
      }
    }
    if (!compMap) continue;

    var partNum = numByPrefix[SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[compMap.key]] || participantNums[ci] || participantNums[0] || "";
    if (!partNum) continue;
    previewPartNums.push(partNum);

    var participantName = "";
    if (compMap.nameCol) {
      var nc = S[compMap.nameCol];
      if (nc) participantName = String(rowVals[nc - 1] || "").trim();
    }

    var result = {
      participantNum: partNum,
      competitionType: compType,
      matchedGenId: genId,
      participantName: participantName,
      email: email,
      status: "PROCESSED",
      piiResult: { flagged: false, matches: [] },
      fileCount: 0
    };

    previewHtmlParts.push(buildSubmissionConfirmationHtml_(result));
    if (!previewSubject) {
      previewSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + partNum + "]";
    }
  }

  if (previewHtmlParts.length === 0) throw new Error("Could not build email preview for row " + rowIndex + ".");

  // For multi-competition rows, show a combined subject
  if (previewPartNums.length > 1) {
    previewSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + previewPartNums.join(", ") + "]";
  }

  AuditLogService.info("DASH_RESEND_PREVIEW", "Row " + rowIndex + ": preview generated for " + email + " (" + previewPartNums.join(", ") + ")");

  return {
    html:         previewHtmlParts[0], // show first competition email; subject covers all
    subject:      previewSubject,
    recipient:    email,
    participantNum: previewPartNums.join(", ")
  };
}

