/**
 * Test email threading - sends 2 emails to verify they appear in same thread
 * for BOTH sender and recipient
 */
function testEmailThreading() {
  var ui = SpreadsheetApp.getUi();
  
  var response = ui.prompt(
    "🧪 Test Email Threading",
    "Enter the email address to send test emails to:\n\n" +
    "(Two emails will be sent - they should appear in the SAME thread)",
    ui.ButtonSet.OK_CANCEL
  );
  
  if (response.getSelectedButton() !== ui.Button.OK) return;
  
  var testEmail = response.getResponseText().trim();
  if (!testEmail || !Utils.isValidEmail(testEmail)) {
    ui.alert("Invalid email address.");
    return;
  }
  
  // Ask if they want to include logos
  var includeLogos = ui.alert(
    "Include Logos?",
    "Do you want to include inline images (logos) in the test?\n\n" +
    "YES = Test with logos (like real emails)\n" +
    "NO = Test without logos (simple HTML)",
    ui.ButtonSet.YES_NO
  ) === ui.Button.YES;
  
  ui.alert(
    "📧 Starting Test",
    "Will send 2 test emails to: " + testEmail + "\n\n" +
    "Include logos: " + (includeLogos ? "YES" : "NO") + "\n\n" +
    "1. First email (creates thread)\n" +
    "2. Second email (should reply to thread)\n\n" +
    "Click OK to start.",
    ui.ButtonSet.OK
  );
  
  var testId = "TEST-" + new Date().getTime();
  var subject = SYSTEM_CONFIG.META.NAME + ": Threading Test [" + testId + "]";
  
  // Get inline images if requested
  var inlineImages = null;
  if (includeLogos) {
    inlineImages = LogoService.getInlineImages();
    Logger.log("Using inline images: " + (inlineImages ? Object.keys(inlineImages).join(", ") : "none"));
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending first email via Gmail API...", "🧪 Test", -1);
  
  // ===== FIRST EMAIL =====
  var logoHtml = includeLogos ? '<p><img src="cid:uplb_logo" width="50"> <img src="cid:husay_logo" width="50"></p>' : '';
  
  var html1 = '<html><body style="font-family:Arial,sans-serif;padding:20px;">' +
    '<div style="max-width:600px;margin:0 auto;border:2px solid ' + SYSTEM_CONFIG.BRAND.INDIGO + ';border-radius:10px;padding:20px;">' +
    logoHtml +
    '<h2 style="color:' + SYSTEM_CONFIG.BRAND.INDIGO + ';margin-top:0;">📧 Email Threading Test - Email #1</h2>' +
    '<p>This is the <strong>FIRST</strong> email in the thread test.</p>' +
    '<p>Test ID: <code>' + testId + '</code></p>' +
    '<p>Has Inline Images: <strong>' + (includeLogos ? 'YES' : 'NO') + '</strong></p>' +
    '<p>Sent at: ' + new Date().toLocaleString() + '</p>' +
    '<hr style="border:none;border-top:1px solid #eee;margin:20px 0;">' +
    '<p style="color:#666;font-size:12px;">If threading works correctly, Email #2 should appear as a reply to this email in your inbox.</p>' +
    '</div></body></html>';
  
  // Use the new Gmail API method
  var firstResult = EmailThreadService.sendFirstEmail(testEmail, subject, html1, inlineImages);
  
  if (!firstResult.success) {
    ui.alert("❌ Error", "Failed to send first email:\n" + (firstResult.error || "Unknown error"), ui.ButtonSet.OK);
    return;
  }
  
  var threadId = firstResult.threadId;
  var rfc822MessageId = firstResult.rfc822MessageId;
  
  Logger.log("First email sent - ThreadId: " + threadId + ", RFC822 Message-ID: " + rfc822MessageId);
  
  SpreadsheetApp.getActiveSpreadsheet().toast(
    "First email sent! Thread: " + (threadId || "N/A") + ", MsgId: " + (rfc822MessageId ? "✓" : "N/A"), 
    "🧪 Test", 3
  );
  
  // Wait for Gmail to process
  Utilities.sleep(3000);
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending reply email with In-Reply-To header...", "🧪 Test", -1);
  
  // ===== SECOND EMAIL (REPLY) =====
  var html2 = '<html><body style="font-family:Arial,sans-serif;padding:20px;">' +
    '<div style="max-width:600px;margin:0 auto;border:2px solid #059669;border-radius:10px;padding:20px;">' +
    logoHtml +
    '<h2 style="color:#059669;margin-top:0;">📧 Email Threading Test - Email #2 (Reply)</h2>' +
    '<p>This is the <strong>SECOND</strong> email - it should be a REPLY to Email #1.</p>' +
    '<p>Test ID: <code>' + testId + '</code></p>' +
    '<p>Has Inline Images: <strong>' + (includeLogos ? 'YES' : 'NO') + '</strong></p>' +
    '<p>In-Reply-To: <code style="font-size:10px;">' + (rfc822MessageId || "N/A") + '</code></p>' +
    '<p>Sent at: ' + new Date().toLocaleString() + '</p>' +
    '<hr style="border:none;border-top:1px solid #eee;margin:20px 0;">' +
    '<p style="color:#059669;font-size:14px;font-weight:bold;">✅ If you see this in the SAME thread as Email #1, threading is working!</p>' +
    '<p style="color:#DC2626;font-size:14px;font-weight:bold;">❌ If this is a SEPARATE email, threading is NOT working.</p>' +
    '</div></body></html>';
  
  var replyResult = EmailThreadService.sendReplyEmail(
    testEmail,
    subject,
    html2,
    inlineImages,  // Include logos if requested
    threadId,
    rfc822MessageId
  );
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "✅", 3);
  
  var resultMessage = "Both emails have been sent to: " + testEmail + "\n\n";
  resultMessage += "═══════════════════════════════════\n";
  resultMessage += "Include Logos: " + (includeLogos ? "YES" : "NO") + "\n";
  resultMessage += "Thread ID: " + (threadId || "NOT CAPTURED") + "\n";
  resultMessage += "RFC822 Message-ID: " + (rfc822MessageId || "NOT CAPTURED") + "\n";
  resultMessage += "First Email Method: " + (firstResult.method || "unknown") + "\n";
  resultMessage += "Reply Method: " + (replyResult.method || "unknown") + "\n";
  resultMessage += "═══════════════════════════════════\n\n";
  
  if (rfc822MessageId && replyResult.success) {
    resultMessage += "✅ Both emails sent via Gmail API with proper headers!\n\n";
  } else {
    resultMessage += "⚠️ Some issues occurred - check logs.\n\n";
  }
  
  resultMessage += "Now check " + testEmail + "'s inbox:\n\n";
  resultMessage += "✅ SUCCESS: Both emails in ONE thread\n";
  resultMessage += "❌ FAILED: Emails appear separate";
  
  ui.alert("✅ Test Complete!", resultMessage, ui.ButtonSet.OK);
}

/**
 * Test threading using existing registration (resend ALL email types)
 * Tests RR, AR, Referral Success, and Referral Removal notifications
 */
function testThreadingExistingRegistration() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var row = SpreadsheetApp.getActiveRange().getRow();
  
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    ui.alert("Please select a row in the Registration sheet.");
    return;
  }
  
  if (row < 2) {
    ui.alert("Please select a data row (not the header).");
    return;
  }
  
  // ===== READ ALL DATA FROM SHEET (EXACTLY LIKE PRODUCTION) =====
  var repo = new SheetRepository();
  var rowData = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  
  // Build header index map
  var headerIndex = {};
  for (var h = 0; h < headers.length; h++) {
    headerIndex[String(headers[h]).trim()] = h;
  }
  
  // Core fields from fixed columns
  var email = rowData[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "";
  var name = rowData[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "";
  var school = rowData[SYSTEM_CONFIG.COLS.REG.SCHOOL - 1] || "";
  var competitions = rowData[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "";
  var payMode = rowData[SYSTEM_CONFIG.COLS.REG.PAY_MODE - 1] || "";
  var genId = rowData[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "";
  var lockedCoupon = rowData[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || "";
  var lockedRef = rowData[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "";
  var finalAmount = Number(rowData[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
  var cashback = Number(rowData[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
  var refCount = Number(rowData[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
  var masterSubject = rowData[SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT - 1] || "";
  
  // SYS fields from dynamic columns
  var refDiscountApplied = 0;
  if (headerIndex[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED] !== undefined) {
    refDiscountApplied = Number(rowData[headerIndex[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]] || 0);
  }
  
  if (!email || !genId) {
    ui.alert("Selected row is missing email or Gen ID.");
    return;
  }
  
  // Coupon value from the Coupon Manager sheet (the lookup every feature shares)
  var couponDiscountValue = lockedCoupon ? getCouponValue_(lockedCoupon, repo.getCouponSheet()) : 0;
  
  // Calculate pricing
  var pricing = PricingEngine.calculate("", competitions);
  var normalizedCompetitions = pricing.normalizedCompetitions || competitions;
  
  // Use referral discount from sheet, or calculate if not stored
  var referralDiscount = refDiscountApplied;
  if (!referralDiscount && lockedRef) {
    referralDiscount = SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE || 0;
  }
  
  // ===== ASK USER WHICH EMAILS TO TEST =====
  var testChoice = ui.alert(
    "🧪 Test ALL Email Types",
    "This will test email threading with ALL 4 email types:\n\n" +
    "1️⃣ Registration Received (RR) - Creates thread\n" +
    "2️⃣ Acknowledgement Receipt (AR) - Reply to thread\n" +
    "3️⃣ Referral Success Notification - Reply to thread\n" +
    "4️⃣ Referral Removal Notification - Reply to thread\n\n" +
    "══════ PARTICIPANT DATA ══════\n" +
    "Name: " + name + "\n" +
    "Email: " + email + "\n" +
    "Gen ID: " + genId + "\n" +
    "Final Amount: ₱" + finalAmount + "\n" +
    "Referral Count: " + refCount + "\n" +
    "Cashback: ₱" + cashback + "\n\n" +
    "All 4 emails will be sent to: " + email + "\n\n" +
    "Continue?",
    ui.ButtonSet.YES_NO
  );
  
  if (testChoice !== ui.Button.YES) return;
  
  // Clear existing thread info
  var threadColIndex = headerIndex[SYSTEM_CONFIG.SYS_REG_HEADERS.EMAIL_THREAD_ID];
  if (threadColIndex !== undefined) {
    sheet.getRange(row, threadColIndex + 1).setValue("");
    Logger.log("Cleared thread info at column " + (threadColIndex + 1));
  }
  
  // Clear email tracking for all types
  ReceiptGuard.clearTracking(genId, "REGCONF");
  ReceiptGuard.clearTracking(genId, "PAID");
  ReceiptGuard.clearTracking("REFNOTIF-" + genId + "-TEST", "REFNOTIF_SUCCESS");
  ReceiptGuard.clearTracking("REFNOTIF-REM-" + genId + "-TEST", "REFNOTIF_REMOVED");
  
  var baseSubject = masterSubject || (SYSTEM_CONFIG.META.NAME + ": Registration [" + genId + "]");
  var inlineImages = LogoService.getInlineImages();
  var results = {};
  
  // ═══════════════════════════════════════════════════════════════════
  // EMAIL 1: REGISTRATION RECEIVED (RR)
  // ═══════════════════════════════════════════════════════════════════
  SpreadsheetApp.getActiveSpreadsheet().toast("1/4: Sending Registration Received...", "🧪 Test", -1);
  
  var regEmailData = {
    name: name,
    school: school,
    payMode: payMode,
    competitions: competitions,
    genId: genId,
    finalAmount: finalAmount,
    couponCode: lockedCoupon || "",
    refCodeUsed: lockedRef || "",
    cashback: cashback
  };
  
  var regHtml = EmailBuilder.buildRegistrationConfirmedHtml(
    regEmailData, 
    pricing, 
    couponDiscountValue,
    referralDiscount,
    { preview: false }
  );
  
  var result1 = EmailThreadService.sendFirstEmail(email, baseSubject, regHtml, inlineImages);
  results.rr = result1;
  
  if (!result1.success) {
    ui.alert("❌ Registration email failed: " + (result1.error || "Unknown"));
    return;
  }
  
  var threadId = result1.threadId;
  var rfc822MessageId = result1.rfc822MessageId;
  
  // Store thread info
  if (threadId) {
    EmailThreadService.setThreadInfo(genId, threadId, rfc822MessageId);
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("1/4: RR sent ✓ Waiting...", "🧪 Test", 2);
  Utilities.sleep(2000);
  
  // ═══════════════════════════════════════════════════════════════════
  // EMAIL 2: ACKNOWLEDGEMENT RECEIPT (AR)
  // ═══════════════════════════════════════════════════════════════════
  SpreadsheetApp.getActiveSpreadsheet().toast("2/4: Sending Acknowledgement Receipt...", "🧪 Test", -1);
  
  var arPaidData = {
    name: name,
    school: school,
    payMode: payMode,
    competitions: normalizedCompetitions,
    genId: genId,
    finalAmount: finalAmount,
    couponCode: lockedCoupon,
    couponDiscount: couponDiscountValue,
    referralDiscount: referralDiscount,
    cashback: cashback,
    paidAt: new Date()
  };
  
  var arHtml = EmailBuilder.buildReceiptHtml(arPaidData, false, { preview: false });
  
  var storedThreadInfo = EmailThreadService.getThreadInfo(genId);
  var result2;
  if (storedThreadInfo && storedThreadInfo.threadId && storedThreadInfo.messageId) {
    result2 = EmailThreadService.sendReplyEmail(
      email, baseSubject, arHtml, inlineImages,
      storedThreadInfo.threadId, storedThreadInfo.messageId
    );
  } else {
    result2 = { success: false, error: "No thread info" };
  }
  results.ar = result2;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("2/4: AR sent ✓ Waiting...", "🧪 Test", 2);
  Utilities.sleep(2000);
  
  // ═══════════════════════════════════════════════════════════════════
  // EMAIL 3: REFERRAL SUCCESS NOTIFICATION
  // ═══════════════════════════════════════════════════════════════════
  SpreadsheetApp.getActiveSpreadsheet().toast("3/4: Sending Referral Success Notification...", "🧪 Test", -1);
  
  var refSuccessData = {
    referrerCode: genId,
    referrerName: name,
    referredName: "Test Referral Person",
    referredGenId: "TEST-REF-" + Date.now(),
    // Same field names and reward rule the live notification uses
    newCount: refCount + 1,
    newCashback: cashback + (refCount === 0 ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT),
    cashbackEarned: (refCount === 0 ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT)
  };
  
  var refSuccessHtml = EmailBuilder.buildReferralSuccessHtml(refSuccessData, { preview: false });
  
  var result3;
  storedThreadInfo = EmailThreadService.getThreadInfo(genId);
  if (storedThreadInfo && storedThreadInfo.threadId && storedThreadInfo.messageId) {
    result3 = EmailThreadService.sendReplyEmail(
      email, baseSubject, refSuccessHtml, inlineImages,
      storedThreadInfo.threadId, storedThreadInfo.messageId
    );
  } else {
    result3 = { success: false, error: "No thread info" };
  }
  results.refSuccess = result3;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("3/4: Referral Success sent ✓ Waiting...", "🧪 Test", 2);
  Utilities.sleep(2000);
  
  // ═══════════════════════════════════════════════════════════════════
  // EMAIL 4: REFERRAL REMOVAL NOTIFICATION
  // ═══════════════════════════════════════════════════════════════════
  SpreadsheetApp.getActiveSpreadsheet().toast("4/4: Sending Referral Removal Notification...", "🧪 Test", -1);
  
  var refRemovedData = {
    referrerCode: genId,
    referrerName: name,
    referredName: "Test Removed Person",
    referredGenId: "TEST-REM-" + Date.now(),
    newCount: Math.max(0, refCount - 1),
    newCashback: Math.max(0, cashback - (refCount <= 1 ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT)),
    cashbackRemoved: (refCount <= 1 ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT),
    reason: "Payment was not completed (test scenario)"
  };
  
  var refRemovedHtml = EmailBuilder.buildReferralRemovedHtml(refRemovedData, { preview: false });
  
  var result4;
  storedThreadInfo = EmailThreadService.getThreadInfo(genId);
  if (storedThreadInfo && storedThreadInfo.threadId && storedThreadInfo.messageId) {
    result4 = EmailThreadService.sendReplyEmail(
      email, baseSubject, refRemovedHtml, inlineImages,
      storedThreadInfo.threadId, storedThreadInfo.messageId
    );
  } else {
    result4 = { success: false, error: "No thread info" };
  }
  results.refRemoved = result4;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("All 4 emails sent!", "✅", 3);
  
  // ═══════════════════════════════════════════════════════════════════
  // RESULT SUMMARY
  // ═══════════════════════════════════════════════════════════════════
  var allSuccess = result1.success && result2.success && result3.success && result4.success;
  
