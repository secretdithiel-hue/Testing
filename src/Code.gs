  h.push('<p style="font-size:14px;color:#78350f;margin:0;line-height:1.5;">' + esc(reason) + '</p>');
  h.push('</td></tr></table>');

  // Submission details table
  var thStyle = 'align="left" style="background:#f8fafc;padding:10px 12px;border:1px solid #e6e8ec;width:40%;font-weight:bold;"';
  var tdStyle = 'style="padding:10px 12px;border:1px solid #e6e8ec;"';

  h.push('<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 20px;">');
  if (partNum) h.push('<tr><th ' + thStyle + '>Participant No.</th><td ' + tdStyle + '>' + esc(partNum) + '</td></tr>');
  h.push('<tr><th ' + thStyle + '>Competition</th><td ' + tdStyle + '>' + esc(rawCompType) + '</td></tr>');
  if (participantName) h.push('<tr><th ' + thStyle + '>Name</th><td ' + tdStyle + '>' + esc(participantName) + '</td></tr>');
  h.push('</table>');

  // What to do section
