// ----- Submission Sheet Access -----
SheetRepository.prototype.getSubmissionSheet = function () {
  if (!this._sub) this._sub = this.ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  return this._sub;
};

SheetRepository.prototype.getSubmissionRow = function (rowIndex) {
  var sheet = this.getSubmissionSheet();
  var width = sheet.getLastColumn();
  return sheet.getRange(rowIndex, 1, 1, width).getValues()[0];
};

SheetRepository.prototype.findSubmissionRowsByEmail = function (email) {
  var sheet = this.getSubmissionSheet();
  var target = Utils.normalizeEmail(email);
  if (!sheet || !target) return [];
  var emailCol = SYSTEM_CONFIG.COLS.SUB.EMAIL;
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var values = sheet.getRange(2, emailCol, lastRow - 1, 1).getValues();
  var results = [];
  for (var i = 0; i < values.length; i++) {
    if (Utils.normalizeEmail(values[i][0]) === target) results.push(i + 2);
  }
  return results;
};

// ----- Depersonalization Service -----
var DepersonalizationService = (function () {

  /**
   * Generate the next sequential participant number for a competition.
   * Scans existing SYS_PARTICIPANT_NUM values to find the max and increments.
   * @param {Sheet} subSheet - The submissions sheet
   * @param {Object} sysCols - Column map from ensureSysColsOnSubmissions
   * @param {string} competitionKey - e.g. "SPEECH", "ESSAY"
   * @returns {string} e.g. "SP-0001"
   */
  function generateParticipantNumber_(subSheet, sysCols, competitionKey) {
    var prefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[competitionKey];
    var digits = SYSTEM_CONFIG.DEPERSONALIZATION.COUNTER_DIGITS;
    var numCol = sysCols["SYS_PARTICIPANT_NUM"];
    if (!numCol) return prefix + "-" + padNumber_(1, digits);

    var lastRow = subSheet.getLastRow();
    var maxNum = 0;
    if (lastRow >= 2) {
      var vals = subSheet.getRange(2, numCol, lastRow - 1, 1).getValues();
      var re = new RegExp("^" + prefix + "-(\\d+)$");
      for (var i = 0; i < vals.length; i++) {
        // Split by comma to handle multi-competition cells like "ES-0039, FM-0017"
        var parts = String(vals[i][0]).split(/\s*,\s*/);
        for (var j = 0; j < parts.length; j++) {
          var m = parts[j].trim().match(re);
          if (m) {
            var n = parseInt(m[1], 10);
            if (n > maxNum) maxNum = n;
          }
        }
      }
    }
    return prefix + "-" + padNumber_(maxNum + 1, digits);
  }

  function padNumber_(num, digits) {
    var s = String(num);
    while (s.length < digits) s = "0" + s;
    return s;
  }

  /**
   * Match submitter email to Registration Form registration.
   * @returns {Object|null} { rowIndex, genId, name, school, paymentStatus }
   */
  function matchToRegistration_(email, repo) {
    var regSheet = repo.getRegistrationSheet();
    if (!regSheet) return null;
    var rowIdx = repo.findRegistrationRowIndexByEmail(email);
    if (!rowIdx) return null;
    var row = repo.getRegistrationRow(rowIdx);
    var R = SYSTEM_CONFIG.COLS.REG;
    var paymentStatus = String(row[R.PAYMENT_STATUS - 1] || "").trim();

    // The Financial Dashboard is the source of truth for payment status.
    // If the Registration column is blank or stale, fall back to it so paid
    // participants are not blocked from submitting.
    if (paymentStatus !== SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
      try {
        var finSheet = repo.getFinanceSheet();
        var finHeaders = finSheet ? ColumnManager.headerMap(finSheet) : {};
        var finEmailCol = finHeaders["Email"];
        var finStatusCol = finHeaders["Status"];
        var isPaidInFinance = function (someEmail) {
          if (!finSheet || !finEmailCol || !finStatusCol || !someEmail) return false;
          var finRow = repo.findFinanceRowIndexByEmail(someEmail, { Email: finEmailCol });
          if (!finRow) return false;
          return Utils.normalizeStatusValue(finSheet.getRange(finRow, finStatusCol).getValue()) === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
        };

        if (isPaidInFinance(email)) {
          paymentStatus = SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
        } else if (typeof MergeService !== "undefined") {
          // Member of a merged group: the payment is carried by the group's primary payer
          // (a member's own status cells are deliberately left blank by the merge).
          var mergeMeta = MergeService.getMergeMetaForEmail_(email, rowIdx, regSheet);
          if (mergeMeta && mergeMeta.groupId) {
            var mergeGroup = MergeService.getGroupFromRegistration_(mergeMeta.groupId, regSheet);
            var payerEmail = mergeGroup ? mergeGroup.primaryEmail : mergeMeta.primaryEmail;
            if (payerEmail && Utils.normalizeEmail(payerEmail) !== email && isPaidInFinance(payerEmail)) {
              paymentStatus = SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
            }
          }
        }
      } catch (finErr) {
        AuditLogService.warn("SUB_FIN_STATUS_LOOKUP_FAIL", "email=" + email + " err=" + finErr);
      }
    }

    return {
      rowIndex: rowIdx,
      genId: String(row[R.GEN_ID - 1] || "").trim(),
      name: String(row[R.NAME - 1] || "").trim(),
      school: String(row[R.SCHOOL - 1] || "").trim(),
      paymentStatus: paymentStatus
    };
  }

  /**
   * Extract text content from a Google Drive file for PII scanning.
   * Supports Google Docs, PDFs (via Drive API OCR conversion), .docx, and plain text.
   * @param {string} fileId - Google Drive file ID
   * @returns {Object} { text: string, fileName: string, mimeType: string, error: string|null }
   */
  function extractTextFromFile_(fileId) {
    var MAX_CHARS = 50000; // limit to prevent timeout
    var result = { text: "", fileName: "", mimeType: "", error: null };

    try {
      var file = DriveApp.getFileById(fileId);
      result.fileName = file.getName();
      result.mimeType = file.getMimeType();
      var mime = result.mimeType;

      // Google Docs — native text extraction
      if (mime === "application/vnd.google-apps.document") {
        var doc = DocumentApp.openById(fileId);
        result.text = doc.getBody().getText().substring(0, MAX_CHARS);
        return result;
      }

      // Plain text files
      if (mime === "text/plain" || mime === "text/csv") {
        result.text = file.getBlob().getDataAsString().substring(0, MAX_CHARS);
        return result;
      }

      // PDF or Word (.docx) — convert to temp Google Doc via Drive API, extract text, delete temp
      if (mime === "application/pdf" ||
          mime === "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
          mime === "application/msword") {
        try {
          // Use Drive Advanced Service v3 to convert PDF/docx → Google Doc
          var tempResource = {
            name: "__PII_SCAN_TEMP_" + fileId,
            mimeType: "application/vnd.google-apps.document"
          };
          var blob = file.getBlob();
          var tempFile = Drive.Files.create(tempResource, blob, { ocrLanguage: "en" });
          var tempDoc = DocumentApp.openById(tempFile.id);
          result.text = tempDoc.getBody().getText().substring(0, MAX_CHARS);
          // Clean up temp file
          DriveApp.getFileById(tempFile.id).setTrashed(true);
          return result;
        } catch (convErr) {
          result.error = "Drive API conversion failed (is Advanced Drive Service enabled?): " + convErr;
          AuditLogService.warn("PII_SCAN_CONVERT_ERR", result.fileName + ": " + result.error);
          return result;
        }
      }

      // Unsupported MIME type
      result.error = "Unsupported file type for text extraction: " + mime;
      return result;
    } catch (e) {
      result.error = "Failed to access file: " + e;
      return result;
    }
  }

  /**
   * Scan a document file for PII (participant name, school, adviser).
   * @param {string} fileId - Google Drive file ID
   * @param {string} participantName - Full name to search for
   * @param {string} schoolName - School/university to search for
   * @param {string} adviserName - Adviser/coach name to search for
   * @returns {Object} { flagged: boolean, matches: string[], fileName: string, error: string|null }
   */
  function scanDocumentForPii_(fileId, participantName, schoolName, adviserName) {
    var scanResult = { flagged: false, matches: [], fileName: "", error: null };

    var extracted = extractTextFromFile_(fileId);
    scanResult.fileName = extracted.fileName;
    scanResult.error = extracted.error;

    if (!extracted.text || extracted.error) return scanResult;

    var upper = extracted.text.toUpperCase();

    // Check participant name parts (each word > 2 chars)
    if (participantName) {
      var nameParts = participantName.toUpperCase().split(/\s+/);
      for (var i = 0; i < nameParts.length; i++) {
        if (nameParts[i].length > 2 && upper.indexOf(nameParts[i]) >= 0) {
          scanResult.flagged = true;
          scanResult.matches.push("Name: \"" + nameParts[i] + "\" in " + extracted.fileName);
        }
      }
    }

    // Check school name parts (each word > 3 chars)
    if (schoolName && schoolName.length > 3) {
      var schoolParts = schoolName.toUpperCase().split(/[\s\-\/]+/);
      for (var j = 0; j < schoolParts.length; j++) {
        if (schoolParts[j].length > 3 && upper.indexOf(schoolParts[j]) >= 0) {
          scanResult.flagged = true;
          scanResult.matches.push("School: \"" + schoolParts[j] + "\" in " + extracted.fileName);
        }
      }
    }

    // Check adviser name parts (each word > 2 chars)
    if (adviserName) {
      var advParts = adviserName.toUpperCase().split(/\s+/);
      for (var k = 0; k < advParts.length; k++) {
        if (advParts[k].length > 2 && upper.indexOf(advParts[k]) >= 0) {
          scanResult.flagged = true;
          scanResult.matches.push("Adviser: \"" + advParts[k] + "\" in " + extracted.fileName);
        }
      }
    }

    return scanResult;
  }

  /**
   * Check if a title or filename contains PII (participant name or school).
   * @returns {Object} { flagged: boolean, matches: string[] }
   */
  function flagPiiInTitle_(text, participantName, schoolName) {
    var result = { flagged: false, matches: [] };
    if (!text) return result;
    var upper = text.toUpperCase();

    if (participantName) {
      var nameParts = participantName.toUpperCase().split(/\s+/);
      for (var i = 0; i < nameParts.length; i++) {
        if (nameParts[i].length > 2 && upper.indexOf(nameParts[i]) >= 0) {
          result.flagged = true;
          result.matches.push("Name part: " + nameParts[i]);
        }
      }
    }
    if (schoolName && schoolName.length > 3) {
      var schoolParts = schoolName.toUpperCase().split(/[\s\-\/]+/);
      for (var j = 0; j < schoolParts.length; j++) {
        if (schoolParts[j].length > 3 && upper.indexOf(schoolParts[j]) >= 0) {
          result.flagged = true;
          result.matches.push("School part: " + schoolParts[j]);
        }
      }
    }
    return result;
  }

  /**
   * Extract a Google Drive file ID from a URL.
   * Handles various Drive/Forms URL formats.
   */
  function extractFileId_(url) {
    if (!url) return null;
    var str = String(url).trim();
    // Format: https://drive.google.com/open?id=FILE_ID
    var m1 = str.match(/[?&]id=([a-zA-Z0-9_-]+)/);
    if (m1) return m1[1];
    // Format: https://drive.google.com/file/d/FILE_ID/...
    var m2 = str.match(/\/d\/([a-zA-Z0-9_-]+)/);
    if (m2) return m2[1];
    // If it looks like a bare ID
    if (/^[a-zA-Z0-9_-]{20,}$/.test(str)) return str;
    return null;
  }

  /**
   * Copy and rename files to the anonymized folder.
   * @param {Object[]} fileCols - array of column config keys like "SPEECH_VIDEO"
   * @param {string[]} rowVals - full row values
   * @param {string} participantNum - e.g. "SP-0001"
   * @param {string} anonFolderId - Google Drive folder ID
   * @returns {Object[]} array of { originalId, anonId, anonName }
   */
  function depersonalizeFiles_(fileCols, rowVals, participantNum, anonFolderId) {
    var results = [];
    var failedCount = 0; // Bug 6 fix: track copy failures separately

    if (!anonFolderId) {
      AuditLogService.warn("DEPERSON_NO_FOLDER", "No anonymized folder configured for " + participantNum);
      return { files: results, failedCount: 0 };
    }

    var folder;
    try {
      folder = DriveApp.getFolderById(anonFolderId);
    } catch (e) {
      AuditLogService.error("DEPERSON_FOLDER_ERR", "Cannot access folder " + anonFolderId + ": " + e);
      return { files: results, failedCount: 0 };
    }

    for (var i = 0; i < fileCols.length; i++) {
      var colKey = fileCols[i];
      var colNum = SYSTEM_CONFIG.COLS.SUB[colKey];
      if (!colNum) continue;
      var cellValue = String(rowVals[colNum - 1] || "").trim();
      if (!cellValue) continue;

      var fileId = extractFileId_(cellValue);
      if (!fileId) {
        AuditLogService.warn("DEPERSON_NO_FILE_ID", "Could not extract file ID from col " + colKey + ": " + cellValue);
        failedCount++; // Bug 6: count this as a failure
        continue;
      }

      try {
        var originalFile = DriveApp.getFileById(fileId);
        var originalName = originalFile.getName();
        var ext = "";
        var dotIdx = originalName.lastIndexOf(".");
        if (dotIdx > 0) ext = originalName.substring(dotIdx);
        var suffix = colKey.split("_").pop().toLowerCase();
        var anonName = participantNum + "_" + suffix + ext;
        var copy = originalFile.makeCopy(anonName, folder);
        results.push({
          originalId: fileId,
          anonId: copy.getId(),
          anonName: anonName
        });
        AuditLogService.info("DEPERSON_FILE_COPIED", participantNum + ": " + originalName + " → " + anonName);
      } catch (e2) {
        AuditLogService.error("DEPERSON_FILE_ERR", "Failed to copy file " + fileId + " for " + participantNum + ": " + e2);
        failedCount++; // Bug 6: count Drive errors as failures
      }
    }
    return { files: results, failedCount: failedCount };
  }

  /**
   * Clean up old anonymized file copies from Google Drive.
   * Trashes files whose IDs are stored in SYS_ANON_FILE_IDS for a specific competition prefix.
   * @param {string} existingAnonFileIds - Comma-separated anon file IDs from SYS_ANON_FILE_IDS
   * @param {string} competitionPrefix - e.g. "ES", "SP" — only delete files whose names start with this prefix
   * @returns {number} Count of files successfully trashed
   */
  function cleanupOldAnonFiles_(existingAnonFileIds, competitionPrefix) {
    if (!existingAnonFileIds) return 0;
    var ids = existingAnonFileIds.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
    var trashed = 0;
    for (var i = 0; i < ids.length; i++) {
      try {
        var file = DriveApp.getFileById(ids[i]);
        var name = file.getName();
        // Only trash files belonging to the specific competition (e.g. "ES-0001_file.pdf")
        if (competitionPrefix && name.indexOf(competitionPrefix + "-") !== 0) continue;
        file.setTrashed(true);
        trashed++;
        AuditLogService.info("DEPERSON_CLEANUP", "Trashed old anon file: " + name + " (" + ids[i] + ")");
      } catch (e) {
        AuditLogService.warn("DEPERSON_CLEANUP_ERR", "Could not trash file " + ids[i] + ": " + e);
      }
    }
    return trashed;
  }

  /**
   * Look up an existing participant number for a competition prefix from a SYS_PARTICIPANT_NUM value.
   * @param {string} existingNums - Comma-separated participant numbers (e.g. "SP-0001, ES-0003")
   * @param {string} competitionKey - e.g. "SPEECH", "ESSAY"
   * @returns {string|null} The existing number (e.g. "ES-0003") or null if not found
   */
  function getExistingParticipantNum_(existingNums, competitionKey) {
    if (!existingNums) return null;
    var prefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[competitionKey];
    if (!prefix) return null;
    var nums = existingNums.split(/\s*,\s*/);
    for (var i = 0; i < nums.length; i++) {
      if (nums[i].indexOf(prefix + "-") === 0) return nums[i];
    }
    return null;
  }

  /**
   * "2nd Layer": Auto-detect competitions by scanning actual form data.
   * Column E only stores the LAST dropdown selection, but participants may fill
   * multiple competition sections by going back in the form. This scans each
   * competition's column group for actual data (name/members + uploaded files)
   * and returns all detected competitions as an array of competition type strings.
   *
   * @param {Array} rowVals - Full row values from Submission Form
   * @returns {string[]} Array of competition type strings that have data
   */
  function detectCompetitionsFromData_(rowVals) {
    var S = SYSTEM_CONFIG.COLS.SUB;
    var detected = [];
    var map = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP;
    var mapKeys = Object.keys(map); // ["Speech Competition", "Essay Writing Competition", ...]

    for (var i = 0; i < mapKeys.length; i++) {
      var compName = mapKeys[i];
      var compMap = map[compName];

      // Check if the NAME/MEMBERS column has data (primary indicator)
      var nameColKey = compMap.nameCol;
      var nameColNum = nameColKey ? S[nameColKey] : null;
      var hasName = nameColNum ? String(rowVals[nameColNum - 1] || "").trim().length > 0 : false;

      // Check if any FILE column has data (strongest indicator of actual submission)
      var hasFile = false;
      if (compMap.fileCols && compMap.fileCols.length > 0) {
        for (var f = 0; f < compMap.fileCols.length; f++) {
          var fileColNum = S[compMap.fileCols[f]];
          if (fileColNum && String(rowVals[fileColNum - 1] || "").trim().length > 0) {
            hasFile = true;
            break;
          }
        }
      }

      // A competition is detected if it has BOTH a name AND at least one file
      // This prevents false positives from leftover name-only data
      if (hasName && hasFile) {
        detected.push(compName);
      }
    }
    return detected;
  }

  /**
   * Main orchestrator: process a single submission row.
   * @param {Sheet} subSheet
   * @param {Object} sysCols - column map from ensureSysColsOnSubmissions
   * @param {number} row - row index (1-based)
   * @param {string[]} rowVals - full row values
   * @param {SheetRepository} repo
   * @returns {Object} result with participantNum, status, matchedGenId, etc.
   */
  function processSubmission(subSheet, sysCols, row, rowVals, repo) {
    // Optional 6th argument: { skipWrite, existingParticipantNum }
    var options = (arguments.length > 5 && arguments[5]) || {};
    var email = Utils.normalizeEmail(rowVals[SYSTEM_CONFIG.COLS.SUB.EMAIL - 1]);
    var competitionType = String(rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] || "").trim();

    AuditLogService.info("SUB_PROCESS_START", "Row " + row + " | Email: " + email + " | Competition: " + competitionType);

    // 1. Resolve competition mapping
    var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[competitionType];
    if (!compMap) {
      // Try case-insensitive match
      var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
      for (var k = 0; k < keys.length; k++) {
        if (keys[k].toUpperCase() === competitionType.toUpperCase()) {
          compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]];
          break;
        }
      }
    }
    if (!compMap) {
      var errMsg = "Unknown competition type: " + competitionType;
      AuditLogService.error("SUB_UNKNOWN_COMP", errMsg);
      writeSysCols_(subSheet, sysCols, row, { SYS_SUB_STATUS: "ERROR", SYS_DEPERSONALIZED: "", SYS_PARTICIPANT_NUM: "" });
      return { success: false, error: errMsg, status: "ERROR" };
    }

    // 2. Match to registration
    var regMatch = matchToRegistration_(email, repo);
    var matchedGenId = "";
    var matchedRegRow = "";
    var participantName = "";
    var schoolName = "";

    if (regMatch) {
      matchedGenId = regMatch.genId;
      matchedRegRow = String(regMatch.rowIndex);
      participantName = regMatch.name;
      schoolName = regMatch.school;
      AuditLogService.info("SUB_REG_MATCHED", "Row " + row + " matched to registration GenID=" + matchedGenId + " (row " + matchedRegRow + ")");
    } else {
      AuditLogService.warn("SUB_NO_REG_MATCH", "Row " + row + " email " + email + " not found in registration sheet");
    }

    // Bug 5 fix: Block submission processing if participant has not paid
    if (regMatch && regMatch.paymentStatus !== SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
      var notPaidMsg = "Participant not yet paid (status: \"" + regMatch.paymentStatus + "\"). Submission blocked until payment is verified.";
      AuditLogService.warn("SUB_NOT_PAID", "Row " + row + " | Email: " + email + " | " + notPaidMsg);
      if (!options.skipWrite) {
        writeSysCols_(subSheet, sysCols, row, { SYS_SUB_STATUS: "ERROR" });
      }
      return { success: false, error: notPaidMsg, status: "ERROR" };
    }

    // PREFER the name from Form 2 (competition-specific) over Form 1 (registration).
    // Form 1 name can be a group listing ("1. Name1 2. Name2") while Form 2 has the individual name.
    if (compMap.nameCol) {
      var nameColNum = SYSTEM_CONFIG.COLS.SUB[compMap.nameCol];
      if (nameColNum) {
        var form2Name = String(rowVals[nameColNum - 1] || "").trim();
        if (form2Name) participantName = form2Name;
      }
    }
    if (compMap.schoolCol) {
      var schoolColNum = SYSTEM_CONFIG.COLS.SUB[compMap.schoolCol];
      if (schoolColNum) {
        var form2School = String(rowVals[schoolColNum - 1] || "").trim();
        if (form2School) schoolName = form2School;
      }
    }

    // Extract all submission-specific fields for the acknowledgement email
    var region = "";
    if (compMap.regionCol) {
      var regionColNum = SYSTEM_CONFIG.COLS.SUB[compMap.regionCol];
      if (regionColNum) region = String(rowVals[regionColNum - 1] || "").trim();
    }
    var adviser = "";
    if (compMap.adviserCol) {
      var adviserColNum = SYSTEM_CONFIG.COLS.SUB[compMap.adviserCol];
      if (adviserColNum) adviser = String(rowVals[adviserColNum - 1] || "").trim();
    }
    var facebook = "";
    if (compMap.facebookCol) {
      var facebookColNum = SYSTEM_CONFIG.COLS.SUB[compMap.facebookCol];
      if (facebookColNum) facebook = String(rowVals[facebookColNum - 1] || "").trim();
    }
    var contact = "";
    if (compMap.contactCol) {
      var contactColNum = SYSTEM_CONFIG.COLS.SUB[compMap.contactCol];
      if (contactColNum) contact = String(rowVals[contactColNum - 1] || "").trim();
    }
    var entryTitle = "";
    if (compMap.titleCol) {
      var entryTitleColNum = SYSTEM_CONFIG.COLS.SUB[compMap.titleCol];
      if (entryTitleColNum) entryTitle = String(rowVals[entryTitleColNum - 1] || "").trim();
    }

    // 3. Generate or reuse participant number (reuse on edit)
    var participantNum;
    if (options.existingParticipantNum) {
      participantNum = options.existingParticipantNum;
      AuditLogService.info("SUB_REUSE_NUM", "Row " + row + " reusing existing " + participantNum);
    } else {
      participantNum = generateParticipantNumber_(subSheet, sysCols, compMap.key);
      AuditLogService.info("SUB_PARTICIPANT_NUM", "Row " + row + " assigned " + participantNum);
    }

    // 4. Check for PII in title (if applicable)
    var piiResult = { flagged: false, matches: [] };
    if (compMap.titleCol) {
      var titleColNum = SYSTEM_CONFIG.COLS.SUB[compMap.titleCol];
      if (titleColNum) {
        var titleVal = String(rowVals[titleColNum - 1] || "").trim();
        piiResult = flagPiiInTitle_(titleVal, participantName, schoolName);
        if (piiResult.flagged) {
          AuditLogService.warn("SUB_PII_DETECTED", "Row " + row + " (" + participantNum + ") PII in title: " + piiResult.matches.join(", "));
        }
      }
    }

    // 4.5 Scan document files for PII content
    if (compMap.scannableCols && compMap.scannableCols.length > 0) {
      for (var sc = 0; sc < compMap.scannableCols.length; sc++) {
        var scanColKey = compMap.scannableCols[sc];
        var scanColNum = SYSTEM_CONFIG.COLS.SUB[scanColKey];
        if (!scanColNum) continue;
        var scanCellVal = String(rowVals[scanColNum - 1] || "").trim();
        if (!scanCellVal) continue;
        var scanFileId = extractFileId_(scanCellVal);
        if (!scanFileId) continue;
        try {
          var docScan = scanDocumentForPii_(scanFileId, participantName, schoolName, adviser);
          if (docScan.flagged) {
            piiResult.flagged = true;
            piiResult.matches = piiResult.matches.concat(docScan.matches);
            AuditLogService.warn("SUB_PII_IN_DOC", "Row " + row + " (" + participantNum + ") PII in document [" + scanColKey + "]: " + docScan.matches.join(", "));
          }
          if (docScan.error) {
            AuditLogService.warn("SUB_PII_SCAN_ERR", "Row " + row + " [" + scanColKey + "]: " + docScan.error);
          }
        } catch (scanErr) {
          AuditLogService.warn("SUB_PII_SCAN_ERR", "Row " + row + " [" + scanColKey + "]: " + scanErr);
        }
      }
    }

    // 5. Depersonalize files
    var anonFolderId = getAnonFolderId_(compMap.key);
    // Bug 6 fix: depersonalizeFiles_ now returns {files, failedCount}
    var fileData = depersonalizeFiles_(compMap.fileCols, rowVals, participantNum, anonFolderId);
    var fileResults = fileData.files;
    var fileFailures = fileData.failedCount;
    var anonFileIds = fileResults.map(function (f) { return f.anonId; }).join(",");

    // 6. Determine status
    var status = "PROCESSED";
    if (piiResult.flagged) status = "FLAGGED";
    if (!regMatch) status = "ERROR";
    // Bug 6 fix: partial file copy failure = ERROR so admin knows to intervene
    if (fileFailures > 0 && anonFolderId && status !== "ERROR") status = "ERROR";
    // Bug 1 fix: only apply PENDING/PROCESSED override if not already ERROR
    if (!anonFolderId && status !== "ERROR") status = fileResults.length === 0 ? "PENDING" : "PROCESSED";

    // 7. Write SYS columns
    var sysWriteData = {
      SYS_PARTICIPANT_NUM: participantNum,
      // Bug 6 fix: show PARTIAL if some files failed, YES only when all succeeded
      SYS_DEPERSONALIZED: fileResults.length > 0 ? (fileFailures > 0 ? "PARTIAL" : "YES") : "NO",
      SYS_DEPERSONALIZED_AT: fileResults.length > 0 ? Utils.nowTzString() : "",
      SYS_ANON_FILE_IDS: anonFileIds,
      SYS_MATCHED_REG_ROW: matchedRegRow,
      SYS_MATCHED_GEN_ID: matchedGenId,
      SYS_SUB_STATUS: status
    };
    if (piiResult.flagged) {
      sysWriteData.SYS_FLAG_REASON = "Auto-detected PII: " + piiResult.matches.join("; ");
      sysWriteData.SYS_FLAG_DATE = Utils.nowTzString();
    }
    if (fileFailures > 0) {
      sysWriteData.SYS_FLAG_REASON = (sysWriteData.SYS_FLAG_REASON ? sysWriteData.SYS_FLAG_REASON + " | " : "") +
        "File copy failures: " + fileFailures + " file(s) could not be depersonalized. Check Drive permissions and retry.";
    }
    // Bug 2a fix: only write to sheet directly when NOT inside a multi-competition loop
    // (multi-competition callers pass options.skipWrite = true and do one aggregated write)
    if (!options.skipWrite) {
      writeSysCols_(subSheet, sysCols, row, sysWriteData);
    }

    AuditLogService.info("SUB_PROCESS_DONE", "Row " + row + " → " + participantNum + " | Status: " + status + " | Files: " + fileResults.length);

    return {
      success: true,
      participantNum: participantNum,
      competitionType: competitionType,
      competitionKey: compMap.key,
      matchedGenId: matchedGenId,
      matchedRegRow: matchedRegRow,
      participantName: participantName,
      email: email,
      status: status,
      piiResult: piiResult,
      fileResults: fileResults,
      fileCount: fileResults.length,
      // Submission-specific fields for acknowledgement email
      region: region,
      school: schoolName,
      adviser: adviser,
      facebook: facebook,
      contact: contact,
      entryTitle: entryTitle,
      paymentStatus: regMatch ? regMatch.paymentStatus : ""
    };
  }

  /**
   * Write multiple SYS columns for a submission row.
   */
  function writeSysCols_(subSheet, sysCols, row, data) {
    var keys = Object.keys(data);
    for (var i = 0; i < keys.length; i++) {
      var col = sysCols[keys[i]];
      if (col) {
        subSheet.getRange(row, col).setValue(data[keys[i]]);
      }
    }
  }

  /**
   * Admin tool: re-run depersonalization for a specific row.
   * Supports multiple competitions per row (column E comma-separated).
   * Cleans up old anonymized files and reuses existing participant numbers.
   */
  function reprocessSubmission(subSheet, sysCols, rowIndex, repo) {
    if (rowIndex < 2) return { success: false, error: "Invalid row" };
    var width = subSheet.getLastColumn();
    var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];

    // Read existing SYS data for cleanup and number reuse
    var existingNumStr = sysCols["SYS_PARTICIPANT_NUM"] ? String(subSheet.getRange(rowIndex, sysCols["SYS_PARTICIPANT_NUM"]).getValue() || "").trim() : "";
    var existingAnonFileIds = sysCols["SYS_ANON_FILE_IDS"] ? String(subSheet.getRange(rowIndex, sysCols["SYS_ANON_FILE_IDS"]).getValue() || "").trim() : "";

    // Layer 1: Column E dropdown value
    var rawCompetition = String(rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] || "").trim();
    var dropdownComps = rawCompetition.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });

    // Layer 2: Auto-detect from actual form data
    var detectedComps = detectCompetitionsFromData_(rowVals);

    // Merge both layers: union, deduplicated
    var compSet = {};
    var competitionTypes = [];
    var allSources = dropdownComps.concat(detectedComps);
    for (var cs = 0; cs < allSources.length; cs++) {
      var cKey = allSources[cs].trim();
      if (cKey && !compSet[cKey]) { compSet[cKey] = true; competitionTypes.push(cKey); }
    }

    if (competitionTypes.length <= 1) {
      // Single competition — cleanup + reuse number
      var singleCompType = competitionTypes.length === 1 ? competitionTypes[0] : rawCompetition;
      var singleMapEntry = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[singleCompType];
      var singleOptions = {};
      if (singleMapEntry) {
        var singlePrefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[singleMapEntry.key];
        // Cleanup old anon files for this competition
        if (existingAnonFileIds && singlePrefix) {
          cleanupOldAnonFiles_(existingAnonFileIds, singlePrefix);
        }
        // Reuse existing participant number
        var existingNum = getExistingParticipantNum_(existingNumStr, singleMapEntry.key);
        if (existingNum) singleOptions.existingParticipantNum = existingNum;
      }
      return processSubmission(subSheet, sysCols, rowIndex, rowVals, repo, singleOptions);
    }

    // Multi-competition processing
    AuditLogService.info("SUB_REPROCESS_MULTI", "Row " + rowIndex + ": " + competitionTypes.length + " competitions detected (dropdown: [" + dropdownComps.join(", ") + "], data: [" + detectedComps.join(", ") + "]).");
    var allParticipantNums = [];
    var allStatuses = [];
    var allAnonFileIds = [];
    var allDepersonalized = [];
    var lastResult = null;

    for (var ci = 0; ci < competitionTypes.length; ci++) {
      var singleCompType2 = competitionTypes[ci].trim();
      if (!singleCompType2) continue;

      var originalCompValue = rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1];
      rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = singleCompType2;

      // Cleanup old files and reuse number for this competition
      // Bug 2a fix: skipWrite=true prevents each processSubmission call from writing
      // to the sheet mid-loop; the outer aggregated writeSysCols_ does the single final write
      var compOptions = { skipWrite: true };
      var mapEntry = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[singleCompType2];
      if (mapEntry) {
        var compPrefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[mapEntry.key];
        if (existingAnonFileIds && compPrefix) {
          cleanupOldAnonFiles_(existingAnonFileIds, compPrefix);
        }
        var existNum = getExistingParticipantNum_(existingNumStr, mapEntry.key);
        if (existNum) compOptions.existingParticipantNum = existNum;
      }

      var result = processSubmission(subSheet, sysCols, rowIndex, rowVals, repo, compOptions);

      rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = originalCompValue;

      if (result.success) {
        allParticipantNums.push(result.participantNum);
        allStatuses.push(result.status);
        allDepersonalized.push(result.fileCount > 0 ? "YES" : "NO");
        if (result.fileResults && result.fileResults.length > 0) {
          var ids = result.fileResults.map(function(f) { return f.anonId; });
          allAnonFileIds = allAnonFileIds.concat(ids);
        }
        lastResult = result;
      } else {
        allStatuses.push("ERROR");
      }
    }

    // Write aggregated SYS columns
    var overallStatus = allStatuses.indexOf("ERROR") >= 0 ? "ERROR" : (allStatuses.indexOf("FLAGGED") >= 0 ? "FLAGGED" : "PROCESSED");
    writeSysCols_(subSheet, sysCols, rowIndex, {
      SYS_PARTICIPANT_NUM: allParticipantNums.join(", "),
      SYS_SUB_STATUS: overallStatus,
      SYS_DEPERSONALIZED: allDepersonalized.indexOf("YES") >= 0 || allDepersonalized.indexOf("PARTIAL") >= 0 ? "YES" : "NO",
      SYS_DEPERSONALIZED_AT: allDepersonalized.indexOf("YES") >= 0 || allDepersonalized.indexOf("PARTIAL") >= 0 ? Utils.nowTzString() : "",
      SYS_ANON_FILE_IDS: allAnonFileIds.join(", "),
      SYS_MATCHED_REG_ROW: lastResult ? String(lastResult.matchedRegRow || "") : "",
      SYS_MATCHED_GEN_ID: lastResult ? (lastResult.matchedGenId || "") : "",
      SYS_CONFIRMATION_SENT: "" // Bug 9 fix: clear on reprocess so admin can resend updated numbers
    });

    return {
      success: allParticipantNums.length > 0,
      participantNum: allParticipantNums.join(", "),
      status: overallStatus,
      competitionCount: competitionTypes.length,
      processedCount: allParticipantNums.length,
      error: allParticipantNums.length === 0 ? "All competitions failed" : null
    };
  }

  return {
    processSubmission: processSubmission,
    reprocessSubmission: reprocessSubmission,
    detectCompetitionsFromData: detectCompetitionsFromData_,
    scanDocumentForPii: scanDocumentForPii_,
    extractTextFromFile: extractTextFromFile_,
    extractFileId: extractFileId_,
    matchToRegistration_: matchToRegistration_,
    flagPiiInTitle_: flagPiiInTitle_,
    cleanupOldAnonFiles: cleanupOldAnonFiles_,
    getExistingParticipantNum: getExistingParticipantNum_,
    generateNextParticipantNumber: generateParticipantNumber_
  };
})();

/**
 * All competitions a submission row really contains: the column E answer(s) plus every
 * competition section that has data. Column E alone only holds the last choice when a
 * participant fills several sections, so tools that read just column E (resend, dashboard,
 * entry editor) missed the other entries. Names come back as spelled in
 * SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP; an unrecognized answer is kept as typed.
 * @param {Array} rowVals - full row values from the Submission Form sheet
 * @returns {string[]}
 */
function getSubmissionCompetitionTypes_(rowVals) {
  var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
  var raw = String(rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] || "").trim();
  var fromDropdown = raw.split(/\s*,\s*/).filter(function (c) { return c.length > 0; });
  var detected = DepersonalizationService.detectCompetitionsFromData(rowVals);

  var seen = {};
  var out = [];
  var all = fromDropdown.concat(detected);
  for (var i = 0; i < all.length; i++) {
    var name = String(all[i]).trim();
    for (var k = 0; k < keys.length; k++) {
      if (keys[k].toUpperCase() === name.toUpperCase()) { name = keys[k]; break; }
    }
    if (name && !seen[name.toUpperCase()]) {
      seen[name.toUpperCase()] = true;
      out.push(name);
    }
  }
  return out;
}

/**
 * The participant number that belongs to one competition on a row (matched by its prefix,
 * e.g. "ES-" for Essay). The old fallback borrowed another competition's number, which sent
 * an acknowledgement quoting the wrong number; a non-matching number is now used only when
 * the row has exactly one competition and one number.
 */
function pickParticipantNumFor_(competitionKey, participantNums, competitionCount) {
  var prefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[competitionKey];
  if (prefix) {
    for (var i = 0; i < participantNums.length; i++) {
      if (String(participantNums[i]).indexOf(prefix + "-") === 0) return participantNums[i];
    }
  }
  return (competitionCount === 1 && participantNums.length === 1) ? participantNums[0] : "";
}

// ============================================================================
// PART 5: BUSINESS SERVICES (PRICING / COUPON / REFERRAL)
// ============================================================================

var PricingEngine = (function () {
  // FIX: Comprehensive competition aliases including "(Special Competition)" variations
  var COMPETITION_ALIASES = {
    // Essay Writing
    "ESSAY WRITING": "Essay Writing Competition",
    "ESSAY WRITING COMPETITION": "Essay Writing Competition",
    "ESSAY": "Essay Writing Competition",
    
    // Speech
    "SPEECH": "Speech Competition",
    "SPEECH COMPETITION": "Speech Competition",
    
    // Photography
    "MOBILE PHONE PHOTOGRAPHY": "Mobile Phone Photography Competition",
    "MOBILE PHONE PHOTOGRAPHY COMPETITION": "Mobile Phone Photography Competition",
    "PHOTOGRAPHY": "Mobile Phone Photography Competition",
    "PHOTOGRAPHY COMPETITION": "Mobile Phone Photography Competition",
    
    // Short Film - Basic variations
    "SHORT FILM": "Short Film Making",
    "SHORT FILM MAKING": "Short Film Making",
    "SHORTFILM": "Short Film Making",
    "SHORTFILM MAKING": "Short Film Making",
    "FILM MAKING": "Short Film Making",
    "FILMMAKING": "Short Film Making",
    
    // FIX: Short Film with "(Special Competition)" suffix variations
    "SHORT FILM MAKING SPECIAL COMPETITION": "Short Film Making",
    "SHORT FILM MAKING (SPECIAL COMPETITION)": "Short Film Making",
    "SHORT FILM (SPECIAL COMPETITION)": "Short Film Making",
    "SHORT FILM SPECIAL COMPETITION": "Short Film Making",
    "SHORTFILM MAKING SPECIAL COMPETITION": "Short Film Making",
    "SHORTFILM MAKING (SPECIAL COMPETITION)": "Short Film Making",
    "SHORTFILM (SPECIAL COMPETITION)": "Short Film Making",
    "SHORTFILM SPECIAL COMPETITION": "Short Film Making",
    "FILM MAKING SPECIAL COMPETITION": "Short Film Making",
    "FILM MAKING (SPECIAL COMPETITION)": "Short Film Making",
    
    // Short Film Group variations
    "SHORT FILM (GROUP)": "Short Film (Group)",
    "SHORT FILM GROUP": "Short Film (Group)",
    "SHORTFILM (GROUP)": "Short Film (Group)",
    "SHORTFILM GROUP": "Short Film (Group)"
  };

  // FIX: Enhanced normalization with better handling of "(Special Competition)" suffix
  function normalizeCompetitionName_(name) {
    var raw = String(name || "").trim();
    if (!raw) return "";
    raw = raw.replace(/\s+/g, " ");
    var up = raw.toUpperCase();
    
    // Direct alias match
    if (COMPETITION_ALIASES[up]) {
      AuditLogService.debug("COMP_NORM", "Direct match: '" + raw + "' -> '" + COMPETITION_ALIASES[up] + "'");
      return COMPETITION_ALIASES[up];
    }
    
    // Check if it's already a known competition name
    if (SYSTEM_CONFIG.PRICING.SINGLE[raw] != null) {
      AuditLogService.debug("COMP_NORM", "Known name: '" + raw + "'");
      return raw;
    }
    
    // FIX: Try removing all parentheses and their content
    var withoutParens = up.replace(/\([^)]*\)/g, "").replace(/\s+/g, " ").trim();
    if (COMPETITION_ALIASES[withoutParens]) {
      AuditLogService.debug("COMP_NORM", "No-paren match: '" + raw + "' -> '" + COMPETITION_ALIASES[withoutParens] + "'");
      return COMPETITION_ALIASES[withoutParens];
    }
    
    // FIX: Try removing just parentheses characters (keep content)
    var parensRemoved = up.replace(/[()]/g, "").replace(/\s+/g, " ").trim();
    if (COMPETITION_ALIASES[parensRemoved]) {
      AuditLogService.debug("COMP_NORM", "Paren-char removed match: '" + raw + "' -> '" + COMPETITION_ALIASES[parensRemoved] + "'");
      return COMPETITION_ALIASES[parensRemoved];
    }
    
    // FIX: Special handling for Short Film variations - catch-all
    if (up.indexOf("SHORT FILM") >= 0 || up.indexOf("SHORTFILM") >= 0 || up.indexOf("FILM MAKING") >= 0 || up.indexOf("FILMMAKING") >= 0) {
      // Check if it's a group competition
      if (up.indexOf("GROUP") >= 0) {
        AuditLogService.debug("COMP_NORM", "Short Film Group fallback: '" + raw + "' -> 'Short Film (Group)'");
        return "Short Film (Group)";
      }
      // Default to Short Film Making (special competition)
      AuditLogService.debug("COMP_NORM", "Short Film fallback: '" + raw + "' -> 'Short Film Making'");
      return "Short Film Making";
    }
    
    AuditLogService.debug("COMP_NORM", "No match, using raw: '" + raw + "'");
    return raw;
  }

  function parseCompetitions_(selectionString) {
    var out = [];
    if (!selectionString) return out;
    var parts = String(selectionString).split(/[,;|]/);
    for (var i = 0; i < parts.length; i++) {
      var v = String(parts[i] || "").trim();
      if (!v) continue;
      var canon = normalizeCompetitionName_(v);
      if (canon) out.push(canon);
    }
    var seen = {};
    var uniq = [];
    for (var j = 0; j < out.length; j++) {
      var key = String(out[j]);
      if (seen[key]) continue;
      seen[key] = true;
      uniq.push(out[j]);
    }
    return uniq;
  }

  function hasAnyKnownCompetition_(selectionString) {
    if (!selectionString) return false;
    var picks = parseCompetitions_(selectionString);
    for (var i = 0; i < picks.length; i++) {
      if (SYSTEM_CONFIG.PRICING.SINGLE[picks[i]] != null) return true;
    }
    return false;
  }

  function synthesizeFromCount_(countAnswer) {
    var up = Utils.upper(countAnswer);
    // Standard competitions first, then the special one(s), in the order of SYSTEM_CONFIG.COMPETITIONS
    var comps = getCompetitions_();
    var standard = comps.filter(function (c) { return !c.special; }).map(function (c) { return c.registrationName; });
    var special = comps.filter(function (c) { return c.special; }).map(function (c) { return c.registrationName; });
    if (up.indexOf("ALL IN") >= 0) return standard.concat(special).join(", ");
    var m = String(countAnswer || "").match(/(\d+)/);
    var n = m ? Number(m[1]) : 0;
    if (!n && up.indexOf("STANDARD A") >= 0) n = 1;
    if (!n && up.indexOf("STANDARD B") >= 0) n = 2;
    if (!n && up.indexOf("STANDARD C") >= 0) n = 3;
    var picks = standard.slice(0, Math.min(n, standard.length));
    if (n > standard.length) picks = picks.concat(special.slice(0, n - standard.length));
    return picks.join(", ");
  }

  function normalizeSelection(countAnswer, competitionsString) {
    if (hasAnyKnownCompetition_(competitionsString)) {
      return parseCompetitions_(competitionsString).join(", ");
    }
    return synthesizeFromCount_(countAnswer);
  }

  function calculate(countAnswer, competitionsString) {
    // Debug logging for competition parsing
    AuditLogService.debug("PRICING_CALC_INPUT", "countAnswer='" + countAnswer + "', competitions='" + competitionsString + "'");
    
    var effective = normalizeSelection(countAnswer, competitionsString);
    if (!effective) {
      AuditLogService.debug("PRICING_CALC", "No effective selection, using default");
      return {
        rawTotal: SYSTEM_CONFIG.PRICING.BUNDLES.STD_1_SPC_0,
        finalPrice: SYSTEM_CONFIG.PRICING.BUNDLES.STD_1_SPC_0,
        bundleDiscount: 0,
        normalizedCompetitions: ""
      };
    }
    var choices = parseCompetitions_(effective);
    var stdCount = 0, spcCount = 0, rawTotal = 0;
    
    // Detailed logging for each competition
    for (var i = 0; i < choices.length; i++) {
      var choice = String(choices[i]).trim();
      var price = SYSTEM_CONFIG.PRICING.SINGLE[choice];
      if (price == null) {
        AuditLogService.warn("PRICING_UNKNOWN_COMP", "Unknown competition (no price): '" + choice + "'");
        continue;
      }
      rawTotal += Number(price || 0);
      if (isSpecialCompetition_(choice)) {
        spcCount++;
        AuditLogService.debug("PRICING_COMP_COUNT", "Special competition: '" + choice + "' (price=" + price + ")");
      } else {
        stdCount++;
        AuditLogService.debug("PRICING_COMP_COUNT", "Standard competition: '" + choice + "' (price=" + price + ")");
      }
    }
    
    // Log final counts
    AuditLogService.debug("PRICING_COUNTS", "stdCount=" + stdCount + ", spcCount=" + spcCount + ", rawTotal=" + rawTotal);
    
    var finalPrice = rawTotal;
    var B = SYSTEM_CONFIG.PRICING.BUNDLES;
    if (stdCount === 3 && spcCount === 1) finalPrice = B.STD_3_SPC_1;
    else if (stdCount === 3 && spcCount === 0) finalPrice = B.STD_3_SPC_0;
    else if (stdCount === 2 && spcCount === 1) finalPrice = B.STD_2_SPC_1;
    else if (stdCount === 2 && spcCount === 0) finalPrice = B.STD_2_SPC_0;
    else if (stdCount === 1 && spcCount === 1) finalPrice = B.STD_1_SPC_1;
    else if (stdCount === 1 && spcCount === 0) finalPrice = B.STD_1_SPC_0;
    else if (stdCount === 0 && spcCount === 1) finalPrice = B.STD_0_SPC_1;
    
    AuditLogService.debug("PRICING_RESULT", "finalPrice=" + finalPrice + ", bundleDiscount=" + (rawTotal - finalPrice));
    
    return {
      rawTotal: rawTotal,
      finalPrice: finalPrice,
      bundleDiscount: Math.max(0, rawTotal - finalPrice),
      normalizedCompetitions: choices.join(", ")
    };
  }

  return {
    normalizeSelection: normalizeSelection,
    calculate: calculate,
    // The canonical names the spelling table can produce (checked by the health check)
    aliasTargets: function () {
      var seen = {}, out = [];
      Object.keys(COMPETITION_ALIASES).forEach(function (k) {
        if (!seen[COMPETITION_ALIASES[k]]) { seen[COMPETITION_ALIASES[k]] = true; out.push(COMPETITION_ALIASES[k]); }
      });
      return out;
    }
  };
})();

// UPGRADED: CouponService with lazy loading option
function CouponService(couponSheet, options) {
  this.sheet = couponSheet;
  this.cache = null;
  this.options = options || { lazyLoad: false };
}

CouponService.prototype.loadCache = function () {
  if (this.cache) return this.cache;
  this.cache = new Map();
  if (!this.sheet) return this.cache;

  var lastRow = this.sheet.getLastRow();
  if (lastRow < 2) return this.cache;
  
  // Lazy load: only load active coupons
  var data = this.sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var code = Utils.upper(row[SYSTEM_CONFIG.COLS.COUPON.CODE - 1]);
    if (!code) continue;
    
    var status = Utils.upper(row[SYSTEM_CONFIG.COLS.COUPON.STATUS - 1] || "ACTIVE");
    
    // If lazy loading, skip inactive coupons
    if (this.options.lazyLoad && status !== "ACTIVE") continue;

    var maxRaw = row[SYSTEM_CONFIG.COLS.COUPON.MAX_USE - 1];
    var max = Number(maxRaw || 0);

    this.cache.set(code, {
      rowIndex: i + 1,
      value: Number(row[SYSTEM_CONFIG.COLS.COUPON.VALUE - 1] || 0),
      start: row[SYSTEM_CONFIG.COLS.COUPON.START - 1],
      end: row[SYSTEM_CONFIG.COLS.COUPON.END - 1],
      max: max,
      used: Number(row[SYSTEM_CONFIG.COLS.COUPON.CURRENT_USE - 1] || 0),
      status: status
    });
  }
  return this.cache;
};

CouponService.prototype.validate = function (code) {
  var c = Utils.upper(code);
  if (!c || !this.sheet) return { valid: false, value: 0, reason: "No code/sheet" };

  var info = this.loadCache().get(c);
  if (!info) return { valid: false, value: 0, reason: "Not found" };

  var today = Utils.midnightToday();
  var start = Utils.parseMaybeDate(info.start);
  var end = Utils.parseMaybeDate(info.end);

  if (info.status !== "ACTIVE") return { valid: false, value: 0, reason: "Inactive" };
  if (!start || !end) return { valid: false, value: 0, reason: "Invalid date range" };

  start.setHours(0, 0, 0, 0);
  end.setHours(0, 0, 0, 0);

  if (today < start) return { valid: false, value: 0, reason: "Not yet active" };
  if (today > end) return { valid: false, value: 0, reason: "Expired" };
  if (info.max > 0 && info.used >= info.max) return { valid: false, value: 0, reason: "Fully redeemed" };

  return { valid: true, value: info.value, reason: "" };
};

CouponService.prototype.claim = function (code) {
  var c = Utils.upper(code);
  var v = this.validate(c);
  if (!v.valid) return { valid: false, value: 0, reason: v.reason };

  var info = this.loadCache().get(c);
  var newUsed = info.used + 1;

  this.sheet.getRange(info.rowIndex, SYSTEM_CONFIG.COLS.COUPON.CURRENT_USE).setValue(newUsed);
  info.used = newUsed;

  AuditLogService.info("COUPON_CLAIM", "Code " + c + " used. Count: " + newUsed);
  return { valid: true, value: info.value, reason: "" };
};

// The value of a code already claimed, for receipts and recalculation. It must not depend on
// the coupon still being ACTIVE (the lazy cache skips inactive codes, so a coupon switched off
// after use showed a P0 discount on the receipt), so it uses the shared lookup.
CouponService.prototype.getValueOnly = function (code) {
  return getCouponValue_(code, this.sheet);
};

CouponService.prototype.revert = function (code) {
  var c = Utils.upper(code);
  if (!c || !this.sheet) return;

  var info = this.loadCache().get(c);
  if (!info) return;

  var newUsed = Math.max(0, info.used - 1);
  this.sheet.getRange(info.rowIndex, SYSTEM_CONFIG.COLS.COUPON.CURRENT_USE).setValue(newUsed);
  info.used = newUsed;

  AuditLogService.info("COUPON_REVERT", "Code " + c + " reverted. Count: " + newUsed);
};

// UPGRADED: ReferralService with complete ADD/REMOVE logic
// Fixed email capture and added comprehensive logging
function ReferralService(regSheet) {
  this.sheet = regSheet;
}

ReferralService.prototype.updateReferrer = function (referrerCode, action, childGenId) {
  if (!referrerCode || !this.sheet) {
    return { ok: false, reason: "No referrer/sheet" };
  }

  var target = Utils.upper(referrerCode);
  var repo = new SheetRepository();
  var rowIndex = repo.findRegistrationRowIndexByGenId(target);
  
  if (!rowIndex) {
    AuditLogService.warn("REF_NOT_FOUND", "Referrer " + target + " not found for action " + action);
    return { ok: false, reason: "Referrer not found" };
  }

  var width = this.sheet.getLastColumn();
  var rowVals = this.sheet.getRange(rowIndex, 1, 1, width).getValues()[0];

  // FIX: Capture and validate email EARLY, before any other operations
  // Use Utils.normalizeEmail to ensure consistent formatting
  var rawEmail = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
  var referrerEmail = Utils.normalizeEmail(rawEmail);
  var referrerName = String(rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "").trim();
  
  // Debug logging for email capture
  AuditLogService.debug("REF_EMAIL_CAPTURE", 
    "Referrer " + target + " at row " + rowIndex + 
    ": rawEmail='" + rawEmail + "' (type=" + typeof rawEmail + ")" +
    ", normalizedEmail='" + referrerEmail + "'" +
    ", name='" + referrerName + "'"
  );
  
  // Validate the captured email
  if (!referrerEmail || !Utils.isValidEmail(referrerEmail)) {
    AuditLogService.warn("REF_EMAIL_INVALID_EARLY", 
      "Referrer " + target + " has invalid email: '" + referrerEmail + "'. Attempting direct cell read...");
    
    // Try reading the email cell directly as a fallback
    try {
      var directEmailCell = this.sheet.getRange(rowIndex, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
      referrerEmail = Utils.normalizeEmail(directEmailCell);
      AuditLogService.debug("REF_EMAIL_DIRECT_READ", 
        "Direct cell read for " + target + ": '" + referrerEmail + "'");
    } catch (directReadErr) {
      AuditLogService.warn("REF_EMAIL_DIRECT_READ_FAIL", 
        "Direct cell read failed for " + target + ": " + directReadErr);
    }
  }

  var currentCount = Number(rowVals[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
  var currentCashback = Number(rowVals[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);

  var deltaCash = 0;
  var newCount = currentCount;

  if (action === "ADD") {
    newCount = currentCount + 1;
    deltaCash = (currentCount === 0)
      ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL
      : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
      
    AuditLogService.info("REFERRAL_ADD", "Adding referral for " + target + ". Previous count: " + currentCount + ", New count: " + newCount);
    
  } else if (action === "REMOVE") {
    if (currentCount <= 0) {
      AuditLogService.warn("REF_REMOVE_ZERO", "Cannot remove referral from " + target + " - count already 0");
      return { ok: false, reason: "Count already 0" };
    }
    
    // Calculate delta based on what was added for this position
    deltaCash = (currentCount === 1)
      ? -SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL
      : -SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
    newCount = currentCount - 1;
    
    AuditLogService.info("REFERRAL_REMOVE", "Removing referral for " + target + ". Previous count: " + currentCount + ", New count: " + newCount);
    
  } else {
    return { ok: false, reason: "Invalid action: " + action };
  }

  var newCashback = Math.max(0, currentCashback + deltaCash);

  // BATCH WRITE: Update both cells at once
  this.sheet.getRange(rowIndex, SYSTEM_CONFIG.COLS.REG.REF_COUNT, 1, 2)
    .setValues([[newCount, newCashback]]);

  // Get the original FINAL_AMOUNT (what they originally needed to pay)
  var originalFinalAmount = Number(rowVals[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
  
  // Calculate NET amount (original payment - cashback earned)
  // This is the effective total cost after cashback is applied
  var netTotalAmount = Math.max(0, originalFinalAmount - newCashback);

  // Sync to Finance - including the updated Total Amount
  // Use the already-validated referrerEmail
  try {
    var finSheet = repo.getFinanceSheet();
    if (finSheet) {
      var finCols = ColumnManager.getFinanceCols(finSheet);
      if (referrerEmail) {
        var finRowIndex = repo.findFinanceRowIndexByEmail(referrerEmail, finCols);
        if (finRowIndex) {
          // Update RefCount and Cashback
          if (finCols.RefCount && finCols.Cashback) {
            finSheet.getRange(finRowIndex, finCols.RefCount, 1, 2)
              .setValues([[newCount, newCashback]]);
          }
          // Update Total Amount to show NET cost (original - cashback)
          if (finCols.TotalAmount) {
            finSheet.getRange(finRowIndex, finCols.TotalAmount).setValue(netTotalAmount);
          }
          AuditLogService.info("REF_FIN_SYNC", "Updated Finance for " + referrerEmail + ": RefCount=" + newCount + ", Cashback=" + newCashback + ", NetTotal=" + netTotalAmount);
        } else {
          AuditLogService.warn("REF_FIN_NOT_FOUND", "Finance row not found for referrer email: " + referrerEmail);
        }
      } else {
        AuditLogService.warn("REF_FIN_SYNC_SKIP", "Skipping Finance sync - no valid referrer email");
      }
    }
  } catch (e) {
    AuditLogService.warn("REF_FIN_SYNC_FAIL", "Could not sync referrer finance for " + target + ": " + e);
  }

  // Log the final return values
  AuditLogService.info("REFERRAL_UPDATE", 
    "Referrer " + target + " " + action + " Child " + childGenId + 
    ". Count: " + newCount + ", Cashback: " + newCashback + ", NetTotal: " + netTotalAmount +
    ", Email: " + referrerEmail + ", Name: " + referrerName);
  
  // Return the already-validated email and name
  return { 
    ok: true, 
    rowIndex: rowIndex, 
    count: newCount, 
    cashback: newCashback, 
    netTotal: netTotalAmount,
    referrerEmail: referrerEmail,  // Use the pre-validated email
    referrerName: referrerName     // Use the pre-captured name
  };
};

