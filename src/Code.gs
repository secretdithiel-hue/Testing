}


function forceReprocess() {
  var ui = SpreadsheetApp.getUi();

  try {
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    if (!regSheet) throw new Error("Registration sheet not found.");

    var activeSheet = SpreadsheetApp.getActiveSheet();
    var activeRow = activeSheet.getActiveCell().getRow();

    if (activeSheet.getName() === SYSTEM_CONFIG.SHEETS.REGISTRATION) {
      if (activeRow < 2) return ui.alert("Select a data row (row 2+).");
      handleSubmission({ range: regSheet.getRange(activeRow, 1) });
      clearNotProcessedNotes_(regSheet.getRange(activeRow, 1));
      return ui.alert("✅ Reprocessed Registration row " + activeRow + ".");
    }

    var email = findEmailFromActiveRow_();
    if (!email) {
      return ui.alert("⚠️ Can't detect Email in current row.");
    }

    var regRow = reprocessRegistrationRowByEmail_(email);
    return ui.alert("✅ Reprocessed by Email.\nRegistration row: " + regRow + "\nEmail: " + email);

  } catch (err) {
    AuditLogService.error("FORCE_REPROCESS_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ Force Reprocess failed:\n" + String(err));
  }
}

function runSmartMigration() {
  var ui = SpreadsheetApp.getUi();

  try {
    var repo = new SheetRepository();
    var sheet = repo.getRegistrationSheet();
    if (!sheet) throw new Error("Registration sheet not found.");

    ColumnManager.ensureSysColsOnRegistration(sheet);

    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return ui.alert("No registration data to migrate.");

    var data = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();
    var fixed = 0;

    for (var i = 0; i < data.length; i++) {
      var rowIndex = i + 2;
      var email = data[i][SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
      if (!email) continue;

      var id = data[i][SYSTEM_CONFIG.COLS.REG.GEN_ID - 1];
      var subj = data[i][SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT - 1];

      if (!id) {
        handleSubmission({ range: sheet.getRange(rowIndex, 1) });
        fixed++;
        continue;
      }

      if (!subj) {
        var newSub = SYSTEM_CONFIG.META.NAME + ": Registration Received [" + id + "]";
        sheet.getRange(rowIndex, SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT).setValue(newSub);
        fixed++;
      }
    }

    ui.alert("✅ Migration completed. Fixed " + fixed + " row(s).");

  } catch (err) {
    AuditLogService.error("SMART_MIGRATION_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ Migration failed:\n" + String(err));
  }
}

function exportCashbackReport() {
  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var report = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.CASHBACK_REPORT);
  if (!report) report = ss.insertSheet(SYSTEM_CONFIG.SHEETS.CASHBACK_REPORT);
  report.clearContents();

  var data = regSheet.getDataRange().getValues();
  var out = [];
  out.push(["GEN_ID", "EMAIL", "NAME", "REF_COUNT", "CASHBACK", "LOCKED_REF", "FINAL_AMOUNT"]);

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var genId = row[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1];
    var email = row[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
    var name = row[SYSTEM_CONFIG.COLS.REG.NAME - 1];
    var refCount = Number(row[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
    var cashback = Number(row[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
    var lockedRef = row[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1];
    var finalAmt = Number(row[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);

    if (refCount > 0 || cashback > 0) {
      out.push([genId, email, name, refCount, cashback, lockedRef, finalAmt]);
