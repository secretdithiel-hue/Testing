/**
 * Main entry point for Column Structure Checker from Admin Center
 * Shows current column status and offers to fix issues
 */
function checkAndFixColumns() {
  var ui = SpreadsheetApp.getUi();
  
  var choice = ui.alert("🔍 Check & Fix Columns + Data", 
    "This tool will:\n\n" +
    "1. Check for MISSING system columns and ADD them\n" +
    "2. Validate data integrity (Gen IDs, emails, pricing)\n" +
    "3. Sync data between sheets (Finance ↔ Registration)\n" +
    "4. Fix any issues found\n\n" +
    "Click OK to start comprehensive check.",
    ui.ButtonSet.OK_CANCEL);
  
  if (choice !== ui.Button.OK) return;
  
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  
  if (!regSheet) {
    ui.alert("❌ Error", "Registration sheet not found!\n\nUse BUILD BUILD BUILD to create it.", ui.ButtonSet.OK);
    return;
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Analyzing columns...", "🔍", -1);
  
  // ========================================
  // STEP 1: Define ALL required system columns
  // ========================================
  var requiredColumns = [
    { name: "Gen. ID", key: "GEN_ID" },
    { name: "Base Fee", key: "BASE_FEE" },
    { name: "Bundle Discount", key: "BUNDLE_DISCOUNT" },
    { name: "Coupon Discount", key: "COUPON_DISCOUNT" },
    { name: "Referral Discount", key: "REF_DISCOUNT" },
    { name: "Total Fee", key: "TOTAL_FEE" },
    { name: "Payment Status", key: "PAYMENT_STATUS" },
    { name: "Referral Count", key: "REF_COUNT" },
    { name: "Referral Earnings", key: "REF_EARNINGS" },
    { name: "Email Sent", key: "EMAIL_SENT" },
    { name: "OR Email Sent", key: "OR_EMAIL_SENT" },
    { name: "Remarks", key: "REMARKS" },
    { name: "LOCKED_COUPON", key: "LOCKED_COUPON" },
    { name: "LOCKED_REF", key: "LOCKED_REF" },
    { name: "MASTER_SUBJECT", key: "MASTER_SUBJECT" },
    { name: "SYS_PROCESSED", key: "SYS_PROCESSED" },
    { name: "SYS_REFERRER_CREDITED", key: "SYS_REFERRER_CREDITED" },
    { name: "SYS_REF_NOTIF_SENT", key: "SYS_REF_NOTIF_SENT" }
  ];
  
  // ========================================
  // STEP 2: Get current headers
  // ========================================
  var lastCol = regSheet.getLastColumn();
  var headers = [];
  var headerMap = {}; // name -> column number
  
  if (lastCol > 0) {
    var headerRow = regSheet.getRange(1, 1, 1, lastCol).getValues()[0];
    for (var i = 0; i < headerRow.length; i++) {
      var h = String(headerRow[i] || "").trim();
      headers.push(h);
      if (h) {
        headerMap[h.toUpperCase()] = i + 1;
      }
    }
  }
  
  // ========================================
  // STEP 3: Find missing columns
  // ========================================
  var missingColumns = [];
  var existingColumns = [];
  var columnMapping = {}; // key -> column number
  
  for (var r = 0; r < requiredColumns.length; r++) {
    var req = requiredColumns[r];
    var found = false;
    
    // Check various possible names
    var possibleNames = [
      req.name.toUpperCase(),
      req.key.toUpperCase(),
      req.name.replace(/_/g, " ").toUpperCase(),
      req.key.replace(/_/g, " ").toUpperCase()
    ];
    
    for (var p = 0; p < possibleNames.length; p++) {
      if (headerMap[possibleNames[p]]) {
        found = true;
        columnMapping[req.key] = headerMap[possibleNames[p]];
        existingColumns.push({ name: req.name, col: headerMap[possibleNames[p]] });
        break;
      }
    }
    
    if (!found) {
      missingColumns.push(req);
    }
  }
  
  // ========================================
  // STEP 4: Build report
  // ========================================
  var report = [];
  report.push("═══════════════════════════════════════════");
  report.push("       COLUMN & DATA CHECK REPORT");
  report.push("═══════════════════════════════════════════\n");
  
  report.push("📋 CURRENT STRUCTURE");
  report.push("─────────────────────────────────────────");
  report.push("Total Columns: " + lastCol);
  report.push("Data Rows: " + (regSheet.getLastRow() - 1));
  report.push("");
  
  report.push("✅ FOUND SYSTEM COLUMNS (" + existingColumns.length + "):");
  for (var e = 0; e < Math.min(existingColumns.length, 5); e++) {
    report.push("   • " + existingColumns[e].name + " (Col " + existingColumns[e].col + ")");
  }
  if (existingColumns.length > 5) {
    report.push("   ... and " + (existingColumns.length - 5) + " more");
  }
  report.push("");
  
  if (missingColumns.length > 0) {
    report.push("❌ MISSING COLUMNS (" + missingColumns.length + "):");
    for (var m = 0; m < missingColumns.length; m++) {
      report.push("   • " + missingColumns[m].name);
    }
    report.push("");
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Report ready", "📋", 2);
  
  // ========================================
  // STEP 5: Ask to add missing columns
  // ========================================
  if (missingColumns.length > 0) {
    var addChoice = ui.alert("⚠️ Missing Columns Found",
      report.join("\n") + 
      "\n\n🔧 Do you want to ADD the " + missingColumns.length + " missing columns?\n\n" +
      "They will be added at the end of your sheet.",
      ui.ButtonSet.YES_NO);
    
    if (addChoice === ui.Button.YES) {
      SpreadsheetApp.getActiveSpreadsheet().toast("Adding missing columns...", "🔧", -1);
      
      var addedColumns = [];
      var currentLastCol = regSheet.getLastColumn();
      
      for (var a = 0; a < missingColumns.length; a++) {
        var newCol = currentLastCol + a + 1;
        regSheet.getRange(1, newCol).setValue(missingColumns[a].name);
        addedColumns.push(missingColumns[a].name + " (Col " + newCol + ")");
        columnMapping[missingColumns[a].key] = newCol;
      }
      
      // Format new headers
      var newHeaderRange = regSheet.getRange(1, currentLastCol + 1, 1, missingColumns.length);
      newHeaderRange.setBackground("#1e40af")
                    .setFontColor("white")
                    .setFontWeight("bold");
      
      // Add data validation for Payment Status
      if (columnMapping["PAYMENT_STATUS"]) {
        var statusRule = SpreadsheetApp.newDataValidation()
          .requireValueInList(["NOT YET", "PAID", "PENDING", "CANCELLED"], true)
          .setAllowInvalid(true)
          .build();
        regSheet.getRange(2, columnMapping["PAYMENT_STATUS"], 999, 1).setDataValidation(statusRule);
      }
      
      // Add data validation for Email Sent columns
      var emailRule = SpreadsheetApp.newDataValidation()
        .requireValueInList(["SENT", "PENDING", "FAILED", ""], true)
        .setAllowInvalid(true)
        .build();
      if (columnMapping["EMAIL_SENT"]) {
        regSheet.getRange(2, columnMapping["EMAIL_SENT"], 999, 1).setDataValidation(emailRule);
      }
      if (columnMapping["OR_EMAIL_SENT"]) {
        regSheet.getRange(2, columnMapping["OR_EMAIL_SENT"], 999, 1).setDataValidation(emailRule);
      }
      
      SpreadsheetApp.getActiveSpreadsheet().toast("Columns added!", "✅", 3);
      
      // Show what was added
      ui.alert("✅ Columns Added!",
        "Added " + addedColumns.length + " new columns:\n\n" +
        addedColumns.join("\n") +
        "\n\n⚠️ IMPORTANT: Update SYSTEM_CONFIG.COLS.REG\n" +
        "to match the new column positions!\n\n" +
        "Run 'Show All Column Headers' to see the mapping.",
        ui.ButtonSet.OK);
      
      // Show column mapping for user to update config
      showColumnMappingAfterFix_(regSheet, columnMapping, missingColumns);
      return;
    }
  } else {
    ui.alert("✅ All System Columns Present!",
      report.join("\n") +
      "\n\n✅ No missing columns found!\n\n" +
      "All required system columns are present.",
      ui.ButtonSet.OK);
  }
}

