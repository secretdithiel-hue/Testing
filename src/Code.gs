/**
 * Get all existing merge groups with participant details.
 * Called by the "View Groups" tab in the Merge UI.
 */
function V22_merge_getAllGroups() {
  try {
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    Logger.log("[GROUPS_DEBUG] regSheet found: " + !!regSheet);
    if (!regSheet) {
      throw new Error("Registration sheet '" + SYSTEM_CONFIG.SHEETS.REGISTRATION + "' not found.");
    }
    Logger.log("[GROUPS_DEBUG] Sheet name: " + regSheet.getName() + ", lastRow: " + regSheet.getLastRow() + ", lastCol: " + regSheet.getLastColumn());
    var regMap = ColumnManager.headerMap(regSheet);
    Logger.log("[GROUPS_DEBUG] headerMap keys: " + Object.keys(regMap).join(", "));
    var data = regSheet.getDataRange().getValues();
    Logger.log("[GROUPS_DEBUG] data rows (incl header): " + data.length);

    var colGroup = regMap[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID];
    var colRole  = regMap[V22_CONFIG.MERGE.REG_HEADERS.ROLE];
    var colEmail = SYSTEM_CONFIG.COLS.REG.EMAIL;
    var colName  = SYSTEM_CONFIG.COLS.REG.NAME;
    var colGenId = SYSTEM_CONFIG.COLS.REG.GEN_ID;
    var colFinal = SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT;
    var colComps = SYSTEM_CONFIG.COLS.REG.COMPETITION || null;
    var colManualTotal = regMap["SYS_MERGE_MANUAL_TOTAL"] || null;
    var colBundleInfo = regMap["SYS_MERGE_BUNDLE_INFO"] || null;
    var colPrimaryEmail = regMap[V22_CONFIG.MERGE.REG_HEADERS.PRIMARY_EMAIL] || null;
    Logger.log("[GROUPS_DEBUG] colGroup: " + colGroup + ", colRole: " + colRole + ", colEmail: " + colEmail + ", colName: " + colName);

    if (!colGroup || !colRole) {
      Logger.log("[GROUPS_DEBUG] EARLY RETURN: colGroup or colRole is null/undefined. Looking for headers: '" + V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID + "' and '" + V22_CONFIG.MERGE.REG_HEADERS.ROLE + "'");
      return [];
    }

    var groupMap = {};

    for (var i = 1; i < data.length; i++) {
      var r = data[i];
      var gid   = String(r[colGroup - 1] || "").trim();
      var email = String(r[colEmail - 1] || "").trim();
      var role  = String(r[colRole  - 1] || "").toUpperCase();
      if (!gid || !email) continue;

      var name  = String(r[colName  - 1] || "").trim();
      var genId = colGenId ? String(r[colGenId - 1] || "").trim() : "";
      var amt   = Number(r[colFinal - 1] || 0);
      var comps = colComps ? String(r[colComps - 1] || "") : "";

      if (!groupMap[gid]) {
        groupMap[gid] = { groupId: gid, participants: [], primaryEmail: "", groupTotal: 0 };
      }

      var isPrimary = role.indexOf("PRIMARY") !== -1;
      groupMap[gid].participants.push({
        name: name, email: email, genId: genId,
        role: isPrimary ? "PRIMARY" : "MEMBER",
        finalAmount: amt, competitions: comps
      });
      if (isPrimary) {
        groupMap[gid].primaryEmail = email;
        // Read manual total and bundle info from primary's row
        if (colManualTotal) {
          var mt = Number(r[colManualTotal - 1] || 0);
          if (mt > 0) groupMap[gid].manualTotal = mt;
        }
        if (colBundleInfo) {
          var bi = String(r[colBundleInfo - 1] || "").trim();
          if (bi) groupMap[gid].bundleInfo = bi;
        }
      }
      groupMap[gid].groupTotal += amt;
    }

    // Fallback — read Finance sheet to detect manual total overrides for old groups
    var finSheet = null;
    var finCols = null;
    var finData = null;
    var finEmailMap = {};
    try {
      finSheet = repo.getFinanceSheet();
      if (finSheet) {
        finCols = ColumnManager.getFinanceCols(finSheet);
        if (finCols && finCols.Email && finCols.TotalAmount) {
          finData = finSheet.getDataRange().getValues();
          for (var fi = 1; fi < finData.length; fi++) {
            var fEmail = String(finData[fi][finCols.Email - 1] || "").toLowerCase().trim();
            if (fEmail) {
              finEmailMap[fEmail] = {
                totalAmount: Number(finData[fi][finCols.TotalAmount - 1] || 0),
                payRef: finCols.PayRef ? String(finData[fi][finCols.PayRef - 1] || "").trim() : ""
              };
            }
          }
        }
      }
    } catch (fe) {}

    var result = [];
    var gids = Object.keys(groupMap);
    for (var g = 0; g < gids.length; g++) {
      var grp = groupMap[gids[g]];
      grp.memberCount = grp.participants.length;
      grp.participants.sort(function(a, b) {
        if (a.role === "PRIMARY" && b.role !== "PRIMARY") return -1;
        if (a.role !== "PRIMARY" && b.role === "PRIMARY") return 1;
        return (a.name || "").localeCompare(b.name || "");
      });
      // Use manual total as display total if set
      if (grp.manualTotal && grp.manualTotal > 0) {
        grp.groupTotal = grp.manualTotal;
      }
      // Read pay ref and fallback total from Finance sheet
      if (grp.primaryEmail && finEmailMap[grp.primaryEmail.toLowerCase()]) {
        var finInfo = finEmailMap[grp.primaryEmail.toLowerCase()];
        if (finInfo.payRef) grp.payRef = finInfo.payRef;
        if (!grp.manualTotal && finInfo.totalAmount > 0 && finInfo.totalAmount !== grp.groupTotal) {
          grp.manualTotal = finInfo.totalAmount;
          grp.groupTotal = finInfo.totalAmount;
        }
      }
      result.push(grp);
    }
    result.sort(function(a, b) { return a.groupId.localeCompare(b.groupId); });
    return result;
  } catch (e) {
    throw new Error("Load groups failed: " + e.message);
  }
}

