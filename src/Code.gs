var AuditLogService = (function () {
  function getLogSheet_() {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.LOGS);
    if (!sheet) {
      sheet = ss.insertSheet(SYSTEM_CONFIG.SHEETS.LOGS);
      sheet.getRange(1, 1, 1, 5).setValues([["TIMESTAMP", "LEVEL", "ACTION", "DETAILS", "USER"]]);
      sheet.getRange(1, 1, 1, 5).setBackground("#333333").setFontColor("#FFFFFF").setFontWeight("bold");
      sheet.setColumnWidths(1, 5, [160, 80, 180, 520, 200]);
    }
    return sheet;
  }

  function log_(level, action, details) {
    try {
      var user = "";
      try { user = Session.getActiveUser().getEmail(); } catch (e) {}
      getLogSheet_().appendRow([new Date(), level, action, details, user]);
      Logger.log("[" + level + "] " + action + ": " + details);
    } catch (e) {
      console.error("LOGGING FAILED: " + e);
    }
  }

  return {
    info: function (a, d) { log_("INFO", a, d); },
    warn: function (a, d) { log_("WARN", a, d); },
    error: function (a, d) { log_("ERROR", a, d); },
    // DEBUG lines go to the Apps Script execution log only. Writing each one to the Logs sheet
    // added ~10 sheet writes to every price calculation, which made bulk tools (QA, rebuild,
    // dashboards) crawl. Set SYSTEM_CONFIG.ADMIN.DEBUG_LOG_TO_SHEET = true to restore that.
    debug: function (a, d) {
      if (SYSTEM_CONFIG.ADMIN.DEBUG_LOG_TO_SHEET) log_("DEBUG", a, d);
      else Logger.log("[DEBUG] " + a + ": " + d);
    }
  };
})();

var Utils = (function () {
  function upper(x) { return String(x || "").toUpperCase().trim(); }
  function lower(x) { return String(x || "").toLowerCase().trim(); }

  function cleanInput(input) {
    if (input === null || input === undefined) return "";
    var str = String(input).trim();
    var blacklist = ["N/A", "NA", "NONE", "NULL", "-", ".", ""];
    if (blacklist.indexOf(str.toUpperCase()) >= 0) return "";
    return str.toUpperCase();
  }

  function nowTzString() {
    return Utilities.formatDate(new Date(), SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd HH:mm:ss");
  }

  function formatDate(date) {
    var d = date ? new Date(date) : new Date();
    return Utilities.formatDate(d, SYSTEM_CONFIG.META.TIMEZONE, "dd MMMM yyyy");
  }

  function formatCurrency(amount) {
    var n = Number(amount || 0);
    return "₱" + n.toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatCurrencyShort(amount) {
    var n = Number(amount || 0);
    var isWhole = Math.abs(n - Math.round(n)) < 0.000001;
    return "₱" + n.toLocaleString("en-PH", {
      minimumFractionDigits: isWhole ? 0 : 2,
      maximumFractionDigits: isWhole ? 0 : 2
    });
  }

  function generateId(prefix) {
    prefix = prefix || "REF";
    // Always exactly 8 characters (Math.random().toString(36) can come out shorter,
    // which would fail the REF-XXXXXXXX format check used by the data tools)
    var alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    var random = "";
    for (var i = 0; i < 8; i++) {
      random += alphabet.charAt(Math.floor(Math.random() * alphabet.length));
    }
    return prefix + "-" + random;
  }

  function midnightToday() {
    var t = new Date();
    t.setHours(0, 0, 0, 0);
    return t;
  }

  function hashReceiptPayload(payloadObj) {
    var json = JSON.stringify(payloadObj || {});
    var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, json, Utilities.Charset.UTF_8);
    return Utilities.base64EncodeWebSafe(bytes);
  }

  function hoursBetween(a, b) {
    var ms = Math.abs(a.getTime() - b.getTime());
    return ms / (1000 * 60 * 60);
  }

  function parseMaybeDate(x) {
    if (!x) return null;
    if (Object.prototype.toString.call(x) === "[object Date]") return x;
    var d = new Date(x);
    return isNaN(d.getTime()) ? null : d;
  }

  function safeString(x) {
    if (x === null || x === undefined) return "";
    return String(x);
  }

  // UPGRADED: Email normalization with validation
  function normalizeEmail(x) {
    return String(x || "").trim().toLowerCase();
  }

  // NEW: Email format validation
  function isValidEmail(email) {
    if (!email) return false;
    var emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
    return emailRegex.test(String(email).trim());
  }

  // NEW: Validate proof link domain
  function isValidProofLink(url) {
    if (!url) return { valid: true, reason: "No URL provided" }; // Optional field
    
    var urlStr = String(url).trim().toLowerCase();
    if (!urlStr) return { valid: true, reason: "Empty URL" };
    
    // Check if it's a URL
    if (!urlStr.match(/^https?:\/\//)) {
      return { valid: false, reason: "Not a valid URL format" };
    }
    
    var allowedDomains = SYSTEM_CONFIG.ADMIN.ALLOWED_PROOF_DOMAINS;
    var isAllowed = allowedDomains.some(function(domain) {
      return urlStr.indexOf(domain) >= 0;
    });
    
    if (!isAllowed) {
      return { valid: false, reason: "Domain not in allowed list", url: urlStr };
    }
    
    return { valid: true, reason: "" };
  }

  function normalizeStatusValue(x) {
    var v = String(x || "").trim();
    if (!v) return SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
    if (v === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) return SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
    if (v === SYSTEM_CONFIG.ADMIN.NOT_YET_WORD) return SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
    var up = v.toUpperCase();
    if (up === "NOT YET" || up === "NOTYET" || up === "UNPAID") return SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
    if (up === "PAID") return SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
    return SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
  }

  /**
   * true when a status cell means "paid". Every dashboard, filter and report uses this,
   * so they always agree with each other and with SYSTEM_CONFIG.ADMIN.TRIGGER_WORD.
   */
  function isPaidStatus(x) {
    return normalizeStatusValue(x) === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;
  }

  return {
    upper: upper,
    lower: lower,
    cleanInput: cleanInput,
    nowTzString: nowTzString,
    formatDate: formatDate,
    formatCurrency: formatCurrency,
    formatCurrencyShort: formatCurrencyShort,
    generateId: generateId,
    midnightToday: midnightToday,
    hashReceiptPayload: hashReceiptPayload,
    hoursBetween: hoursBetween,
    parseMaybeDate: parseMaybeDate,
    safeString: safeString,
    normalizeEmail: normalizeEmail,
    isValidEmail: isValidEmail,
    isValidProofLink: isValidProofLink,
    // NEW: Escape HTML
    escapeHtml: function (text) {
      if (!text) return "";
      return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    },
    normalizeStatusValue: normalizeStatusValue,
    isPaidStatus: isPaidStatus
  };
})();

