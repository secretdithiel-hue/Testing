/**
 * Comprehensive test suite for the depersonalization & submission system.
 * Simulates the full lifecycle: new submission → edit (same competition) → 
 * add competition via edit → admin reprocess → cleanup.
 * 
 * Creates a temporary test row on Submission Form, processes it through
 * the pipeline, validates all SYS columns, and cleans up afterwards.
 * 
 * Run from: Admin Center → Submission & Depersonalization → Test Depersonalization System
 */
function runDepersonalizationTestSuite() {
  // Competition names and number prefixes used by these tests come from the shared list
  var TC = { SPEECH: getCompetitionByKey_("SPEECH"), ESSAY: getCompetitionByKey_("ESSAY"), PHOTO: getCompetitionByKey_("PHOTO") };
  if (!TC.SPEECH || !TC.ESSAY || !TC.PHOTO) {
    SpreadsheetApp.getUi().alert("Test not run", "These tests use the SPEECH, ESSAY and PHOTO entries of SYSTEM_CONFIG.COMPETITIONS, and one of them is missing.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }
  var sampleEssayNum = sampleParticipantNumber_("ESSAY", 2);
  // A participant number is "<prefix>-<digits>", with the prefix and the number of digits from the settings
  var numberFormat = function (prefix) {
    return new RegExp("^" + prefix + "-\\d{" + (SYSTEM_CONFIG.DEPERSONALIZATION.COUNTER_DIGITS || 4) + "}$");
  };
  var sampleTwoNums = sampleParticipantNumber_("SPEECH", 1) + ", " + sampleEssayNum;
  var ui = SpreadsheetApp.getUi();
  var startTime = new Date();
  
  var confirm = ui.alert(
    "🧪 Depersonalization Test Suite",
    "This will run a comprehensive test of the submission & depersonalization system.\n\n" +
    "What it does:\n" +
    "• Creates a temporary test row on " + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "\n" +
    "• Simulates new submission processing\n" +
    "• Simulates form edit (same competition)\n" +
    "• Simulates adding a new competition via edit\n" +
    "• Tests admin reprocess\n" +
    "• Validates all SYS columns at each step\n" +
    "• Cleans up all test data when done\n\n" +
    "⚠️ This will NOT send any real emails.\n\n" +
    "Continue?",
    ui.ButtonSet.YES_NO
  );
  
  if (confirm !== ui.Button.YES) return;
  
  var results = [];
  var testRow = null;
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  
  if (!subSheet) {
    ui.alert("❌ Test Failed", "Could not find the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.", ui.ButtonSet.OK);
    return;
  }
  
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  
  // ===== Helper functions =====
  function pass(name, detail) {
    results.push({ name: name, status: "PASS", detail: detail || "" });
    AuditLogService.info("TEST_PASS", name + (detail ? ": " + detail : ""));
  }
  function fail(name, detail) {
    results.push({ name: name, status: "FAIL", detail: detail || "" });
    AuditLogService.error("TEST_FAIL", name + ": " + detail);
  }
  function getSysVal(row, header) {
    var col = sysCols[header];
    if (!col) return "";
    return String(subSheet.getRange(row, col).getValue() || "").trim();
  }
  
  try {
    // =========================================================================
    // SETUP: Create a fake test row on Submission Form
    // =========================================================================
    AuditLogService.info("TEST_SUITE_START", "Starting Depersonalization Test Suite");
    
    var S = SYSTEM_CONFIG.COLS.SUB;
    var lastRow = subSheet.getLastRow();
    testRow = lastRow + 1;
    var testEmail = "depersonalization.test." + new Date().getTime() + "@test.husay.local";
    var testTimestamp = new Date();
    
    // Build a minimal test row for Speech Competition
    var width = subSheet.getLastColumn();
    var emptyRow = new Array(width).fill("");
    emptyRow[S.TIMESTAMP - 1] = testTimestamp;
    emptyRow[S.EMAIL - 1] = testEmail;
    emptyRow[S.COMPETITION_TYPE - 1] = TC.SPEECH.submissionName;
    emptyRow[S.SPEECH_NAME - 1] = "TEST PARTICIPANT NAME";
    emptyRow[S.SPEECH_REGION - 1] = "NCR";
    emptyRow[S.SPEECH_SCHOOL - 1] = "TEST UNIVERSITY";
    emptyRow[S.SPEECH_ADVISER - 1] = "TEST ADVISER";
    emptyRow[S.SPEECH_FACEBOOK - 1] = "https://facebook.com/test";
    emptyRow[S.SPEECH_CONTACT - 1] = "09171234567";
    // Note: No actual file uploads for test (SPEECH_VIDEO, SPEECH_WRITTEN left empty)
    
    subSheet.getRange(testRow, 1, 1, width).setValues([emptyRow]);
    pass("Setup: Create test row", "Row " + testRow + " created with " + TC.SPEECH.submissionName + " data");
    
    // =========================================================================
    // TEST 1: Fresh submission processing (new entry)
    // =========================================================================
    AuditLogService.info("TEST_1", "=== TEST 1: Fresh Submission Processing ===");
    
    var rowVals = subSheet.getRange(testRow, 1, 1, width).getValues()[0];
    var result1 = DepersonalizationService.processSubmission(subSheet, sysCols, testRow, rowVals, repo);
    
    if (result1.success) {
      pass("Test 1a: processSubmission succeeds", "Result: " + JSON.stringify({ num: result1.participantNum, status: result1.status }));
    } else {
      fail("Test 1a: processSubmission succeeds", "Error: " + (result1.error || "Unknown"));
    }
    
    // Validate participant number format
    var num1 = getSysVal(testRow, "SYS_PARTICIPANT_NUM");
    if (numberFormat(TC.SPEECH.prefix).test(num1)) {
      pass("Test 1b: Participant number format", "Got: " + num1 + " (valid " + TC.SPEECH.prefix + "-number format)");
    } else {
      fail("Test 1b: Participant number format", "Expected " + sampleParticipantNumber_("SPEECH", 1) + " style, got: " + num1);
    }
    
    // Validate SYS_SUB_STATUS is set
    var status1 = getSysVal(testRow, "SYS_SUB_STATUS");
    if (status1 === "PROCESSED" || status1 === "PENDING" || status1 === "ERROR") {
      pass("Test 1c: SYS_SUB_STATUS set", "Status: " + status1);
    } else {
      fail("Test 1c: SYS_SUB_STATUS set", "Expected PROCESSED/PENDING/ERROR, got: " + status1);
    }
    
    // Validate SYS_DEPERSONALIZED is set
    var deperson1 = getSysVal(testRow, "SYS_DEPERSONALIZED");
    if (deperson1 === "YES" || deperson1 === "NO") {
      pass("Test 1d: SYS_DEPERSONALIZED set", "Value: " + deperson1);
    } else {
      fail("Test 1d: SYS_DEPERSONALIZED set", "Expected YES/NO, got: " + deperson1);
    }
    
    // =========================================================================
    // TEST 2: Edit same competition (should reuse participant number)
    // =========================================================================
    AuditLogService.info("TEST_2", "=== TEST 2: Edit Same Competition ===");
    
    // Simulate editing: change the adviser name
    subSheet.getRange(testRow, S.SPEECH_ADVISER).setValue("EDITED ADVISER NAME");
    
    // Re-read row data
    var rowVals2 = subSheet.getRange(testRow, 1, 1, width).getValues()[0];
    
    // Read existing SYS data (as handleSubmissionFormResponse2 would)
    var existingNum2 = getSysVal(testRow, "SYS_PARTICIPANT_NUM");
    var existingAnonIds2 = getSysVal(testRow, "SYS_ANON_FILE_IDS");
    
    // Look up existing participant number for SPEECH
    var reuseNum = DepersonalizationService.getExistingParticipantNum(existingNum2, "SPEECH");
    
    if (reuseNum === num1) {
      pass("Test 2a: getExistingParticipantNum finds existing", "Found: " + reuseNum);
    } else {
      fail("Test 2a: getExistingParticipantNum finds existing", "Expected " + num1 + ", got: " + reuseNum);
    }
    
    // Process with reuse option
    var editOptions = {};
    if (reuseNum) editOptions.existingParticipantNum = reuseNum;
    var result2 = DepersonalizationService.processSubmission(subSheet, sysCols, testRow, rowVals2, repo, editOptions);
    
    if (result2.success) {
      pass("Test 2b: Edit processSubmission succeeds", "Num: " + result2.participantNum);
    } else {
      fail("Test 2b: Edit processSubmission succeeds", "Error: " + (result2.error || "Unknown"));
    }
    
    // Validate participant number was REUSED (not incremented)
    var num2 = getSysVal(testRow, "SYS_PARTICIPANT_NUM");
    if (num2 === num1) {
      pass("Test 2c: Participant number REUSED on edit", "Still: " + num2 + " (no bloat)");
    } else {
      fail("Test 2c: Participant number REUSED on edit", "Expected " + num1 + ", got: " + num2 + " (NUMBER BLOAT!)");
    }
    
    // =========================================================================
    // TEST 3: Add new competition via edit (should get NEW number)
    // =========================================================================
    AuditLogService.info("TEST_3", "=== TEST 3: Add New Competition via Edit ===");
    
    // Add Essay data to the same row
    subSheet.getRange(testRow, S.ESSAY_NAME).setValue("TEST PARTICIPANT NAME");
    subSheet.getRange(testRow, S.ESSAY_REGION).setValue("NCR");
    subSheet.getRange(testRow, S.ESSAY_SCHOOL).setValue("TEST UNIVERSITY");
    subSheet.getRange(testRow, S.ESSAY_ADVISER).setValue("TEST ADVISER");
    subSheet.getRange(testRow, S.ESSAY_FACEBOOK).setValue("https://facebook.com/test");
    subSheet.getRange(testRow, S.ESSAY_CONTACT).setValue("09171234567");
    subSheet.getRange(testRow, S.ESSAY_TITLE).setValue("Test Essay Title");
    
    // Re-read row data
    var rowVals3 = subSheet.getRange(testRow, 1, 1, width).getValues()[0];
    
    // Detect competitions from data (should find both Speech and Essay)
    var detected = DepersonalizationService.detectCompetitionsFromData(rowVals3);
    
    // Note: Detection requires both NAME and FILE data. Since we have no files,
    // this may only detect competitions with name data. That's expected behavior.
    pass("Test 3a: detectCompetitionsFromData", "Detected: [" + detected.join(", ") + "] (Note: requires both name AND file data)");
    
    // Manually test processing Essay as a NEW competition
    var existingNum3 = getSysVal(testRow, "SYS_PARTICIPANT_NUM");
    var essayExistingNum = DepersonalizationService.getExistingParticipantNum(existingNum3, "ESSAY");
    
    if (!essayExistingNum) {
      pass("Test 3b: No existing Essay number found", "Correctly identified as NEW competition");
    } else {
      fail("Test 3b: No existing Essay number found", "Unexpectedly found: " + essayExistingNum);
    }
    
    // Process Essay (temporarily override competition type)
    rowVals3[S.COMPETITION_TYPE - 1] = TC.ESSAY.submissionName;
    var result3 = DepersonalizationService.processSubmission(subSheet, sysCols, testRow, rowVals3, repo);
    
    if (result3.success) {
      pass("Test 3c: New Essay processSubmission succeeds", "Essay number: " + result3.participantNum);
    } else {
      fail("Test 3c: New Essay processSubmission succeeds", "Error: " + (result3.error || "Unknown"));
    }
    
    // Check Essay got a different prefix
    if (result3.success && numberFormat(TC.ESSAY.prefix).test(result3.participantNum)) {
      pass("Test 3d: Essay number format", "Got: " + result3.participantNum + " (valid " + TC.ESSAY.prefix + "-number format)");
    } else if (result3.success) {
      fail("Test 3d: Essay number format", "Expected " + sampleParticipantNumber_("ESSAY", 1) + " style, got: " + result3.participantNum);
    }
    
    // =========================================================================
    // TEST 4: Admin reprocess (should reuse all existing numbers + cleanup)
    // =========================================================================
    AuditLogService.info("TEST_4", "=== TEST 4: Admin Reprocess ===");
    
    // Reset competition type back to Speech for reprocess
    subSheet.getRange(testRow, S.COMPETITION_TYPE).setValue(TC.SPEECH.submissionName);
    
    // Write combined numbers for reprocess to find
    var combinedNums = num1;
    if (result3.success) combinedNums += ", " + result3.participantNum;
    subSheet.getRange(testRow, sysCols["SYS_PARTICIPANT_NUM"]).setValue(combinedNums);
    
    // Run reprocess
    var sysCols4 = ColumnManager.ensureSysColsOnSubmissions(subSheet);
    var result4 = DepersonalizationService.reprocessSubmission(subSheet, sysCols4, testRow, repo);
    
    if (result4.success) {
      pass("Test 4a: reprocessSubmission succeeds", "Num: " + result4.participantNum + ", Status: " + result4.status);
    } else {
      fail("Test 4a: reprocessSubmission succeeds", "Error: " + (result4.error || "Unknown"));
    }
    
    // Validate reprocess reused the participant number
    var num4 = getSysVal(testRow, "SYS_PARTICIPANT_NUM");
    if (num4.indexOf(num1) >= 0) {
      pass("Test 4b: Reprocess reused Speech number", "SYS_PARTICIPANT_NUM contains " + num1);
    } else {
      fail("Test 4b: Reprocess reused Speech number", "Expected to contain " + num1 + ", got: " + num4);
    }
    
    // =========================================================================
    // TEST 5: Cleanup verification
    // =========================================================================
    AuditLogService.info("TEST_5", "=== TEST 5: Cleanup Verification ===");
    
    // Test cleanupOldAnonFiles with empty IDs (should not error)
    var cleanCount = DepersonalizationService.cleanupOldAnonFiles("", TC.SPEECH.prefix);
    if (cleanCount === 0) {
      pass("Test 5a: cleanupOldAnonFiles with empty input", "Returns 0 (no-op)");
    } else {
      fail("Test 5a: cleanupOldAnonFiles with empty input", "Expected 0, got: " + cleanCount);
    }
    
    // Test cleanupOldAnonFiles with invalid IDs (should handle gracefully)
    var cleanCount2 = DepersonalizationService.cleanupOldAnonFiles("invalid_id_12345,another_bad_id", TC.SPEECH.prefix);
    pass("Test 5b: cleanupOldAnonFiles with invalid IDs", "Handled gracefully, trashed: " + cleanCount2);
    
    // Test getExistingParticipantNum with edge cases
    var edgeTest1 = DepersonalizationService.getExistingParticipantNum("", "SPEECH");
    var edgeTest2 = DepersonalizationService.getExistingParticipantNum(sampleTwoNums, "PHOTO");
    var edgeTest3 = DepersonalizationService.getExistingParticipantNum(sampleTwoNums, "ESSAY");
    
    if (edgeTest1 === null) {
      pass("Test 5c: getExistingParticipantNum with empty", "Returns null");
    } else {
      fail("Test 5c: getExistingParticipantNum with empty", "Expected null, got: " + edgeTest1);
    }
    
    if (edgeTest2 === null) {
      pass("Test 5d: getExistingParticipantNum no match", "PHOTO not in '" + sampleTwoNums + "' → null");
    } else {
      fail("Test 5d: getExistingParticipantNum no match", "Expected null, got: " + edgeTest2);
    }
    
    if (edgeTest3 === sampleEssayNum) {
      pass("Test 5e: getExistingParticipantNum match", "ESSAY in '" + sampleTwoNums + "' → " + sampleEssayNum);
    } else {
      fail("Test 5e: getExistingParticipantNum match", "Expected " + sampleEssayNum + ", got: " + edgeTest3);
    }
    
    // =========================================================================
    // TEST 6: PII Detection Tests
    // =========================================================================
    AuditLogService.info("TEST_6", "=== TEST 6: PII Detection ===");
    
    var pii1 = DepersonalizationService.flagPiiInTitle_("My Essay by John Smith", "JOHN SMITH", "XYZ University");
    if (pii1.flagged && pii1.matches.length > 0) {
      pass("Test 6a: PII detected in title with name", "Matches: " + pii1.matches.join(", "));
    } else {
      fail("Test 6a: PII detected in title with name", "Expected flagged=true");
    }
    
    var pii2 = DepersonalizationService.flagPiiInTitle_("A Beautiful Sunset", "JOHN SMITH", "XYZ University");
    if (!pii2.flagged) {
      pass("Test 6b: No PII in clean title", "Correctly not flagged");
    } else {
      fail("Test 6b: No PII in clean title", "False positive: " + pii2.matches.join(", "));
    }
    
    var pii3 = DepersonalizationService.flagPiiInTitle_("Research Paper from Mabini School of Science", "Test Name", "Mabini");
    if (pii3.flagged) {
      pass("Test 6c: School name PII detected in title", "Matches: " + pii3.matches.join(", "));
    } else {
      fail("Test 6c: School name PII detected in title", "Expected the school name to be flagged");
    }
    
    // =========================================================================
    // TEST 7: Competition Detection Tests
    // =========================================================================
    AuditLogService.info("TEST_7", "=== TEST 7: Competition Detection from Data ===");
    
    // Build a mock row with Speech + Photo data (name + file URLs present)
    var mockRow = new Array(width).fill("");
    mockRow[S.COMPETITION_TYPE - 1] = TC.SPEECH.submissionName;
    mockRow[S.SPEECH_NAME - 1] = "Mock Speaker";
    mockRow[S.SPEECH_VIDEO - 1] = "https://drive.google.com/file/d/abc123/view";
    mockRow[S.PHOTO_NAME - 1] = "Mock Photographer";
    mockRow[S.PHOTO_FILE - 1] = "https://drive.google.com/file/d/def456/view";
    
    var mockDetected = DepersonalizationService.detectCompetitionsFromData(mockRow);
    
    if (mockDetected.indexOf(TC.SPEECH.submissionName) >= 0) {
      pass("Test 7a: Speech detected from mock data", "Speech found in detected list");
    } else {
      fail("Test 7a: Speech detected from mock data", "Speech NOT found in: [" + mockDetected.join(", ") + "]");
    }
    
    if (mockDetected.indexOf(TC.PHOTO.submissionName) >= 0) {
      pass("Test 7b: Photo detected from mock data", "Photo found in detected list");
    } else {
      fail("Test 7b: Photo detected from mock data", "Photo NOT found in: [" + mockDetected.join(", ") + "]");
    }
    
    // Verify that Essay is NOT detected (no file data for it)
    if (mockDetected.indexOf(TC.ESSAY.submissionName) < 0) {
      pass("Test 7c: Essay NOT detected (no file data)", "Correctly excluded");
    } else {
      fail("Test 7c: Essay NOT detected (no file data)", "False positive: Essay detected without file");
    }
    
    // =========================================================================
    // TEST 8: File ID Extraction Tests
    // =========================================================================
    AuditLogService.info("TEST_8", "=== TEST 8: File ID Extraction ===");
    
    var fid1 = DepersonalizationService.extractFileId("https://drive.google.com/file/d/1aBcDeFgHiJkLmNoPqRs/view?usp=sharing");
    if (fid1 === "1aBcDeFgHiJkLmNoPqRs") {
      pass("Test 8a: Extract from /d/ID format", "Got: " + fid1);
    } else {
      fail("Test 8a: Extract from /d/ID format", "Expected 1aBcDeFgHiJkLmNoPqRs, got: " + fid1);
    }
    
    var fid2 = DepersonalizationService.extractFileId("https://drive.google.com/open?id=1aBcDeFgHiJkLmNoPqRs");
    if (fid2 === "1aBcDeFgHiJkLmNoPqRs") {
      pass("Test 8b: Extract from ?id=ID format", "Got: " + fid2);
    } else {
      fail("Test 8b: Extract from ?id=ID format", "Expected 1aBcDeFgHiJkLmNoPqRs, got: " + fid2);
    }
    
    var fid3 = DepersonalizationService.extractFileId("");
    if (fid3 === null) {
      pass("Test 8c: Extract from empty string", "Returns null");
    } else {
      fail("Test 8c: Extract from empty string", "Expected null, got: " + fid3);
    }
    
  } catch (err) {
    fail("UNEXPECTED ERROR", err.toString() + "\nStack: " + (err.stack || "N/A"));
    AuditLogService.error("TEST_SUITE_ERROR", "Unexpected error: " + err);
  
  } finally {
    // =========================================================================
    // CLEANUP: Remove the test row
    // =========================================================================
    if (testRow) {
      try {
        // Delete the test row by finding its unique test email, never by the remembered row
        // number: a real submission arriving during the test could shift rows, and deleting
        // by number would then remove a participant's entry.
        var cleanupLast = subSheet.getLastRow();
        var cleanupEmails = cleanupLast >= 2
          ? subSheet.getRange(2, SYSTEM_CONFIG.COLS.SUB.EMAIL, cleanupLast - 1, 1).getValues()
          : [];
        var deletedTestRows = 0;
        for (var cr = cleanupEmails.length - 1; cr >= 0; cr--) {
          if (String(cleanupEmails[cr][0] || "").trim() === testEmail) {
            subSheet.deleteRow(cr + 2);
            deletedTestRows++;
          }
        }
        if (deletedTestRows > 0) {
          pass("Cleanup: Test row deleted", "Test row removed from " + SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
        } else {
          fail("Cleanup: Test row deleted", "Test row (" + testEmail + ") was not found; nothing was deleted");
        }
      } catch (cleanErr) {
        fail("Cleanup: Test row deleted", "Could not delete the test row: " + cleanErr);
      }
    }
  }
  
  // =========================================================================
  // REPORT: Show results
  // =========================================================================
  var elapsed = ((new Date().getTime() - startTime.getTime()) / 1000).toFixed(1);
  var passed = results.filter(function(r) { return r.status === "PASS"; }).length;
  var failed = results.filter(function(r) { return r.status === "FAIL"; }).length;
  var total = results.length;
  
  AuditLogService.info("TEST_SUITE_DONE", "Depersonalization Test Suite complete: " + passed + "/" + total + " passed, " + failed + " failed in " + elapsed + "s");
  
  // Build report HTML
  var h = [];
  h.push('<html><head><style>');
  h.push('body { font-family: "Google Sans", "Segoe UI", sans-serif; margin: 0; padding: 20px; background: #0d1117; color: #c9d1d9; }');
  h.push('.header { text-align: center; margin-bottom: 20px; }');
  h.push('.header h1 { color: #fff; font-size: 20px; margin: 0; }');
  h.push('.header .subtitle { color: #8b949e; font-size: 12px; }');
  h.push('.summary { display: flex; gap: 12px; justify-content: center; margin: 16px 0; }');
  h.push('.stat { padding: 12px 20px; border-radius: 8px; text-align: center; min-width: 80px; }');
  h.push('.stat .num { font-size: 24px; font-weight: bold; }');
  h.push('.stat .lbl { font-size: 11px; text-transform: uppercase; margin-top: 4px; }');
  h.push('.stat-pass { background: rgba(46,160,67,0.15); color: #3fb950; }');
  h.push('.stat-fail { background: rgba(248,81,73,0.15); color: #ff7b72; }');
  h.push('.stat-total { background: #161b22; color: #58a6ff; }');
  h.push('.stat-time { background: #0d1117; color: #3fb950; }');
  h.push('.results { max-height: 400px; overflow-y: auto; }');
  h.push('.row { display: flex; align-items: center; padding: 6px 12px; border-bottom: 1px solid #21262d; font-size: 13px; }');
  h.push('.row:hover { background: #0d1117; }');
  h.push('.icon { width: 20px; text-align: center; margin-right: 8px; }');
  h.push('.name { flex: 1; color: #c9d1d9; }');
  h.push('.detail { color: #8b949e; font-size: 11px; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }');
  h.push('.pass .icon { color: #3fb950; }');
  h.push('.fail .icon { color: #ff7b72; }');
  h.push('.fail .name { color: #ff7b72; }');
  h.push('</style></head><body>');
  h.push('<div class="header">');
  h.push('<h1>🧪 Depersonalization Test Suite</h1>');
  h.push('<div class="subtitle">System Validation</div>');
  h.push('</div>');
  
  h.push('<div class="summary">');
  h.push('<div class="stat stat-pass"><div class="num">' + passed + '</div><div class="lbl">Passed</div></div>');
  h.push('<div class="stat stat-fail"><div class="num">' + failed + '</div><div class="lbl">Failed</div></div>');
  h.push('<div class="stat stat-total"><div class="num">' + total + '</div><div class="lbl">Total</div></div>');
  h.push('<div class="stat stat-time"><div class="num">' + elapsed + 's</div><div class="lbl">Time</div></div>');
  h.push('</div>');
  
  h.push('<div class="results">');
  for (var i = 0; i < results.length; i++) {
    var r = results[i];
    var cls = r.status === "PASS" ? "pass" : "fail";
    var icon = r.status === "PASS" ? "✅" : "❌";
    h.push('<div class="row ' + cls + '">');
    h.push('<span class="icon">' + icon + '</span>');
    h.push('<span class="name">' + r.name + '</span>');
    if (r.detail) h.push('<span class="detail" title="' + r.detail.replace(/"/g, '&quot;') + '">' + r.detail + '</span>');
    h.push('</div>');
  }
  h.push('</div>');
  
  // Overall verdict
  if (failed === 0) {
    h.push('<div style="text-align:center;margin-top:20px;padding:12px;background:rgba(46,160,67,0.15);border-radius:8px;color:#3fb950;font-weight:bold;">');
    h.push('🎉 ALL TESTS PASSED — Depersonalization system is working correctly!');
    h.push('</div>');
  } else {
    h.push('<div style="text-align:center;margin-top:20px;padding:12px;background:rgba(248,81,73,0.15);border-radius:8px;color:#ff7b72;font-weight:bold;">');
    h.push('⚠️ ' + failed + ' TEST(S) FAILED — Check the ' + Utils.escapeHtml(SYSTEM_CONFIG.SHEETS.LOGS) + ' sheet for details.');
    h.push('</div>');
  }
  
  h.push('</body></html>');
  
  var output = HtmlService.createHtmlOutput(withGuideLink_(h.join('\n'), "submit"))
    .setWidth(620).setHeight(580).setTitle('Depersonalization Test Results');
  SpreadsheetApp.getUi().showModalDialog(output, '🧪 Depersonalization Test Results');
}



function rebuildFinanceDashboardFull() {
  var ui = SpreadsheetApp.getUi();

  try {
    var ok = ui.alert(
      "Full Rebuild Finance Dashboard?",
      "This will rebuild Finance from Registration, preserve admin fields, keep dropdown validation working, and run QA checks.\nContinue?",
      ui.ButtonSet.YES_NO
    );
    if (ok !== ui.Button.YES) return;

    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    if (!regSheet || !finSheet) throw new Error("Missing Registration or Finance sheet.");

    ColumnManager.ensureSysColsOnRegistration(regSheet);
    var finCols = ColumnManager.getFinanceCols(finSheet);

    // Cache existing admin fields by email
    var metaCache = buildFinanceMetaCache_(finSheet, finCols);

    // Read registration
    var regLastRow = regSheet.getLastRow();
    if (regLastRow < 2) {
      ui.alert("No registration data found.");
      return;
    }

    var regLastCol = regSheet.getLastColumn();
    var regData = regSheet.getRange(2, 1, regLastRow - 1, regLastCol).getValues();

    var regSysCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regPaidAtCol = regSysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT];

    // Build payloads in order
    var payloads = [];
    for (var i = 0; i < regData.length; i++) {
      var rr = regData[i];
      var email = String(rr[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
      if (!email) continue;

      var key = email.toLowerCase();
      var cached = metaCache[key] || {
        Status: SYSTEM_CONFIG.ADMIN.NOT_YET_WORD,
        Verifier: "",
        PayRef: "",
        EmailSent: "",
        SysPaidAt: ""
      };

      var regPaidAtVal = regPaidAtCol ? rr[regPaidAtCol - 1] : "";
      var status = cached.Status || SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
      if (regPaidAtVal) status = SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;

      // Calculate NET total (original payment - cashback earned)
      var originalPayment = Number(rr[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
      var cashbackEarned = Number(rr[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
      var netTotalAmount = Math.max(0, originalPayment - cashbackEarned);

      payloads.push({
        Timestamp: rr[SYSTEM_CONFIG.COLS.REG.TIMESTAMP - 1] || new Date(),
        Email: email,
        Name: rr[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "",
        PaymentMode: rr[SYSTEM_CONFIG.COLS.REG.PAY_MODE - 1] || "",
        ProofLink: rr[SYSTEM_CONFIG.COLS.REG.PAY_PROOF - 1] || "",
        RefCode: rr[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || rr[SYSTEM_CONFIG.COLS.REG.REF_INPUT - 1] || "",
        CouponCode: rr[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || rr[SYSTEM_CONFIG.COLS.REG.COUPON_INPUT - 1] || "",
        GenId: rr[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "",
        RefCount: rr[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0,
        Cashback: cashbackEarned,
        TotalAmount: netTotalAmount,
        Status: status,
        Verifier: cached.Verifier || "",
        PayRef: cached.PayRef || "",
        EmailSent: cached.EmailSent || "",
        SysPaidAt: cached.SysPaidAt || (regPaidAtVal || "")
      });
    }

    // Ensure enough rows + buffer for future entries
    var buffer = 100;
    ensureFinanceRowCapacity_(finSheet, 1 + payloads.length + buffer);

    // Copy Row2 validations down to all rows
    applyFinanceTemplateValidations_(finSheet);

    // Clear content (keep validations)
    clearFinanceDataRange_(finSheet, finSheet.getMaxRows() - 1);

    // Write bulk
    writeFinancePayloadsSequential_(finSheet, finCols, payloads);

    AuditLogService.info("FIN_REBUILD_FULL", "Rebuilt rows=" + payloads.length + " buffer=" + buffer);

    // QA
    var qa = validateFinanceDashboard_({ silent: true });
    // Reapply merge group accounting (prevents merged totals from being overwritten by Rebuild)
    try {
      MergeService.reapplyAllMerges({ silent: true });
    } catch (e) {
      AuditLogService.warn("MERGE_REAPPLY_AFTER_REBUILD_FAIL", String(e));
    }

ui.alert(
      "✅ Full rebuild completed.\n" +
      "Rows rebuilt: " + payloads.length + "\n\n" +
      "QA Summary:\n" +
      "• Issues: " + qa.issueCount + "\n" +
      "• Report Sheet: " + qa.reportSheetName
    );

  } catch (err) {
    AuditLogService.error("FIN_REBUILD_FULL_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ Full rebuild failed:\n" + String(err));
  }
}

function validateFinanceDashboard() {
  var ui = SpreadsheetApp.getUi();
  try {
    var qa = validateFinanceDashboard_({ silent: false });
    ui.alert(
      "✅ QA completed.\n" +
      "Issues: " + qa.issueCount + "\n" +
      "Report Sheet: " + qa.reportSheetName
    );
  } catch (err) {
    AuditLogService.error("FIN_QA_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ QA failed:\n" + String(err));
  }
}

function validateFinanceDashboard_(opts) {
  opts = opts || {};
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet || !finSheet) throw new Error("Missing Registration or Finance sheet.");

  ColumnManager.ensureSysColsOnRegistration(regSheet);
  var finCols = ColumnManager.getFinanceCols(finSheet);

  var reportName = "Finance QA Report";
  var report = ss.getSheetByName(reportName);
  if (!report) report = ss.insertSheet(reportName);
  report.clearContents();

  var rows = [];
  rows.push(["TYPE", "EMAIL", "DETAILS", "SUGGESTED FIX"]);

  // Registration expected map
  var regLastRow = regSheet.getLastRow();
  var regData = (regLastRow >= 2)
    ? regSheet.getRange(2, 1, regLastRow - 1, regSheet.getLastColumn()).getValues()
    : [];

  // Rows in a merge group carry a group total (primary) or 0 (members), so their
  // Finance amount is not expected to equal their own Registration amount.
  var mergeGroupCol = ColumnManager.headerMap(regSheet)[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID] || 0;

  var regByEmail = {};
  for (var i = 0; i < regData.length; i++) {
    var rr = regData[i];
    var email = String(rr[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
    if (!email) continue;

    var key = email.toLowerCase();
    if (regByEmail[key]) {
      rows.push(["DUP_REG_EMAIL", email, "Duplicate email in Registration.", "Resolve duplicates in Registration sheet."]);
      continue;
    }

    var q1 = rr[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
    var q2 = rr[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
    var pricing = PricingEngine.calculate(q1, q2);

    // Finance "Total Amount" is stored NET of referral cashback (see handleSubmission /
    // Sync / Rebuild), so that is the value to compare against.
    var regFinal = Number(rr[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
    var regCashback = Number(rr[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);

    regByEmail[key] = {
      email: email,
      expectedFinal: Math.max(0, regFinal - regCashback),
      merged: mergeGroupCol ? String(rr[mergeGroupCol - 1] || "").trim() !== "" : false,
      normalizedCompetitions: pricing.normalizedCompetitions || String(q2 || "")
    };
  }

  // Finance checks
  var finLastRow = finSheet.getLastRow();
  var finLastCol = finSheet.getLastColumn();
  var finData = (finLastRow >= 2)
    ? finSheet.getRange(2, 1, finLastRow - 1, finLastCol).getValues()
    : [];

  var seenFinance = {};
  var validStatuses = {};
  validStatuses[SYSTEM_CONFIG.ADMIN.TRIGGER_WORD] = true;
  validStatuses[SYSTEM_CONFIG.ADMIN.NOT_YET_WORD] = true;

  for (var r = 0; r < finData.length; r++) {
    var row = finData[r];
    var emailCell = finCols.Email ? String(row[finCols.Email - 1] || "").trim() : "";
    if (!emailCell) continue;

    var key2 = emailCell.toLowerCase();
    if (seenFinance[key2]) {
      rows.push(["DUP_FIN_EMAIL", emailCell, "Duplicate email in Finance Dashboard.", "Run " + getMenuPathText_("rebuildFinanceDashboardFull") + "."]);
    }
    seenFinance[key2] = true;

    // Status validation
    var statusCell = finCols.Status ? String(row[finCols.Status - 1] || "").trim() : "";
    if (statusCell && !validStatuses[statusCell]) {
      rows.push(["BAD_STATUS", emailCell, "Invalid Status: " + statusCell, 'Use only: "' + SYSTEM_CONFIG.ADMIN.TRIGGER_WORD + '" or "' + SYSTEM_CONFIG.ADMIN.NOT_YET_WORD + '".']);
    }

    // Amount validation
    var reg = regByEmail[key2];
    if (!reg) {
      rows.push(["FIN_NO_REG", emailCell, "Finance row exists but no matching Registration row.", "Check email mismatch / remove orphan row."]);
      continue;
    }

    if (finCols.TotalAmount && !reg.merged) {
      var finAmt = Number(row[finCols.TotalAmount - 1] || 0);
      if (Math.abs(finAmt - reg.expectedFinal) > 0.0001) {
        rows.push(["AMOUNT_MISMATCH", emailCell, "Finance Total=" + finAmt + " but Registration Final less cashback=" + reg.expectedFinal, "Run Force Reprocess or Full Rebuild."]);
      }
    }
  }

  // Missing coverage
  var regKeys = Object.keys(regByEmail);
  for (var j = 0; j < regKeys.length; j++) {
    if (!seenFinance[regKeys[j]]) {
      rows.push(["MISSING_IN_FIN", regByEmail[regKeys[j]].email, "Registrant missing in Finance.", "Run Full Rebuild."]);
    }
  }

  report.getRange(1, 1, rows.length, 4).setValues(rows);
  report.getRange(1, 1, 1, 4).setFontWeight("bold");
  report.autoResizeColumns(1, 4);

  var issueCount = Math.max(0, rows.length - 1);
  AuditLogService.info("FIN_QA_DONE", "Issues=" + issueCount);

  return { issueCount: issueCount, reportSheetName: reportName };
}

// ============================================================================
// PART 11.6: HELPER FUNCTIONS FOR REBUILD
// ============================================================================

function buildFinanceMetaCache_(finSheet, finCols) {
  var metaCache = {};
  var lastRow = finSheet.getLastRow();
  var lastCol = finSheet.getLastColumn();
  if (lastRow < 2 || !finCols.Email) return metaCache;

  var data = finSheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var email = String(row[finCols.Email - 1] || "").trim().toLowerCase();
    if (!email) continue;

    metaCache[email] = {
      Status: Utils.normalizeStatusValue(finCols.Status ? row[finCols.Status - 1] : SYSTEM_CONFIG.ADMIN.NOT_YET_WORD),
      Verifier: finCols.Verifier ? row[finCols.Verifier - 1] : "",
      PayRef: finCols.PayRef ? row[finCols.PayRef - 1] : "",
      EmailSent: finCols.EmailSent ? row[finCols.EmailSent - 1] : "",
      SysPaidAt: finCols.SysPaidAt ? row[finCols.SysPaidAt - 1] : ""
    };
  }
  return metaCache;
}

function ensureFinanceRowCapacity_(finSheet, requiredTotalRows) {
  var current = finSheet.getMaxRows();
  if (current >= requiredTotalRows) return;
  finSheet.insertRowsAfter(current, requiredTotalRows - current);
}

function applyFinanceTemplateValidations_(finSheet) {
  var lastCol = finSheet.getLastColumn();
  if (finSheet.getMaxRows() < 2) finSheet.insertRowsAfter(1, 1);

  var template = finSheet.getRange(2, 1, 1, lastCol);
  var validations = template.getDataValidations();
  if (!validations || !validations.length) return;

  var targetRows = finSheet.getMaxRows() - 1;
  if (targetRows <= 1) return;

  var matrix = [];
  for (var r = 0; r < targetRows; r++) matrix.push(validations[0]);
  finSheet.getRange(2, 1, targetRows, lastCol).setDataValidations(matrix);
}

function clearFinanceDataRange_(finSheet, rowCount) {
  var lastCol = finSheet.getLastColumn();
  if (rowCount <= 0) return;
  finSheet.getRange(2, 1, rowCount, lastCol).clearContent();
}

function writeFinancePayloadsSequential_(finSheet, finCols, payloads) {
  var lastCol = finSheet.getLastColumn();
  if (!payloads || !payloads.length) return;

  var out = [];
  for (var i = 0; i < payloads.length; i++) {
    var p = payloads[i];
    var row = new Array(lastCol);
    for (var c = 0; c < lastCol; c++) row[c] = "";

    function set(col, val) { if (col) row[col - 1] = (val === undefined || val === null) ? "" : val; }

    set(finCols.Timestamp, p.Timestamp);
    set(finCols.Email, String(p.Email || "").trim());
    set(finCols.Name, p.Name);
    set(finCols.PaymentMode, p.PaymentMode);
    set(finCols.ProofLink, p.ProofLink);
    set(finCols.RefCode, p.RefCode);
    set(finCols.CouponCode, p.CouponCode);
    set(finCols.GenId, p.GenId);
    set(finCols.RefCount, p.RefCount);
    set(finCols.Cashback, p.Cashback);
    set(finCols.TotalAmount, p.TotalAmount);
    set(finCols.Status, Utils.normalizeStatusValue(p.Status));
    set(finCols.Verifier, p.Verifier);
    set(finCols.PayRef, p.PayRef);
    set(finCols.EmailSent, p.EmailSent);
    set(finCols.SysPaidAt, p.SysPaidAt);

    out.push(row);
  }

  finSheet.getRange(2, 1, out.length, lastCol).setValues(out);
}

// ============================================================================
// PART 11.7: HELPER - FIND EMAIL FROM ACTIVE ROW (FOR FORCE REPROCESS)
// ============================================================================

function getHeaderMap_(sheet) {
  var lastCol = sheet.getLastColumn();
  if (lastCol < 1) return {};
  var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  var map = {};
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i] || "").trim();
    if (h) map[h.toUpperCase()] = i + 1;
  }
  return map;
}

function findEmailFromActiveRow_() {
  var sheet = SpreadsheetApp.getActiveSheet();
  var row = sheet.getActiveCell().getRow();
  if (row < 2) return "";

  var map = getHeaderMap_(sheet);
  var candidates = ["EMAIL", "E-MAIL", "EMAIL ADDRESS", "GMAIL", "MAIL"];
  var emailCol = null;
  for (var i = 0; i < candidates.length; i++) {
    if (map[candidates[i]]) { emailCol = map[candidates[i]]; break; }
  }
  if (!emailCol) return "";

  return String(sheet.getRange(row, emailCol).getValue() || "").trim();
}

function reprocessRegistrationRowByEmail_(email) {
  email = String(email || "").trim();
  if (!email) throw new Error("No email provided to reprocess.");

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  if (!regSheet) throw new Error("Registration sheet not found.");

  var regRowIndex = repo.findRegistrationRowIndexByEmail(email);
  if (!regRowIndex) throw new Error("Registration row not found for email: " + email);

  handleSubmission({ range: regSheet.getRange(regRowIndex, 1) });
  return regRowIndex;
}

