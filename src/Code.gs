// ============================================================================

var BatchWriter = (function() {
  /**
   * Writes multiple cells to a sheet in a single operation
   * @param {Sheet} sheet - The sheet to write to
   * @param {number} row - The row number
   * @param {Object} updates - Object mapping column numbers to values
   */
  function writeRow(sheet, row, updates) {
    var lastCol = sheet.getLastColumn();
    var rowData = sheet.getRange(row, 1, 1, lastCol).getValues()[0];
    
    for (var col in updates) {
      if (updates.hasOwnProperty(col)) {
        var colNum = Number(col);
        if (colNum >= 1 && colNum <= lastCol) {
          rowData[colNum - 1] = updates[col];
        }
      }
    }
    
    sheet.getRange(row, 1, 1, lastCol).setValues([rowData]);
  }
  
  /**
   * Writes specific columns to a row
   * @param {Sheet} sheet - The sheet to write to
   * @param {number} row - The row number
   * @param {number} startCol - Starting column
   * @param {Array} values - Array of values to write
   */
  function writeColumns(sheet, row, startCol, values) {
    if (!values || values.length === 0) return;
    sheet.getRange(row, startCol, 1, values.length).setValues([values]);
  }
  
  return {
    writeRow: writeRow,
    writeColumns: writeColumns
  };
})();

