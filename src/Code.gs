var DataIntegrity = (function() {
  /**
   * Validates a registration row has all required data
   */
  function validateRegistrationRow(rowVals) {
    var issues = [];
    
    var email = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
    if (!email || !Utils.isValidEmail(email)) {
      issues.push("Invalid or missing email");
    }
    
    var name = rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1];
    if (!name || String(name).trim().length < 2) {
      issues.push("Invalid or missing name");
    }
    
    var competitions = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
    var compCount = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
    if (!competitions && !compCount) {
      issues.push("No competition selection");
    }
    
    return {
      valid: issues.length === 0,
      issues: issues
    };
  }
  
  /**
   * Checks for orphaned finance rows (no matching registration)
   */
  function findOrphanedFinanceRows() {
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    
    if (!regSheet || !finSheet) return [];
    
    var finCols = ColumnManager.getFinanceCols(finSheet);
    
    // Build set of registration emails
    var regEmails = {};
    var regLastRow = regSheet.getLastRow();
    if (regLastRow >= 2) {
      var regData = regSheet.getRange(2, SYSTEM_CONFIG.COLS.REG.EMAIL, regLastRow - 1, 1).getValues();
      for (var i = 0; i < regData.length; i++) {
        var email = Utils.normalizeEmail(regData[i][0]);
        if (email) regEmails[email] = true;
      }
    }
    
    // Find finance rows without matching registration
    var orphans = [];
    var finLastRow = finSheet.getLastRow();
    if (finLastRow >= 2 && finCols.Email) {
      var finData = finSheet.getRange(2, finCols.Email, finLastRow - 1, 1).getValues();
      for (var j = 0; j < finData.length; j++) {
        var finEmail = Utils.normalizeEmail(finData[j][0]);
        if (finEmail && !regEmails[finEmail]) {
          orphans.push({ row: j + 2, email: finEmail });
        }
      }
    }
    
    return orphans;
  }
  
  return {
    validateRegistrationRow: validateRegistrationRow,
    findOrphanedFinanceRows: findOrphanedFinanceRows
  };
})();

