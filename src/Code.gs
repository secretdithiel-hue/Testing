function SheetRepository() {
  this.ss = SpreadsheetApp.getActiveSpreadsheet();
  this._reg = null;
  this._coupon = null;
  this._finance = null;
  this._sub = null;
}

SheetRepository.prototype.getRegistrationSheet = function () {
  if (!this._reg) this._reg = this.ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  return this._reg;
};

SheetRepository.prototype.getCouponSheet = function () {
  if (!this._coupon) this._coupon = this.ss.getSheetByName(SYSTEM_CONFIG.SHEETS.COUPONS);
  return this._coupon;
};

SheetRepository.prototype.getFinanceSheet = function () {
  if (!this._finance) this._finance = this.ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
  return this._finance;
};

SheetRepository.prototype.getRegistrationRow = function (rowIndex) {
  var sheet = this.getRegistrationSheet();
  var width = sheet.getLastColumn();
  return sheet.getRange(rowIndex, 1, 1, width).getValues()[0];
};

SheetRepository.prototype.findRegistrationRowIndexByEmail = function (email) {
  var sheet = this.getRegistrationSheet();
  var target = Utils.normalizeEmail(email);
  if (!sheet || !target) return null;
  var emailCol = SYSTEM_CONFIG.COLS.REG.EMAIL;
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var values = sheet.getRange(2, emailCol, lastRow - 1, 1).getValues();
  for (var i = 0; i < values.length; i++) {
    var cell = Utils.normalizeEmail(values[i][0]);
    if (cell && cell === target) return i + 2;
  }
  return null;
};

SheetRepository.prototype.findFinanceRowIndexByEmail = function (email, finCols) {
  var sheet = this.getFinanceSheet();
  var target = Utils.normalizeEmail(email);
  if (!sheet || !target) return null;
  var emailCol = finCols.Email;
  if (!emailCol) return null;
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var values = sheet.getRange(2, emailCol, lastRow - 1, 1).getValues();
  for (var i = 0; i < values.length; i++) {
    var cell = Utils.normalizeEmail(values[i][0]);
    if (cell && cell === target) return i + 2;
  }
  return null;
};

SheetRepository.prototype.getRegistrationByEmail = function (email) {
  var rowIndex = this.findRegistrationRowIndexByEmail(email);
  if (!rowIndex) return null;
  var rowVals = this.getRegistrationRow(rowIndex);
  return {
    rowIndex: rowIndex,
    email: rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1],
    name: rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1],
    school: rowVals[SYSTEM_CONFIG.COLS.REG.SCHOOL - 1],
    payMode: rowVals[SYSTEM_CONFIG.COLS.REG.PAY_MODE - 1],
    competitions: rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1],
    genId: rowVals[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1],
    masterSubject: rowVals[SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT - 1],
    couponCode: rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1],
    refInput: rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1],
    cashback: Number(rowVals[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0),
    finalAmount: Number(rowVals[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0)
  };
};

SheetRepository.prototype.isValidReferralCode = function (code, excludeRowIndex) {
  var sheet = this.getRegistrationSheet();
  var target = Utils.upper(code);
  if (!sheet || !target) return false;
  var idCol = SYSTEM_CONFIG.COLS.REG.GEN_ID;
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return false;
  var idValues = sheet.getRange(2, idCol, lastRow - 1, 1).getValues();
  for (var i = 0; i < idValues.length; i++) {
    var cell = Utils.upper(idValues[i][0]);
    if (cell && cell === target) {
      var rowIndex = i + 2;
      return rowIndex !== excludeRowIndex;
    }
  }
  return false;
};

SheetRepository.prototype.findRegistrationRowIndexByGenId = function (genId) {
  var sheet = this.getRegistrationSheet();
  var target = Utils.upper(genId);
  if (!sheet || !target) return null;
  var idCol = SYSTEM_CONFIG.COLS.REG.GEN_ID;
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return null;
  var vals = sheet.getRange(2, idCol, lastRow - 1, 1).getValues();
  for (var i = 0; i < vals.length; i++) {
    var cell = Utils.upper(vals[i][0]);
    if (cell && cell === target) return i + 2;
  }
  return null;
};

// Get referrer's email by their GenID (referral code)
SheetRepository.prototype.getReferrerEmailByGenId = function (genId) {
  if (!genId) return null;
  var regSheet = this.getRegistrationSheet();
  if (!regSheet) return null;

  var target = Utils.upper(genId);
  var lastRow = regSheet.getLastRow();
  if (lastRow < 2) return null;

  var data = regSheet.getRange(2, 1, lastRow - 1, Math.max(SYSTEM_CONFIG.COLS.REG.GEN_ID, SYSTEM_CONFIG.COLS.REG.EMAIL)).getValues();
  for (var i = 0; i < data.length; i++) {
    if (Utils.upper(data[i][SYSTEM_CONFIG.COLS.REG.GEN_ID - 1]) === target) {
      return data[i][SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
    }
  }
  return null;
};

// Get referrer's name by their GenID (referral code)
SheetRepository.prototype.getReferrerNameByGenId = function (genId) {
  if (!genId) return null;
  var regSheet = this.getRegistrationSheet();
  if (!regSheet) return null;

  var target = Utils.upper(genId);
  var lastRow = regSheet.getLastRow();
  if (lastRow < 2) return null;

  var data = regSheet.getRange(2, 1, lastRow - 1, Math.max(SYSTEM_CONFIG.COLS.REG.GEN_ID, SYSTEM_CONFIG.COLS.REG.NAME)).getValues();
  for (var i = 0; i < data.length; i++) {
    if (Utils.upper(data[i][SYSTEM_CONFIG.COLS.REG.GEN_ID - 1]) === target) {
      return data[i][SYSTEM_CONFIG.COLS.REG.NAME - 1];
    }
  }
  return null;
};

