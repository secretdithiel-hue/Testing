function V22_merge_searchParticipants(query) {
  try {
    query = String(query || "").toLowerCase().trim();
    Logger.log("[MERGE_DEBUG] searchParticipants called, query='" + query + "'");
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    Logger.log("[MERGE_DEBUG] regSheet found: " + !!regSheet);
    if (!regSheet) {
      throw new Error("Registration sheet '" + SYSTEM_CONFIG.SHEETS.REGISTRATION + "' not found. Check SYSTEM_CONFIG.SHEETS.REGISTRATION.");
    }
    Logger.log("[MERGE_DEBUG] Sheet name: " + regSheet.getName() + ", lastRow: " + regSheet.getLastRow() + ", lastCol: " + regSheet.getLastColumn());

    // Ensure merge cols exist? NO - search should not mutate structure.
    var mergeCols = (function () {
      var map = ColumnManager.headerMap(regSheet) || {};
      var cols = {};
      cols[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID] = map[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID] || null;
      cols[V22_CONFIG.MERGE.REG_HEADERS.ROLE] = map[V22_CONFIG.MERGE.REG_HEADERS.ROLE] || null;
      cols["SYS_MERGE_MANUAL_TOTAL"] = map["SYS_MERGE_MANUAL_TOTAL"] || null;
      cols["SYS_MERGE_BUNDLE_INFO"] = map["SYS_MERGE_BUNDLE_INFO"] || null;
      return cols;
    })();

    var lastRow = regSheet.getLastRow();
    Logger.log("[MERGE_DEBUG] lastRow: " + lastRow);
    if (lastRow < 2) {
      Logger.log("[MERGE_DEBUG] EARLY RETURN: lastRow < 2, sheet appears empty");
      return [];
    }

    var lastCol = regSheet.getLastColumn();
    var values = regSheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
    Logger.log("[MERGE_DEBUG] Loaded " + values.length + " data rows, " + lastCol + " cols");

    var out = [];
    for (var i = 0; i < values.length; i++) {
      var row = values[i];
      var email = Utils.normalizeEmail(row[SYSTEM_CONFIG.COLS.REG.EMAIL - 1]);
      if (!email) continue;

      var name = String(row[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "").trim();
      var genId = String(row[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "").trim();
      var competitions = String(row[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "").trim();
      var finalAmount = Number(row[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);

      var hay = (email + " " + name + " " + genId).toLowerCase();
      
      // Support multiple comma-separated search terms (OR logic)
      var tokens = query.split(/[\s,]+/).filter(function(t){ return t.trim().length > 0; });
      var match = false;
      if (tokens.length === 0) match = true;
      else {
        for(var k=0; k<tokens.length; k++){
          if(hay.indexOf(tokens[k]) > -1) { match = true; break; }
        }
      }
      
      if (!match && tokens.length > 0) continue;

      var gid = "";
      var role = "";
      if (mergeCols[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID]) {
        gid = String(row[mergeCols[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID] - 1] || "").trim();
      }
      if (mergeCols[V22_CONFIG.MERGE.REG_HEADERS.ROLE]) {
        role = String(row[mergeCols[V22_CONFIG.MERGE.REG_HEADERS.ROLE] - 1] || "").trim();
      }

      var manualTotal = "";
      var bundleInfo = "";
      if (mergeCols["SYS_MERGE_MANUAL_TOTAL"]) {
        manualTotal = String(row[mergeCols["SYS_MERGE_MANUAL_TOTAL"] - 1] || "").trim();
      }
      if (mergeCols["SYS_MERGE_BUNDLE_INFO"]) {
        bundleInfo = String(row[mergeCols["SYS_MERGE_BUNDLE_INFO"] - 1] || "").trim();
      }

      out.push({
        email: email,
        name: name,
        genId: genId,
        competitions: competitions,
        finalAmount: finalAmount,
        mergeGroupId: gid,
        mergeRole: role,
        manualTotal: manualTotal,
        bundleInfo: bundleInfo
      });

      if (out.length >= 200) break;
    }

    // V23: Second pass — propagate primary's manualTotal/bundleInfo to all group members
    var groupSettings = {};
    for (var gi = 0; gi < out.length; gi++) {
      var item = out[gi];
      if (!item.mergeGroupId) continue;
      if (item.mergeRole && item.mergeRole.toUpperCase().indexOf("PRIMARY") === 0) {
        if (!groupSettings[item.mergeGroupId]) groupSettings[item.mergeGroupId] = {};
        if (item.manualTotal) groupSettings[item.mergeGroupId].manualTotal = item.manualTotal;
        if (item.bundleInfo) groupSettings[item.mergeGroupId].bundleInfo = item.bundleInfo;
      }
    }
    for (var gj = 0; gj < out.length; gj++) {
      var it = out[gj];
      if (!it.mergeGroupId || !groupSettings[it.mergeGroupId]) continue;
      var gs = groupSettings[it.mergeGroupId];
      if (!it.manualTotal && gs.manualTotal) it.manualTotal = gs.manualTotal;
      if (!it.bundleInfo && gs.bundleInfo) it.bundleInfo = gs.bundleInfo;
    }

    return out;
  } catch (e) {
    throw new Error("Search failed: " + e.message);
  }
}

function V22_merge_previewGroupReceipt(payload) {
  payload = payload || {};
  var emails = payload.emails || [];
  var primary = payload.primaryEmail || (emails[0] || "");
  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  if (!regSheet) return "<div class='muted'>Missing Registration sheet.</div>";

  // Build temporary group object from selected rows (no writes)
  var uniq = {};
  (emails || []).forEach(function (e) { var n = Utils.normalizeEmail(e); if (n) uniq[n] = true; });
  var list = Object.keys(uniq);
  if (list.length < 2) return "<div class='muted'>Select at least 2 participants.</div>";

  var participants = [];
  var total = 0;
  list.forEach(function (email) {
    var rowIndex = repo.findRegistrationRowIndexByEmail(email);
    if (!rowIndex) return;
    var rowVals = repo.getRegistrationRow(rowIndex);
    participants.push({
      email: Utils.normalizeEmail(email),
      name: String(rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "").trim(),
      genId: String(rowVals[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "").trim(),
      competitions: String(rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "").trim(),
      finalAmount: Number(rowVals[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0),
      role: (Utils.normalizeEmail(email) === Utils.normalizeEmail(primary)) ? MergeService.ROLES.PRIMARY : MergeService.ROLES.MEMBER
    });
    total += Number(rowVals[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
  });

  var groupId = (payload.groupId || "").trim() || "MTX-PREVIEW";
  var groupObj = {
    groupId: groupId,
    receiptId: groupId,
    primaryEmail: Utils.normalizeEmail(primary),
    participants: participants,
    total: total
  };

  if (payload.manualTotal) {
    var m = Number(payload.manualTotal);
    if (!isNaN(m)) groupObj.total = m;
  }

  var primary = null;
    for (var pi = 0; pi < groupObj.participants.length; pi++) {
      if (String(groupObj.participants[pi].role || "").toUpperCase().indexOf("PRIMARY") >= 0) { primary = groupObj.participants[pi]; break; }
    }
    if (!primary) primary = groupObj.participants[0];
    var html = MergeService.buildGroupReceiptHtml_(groupObj, primary, { payRef: (payload.payRef || ""), verifier: "", paidAt: new Date(), preview: true });
  return html;
}

function V22_merge_previewGroupRegReceived(payload) {
  payload = payload || {};
  var emails = payload.emails || [];
  var primary = payload.primaryEmail || (emails[0] || "");
  var total = 0;
  
  if (payload.manualTotal) {
    total = Number(payload.manualTotal) || 0;
  } else {
    var repo = new SheetRepository();
    var list = [];
    emails.forEach(function(e){
       var row = repo.findRegistrationRowIndexByEmail(e);
       if(row) list.push(repo.getRegistrationRow(row));
    });
    list.forEach(function(r){
      total += Number(r[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
