 * Server-side: Query recipients from Form 1 and/or Form 2 based on filters.
 * @param {Object} filters - { source, paymentStatus, competitions[], regions[], submissionStatus, selectedOnly }
 * @returns {Object} { recipients: [{email, name, genId, competition, school, region, participantNum}], count, errors }
 */
function getAnnouncementRecipients(filters) {
  try {
    filters = filters || {};
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var source = filters.source || "form1";
    var recipientMap = {}; // keyed by email to deduplicate

    // Payment filter sent by the dialog: "" (any), PAID, PENDING or FREE
    // (older saved drafts may hold "all" / "paid" / "unpaid").
    var payFilter = String(filters.paymentStatus || "").trim().toLowerCase();
    if (payFilter === "all") payFilter = "";
    if (payFilter === "unpaid") payFilter = "pending";
    var paidLookup = payFilter ? getPaidEmailLookup_() : null;
    function passesPayFilter_(addr, fallbackStatus) {
      if (!payFilter) return true;
      var isPaid = paidLookup.isPaid(addr, fallbackStatus);
      var isFree = paidLookup.isFree(addr);
      if (payFilter === "paid") return isPaid;
      if (payFilter === "pending") return !isPaid && !isFree;
      if (payFilter === "free") return isFree;
      return true;
    }

    // Submission filter sent by the dialog: "" (any), "submitted" (has a submission) or "none".
    // Any other value is matched against the submission's status (PROCESSED, FLAGGED...).
    var subFilter = String(filters.submissionStatus || "").trim().toLowerCase();
    if (subFilter === "all") subFilter = "";
    var submittedEmails = (subFilter === "submitted" || subFilter === "none") ? getSubmittedEmailSet_() : null;
    function passesSubFilter_(addr) {
      if (!submittedEmails) return true;
      return subFilter === "submitted" ? !!submittedEmails[addr] : !submittedEmails[addr];
    }

    // ----- Form 1 (Registration) -----
    if (source === "form1" || source === "both") {
      var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
      if (regSheet && regSheet.getLastRow() > 1) {
        var R = SYSTEM_CONFIG.COLS.REG;
        var regData = regSheet.getRange(2, 1, regSheet.getLastRow() - 1, regSheet.getLastColumn()).getValues();
        for (var i = 0; i < regData.length; i++) {
          var email = String(regData[i][R.EMAIL - 1] || "").trim().toLowerCase();
          if (!email || email.indexOf("@") < 0) continue;
          var name = String(regData[i][R.NAME - 1] || "").trim();
          var genId = String(regData[i][R.GEN_ID - 1] || "").trim();
          var payStatus = String(regData[i][R.PAYMENT_STATUS - 1] || "").trim().toUpperCase();
          var comp = String(regData[i][R.COMPETITION - 1] || "").trim();
          var school = String(regData[i][R.SCHOOL - 1] || "").trim();
          var region = String(regData[i][R.REGION - 1] || "").trim();

          // Payment + submission filters
          if (!passesPayFilter_(email, payStatus)) continue;
          if (!passesSubFilter_(email)) continue;
          // Competition filter
          if (filters.competitions && filters.competitions.length > 0) {
            var compUpper = comp.toUpperCase();
            var matchesComp = false;
            for (var fc = 0; fc < filters.competitions.length; fc++) {
              if (compUpper.indexOf(filters.competitions[fc].toUpperCase()) >= 0) { matchesComp = true; break; }
            }
            if (!matchesComp) continue;
          }
          // Region filter
          if (filters.regions && filters.regions.length > 0) {
            var regionUpper = region.toUpperCase();
            var matchesRegion = false;
            for (var fr = 0; fr < filters.regions.length; fr++) {
              if (regionUpper.indexOf(filters.regions[fr].toUpperCase()) >= 0) { matchesRegion = true; break; }
            }
            if (!matchesRegion) continue;
          }

          if (!recipientMap[email]) {
            recipientMap[email] = { email: email, name: name, genId: genId, competition: comp, school: school, region: region, participantNum: "", source: "Form 1" };
          }
        }
      }
    }

    // ----- Form 2 (Submissions) -----
    if (source === "form2" || source === "both") {
      var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
      if (subSheet && subSheet.getLastRow() > 1) {
        var S = SYSTEM_CONFIG.COLS.SUB;
        var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
        var subData = subSheet.getRange(2, 1, subSheet.getLastRow() - 1, subSheet.getLastColumn()).getValues();
        for (var j = 0; j < subData.length; j++) {
          var sEmail = String(subData[j][S.EMAIL - 1] || "").trim().toLowerCase();
          if (!sEmail || sEmail.indexOf("@") < 0) continue;

          var sPartNum = sysCols["SYS_PARTICIPANT_NUM"] ? String(subData[j][sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
          var sStatus = sysCols["SYS_SUB_STATUS"] ? String(subData[j][sysCols["SYS_SUB_STATUS"] - 1] || "").trim().toUpperCase() : "";
          var sComp = getSubmissionCompetitionTypes_(subData[j]).join(", ");

          // Payment + submission filters
          if (!passesPayFilter_(sEmail, "")) continue;
          if (!passesSubFilter_(sEmail)) continue;
          if (subFilter && !submittedEmails && sStatus !== subFilter.toUpperCase()) continue;
          // Competition filter
          if (filters.competitions && filters.competitions.length > 0) {
            var sCompUpper = sComp.toUpperCase();
            var sMatchesComp = false;
            for (var sc = 0; sc < filters.competitions.length; sc++) {
              if (sCompUpper.indexOf(filters.competitions[sc].toUpperCase()) >= 0) { sMatchesComp = true; break; }
            }
            if (!sMatchesComp) continue;
          }

          // Try to get the best name from the form data
          var sName = "";
          var sSchool = "";
          var sRegion = "";
          var compMapKeys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
          for (var ck = 0; ck < compMapKeys.length; ck++) {
            var cm = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compMapKeys[ck]];
            if (cm.nameCol && S[cm.nameCol]) {
              var n = String(subData[j][S[cm.nameCol] - 1] || "").trim();
              if (n && !sName) sName = n;
            }
            if (cm.schoolCol && S[cm.schoolCol]) {
              var sc2 = String(subData[j][S[cm.schoolCol] - 1] || "").trim();
              if (sc2 && !sSchool) sSchool = sc2;
            }
            if (cm.regionCol && S[cm.regionCol]) {
              var rg = String(subData[j][S[cm.regionCol] - 1] || "").trim();
              if (rg && !sRegion) sRegion = rg;
            }
          }

          if (!recipientMap[sEmail]) {
            recipientMap[sEmail] = { email: sEmail, name: sName, genId: "", competition: sComp, school: sSchool, region: sRegion, participantNum: sPartNum, source: "Form 2" };
          } else {
            // Enrich existing entry
            if (sPartNum && !recipientMap[sEmail].participantNum) recipientMap[sEmail].participantNum = sPartNum;
            if (sName && !recipientMap[sEmail].name) recipientMap[sEmail].name = sName;
          }
        }
      }
    }

    var recipients = [];
    var keys = Object.keys(recipientMap);
    for (var rk = 0; rk < keys.length; rk++) {
      recipients.push(recipientMap[keys[rk]]);
    }
    recipients.sort(function(a, b) { return a.name.localeCompare(b.name); });


    // specificEmails filter: if the user typed specific email chips, return only those
    if (filters.specificEmails && filters.specificEmails.length > 0) {
      var specSet = {};
      for (var sp = 0; sp < filters.specificEmails.length; sp++) specSet[filters.specificEmails[sp]] = true;
      recipients = recipients.filter(function(r) { return specSet[r.email.toLowerCase()]; });
      // Also handle emails typed directly that may not be in sheet — add them as bare recipients
      for (var se = 0; se < filters.specificEmails.length; se++) {
        var seVal = filters.specificEmails[se];
        if (!recipients.some(function(r){ return r.email === seVal; })) {
          recipients.push({ email: seVal, name: seVal, genId: "", competition: "", school: "", region: "", participantNum: "", source: "Manual" });
        }
      }
    }

    return { recipients: recipients, count: recipients.length, errors: [] };
  } catch (err) {
    return { recipients: [], count: 0, errors: [err.toString()] };
  }
}

/**
 * Server-side: Build the announcement email HTML.
 */
function buildAnnouncementHtml_(category, subject, body, recipientData) {
  var BLUE = SYSTEM_CONFIG.BRAND.INDIGO;
  var GOLD = SYSTEM_CONFIG.BRAND.YELLOW;
  var contactConfig = SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.CONTACT || {};
  var esc = Utils.escapeHtml;

  // Category banner colors
  var banners = {
    general:     { color: SYSTEM_CONFIG.BRAND.INDIGO, icon: "📢", label: "GENERAL ANNOUNCEMENT" },
    reminder:    { color: "#D97706", icon: "⏰", label: "DEADLINE REMINDER" },
    competition: { color: "#7C3AED", icon: "🏆", label: "COMPETITION UPDATE" },
    payment:     { color: "#059669", icon: "💰", label: "PAYMENT NOTICE" },
    custom:      { color: "#475569", icon: "✉️", label: "ANNOUNCEMENT" }
  };
  var banner = banners[category] || banners.custom;

  // Merge field replacement
  var mergedBody = body
    .replace(/\{\{NAME\}\}/gi, esc(recipientData.name || "Participant"))
    .replace(/\{\{GEN_ID\}\}/gi, esc(recipientData.genId || "N/A"))
    .replace(/\{\{COMPETITION\}\}/gi, esc(recipientData.competition || "N/A"))
    .replace(/\{\{SCHOOL\}\}/gi, esc(recipientData.school || "N/A"))
    .replace(/\{\{REGION\}\}/gi, esc(recipientData.region || "N/A"))
    .replace(/\{\{PARTICIPANT_NUM\}\}/gi, esc(recipientData.participantNum || "N/A"));

  var h = [];
  h.push('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">');
  h.push('<title>' + esc(subject) + '</title></head>');
  h.push('<body style="margin:0;padding:0;background-color:' + SYSTEM_CONFIG.BRAND.CREAM + ';font-family:Verdana,Geneva,sans-serif;">');
  h.push('<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:' + SYSTEM_CONFIG.BRAND.CREAM + ';"><tr><td align="center" style="padding:20px 10px;">');
  h.push('<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#fffdf7;border:3px solid ' + SYSTEM_CONFIG.BRAND.INDIGO + ';border-radius:16px;overflow:hidden;">');

  // Header (shared)
  h.push('<tr><td>');
  h.push('<div style="background-color:' + BLUE + ';padding:16px 10px;text-align:center;border-bottom:6px solid ' + GOLD + ';">');
  h.push('<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 auto;max-width:600px;">');
  h.push('<tr>');
  h.push('<td width="20%" align="center" valign="middle" style="padding:0 5px;"><img src="cid:uplb_logo" alt="' + Utils.escapeHtml(SYSTEM_CONFIG.META.ORG) + '" data-logo="org" style="max-width:70px;height:auto;display:block;margin:0 auto;"></td>');
  h.push('<td width="60%" align="center" valign="middle" style="padding:0 5px;">');
  h.push('<div style="color:' + GOLD + ';font-family:' + SYSTEM_CONFIG.BRAND.EMAIL_TITLE_FONT + ';font-size:24px;letter-spacing:2px;font-weight:800;">' + getEventTitleHtml_() + '</div>');
  h.push('<div style="margin-top:4px;color:#ffffff;font-size:11px;letter-spacing:1px;">' + getOrgTitleHtml_() + '</div>');
  h.push('</td>');
  h.push('<td width="20%" align="center" valign="middle" style="padding:0 5px;"><img src="cid:husay_logo" alt="' + Utils.escapeHtml(SYSTEM_CONFIG.META.NAME) + '" data-logo="event" style="max-width:70px;height:auto;display:block;margin:0 auto;"></td>');
  h.push('</tr></table></div>');
  h.push('</td></tr>');

  // Category Banner
  h.push('<tr><td>');
  h.push('<div style="background:' + banner.color + ';padding:14px 20px;text-align:center;">');
  h.push('<span style="color:#ffffff;font-size:16px;font-weight:bold;letter-spacing:1px;">' + banner.icon + ' ' + banner.label + '</span>');
  h.push('</div></td></tr>');



  // Body content
  h.push('<tr><td style="padding:16px 30px 20px;">');
  h.push('<div style="font-size:14px;line-height:1.6;color:#1e293b;">');
  h.push(mergedBody);
  h.push('</div>');
  h.push('</td></tr>');

  // Sign-off (custom from UI)
  if (recipientData._signoff) {
    h.push('<tr><td style="padding:0 30px 20px;">');
    h.push('<div style="font-size:14px;color:#1e293b;margin:16px 0 4px;line-height:1.6;">' + recipientData._signoff + '</div>');
    h.push('</td></tr>');
  }

  // Divider
  h.push('<tr><td style="padding:0 30px;"><hr style="border:none;border-top:1px solid #e2e8f0;margin:0;"></td></tr>');

  // Contact footer
  h.push('<tr><td style="padding:16px 30px 24px;">');
  h.push('<p style="font-size:11px;color:#64748b;margin:0;text-align:center;">');
  if (contactConfig.EMAIL) h.push('📧 ' + esc(contactConfig.EMAIL) + '<br>');
  if (contactConfig.FACEBOOK) h.push('📘 ' + esc(contactConfig.FACEBOOK) + '<br>');
  if (contactConfig.INSTAGRAM) h.push('📸 ' + esc(contactConfig.INSTAGRAM));
  h.push('</p></td></tr>');

  h.push('</table></td></tr></table></body></html>');
  return h.join('');
}

/**
 * Server-side: Generate a preview email for a sample recipient.
 */
function previewAnnouncementEmail(config) {
  try {
    var sampleRecipient = {
      name: config.sampleName || "Juan Dela Cruz",
      genId: "REF-SAMPLE01",
      competition: config.sampleCompetition || (getCompetitions_()[0] || {}).registrationName || "",
      school: "University of the Philippines Los Baños",
      region: "Region IV-A (CALABARZON)",
      participantNum: sampleParticipantNumber_((getCompetitions_()[0] || {}).key, 1),
      _signoff: config.signoff || ""
    };
    var html = buildAnnouncementHtml_(config.category, config.subject, config.body, sampleRecipient);
    return { success: true, html: html };
  } catch (err) {
