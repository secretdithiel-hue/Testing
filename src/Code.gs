/**
 * Generate member ambassador codes
 */
function generateMemberCodes(options) {
  var sheet = new SheetRepository().getCouponSheet();
  if (!sheet) throw new Error("Coupon sheet not found.");
  
  var nameLines = options.names.split("\n").filter(function(n) { return n.trim() !== ""; });
  if (nameLines.length === 0) throw new Error("No valid names provided.");
  
  var prefix = Utils.upper(options.prefix || "SOK");
  var discount = Number(options.discount) || SYSTEM_CONFIG.MEMBER_COUPON.DEFAULT_DISCOUNT;
  var maxUses = Number(options.maxUses) || SYSTEM_CONFIG.MEMBER_COUPON.DEFAULT_MAX_USES;
  var validityMonths = Number(options.validityMonths) || 3;
  
  var today = new Date();
  var endDate = new Date();
  endDate.setMonth(endDate.getMonth() + validityMonths);
  
  // Load existing codes to check for duplicates
  var existingData = sheet.getDataRange().getValues();
  var existingCodes = {};
  for (var i = 1; i < existingData.length; i++) {
    existingCodes[Utils.upper(existingData[i][0])] = true;
  }
  
  var newRows = [];
  var generated = [];
  
  for (var i = 0; i < nameLines.length; i++) {
    var fullName = nameLines[i].trim();
    var firstName = fullName.split(" ")[0];
    var code = prefix + "-" + Utils.upper(firstName);
    
    // Handle duplicates by adding number suffix
    var baseCode = code;
    var counter = 1;
    while (existingCodes[code]) {
      counter++;
      code = baseCode + counter;
    }
    
    existingCodes[code] = true;
    
    // [CODE, VALUE, START, END, MAX_USE, CURRENT_USE, STATUS, TYPE, OWNER]
    newRows.push([code, discount, today, endDate, maxUses, 0, "ACTIVE", "MEMBER", fullName]);
    generated.push(code + " → " + fullName);
  }
  
  ensureCouponHeaders_(sheet);
  sheet.getRange(sheet.getLastRow() + 1, 1, newRows.length, 9).setValues(newRows);
  
  AuditLogService.info("MEMBER_CODES", "Generated " + newRows.length + " member codes");
  
  return "✅ Generated " + newRows.length + " member code(s):\n\n" + generated.join("\n");
}

/**
 * Calculate member compensation based on usage
 */
function calculateMemberCompensation(uses) {
  var config = SYSTEM_CONFIG.MEMBER_COUPON;
  var compensation = 0;
  var breakdown = [];
  
  // Calculate tiered compensation
  if (uses >= config.COMPENSATION.TIER_1.MIN) {
    var tier1Uses = Math.min(uses, config.COMPENSATION.TIER_1.MAX);
    var tier1Amount = tier1Uses * config.COMPENSATION.TIER_1.RATE;
    compensation += tier1Amount;
    breakdown.push("Tier 1 (1-5): " + tier1Uses + " × ₱" + config.COMPENSATION.TIER_1.RATE + " = ₱" + tier1Amount);
  }
  
  if (uses >= config.COMPENSATION.TIER_2.MIN) {
    var tier2Uses = Math.min(uses, config.COMPENSATION.TIER_2.MAX) - config.COMPENSATION.TIER_1.MAX;
    if (tier2Uses > 0) {
      var tier2Amount = tier2Uses * config.COMPENSATION.TIER_2.RATE;
      compensation += tier2Amount;
      breakdown.push("Tier 2 (6-10): " + tier2Uses + " × ₱" + config.COMPENSATION.TIER_2.RATE + " = ₱" + tier2Amount);
    }
  }
  
  if (uses >= config.COMPENSATION.TIER_3.MIN) {
    var tier3Uses = uses - config.COMPENSATION.TIER_2.MAX;
    if (tier3Uses > 0) {
      var tier3Amount = tier3Uses * config.COMPENSATION.TIER_3.RATE;
      compensation += tier3Amount;
      breakdown.push("Tier 3 (11+): " + tier3Uses + " × ₱" + config.COMPENSATION.TIER_3.RATE + " = ₱" + tier3Amount);
    }
  }
  
  // Add milestone bonuses
  var milestones = config.MILESTONES;
  var bonuses = 0;
  for (var milestone in milestones) {
    if (uses >= Number(milestone)) {
      bonuses += milestones[milestone];
      breakdown.push("Bonus at " + milestone + " uses: ₱" + milestones[milestone]);
    }
  }
  
  return {
    uses: uses,
    baseCompensation: compensation,
    bonuses: bonuses,
    totalCompensation: compensation + bonuses,
    breakdown: breakdown
  };
}

/**
 * Export Member Compensation Report
 */
function exportMemberCompensationReport() {
  SpreadsheetApp.getActiveSpreadsheet().toast("Generating report...", "📊 Please wait", -1);
  
  var repo = new SheetRepository();
  var couponSheet = repo.getCouponSheet();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  
  if (!couponSheet) {
    SpreadsheetApp.getUi().alert("Coupon sheet not found.");
    return;
  }
  
  var data = couponSheet.getDataRange().getValues();
  var headers = data[0];
  
  // Find columns
  var codeCol = 0, valueCol = 1, currentUseCol = 5, statusCol = 6, typeCol = 7, ownerCol = 8;
  for (var h = 0; h < headers.length; h++) {
    var header = String(headers[h]).toUpperCase().trim();
    if (header === "CODE") codeCol = h;
    if (header === "VALUE") valueCol = h;
    if (header === "CURRENT USE" || header === "CURRENT_USE") currentUseCol = h;
    if (header === "STATUS") statusCol = h;
    if (header === "TYPE") typeCol = h;
    if (header === "OWNER") ownerCol = h;
  }
  
  // Collect member codes
  var memberData = [];
  var totalUses = 0;
  var totalCompensation = 0;
  var totalDiscount = 0;
  
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var type = String(row[typeCol] || "").toUpperCase().trim();
    
    if (type === "MEMBER") {
      var code = String(row[codeCol] || "");
      var owner = String(row[ownerCol] || code);
      var uses = Number(row[currentUseCol] || 0);
      var discountValue = Number(row[valueCol] || 0);
      var status = String(row[statusCol] || "");
      
      var comp = calculateMemberCompensation(uses);
      
      memberData.push({
        code: code,
        owner: owner,
        uses: uses,
        discountGiven: uses * discountValue,
        baseCompensation: comp.baseCompensation,
        bonuses: comp.bonuses,
        totalCompensation: comp.totalCompensation,
        status: status
      });
      
      totalUses += uses;
      totalCompensation += comp.totalCompensation;
      totalDiscount += uses * discountValue;
    }
  }
  
  // Sort by uses (highest first)
  memberData.sort(function(a, b) { return b.uses - a.uses; });
  
  // Create or get report sheet
  var reportName = "Member Compensation Report";
  var report = ss.getSheetByName(reportName);
  if (!report) {
    report = ss.insertSheet(reportName);
  }
  report.clearContents();
  
  // Write header
  var reportHeaders = [
    "Member Name", "Code", "Uses", "Discount Given (₱)", 
    "Base Compensation (₱)", "Bonuses (₱)", "Total Due (₱)", "Status"
  ];
  report.getRange(1, 1, 1, reportHeaders.length).setValues([reportHeaders]);
  report.getRange(1, 1, 1, reportHeaders.length).setFontWeight("bold").setBackground("#1E4FB8").setFontColor("white");
  
  // Write data
  if (memberData.length > 0) {
    var reportRows = memberData.map(function(m) {
      return [m.owner, m.code, m.uses, m.discountGiven, m.baseCompensation, m.bonuses, m.totalCompensation, m.status];
    });
    report.getRange(2, 1, reportRows.length, reportHeaders.length).setValues(reportRows);
    
    // Add totals row
    var totalsRow = memberData.length + 2;
    report.getRange(totalsRow, 1, 1, reportHeaders.length).setValues([[
      "TOTAL (" + memberData.length + " members)", "", totalUses, totalDiscount, "", "", totalCompensation, ""
    ]]);
    report.getRange(totalsRow, 1, 1, reportHeaders.length).setFontWeight("bold").setBackground("#FEF3C7");
    
    // Format currency columns
    report.getRange(2, 4, memberData.length + 1, 4).setNumberFormat("₱#,##0.00");
  }
  
  // Auto-resize columns
  report.autoResizeColumns(1, reportHeaders.length);
  
  // Add summary at top
  report.insertRowsBefore(1, 5);
  report.getRange(1, 1).setValue("MEMBER AMBASSADOR COMPENSATION REPORT").setFontSize(14).setFontWeight("bold");
  report.getRange(2, 1).setValue("Generated: " + Utils.nowTzString()).setFontColor("#666");
  report.getRange(3, 1).setValue("Total Members: " + memberData.length + " | Total Uses: " + totalUses).setFontColor("#666");
  report.getRange(4, 1).setValue("Total Compensation Due: ₱" + totalCompensation.toLocaleString()).setFontWeight("bold").setFontColor("#059669");
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "📊", 2);
  
  SpreadsheetApp.getUi().alert(
    "✅ Member Compensation Report Generated!\n\n" +
    "Summary:\n" +
    "• Total Members: " + memberData.length + "\n" +
    "• Total Uses: " + totalUses + "\n" +
    "• Total Discount Given: ₱" + totalDiscount.toLocaleString() + "\n" +
    "• Total Compensation Due: ₱" + totalCompensation.toLocaleString() + "\n\n" +
    "View the '" + reportName + "' sheet for details."
  );
  
  // Activate the report sheet
  report.activate();
}

/**
 * View member code statistics
 */
function viewMemberCodeStats() {
  var repo = new SheetRepository();
  var couponSheet = repo.getCouponSheet();
  
  if (!couponSheet) {
    SpreadsheetApp.getUi().alert("Coupon sheet not found.");
    return;
  }
  
  var data = couponSheet.getDataRange().getValues();
  var headers = data[0];
  
  // Find columns
  var typeCol = -1, currentUseCol = -1, statusCol = -1;
  for (var h = 0; h < headers.length; h++) {
    var header = String(headers[h]).toUpperCase().trim();
    if (header === "TYPE") typeCol = h;
    if (header === "CURRENT USE" || header === "CURRENT_USE") currentUseCol = h;
    if (header === "STATUS") statusCol = h;
  }
  
  var memberCodes = 0;
  var promoCodes = 0;
  var memberUses = 0;
  var promoUses = 0;
  var activeMember = 0;
  var activePromo = 0;
  
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var type = typeCol >= 0 ? String(row[typeCol] || "").toUpperCase().trim() : "";
    var uses = currentUseCol >= 0 ? Number(row[currentUseCol] || 0) : 0;
    var status = statusCol >= 0 ? String(row[statusCol] || "").toUpperCase().trim() : "";
    
    if (type === "MEMBER") {
      memberCodes++;
      memberUses += uses;
      if (status === "ACTIVE") activeMember++;
    } else {
      promoCodes++;
      promoUses += uses;
      if (status === "ACTIVE") activePromo++;
    }
  }
  
  var totalComp = calculateMemberCompensation(memberUses);
  
  SpreadsheetApp.getUi().alert(
    "📊 COUPON STATISTICS\n\n" +
    "═══ MEMBER CODES ═══\n" +
    "• Total Codes: " + memberCodes + " (" + activeMember + " active)\n" +
    "• Total Uses: " + memberUses + "\n" +
    "• Est. Total Compensation: ₱" + totalComp.totalCompensation.toLocaleString() + "\n\n" +
    "═══ PROMO CODES ═══\n" +
    "• Total Codes: " + promoCodes + " (" + activePromo + " active)\n" +
    "• Total Uses: " + promoUses + "\n\n" +
    "Use 'Export Member Compensation Report' for detailed breakdown."
  );
}

/**
 * Migrate existing coupons to add TYPE and OWNER columns
 * Run this once to update existing coupon sheet
 */
function migrateCouponSheet() {
  var ui = SpreadsheetApp.getUi();
  var repo = new SheetRepository();
  var couponSheet = repo.getCouponSheet();
  
  if (!couponSheet) {
    return ui.alert("Coupon sheet not found.");
  }
  
  var data = couponSheet.getDataRange().getValues();
  var headers = data[0];
  
  // Check if TYPE column already exists
  var hasTypeCol = false;
  var hasOwnerCol = false;
  for (var h = 0; h < headers.length; h++) {
    var header = String(headers[h]).toUpperCase().trim();
    if (header === "TYPE") hasTypeCol = true;
    if (header === "OWNER") hasOwnerCol = true;
  }
  
  if (hasTypeCol && hasOwnerCol) {
    return ui.alert("✅ Coupon sheet already has TYPE and OWNER columns. No migration needed.");
  }
  
  // Add headers
  var lastCol = headers.length;
  if (!hasTypeCol) {
    couponSheet.getRange(1, lastCol + 1).setValue("Type").setFontWeight("bold").setBackground("#1E4FB8").setFontColor("white");
    lastCol++;
  }
  if (!hasOwnerCol) {
    couponSheet.getRange(1, lastCol + 1).setValue("Owner").setFontWeight("bold").setBackground("#1E4FB8").setFontColor("white");
  }
  
  // Set existing coupons as PROMO type
  var typeColNum = hasTypeCol ? -1 : (headers.length + 1);
  if (typeColNum > 0 && data.length > 1) {
    var promoValues = [];
    for (var i = 1; i < data.length; i++) {
      promoValues.push(["PROMO"]);
    }
    couponSheet.getRange(2, typeColNum, promoValues.length, 1).setValues(promoValues);
  }
  
  ui.alert(
    "✅ Coupon Sheet Migration Complete!\n\n" +
    "Added columns:\n" +
    "• Type - Distinguishes PROMO vs MEMBER codes\n" +
    "• Owner - Stores member name for MEMBER codes\n\n" +
    "All existing coupons marked as 'PROMO' type."
  );
}

