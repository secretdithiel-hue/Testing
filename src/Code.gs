/**
 * Server-side: Scan a row for PII from the dashboard.
 */
function dashScanPii(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];

  var S = SYSTEM_CONFIG.COLS.SUB;
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP;
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var detectedComps = DepersonalizationService.detectCompetitionsFromData(rowVals);
  var allComps = {};
  var compList = [];
  compTypes.concat(detectedComps).forEach(function(c) { if (c && !allComps[c]) { allComps[c] = true; compList.push(c); } });

  var allMatches = [];
  var filesScanned = 0;
  var errors = [];

  for (var ci = 0; ci < compList.length; ci++) {
    var entry = compMap[compList[ci]];
    if (!entry || !entry.scannableCols || entry.scannableCols.length === 0) continue;
    var participantName = "";
    if (entry.nameCol) { var nc = S[entry.nameCol]; if (nc) participantName = String(rowVals[nc - 1] || "").trim(); }
    var schoolName = "";
    if (entry.schoolCol) { var sc = S[entry.schoolCol]; if (sc) schoolName = String(rowVals[sc - 1] || "").trim(); }
    var adviserName = "";
    if (entry.adviserCol) { var ac = S[entry.adviserCol]; if (ac) adviserName = String(rowVals[ac - 1] || "").trim(); }

    for (var fi = 0; fi < entry.scannableCols.length; fi++) {
      var colKey = entry.scannableCols[fi];
      var colNum = S[colKey];
      if (!colNum) continue;
      var cellVal = String(rowVals[colNum - 1] || "").trim();
      if (!cellVal) continue;
      var fileId = DepersonalizationService.extractFileId(cellVal);
      if (!fileId) continue;
      try {
        var scanResult = DepersonalizationService.scanDocumentForPii(fileId, participantName, schoolName, adviserName);
        filesScanned++;
        if (scanResult.flagged) allMatches = allMatches.concat(scanResult.matches);
        if (scanResult.error) errors.push(colKey + ": " + scanResult.error);
      } catch (e) { errors.push(colKey + ": " + e); }
    }
  }

  AuditLogService.info("PII_DASH_SCAN", "Row " + rowIndex + ": " + filesScanned + " files, " + allMatches.length + " matches");
  return { matches: allMatches, filesScanned: filesScanned, errors: errors };
}

