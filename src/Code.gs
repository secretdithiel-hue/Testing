  // Sign-off (custom from UI)
  if (recipientData._signoff) {
    h.push('<tr><td style="padding:0 30px 20px;">');
    h.push('<div style="font-size:14px;color:#1e293b;margin:16px 0 4px;line-height:1.6;">' + recipientData._signoff + '</div>');
    h.push('</td></tr>');
  }

  // Divider
  h.push('<tr><td style="padding:0 30px;"><hr style="border:none;border-top:1px solid #e2e8f0;margin:0;"></td></tr>');

  // Contact footer
