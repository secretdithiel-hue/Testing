    // Step 2: If Step 1 failed, try looking up by referrer code (GenID)
    if (!emailToUse && data && data.referrerCode) {
      AuditLogService.debug("REF_NOTIF_EMAIL_STEP2", 
        "Provided email invalid, attempting lookup for code: " + data.referrerCode);
      
      try {
        var repo = new SheetRepository();
        var lookedUpEmail = repo.getReferrerEmailByGenId(data.referrerCode);
        if (lookedUpEmail && Utils.isValidEmail(lookedUpEmail)) {
          emailToUse = Utils.normalizeEmail(lookedUpEmail);
          emailSource = "lookup_by_genid";
          AuditLogService.info("REF_NOTIF_EMAIL_LOOKUP_SUCCESS", 
            "Found referrer email via lookup: '" + emailToUse + "' for code: " + data.referrerCode);
        } else {
          AuditLogService.warn("REF_NOTIF_EMAIL_LOOKUP_FAIL", 
            "Lookup returned invalid email: '" + lookedUpEmail + "' for code: " + data.referrerCode);
        }
      } catch (lookupErr) {
        AuditLogService.error("REF_NOTIF_EMAIL_LOOKUP_ERROR", 
          "Error looking up referrer email: " + lookupErr);
      }
    }
    
    // Step 3: If Step 2 also failed, try direct sheet lookup
    // V20.0: Also get masterSubject for threading
    var referrerMasterSubject = "";
    if (data && data.referrerCode) {
      if (!emailToUse) {
        AuditLogService.debug("REF_NOTIF_EMAIL_STEP3", 
          "Lookup failed, attempting direct sheet read for code: " + data.referrerCode);
      }
      
      try {
        var repo = new SheetRepository();
        var regSheet = repo.getRegistrationSheet();
        var rowIndex = repo.findRegistrationRowIndexByGenId(data.referrerCode);
        
        if (rowIndex && regSheet) {
          // Get email if not already found
          if (!emailToUse) {
            var directEmail = regSheet.getRange(rowIndex, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
            if (directEmail && Utils.isValidEmail(directEmail)) {
              emailToUse = Utils.normalizeEmail(directEmail);
              emailSource = "direct_sheet_read";
              AuditLogService.info("REF_NOTIF_EMAIL_DIRECT_SUCCESS", 
                "Found referrer email via direct read: '" + emailToUse + "' at row " + rowIndex);
            }
          }
          
          // V20.0: Get referrer's masterSubject for threading
          referrerMasterSubject = regSheet.getRange(rowIndex, SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT).getValue() || "";
          AuditLogService.debug("REF_NOTIF_GOT_SUBJECT", 
            "Got referrer's masterSubject: '" + referrerMasterSubject + "'");
        }
      } catch (directErr) {
        AuditLogService.error("REF_NOTIF_EMAIL_DIRECT_ERROR", 
          "Error in direct sheet read: " + directErr);
      }
    }

    // Final validation
    if (!emailToUse || !Utils.isValidEmail(emailToUse)) {
      AuditLogService.error("REF_NOTIF_NO_EMAIL", 
        "FAILED: Could not obtain valid referrer email after all fallbacks. " +
        "originalEmail='" + referrerEmail + "', " +
        "referrerCode='" + (data ? data.referrerCode : 'N/A') + "'");
      return { sent: false, skipped: true, reason: "Invalid referrer email after all fallbacks" };
    }

    // V20.0: Use referrer's masterSubject for threading, fallback to default
    var subject = referrerMasterSubject || 
                  (SYSTEM_CONFIG.META.NAME + ": Registration [" + data.referrerCode + "]");
    
    AuditLogService.debug("REF_NOTIF_SUBJECT", 
      "Using subject for threading: '" + subject + "'");
    
    var html = EmailBuilder.buildReferralSuccessHtml(data, { preview: false });
    var inlineImages = LogoService.getInlineImages();
    
    // Use a unique identifier for duplicate detection
    var notifId = "REFNOTIF-" + data.referrerCode + "-" + (data.referredGenId || Date.now());
    
    // Use referrerCode (which IS the referrer's GenID) for thread lookup
    // This way the notification goes to the same thread as the referrer's own registration emails
    var threadGenId = data.referrerCode;
    
    AuditLogService.info("REF_NOTIF_SENDING", 
      "Sending referral success notification to: '" + emailToUse + "' (source: " + emailSource + ") " +
      "for code: " + data.referrerCode + " (threadGenId: " + threadGenId + ")");
    
    // isFirstEmail = false (reply to existing thread), threadGenId = referrer's GenID
    return sendWithGuard_(emailToUse, subject, html, notifId, "REFNOTIF_SUCCESS", inlineImages, false, false, threadGenId);
  }

