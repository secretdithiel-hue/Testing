// ============================================================================

var FinanceWriter = (function () {
  function copyTemplateValidations_(finSheet, rowIndex) {
    try {
      var lastCol = finSheet.getLastColumn();
      if (rowIndex < 2) return;
      if (finSheet.getMaxRows() < rowIndex) {
        finSheet.insertRowsAfter(finSheet.getMaxRows(), rowIndex - finSheet.getMaxRows());
      }
      var template = finSheet.getRange(2, 1, 1, lastCol);
      var target = finSheet.getRange(rowIndex, 1, 1, lastCol);
      var validations = template.getDataValidations();
      if (validations && validations.length) target.setDataValidations(validations);
    } catch (e) {
      AuditLogService.warn("FIN_VALIDATION_COPY_FAIL", "Row " + rowIndex + ": " + e);
    }
  }

  function findFirstEmptyEmailRow_(finSheet, finCols) {
    if (!finCols.Email) return null;
    var maxRows = finSheet.getMaxRows();
    if (maxRows < 2) return 2;
    var values = finSheet.getRange(2, finCols.Email, maxRows - 1, 1).getValues();
    for (var i = 0; i < values.length; i++) {
      var cell = String(values[i][0] || "").trim();
      if (!cell) return i + 2;
    }
    return null;
  }

  function upsertByEmail(finSheet, finCols, email, rowPayload) {
    if (!email) return null;
    var repo = new SheetRepository();
    var rowIndex = repo.findFinanceRowIndexByEmail(email, finCols);
    if (rowIndex) {
      copyTemplateValidations_(finSheet, rowIndex);
      writeRow(finSheet, finCols, rowIndex, rowPayload);
      return { action: "UPDATED", rowIndex: rowIndex };
    }
    var emptyRow = findFirstEmptyEmailRow_(finSheet, finCols);
    var newRowIndex = emptyRow || (finSheet.getLastRow() + 1);
    if (newRowIndex > finSheet.getMaxRows()) {
      finSheet.insertRowsAfter(finSheet.getMaxRows(), newRowIndex - finSheet.getMaxRows());
    }
    copyTemplateValidations_(finSheet, newRowIndex);
    writeRow(finSheet, finCols, newRowIndex, rowPayload);
    return { action: "INSERTED", rowIndex: newRowIndex };
  }

  function writeRow(finSheet, finCols, rowIndex, payload) {
    var lastCol = finSheet.getLastColumn();
    var row = new Array(lastCol);
    for (var i = 0; i < lastCol; i++) row[i] = "";
    function set(col, value) {
      if (!col) return;
      row[col - 1] = (value === undefined || value === null) ? "" : value;
    }
    set(finCols.Timestamp, payload.Timestamp);
    set(finCols.Email, String(payload.Email || "").trim());
    set(finCols.Name, payload.Name);
    set(finCols.PaymentMode, payload.PaymentMode);
    set(finCols.ProofLink, payload.ProofLink);
    set(finCols.RefCode, payload.RefCode);
    set(finCols.CouponCode, payload.CouponCode);
    set(finCols.GenId, payload.GenId);
    set(finCols.RefCount, payload.RefCount);
    set(finCols.Cashback, payload.Cashback);
    set(finCols.TotalAmount, payload.TotalAmount);
    set(finCols.Status, Utils.normalizeStatusValue(payload.Status));
    set(finCols.Verifier, payload.Verifier);
    set(finCols.PayRef, payload.PayRef);
    set(finCols.EmailSent, payload.EmailSent);
    set(finCols.SysPaidAt, payload.SysPaidAt);
    finSheet.getRange(rowIndex, 1, 1, lastCol).setValues([row]);
  }

  return { upsertByEmail: upsertByEmail };
})();

// ============================================================================
// PART 10: MAIN TRIGGERS (UPGRADED WITH FIXES)
// ============================================================================

function onFormSubmit(e) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(30000); }
  catch (err) {
    AuditLogService.error("LOCK_TIMEOUT", "onFormSubmit lock timeout");
    return;
  }
  try {
    var sheetName = e.range.getSheet().getName();
    if (sheetName === SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
      handleSubmissionFormResponse2(e);
    } else {
      handleSubmission(e);
    }
  }
  catch (err2) {
    AuditLogService.error("SUBMIT_CRITICAL", err2 && err2.stack ? err2.stack : String(err2));
  }
  finally { lock.releaseLock(); }
}

function handleSubmission(e) {
  if (!e || !e.range) throw new Error("Missing event range.");

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var coupSheet = repo.getCouponSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet || !coupSheet || !finSheet) throw new Error("Missing required sheets.");

  var sysRegCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
  var finCols = ColumnManager.getFinanceCols(finSheet);

  var row = e.range.getRow();
  if (row < 2) return;

  var rowVals = repo.getRegistrationRow(row);

  // Inputs
  var email = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
  var name = rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1];
  var school = rowVals[SYSTEM_CONFIG.COLS.REG.SCHOOL - 1];
  var compCountAns = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
  var competitions = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
  var payMode = rowVals[SYSTEM_CONFIG.COLS.REG.PAY_MODE - 1];
  var payProof = rowVals[SYSTEM_CONFIG.COLS.REG.PAY_PROOF - 1];
  var refInput = Utils.cleanInput(rowVals[SYSTEM_CONFIG.COLS.REG.REF_INPUT - 1]);
  var coupInput = Utils.cleanInput(rowVals[SYSTEM_CONFIG.COLS.REG.COUPON_INPUT - 1]);

  // UPGRADED: Email validation
  if (!Utils.isValidEmail(email)) {
    AuditLogService.error("INVALID_EMAIL", "Row " + row + " has invalid email: " + email);
    // Still process but log the issue
  }

  // UPGRADED: Proof link validation
  var proofValidation = Utils.isValidProofLink(payProof);
  if (!proofValidation.valid) {
    AuditLogService.warn("SUSPICIOUS_PROOF_LINK", "Row " + row + " proof link issue: " + proofValidation.reason + " URL: " + proofValidation.url);
  }

  // State
  var currentId = rowVals[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1];
  var lockedRefPrev = String(rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "").trim();
  var lockedCoupPrev = String(rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || "").trim();
  var savedSubject = rowVals[SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT - 1];
  var isEdit = !!(currentId && String(currentId).trim() !== "");

  // 1) ID + Subject
  var myId = currentId;
  var mySubject = savedSubject;

  if (!isEdit) {
    myId = Utils.generateId("REF");
    mySubject = SYSTEM_CONFIG.META.NAME + ": Registration Received [" + myId + "]";

    // BATCH WRITE for new registration
    var batchData = [];
    batchData.push([SYSTEM_CONFIG.COLS.REG.GEN_ID, myId]);
    batchData.push([SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT, mySubject]);
    batchData.push([SYSTEM_CONFIG.COLS.REG.REF_COUNT, 0]);
    batchData.push([SYSTEM_CONFIG.COLS.REG.CASHBACK, 0]);
    
    for (var i = 0; i < batchData.length; i++) {
      regSheet.getRange(row, batchData[i][0]).setValue(batchData[i][1]);
    }
    SpreadsheetApp.flush();

    AuditLogService.info("NEW_REG", "Created ID " + myId + " for " + email);
  }

  // 2) Pricing
  var priceData = PricingEngine.calculate(compCountAns, competitions);

  if (priceData.normalizedCompetitions) {
    competitions = priceData.normalizedCompetitions;
    regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.COMPETITION).setValue(competitions);
  }

  // 3) Coupon handling
  var couponService = new CouponService(coupSheet, { lazyLoad: true });
  var discountAmount = 0;
  var activeCouponCode = "";
  var lockedCoupNow = lockedCoupPrev;

  if (isEdit && lockedCoupPrev && lockedCoupPrev !== coupInput) {
    couponService.revert(lockedCoupPrev);
    regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON).setValue("");
    lockedCoupNow = "";
    AuditLogService.info("COUPON_CHANGED", "Row " + row + " changed coupon from " + lockedCoupPrev + " to " + coupInput);
  }

  if (coupInput) {
    if (coupInput === lockedCoupPrev) {
      activeCouponCode = coupInput;
      discountAmount = couponService.getValueOnly(activeCouponCode);
      lockedCoupNow = activeCouponCode;
    } else {
      var result = couponService.claim(coupInput);
      if (result.valid) {
        activeCouponCode = coupInput;
        discountAmount = result.value;
        regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON).setValue(activeCouponCode);
        lockedCoupNow = activeCouponCode;
      } else {
        regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON).setValue("");
        lockedCoupNow = "";
        AuditLogService.warn("COUPON_INVALID", "Row " + row + " code=" + coupInput + " reason=" + result.reason);
      }
    }
  } else if (lockedCoupPrev && !coupInput) {
    // User cleared coupon - revert the old one
    couponService.revert(lockedCoupPrev);
    regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON).setValue("");
    lockedCoupNow = "";
    discountAmount = 0;
    AuditLogService.info("COUPON_CLEARED", "Row " + row + " cleared coupon " + lockedCoupPrev);
  }

  // 4) Referral handling (FIXED: Complete removal logic)
  // NOTE: We lock the referral code and give Person B their discount,
  // but we DON'T credit the referrer (Person A) until Person B's payment is VERIFIED (PAID)
  var lockedRefNow = lockedRefPrev;
  var referralDiscount = 0;
  
  // Check if payment is already verified (to protect against abuse)
  var isPaymentVerified = false;
  if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) {
    var paidAtCheck = regSheet.getRange(row, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue();
    isPaymentVerified = paidAtCheck && String(paidAtCheck).trim() !== "";
  }
  
  // Check if referral credit was already given
  var refCreditAlreadyGiven = false;
  if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_CREDIT_GIVEN]) {
    var creditGivenVal = regSheet.getRange(row, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_CREDIT_GIVEN]).getValue();
    refCreditAlreadyGiven = creditGivenVal && String(creditGivenVal).trim() !== "";
  }

  if (refInput && refInput !== lockedRefPrev) {
    // New or changed referral
    
    // ABUSE PROTECTION: If payment is already verified AND credit was given, don't allow changes
    if (isPaymentVerified && refCreditAlreadyGiven && lockedRefPrev) {
      // Cannot change referral after credit has been given
      lockedRefNow = lockedRefPrev;
      referralDiscount = SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE;
      AuditLogService.warn("REF_CHANGE_DENIED", "Row " + row + " cannot change referral from " + lockedRefPrev + " to " + refInput + " after payment verified and credit given");
    } else if (repo.isValidReferralCode(refInput, row)) {
      // If payment verified but credit not yet given (edge case), handle the change
      if (isPaymentVerified && lockedRefPrev && !refCreditAlreadyGiven) {
        // Payment verified but old referrer wasn't credited - just update the code
        AuditLogService.info("REF_CHANGE_PRE_CREDIT", "Row " + row + " changing referral from " + lockedRefPrev + " to " + refInput + " (credit not yet given)");
      }
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue(refInput);
      lockedRefNow = refInput;
      referralDiscount = SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE;
      AuditLogService.info("REF_LOCKED", "Row " + row + " locked referral: " + refInput + " (credit pending PAID verification)");
    } else {
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue("");
      lockedRefNow = "";
      AuditLogService.warn("REF_INVALID", "Row " + row + " invalid ref=" + refInput);
    }
  } else if (!refInput && lockedRefPrev) {
    // User cleared referral input
    // Only allow clearing if payment is NOT yet verified OR credit not yet given
    
    if (!isPaymentVerified) {
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue("");
      lockedRefNow = "";
      referralDiscount = 0;
      AuditLogService.info("REF_CLEARED", "Row " + row + " cleared referral " + lockedRefPrev);
    } else if (!refCreditAlreadyGiven) {
      // Payment verified but credit not given - allow clearing
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue("");
      lockedRefNow = "";
      referralDiscount = 0;
      AuditLogService.info("REF_CLEARED_PRE_CREDIT", "Row " + row + " cleared referral " + lockedRefPrev + " (credit was not given yet)");
    } else {
      // Payment is verified AND credit was given - don't allow clearing referral
      lockedRefNow = lockedRefPrev;
      referralDiscount = SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE;
      AuditLogService.warn("REF_CLEAR_DENIED", "Row " + row + " cannot clear referral after payment verified and credit given");
    }
  } else if (lockedRefNow) {
    // Existing referral still valid
    referralDiscount = SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE;
  }

  // NOTE: Referral credit (cashback) is NOT given here.
  // It will be given in onEdit when this person's payment is verified (status = PAID).
  // This prevents abuse where people register without paying.

  // 5) Final amount calculation (FIXED: Include referral discount)
  var finalPay = Math.max(0, 
    Number(priceData.finalPrice || 0) - 
    Number(discountAmount || 0) - 
    Number(referralDiscount || 0)
  );
  
  regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT).setValue(finalPay);
  
  // Store referral discount applied
  if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
    regSheet.getRange(row, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).setValue(referralDiscount);
  }
  
  SpreadsheetApp.flush();

  // 6) Send REGISTRATION RECEIVED email (FIXED: Pass referral discount)
  var emailData = {
    name: name,
    school: school,
    payMode: payMode,
    competitions: competitions,
    genId: myId,
    finalAmount: finalPay,
    couponCode: lockedCoupNow || "",
    refCodeUsed: lockedRefNow || "",
    cashback: 0
  };

  var sendRes = EmailService.sendRegistrationConfirmed(
    email, 
    mySubject, 
    emailData, 
    priceData, 
    discountAmount,
    referralDiscount  // FIXED: Now passing actual referral discount
  );

  if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_HASH]) {
    regSheet.getRange(row, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_HASH]).setValue(sendRes.hash || "");
  }
  if (sendRes.sent && sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT]) {
    regSheet.getRange(row, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT]).setValue(Utils.nowTzString());
  }

  // 7) Finance UPSERT
  // Get current cashback (should be 0 for new registrations, may be non-zero for edits)
  var currentCashback = Number(rowVals[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
  // Calculate NET total (payment amount - any cashback earned)
  var netTotalAmount = Math.max(0, finalPay - currentCashback);
  
  var payload = {
    Timestamp: new Date(),
    Email: String(email || "").trim(),
    Name: name,
    PaymentMode: payMode,
    ProofLink: payProof,
    RefCode: lockedRefNow || "",
    CouponCode: lockedCoupNow || "",
    GenId: myId,
    RefCount: Number(rowVals[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0),
    Cashback: currentCashback,
    TotalAmount: netTotalAmount,
    Status: SYSTEM_CONFIG.ADMIN.NOT_YET_WORD,
    Verifier: "",
    PayRef: "",
    EmailSent: "",
    SysPaidAt: ""
  };

  var existingRowIndex = repo.findFinanceRowIndexByEmail(email, finCols);
  if (existingRowIndex) {
    var lastCol = finSheet.getLastColumn();
    var existing = finSheet.getRange(existingRowIndex, 1, 1, lastCol).getValues()[0];
    if (finCols.Status) payload.Status = Utils.normalizeStatusValue(existing[finCols.Status - 1] || payload.Status);
    if (finCols.Verifier) payload.Verifier = existing[finCols.Verifier - 1] || payload.Verifier;
    if (finCols.PayRef) payload.PayRef = existing[finCols.PayRef - 1] || payload.PayRef;
    if (finCols.EmailSent) payload.EmailSent = existing[finCols.EmailSent - 1] || payload.EmailSent;
    if (finCols.SysPaidAt) payload.SysPaidAt = existing[finCols.SysPaidAt - 1] || payload.SysPaidAt;
  }

  var upsertRes = FinanceWriter.upsertByEmail(finSheet, finCols, email, payload);
  AuditLogService.info("FIN_UPSERT", upsertRes.action + " finance row=" + upsertRes.rowIndex + " email=" + email);

  // V23: Reapply merge group accounting if participant is in a merge group
  try {
    TriggerGuard.mute(function() {
      MergeService.reapplyMergeForEmail_(email);
    });
  } catch (mergeErr) {
    AuditLogService.warn("MERGE_REAPPLY_AFTER_SUBMIT", "err=" + mergeErr);
  }
}

// ============================================================================
// V23: SUBMISSION FORM (Submission Form) HANDLER
// ============================================================================

/**
 * Handle a new submission from Submission Form.
 * V23.1: Supports MULTIPLE competitions per row (up to 4).
 * Column E may contain comma-separated competition types.
 * Each competition gets its own participant number and acknowledgement email.
 */
function handleSubmissionFormResponse2(e) {
  if (!e || !e.range) throw new Error("Missing event range for submission.");

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Missing 'Submission Form' sheet.");

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var row = e.range.getRow();
  if (row < 2) return;

  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  // V23.1: Smart delta processing — detect already-processed competitions vs. new ones
  var existingNum = sysCols["SYS_PARTICIPANT_NUM"] ? String(subSheet.getRange(row, sysCols["SYS_PARTICIPANT_NUM"]).getValue() || "").trim() : "";
  var existingAnonFileIds = sysCols["SYS_ANON_FILE_IDS"] ? String(subSheet.getRange(row, sysCols["SYS_ANON_FILE_IDS"]).getValue() || "").trim() : "";
  // Bug 3 fix: read SYS_CONFIRMATION_SENT NOW so we can guard against duplicate emails
  // if the form trigger fires twice before the first run finishes writing.
  var alreadySentConfirmation = sysCols["SYS_CONFIRMATION_SENT"]
    ? String(subSheet.getRange(row, sysCols["SYS_CONFIRMATION_SENT"]).getValue() || "").trim() === "YES"
    : false;

  // Build set of already-processed competition prefixes from existing participant numbers
  // e.g. "SP-0001, ES-0003" → { "SP": true, "ES": true }
  var processedPrefixes = {};
  var existingNums = [];
  if (existingNum) {
    existingNums = existingNum.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });
    for (var ep = 0; ep < existingNums.length; ep++) {
      var prefix = existingNums[ep].split("-")[0];
      if (prefix) processedPrefixes[prefix] = true;
    }
  }

  // V23.1 Layer 1: Column E dropdown value
  var rawCompetition = String(rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] || "").trim();
  var dropdownComps = rawCompetition.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });

  // V23.1 Layer 2: Auto-detect from actual form data (scans all competition column groups)
  var detectedComps = DepersonalizationService.detectCompetitionsFromData(rowVals);

  // Merge both layers: union of dropdown + detected, deduplicated
  var compSet = {};
  var allDetectedComps = [];
  var allSources = dropdownComps.concat(detectedComps);
  for (var cs = 0; cs < allSources.length; cs++) {
    var cKey = allSources[cs].trim();
    if (cKey && !compSet[cKey]) {
      compSet[cKey] = true;
      allDetectedComps.push(cKey);
    }
  }

  // V22 SAFEGUARD: Filter out competitions from dropdown that have no actual form data.
  // This prevents accidental participant number assignment when a participant
  // selects a competition in the dropdown but doesn't fill in the corresponding section.
  var validatedComps = [];
  for (var vc = 0; vc < allDetectedComps.length; vc++) {
    var vcName = allDetectedComps[vc];
    var vcMapEntry = compMap[vcName];
    if (!vcMapEntry) {
      // Try case-insensitive match
      for (var vck = 0; vck < compMapKeys.length; vck++) {
        if (compMapKeys[vck].toUpperCase() === vcName.toUpperCase()) {
          vcMapEntry = compMap[compMapKeys[vck]];
          vcName = compMapKeys[vck];
          break;
        }
      }
    }
    if (!vcMapEntry) {
      AuditLogService.warn("SUB_UNKNOWN_COMP_FILTERED", "Row " + row + ": Unknown competition '" + vcName + "' filtered out.");
      continue;
    }

    // Check if participant filled in the competition's NAME/MEMBERS column
    var vcNameColKey = vcMapEntry.nameCol;
    var vcNameColNum = vcNameColKey ? SYSTEM_CONFIG.COLS.SUB[vcNameColKey] : null;
    var vcHasName = vcNameColNum ? String(rowVals[vcNameColNum - 1] || "").trim().length > 0 : false;

    if (vcHasName) {
      validatedComps.push(vcName);
    } else {
      AuditLogService.warn("SUB_FILTERED_NO_DATA",
        "Row " + row + ": Filtered out '" + vcName +
        "' — selected in dropdown but no name/data found in form section. " +
        "No participant number will be assigned for this competition.");
    }
  }
  allDetectedComps = validatedComps;

  if (allDetectedComps.length === 0) {
    AuditLogService.error("SUB_NO_COMPETITION", "Row " + row + ": No competition type found in column E or form data (all were filtered out as having no actual submissions).");
    return;
  }

  // V23.3: Separate competitions into NEW vs EDIT (already-processed but may need re-depersonalization)
  var newCompetitions = [];
  var editCompetitions = [];
  var PREFIXES = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP;
  var compMapKeys = Object.keys(compMap);

  for (var di = 0; di < allDetectedComps.length; di++) {
    var compName = allDetectedComps[di];
    var mapEntry = compMap[compName];
    if (!mapEntry) {
      // Try case-insensitive match
      for (var ck = 0; ck < compMapKeys.length; ck++) {
        if (compMapKeys[ck].toUpperCase() === compName.toUpperCase()) {
          mapEntry = compMap[compMapKeys[ck]];
          compName = compMapKeys[ck];
          break;
        }
      }
    }
    if (mapEntry && processedPrefixes[PREFIXES[mapEntry.key]]) {
      // V23.3: Already processed — mark as EDIT (re-depersonalize)
      editCompetitions.push(compName);
    } else {
      newCompetitions.push(compName);
    }
  }

  // Log detection results
  AuditLogService.info("SUB_DETECT", "Row " + row + " | Dropdown: [" + dropdownComps.join(", ") + "] | Data scan: [" + detectedComps.join(", ") + "] | Already processed: [" + existingNums.join(", ") + "] | NEW: [" + newCompetitions.join(", ") + "] | EDIT: [" + editCompetitions.join(", ") + "]");
  // Bug 8 fix: warn when auto-detection finds competitions not listed in the dropdown.
  // This can happen when a participant partially fills in a section they didn't intend to submit.
  var unmatchedDetected = detectedComps.filter(function(dc) { return dropdownComps.indexOf(dc) < 0; });
  if (unmatchedDetected.length > 0) {
    AuditLogService.warn("SUB_DETECT_MISMATCH",
      "Row " + row + ": Auto-scan found [" + unmatchedDetected.join(", ") + "] not in dropdown selection. " +
      "May be a partially-filled form section. Verify in Submission Dashboard before confirming.");
  }

  if (newCompetitions.length === 0 && editCompetitions.length === 0) {
    AuditLogService.info("SUB_ALL_PROCESSED", "Row " + row + ": No competitions detected to process.");
    return;
  }

  // ===== Process EDIT competitions first: cleanup old files, reuse number, re-depersonalize =====
  var allParticipantNums = existingNums.slice(); // start with existing numbers
  var allStatuses = [];
  // V23.3: Start with anon file IDs that do NOT belong to edit competitions (preserve others)
  var preservedAnonFileIds = [];
  if (existingAnonFileIds) {
    var existingIds = existingAnonFileIds.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
    // We'll remove IDs belonging to edit competitions during cleanup; for now keep all
    preservedAnonFileIds = existingIds.slice();
  }
  var allResults = []; // only NEW competition results (for emails)
  var editResults = []; // EDIT competition results (no emails)
  var allDepersonalized = [];
  var overallSuccess = true;

  for (var edi = 0; edi < editCompetitions.length; edi++) {
    var editCompType = editCompetitions[edi].trim();
    if (!editCompType) continue;

    var editMapEntry = compMap[editCompType];
    if (!editMapEntry) continue;

    var editPrefix = PREFIXES[editMapEntry.key];
    AuditLogService.info("SUB_EDIT_DETECTED", "Row " + row + ": Re-depersonalizing " + editCompType + " (" + editPrefix + ") due to form edit.");

    // Cleanup old anon files for this competition prefix
    DepersonalizationService.cleanupOldAnonFiles(existingAnonFileIds, editPrefix);

    // Remove cleaned-up IDs from preservedAnonFileIds
    preservedAnonFileIds = preservedAnonFileIds.filter(function(id) {
      try {
        // If the file was trashed by cleanup, it will throw or be trashed
        var f = DriveApp.getFileById(id);
        return !f.isTrashed();
      } catch (e) { return false; }
    });

    // Reuse existing participant number
    var editExistingNum = DepersonalizationService.getExistingParticipantNum(existingNum, editMapEntry.key);
    // Bug 2b fix: skipWrite=true prevents processSubmission from writing partial data mid-loop;
    // the outer aggregated write (below) handles the final sheet update.
    var editOptions = { skipWrite: true };
    if (editExistingNum) editOptions.existingParticipantNum = editExistingNum;

    // Temporarily override column E
    var editOrigCompValue = rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1];
    rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = editCompType;

    var editResult = DepersonalizationService.processSubmission(subSheet, sysCols, row, rowVals, repo, editOptions);

    rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = editOrigCompValue;

    if (editResult.success) {
      editResults.push(editResult);
      allStatuses.push(editResult.status);
      allDepersonalized.push(editResult.fileCount > 0 ? "YES" : "NO");
      if (editResult.fileResults && editResult.fileResults.length > 0) {
        var editIds = editResult.fileResults.map(function(f) { return f.anonId; });
        preservedAnonFileIds = preservedAnonFileIds.concat(editIds);
      }
      // Update participant number in the list (it should already be there, but ensure)
      if (editExistingNum) {
        // Number is already in allParticipantNums from existingNums.slice()
      } else {
        allParticipantNums.push(editResult.participantNum);
      }
      AuditLogService.info("SUB_EDIT_PROCESSED", "Row " + row + " [EDIT]: " + editCompType + " → " + editResult.participantNum + " (files re-depersonalized, no email sent)");
    } else {
      allStatuses.push("ERROR");
      AuditLogService.error("SUB_EDIT_FAILED", "Row " + row + " [EDIT " + editCompType + "]: " + (editResult.error || "Unknown error"));
    }
  }

  // ===== Process NEW competitions: full processing + send acknowledgement emails =====
  for (var ci = 0; ci < newCompetitions.length; ci++) {
    var singleCompType = newCompetitions[ci].trim();
    if (!singleCompType) continue;

    // Temporarily override column E in rowVals for single-competition processing
    var originalCompValue = rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1];
    rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = singleCompType;

    // Bug 2b fix: pass skipWrite so processSubmission doesn't write mid-loop
    var result = DepersonalizationService.processSubmission(subSheet, sysCols, row, rowVals, repo, { skipWrite: true });

    // Restore original value
    rowVals[SYSTEM_CONFIG.COLS.SUB.COMPETITION_TYPE - 1] = originalCompValue;

    if (!result.success) {
      AuditLogService.error("SUB_PROCESS_FAILED", "Row " + row + " [" + singleCompType + "]: " + (result.error || "Unknown error"));
      allStatuses.push("ERROR");
      overallSuccess = false;
      continue;
    }

    allResults.push(result);
    allParticipantNums.push(result.participantNum);
    allStatuses.push(result.status);
    allDepersonalized.push(result.fileCount > 0 ? "YES" : "NO");
    if (result.fileResults && result.fileResults.length > 0) {
      var ids = result.fileResults.map(function(f) { return f.anonId; });
      preservedAnonFileIds = preservedAnonFileIds.concat(ids);
    }
    AuditLogService.info("SUB_NEW_PROCESSED", "Row " + row + " [NEW " + (ci + 1) + "/" + newCompetitions.length + "]: " + singleCompType + " → " + result.participantNum);
  }

  // Write aggregated SYS columns (existing + new, comma-separated)
  // V23.3: Deduplicate participant numbers
  var uniqueNums = [];
  var numSet = {};
  for (var un = 0; un < allParticipantNums.length; un++) {
    var pn = allParticipantNums[un].trim();
    if (pn && !numSet[pn]) { numSet[pn] = true; uniqueNums.push(pn); }
  }

  var sysData = {
    SYS_PARTICIPANT_NUM: uniqueNums.join(", "),
    SYS_SUB_STATUS: allStatuses.indexOf("ERROR") >= 0 ? "ERROR" : (allStatuses.indexOf("FLAGGED") >= 0 ? "FLAGGED" : "PROCESSED"),
    SYS_DEPERSONALIZED: allDepersonalized.indexOf("YES") >= 0 ? "YES" : (existingNum ? "YES" : "NO"),
    SYS_DEPERSONALIZED_AT: allDepersonalized.indexOf("YES") >= 0 ? Utils.nowTzString() : "",
    SYS_ANON_FILE_IDS: preservedAnonFileIds.join(", ")
  };
  // Also write matched registration info from the first successful result
  var allSuccessResults = allResults.concat(editResults);
  if (allSuccessResults.length > 0) {
    var firstResult = allSuccessResults[0];
    sysData.SYS_MATCHED_REG_ROW = firstResult.matchedGenId ? String(firstResult.matchedRegRow || "") : "";
    sysData.SYS_MATCHED_GEN_ID = firstResult.matchedGenId || "";
  }
  var sysKeys = Object.keys(sysData);
  for (var si = 0; si < sysKeys.length; si++) {
    var col = sysCols[sysKeys[si]];
    if (col) subSheet.getRange(row, col).setValue(sysData[sysKeys[si]]);
  }

  // V23.3: Send acknowledgement emails ONLY for NEW competitions (not edits)
  // Also check SYS_CONFIRMATION_SENT to avoid duplicate emails on re-trigger
  var emailsSent = 0;
  // Bug 3 fix: do not send emails if we already sent confirmation on an earlier trigger run.
  // Without this guard, two near-simultaneous trigger fires both see processedPrefixes={} and
  // treat everything as NEW, resulting in duplicate acknowledgement emails.
  if (allResults.length > 0 && !alreadySentConfirmation) {
    try {
      var inlineImages = LogoService.getInlineImages();
      var senderName = SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME;

      for (var ei = 0; ei < allResults.length; ei++) {
        var res = allResults[ei];
        var emailSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + res.participantNum + "]";
        var emailHtml = buildSubmissionConfirmationHtml_(res);

        // Try to thread with existing registration email
        if (res.matchedGenId) {
          var threadInfo = EmailThreadService.getThreadInfo(res.matchedGenId);
          if (threadInfo && threadInfo.threadId) {
            EmailThreadService.sendReplyEmail(
              res.email, emailSubject, emailHtml,
              inlineImages, threadInfo.threadId, threadInfo.messageId, senderName
            );
            AuditLogService.info("SUB_CONFIRM_THREADED", "Sent threaded confirmation to " + res.email + " (" + res.participantNum + ")");
          } else {
            MailApp.sendEmail({ to: res.email, subject: emailSubject, htmlBody: emailHtml, inlineImages: inlineImages, name: senderName });
            AuditLogService.info("SUB_CONFIRM_SENT", "Sent confirmation to " + res.email + " (" + res.participantNum + ")");
          }
        } else {
          MailApp.sendEmail({ to: res.email, subject: emailSubject, htmlBody: emailHtml, inlineImages: inlineImages, name: senderName });
          AuditLogService.info("SUB_CONFIRM_SENT", "Sent confirmation to " + res.email + " (" + res.participantNum + ")");
        }
        emailsSent++;

        // Small delay between emails to avoid rate limiting
        if (ei < allResults.length - 1) Utilities.sleep(1500);
      }

      // Mark confirmation as sent
      if (sysCols["SYS_CONFIRMATION_SENT"] && emailsSent > 0) {
        subSheet.getRange(row, sysCols["SYS_CONFIRMATION_SENT"]).setValue("YES");
      }
    } catch (emailErr) {
      AuditLogService.error("SUB_CONFIRM_ERR", "Failed to send confirmation for row " + row + ": " + emailErr);
    }
  }

  var totalProcessed = allResults.length + editResults.length;
  var totalComps = newCompetitions.length + editCompetitions.length;
  AuditLogService.info("SUB_MULTI_COMPLETE", "Row " + row + ": " + totalProcessed + "/" + totalComps + " competitions processed (" + newCompetitions.length + " new, " + editCompetitions.length + " edits), " + emailsSent + " email(s) sent. Numbers: " + uniqueNums.join(", "));
}

/**
 * Build the HTML for a submission acknowledgement email.
 * V23: Rewritten to match the AR email style with full spiel section.
 */
function buildSubmissionConfirmationHtml_(result) {
  var orgName = SYSTEM_CONFIG.META.ORG;
  var eventName = SYSTEM_CONFIG.META.NAME;
  var BLUE = "#1E4FB8";
  var GOLD = "#FFD700";
  var spielConfig = SYSTEM_CONFIG.ADMIN.SUB_EMAIL_SPIEL || {};
  var contactConfig = SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.CONTACT || {};

  // ---- PII Warning ----
  var piiWarning = "";
  if (result.piiResult && result.piiResult.flagged) {
    piiWarning =
      '<div style="background:#FEF3C7;border-left:4px solid #F59E0B;padding:12px 16px;margin:16px 0;border-radius:4px;">' +
      '<strong style="color:#92400E;">⚠️ IMPORTANT NOTICE:</strong><br>' +
      '<span style="color:#92400E;">We detected potential identifying information in your submission ' +
      '(e.g., name, school, or organization). Our team will review and remove any identifying details ' +
      'before your entry is forwarded to judges. For future reference, please avoid including personal ' +
      'information in your work to ensure fair and anonymous evaluation.</span></div>';
  }

  // ---- File Processing Status ----
  var filesInfo = "";
  if (result.fileCount > 0) {
    filesInfo = '<div style="background:#ECFDF5;border-left:4px solid #059669;padding:12px 16px;margin:16px 0;border-radius:4px;">' +
      '<strong style="color:#059669;">✅ ' + result.fileCount + ' file(s)</strong>' +
      '<span style="color:#065F46;"> received and depersonalized successfully.</span></div>';
  } else {
    filesInfo = '<div style="background:#FFFBEB;border-left:4px solid #D97706;padding:12px 16px;margin:16px 0;border-radius:4px;">' +
      '<strong style="color:#D97706;">⚠️ No files were processed.</strong>' +
      '<span style="color:#92400E;"> If you uploaded files, our team will process them manually.</span></div>';
  }

  // ---- Build Submission Details Table Rows ----
  var esc = Utils.escapeHtml;
  var thStyle = 'align="left" style="background:#f8fafc;padding:10px 12px;border:1px solid #e6e8ec;width:40%;font-weight:bold;"';
  var tdStyle = 'style="padding:10px 12px;border:1px solid #e6e8ec;"';
  var tdBoldStyle = 'style="padding:10px 12px;border:1px solid #e6e8ec;font-weight:bold;color:' + BLUE + ';"';

  var detailRows = '';
  // Registration No.
  if (result.matchedGenId) {
    detailRows += '<tr><th ' + thStyle + '>Registration No.</th><td ' + tdStyle + '>' + esc(result.matchedGenId) + '</td></tr>';
  }
  // Participant No.
  detailRows += '<tr><th ' + thStyle + '>Participant No.</th><td ' + tdBoldStyle + '>' + esc(result.participantNum) + '</td></tr>';
  // Competition
  detailRows += '<tr><th ' + thStyle + '>Competition</th><td ' + tdStyle + '>' + esc(result.competitionType) + '</td></tr>';
  // Full Name
  if (result.participantName) {
    detailRows += '<tr><th ' + thStyle + '>Full Name</th><td ' + tdStyle + '>' + esc(result.participantName) + '</td></tr>';
  }
  // Region
  if (result.region) {
    detailRows += '<tr><th ' + thStyle + '>Region</th><td ' + tdStyle + '>' + esc(result.region) + '</td></tr>';
  }
  // School/University
  if (result.school) {
    detailRows += '<tr><th ' + thStyle + '>School/University</th><td ' + tdStyle + '>' + esc(result.school) + '</td></tr>';
  }
  // Adviser/Coach
  if (result.adviser) {
    detailRows += '<tr><th ' + thStyle + '>Adviser/Coach</th><td ' + tdStyle + '>' + esc(result.adviser) + '</td></tr>';
  }
  // Contact Number
  if (result.contact) {
    detailRows += '<tr><th ' + thStyle + '>Contact Number</th><td ' + tdStyle + '>' + esc(result.contact) + '</td></tr>';
  }
  // Entry Title
  if (result.entryTitle) {
    detailRows += '<tr><th ' + thStyle + '>Entry Title</th><td ' + tdStyle + '>' + esc(result.entryTitle) + '</td></tr>';
  }
  // Status
  var statusLabel = result.status === "PROCESSED" ? "✅ Processed" : result.status === "FLAGGED" ? "⚠️ Flagged for Review" : result.status;
  detailRows += '<tr><th ' + thStyle + '>Status</th><td ' + tdStyle + '>' + statusLabel + '</td></tr>';

  // ---- Build Spiel Section ----
  var spielSection = '';
  if (spielConfig.ENABLED) {
    var spielContent = spielConfig.CONTENT || [];

    // Greeting
    spielSection += '<p style="font-size:14px;margin:15px 0;">Dear <b>' + esc(result.participantName || "Participant") + '</b>,</p>';

    // Main content paragraphs
    for (var i = 0; i < spielContent.length; i++) {
      if (spielContent[i] === "") {
        spielSection += '<br>';
      } else {
        spielSection += '<p style="font-size:14px;margin:8px 0;line-height:1.5;">' + spielContent[i] + '</p>';
      }
    }

    // Anonymity Assurance callout (blue box)
    if (spielConfig.ANONYMITY_NOTE) {
      spielSection += '<div style="background:#EFF6FF;border:1px solid #BFDBFE;padding:14px 16px;border-radius:10px;margin:16px 0;">' +
        '<b style="color:' + BLUE + ';">🔒 Anonymity Assurance</b><br>' +
        '<span style="color:#1E40AF;font-size:13px;line-height:1.5;">' + spielConfig.ANONYMITY_NOTE + '</span></div>';
    }
  }

  // ---- Build Full HTML ----
  var html =
    // DOCTYPE + Head
    '<!DOCTYPE html>' +
    '<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">' +
    '<title>' + eventName + ' - Submission Acknowledgement</title>' +
    '<style>' +
    '  @media only screen and (max-width: 600px) {' +
    '    .email-container { width: 100% !important; padding: 10px !important; }' +
    '    .email-content { padding: 20px 15px !important; }' +
    '    .header-title { font-size: 20px !important; }' +
    '    .header-logo { max-width: 60px !important; }' +
    '    .info-table th, .info-table td { display: block !important; width: 100% !important; box-sizing: border-box !important; }' +
    '    .info-table th { border-bottom: none !important; }' +
    '    .participant-num { font-size: 26px !important; }' +
    '  }' +
    '</style>' +
    '</head>' +
    '<body style="margin:0;padding:20px;background-color:#f2f2f2;font-family:Arial, Helvetica, sans-serif;">' +
    '<div class="email-container" style="max-width:700px;margin:0 auto;background-color:#ffffff;box-shadow:0 0 10px rgba(0,0,0,0.1);border-radius:10px;overflow:hidden;">' +

    // Header with logos (matching AR style)
    '<div style="background-color:' + BLUE + ';padding:18px 10px;text-align:center;border-bottom:6px solid ' + GOLD + ';">' +
    '  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 auto;">' +
    '    <tr>' +
    '      <td width="20%" align="center" valign="middle" style="padding:0 5px;">' +
    '        <img class="header-logo" src="cid:uplb_logo" alt="UPLB Sociology Society" style="max-width:75px;height:auto;display:block;margin:0 auto;">' +
    '      </td>' +
    '      <td width="60%" align="center" valign="middle" style="padding:0 5px;">' +
    '        <h1 class="header-title" style="margin:0;color:' + GOLD + ';font-family:Times New Roman, serif;font-size:26px;letter-spacing:2px;font-weight:800;">HUSAY NG SOKSAY</h1>' +
    '        <p style="margin:5px 0 0 0;color:#ffffff;font-size:11px;letter-spacing:1px;">UPLB SOCIOLOGY SOCIETY</p>' +
    '      </td>' +
    '      <td width="20%" align="center" valign="middle" style="padding:0 5px;">' +
    '        <img class="header-logo" src="cid:husay_logo" alt="Husay ng Soksay" style="max-width:75px;height:auto;display:block;margin:0 auto;">' +
    '      </td>' +
    '    </tr>' +
    '  </table>' +
    '</div>' +

    // Title bar (matching AR style)
    '<div style="background-color:' + BLUE + ';color:#ffffff;text-align:center;padding:12px;font-size:16px;font-weight:bold;letter-spacing:1px;">' +
    (spielConfig.TITLE || "SUBMISSION ACKNOWLEDGEMENT") +
    '</div>' +

    // Content area
    '<div class="email-content" style="padding:25px 30px;">' +

    // Confidential Badge (matching AR style)
    '<div style="display:inline-block;padding:6px 12px;border-radius:999px;font-size:11px;font-weight:bold;background:#eef2ff;color:#3730a3;margin-bottom:15px;">CONFIDENTIAL - DO NOT SHARE</div>' +

    // Spiel Section
    spielSection +

    // Participant Number highlight box
    '<div style="background:linear-gradient(135deg,' + BLUE + ',#2563EB);padding:20px;border-radius:10px;text-align:center;margin:20px 0;">' +
    '<p style="color:#93C5FD;margin:0 0 4px;font-size:13px;text-transform:uppercase;letter-spacing:1px;">Your Participant Number</p>' +
    '<p class="participant-num" style="color:#fff;margin:0;font-size:32px;font-weight:bold;letter-spacing:3px;">' + esc(result.participantNum) + '</p>' +
    '<p style="color:#93C5FD;margin:6px 0 0;font-size:12px;">This number identifies your entry during anonymous evaluation</p></div>' +

    // Divider
    '<div style="height:1px;background:#e6e8ec;margin:20px 0;"></div>' +

    // Submission Details header
    '<h2 style="font-size:16px;font-weight:bold;margin:15px 0 12px 0;">Submission Details</h2>' +

    // Submission Details Table (matching AR info-table style)
    '<table class="info-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e6e8ec;border-collapse:collapse;font-size:13px;margin-bottom:15px;">' +
    detailRows +
    '</table>' +

    // File processing status
    filesInfo +

    // PII warning
    piiWarning +

    // Confidentiality notice (matching AR style)
    (spielConfig.CONFIDENTIALITY_NOTE ?
      '<div style="background:#fff7ed;border:1px solid #fed7aa;padding:12px;border-radius:10px;font-size:13px;margin:15px 0;">' +
      '<b>🔐 Confidentiality reminder:</b> ' + spielConfig.CONFIDENTIALITY_NOTE + '</div>'
      : '') +

    // Closing
    (spielConfig.CLOSING ?
      '<p style="font-size:14px;margin:15px 0;line-height:1.5;">' + spielConfig.CLOSING + '</p>'
      : '') +

    // Divider before contact
    '<div style="height:1px;background:#e6e8ec;margin:15px 0;"></div>' +

    // Contact Section (matching AR style)
    '<h4 style="font-size:14px;font-weight:bold;margin:15px 0 8px 0;">Contact</h4>' +
    '<p style="font-size:13px;color:#555;line-height:1.6;">' +
    'For any questions, clarifications, and updates, please reach out to us on:<br>' +
    'Email: <b>' + esc(contactConfig.EMAIL || "husayngsoksayteam@gmail.com") + '</b><br>' +
    'Facebook: ' + esc(contactConfig.FACEBOOK || "Husay Ng Soksay - UPLB Sociology Society") + '<br>' +
    'Instagram: <b>' + esc(contactConfig.INSTAGRAM || "@husayngsoksay") + '</b>' +
    '</p>' +

    // Sign off
    '<p style="font-size:13px;margin-top:15px;">' + (spielConfig.SIGN_OFF || SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.SIGN_OFF) + '</p>' +

    '</div>' +

    // Footer (matching AR style)
    '<div style="background-color:#eee;padding:12px 15px;font-size:10px;color:#555;text-align:center;">This is a system-generated submission acknowledgement from the ' + eventName + ' System.<br>© 2026 ' + orgName + '. All rights reserved.</div>' +

    '</div></body></html>';

  return html;
}

function onEdit(e) {
  if (!e || !e.range) return;
  if (TriggerGuard.isMuted()) return;

  var range = e.range;
  var sheet = range.getSheet();

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet || !finSheet) return;

  var sysRegCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
  var finCols = ColumnManager.getFinanceCols(finSheet);

  if (sheet.getName() === SYSTEM_CONFIG.SHEETS.FINANCE) {
    var editedCol = range.getColumn();
    var header = Utils.safeString(sheet.getRange(1, editedCol).getValue()).trim();
    var aliases = SYSTEM_CONFIG.FINANCE_HEADERS.ALIASES || {};
    var canonical = aliases[header] || header;
    var watched = { "Status": true, "Verifier": true, "Pay Ref": true, "Email Sent": true, "SYS_PAID_AT": true };
    if (watched[canonical]) handleFinanceEditSync(e, sysRegCols, finCols, canonical);
    return;
  }

  if (sheet.getName() === SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    var editedCol = range.getColumn();
    var row = range.getRow();
    if (row < 2) return;
    
    // Handle SYS_PAID_AT column edits
    var sysPaidAtCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT];
    if (sysPaidAtCol && editedCol === sysPaidAtCol) {
      handleRegistrationPaidAtEditSync(e, finCols);
      return;
    }
    
    // V18.0: Handle Referral Code edits (REF_INPUT or LOCKED_REF columns)
    var isRefInputEdit = (editedCol === SYSTEM_CONFIG.COLS.REG.REF_INPUT);
    var isLockedRefEdit = (editedCol === SYSTEM_CONFIG.COLS.REG.LOCKED_REF);
    
    if (isRefInputEdit || isLockedRefEdit) {
      AuditLogService.info("REF_EDIT_DETECTED", 
        "Referral code edit detected at row " + row + ", column " + editedCol + 
        " (isRefInput=" + isRefInputEdit + ", isLockedRef=" + isLockedRefEdit + ")");
      handleReferralCodeEdit(e, regSheet, finSheet, sysRegCols, finCols, row);
      return;
    }
  }
}

/**
 * V18.0: Handle direct edits to the referral code columns
 * This processes referral changes when someone edits their registration directly
 */
function handleReferralCodeEdit(e, regSheet, finSheet, sysRegCols, finCols, row) {
  var repo = new SheetRepository();
  
  // Get current row data
  var width = regSheet.getLastColumn();
  var rowVals = regSheet.getRange(row, 1, 1, width).getValues()[0];
  
  var email = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
  var name = rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1];
  var myGenId = rowVals[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1];
  
  // Get the new and old referral codes
  var newRefInput = Utils.cleanInput(rowVals[SYSTEM_CONFIG.COLS.REG.REF_INPUT - 1]);
  var oldLockedRef = Utils.cleanInput(rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1]);
  
  // If editing LOCKED_REF directly, use the new value from there
  if (e.range.getColumn() === SYSTEM_CONFIG.COLS.REG.LOCKED_REF) {
    newRefInput = Utils.cleanInput(e.range.getValue());
    // Also update REF_INPUT to match
    regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.REF_INPUT).setValue(newRefInput || "");
  }
  
  AuditLogService.info("REF_EDIT_PROCESSING", 
    "Processing referral edit for " + email + " (GenID: " + myGenId + "): " +
    "oldLockedRef='" + oldLockedRef + "', newRefInput='" + newRefInput + "'");
  
  // Check if the referral code actually changed
  if (Utils.upper(newRefInput) === Utils.upper(oldLockedRef)) {
    AuditLogService.info("REF_EDIT_NO_CHANGE", "Referral code unchanged, skipping");
    return;
  }
  
  // Check if this person is already PAID (verified)
  var refCreditGivenCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_CREDIT_GIVEN];
  var isPaidAndCredited = false;
  
  // Check if this person's payment was already verified and credit was given
  if (refCreditGivenCol) {
    var creditGivenVal = String(regSheet.getRange(row, refCreditGivenCol).getValue() || "").trim();
    if (creditGivenVal && creditGivenVal.indexOf(oldLockedRef) >= 0) {
      isPaidAndCredited = true;
    }
  }
  
  // Also check Finance Dashboard status
  var finRowIndex = repo.findFinanceRowIndexByEmail(email, finCols);
  var isPersonPaid = false;
  if (finRowIndex && finCols.Status) {
    var finStatus = Utils.normalizeStatusValue(finSheet.getRange(finRowIndex, finCols.Status).getValue());
    isPersonPaid = (finStatus === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD);
  }
  
  AuditLogService.info("REF_EDIT_STATUS", 
    "Person status: isPaidAndCredited=" + isPaidAndCredited + ", isPersonPaid=" + isPersonPaid);
  
  TriggerGuard.mute(function() {
    // === STEP 1: Remove credit from old referrer if credit was already given ===
    if (oldLockedRef && isPaidAndCredited) {
      AuditLogService.info("REF_EDIT_REMOVE_OLD", 
        "Removing credit from old referrer: " + oldLockedRef);
      
      var referralService = new ReferralService(regSheet);
      var removeResult = referralService.updateReferrer(oldLockedRef, "REMOVE", myGenId);
      
      if (removeResult.ok) {
        AuditLogService.info("REF_EDIT_REMOVE_SUCCESS", 
          "Successfully removed credit from " + oldLockedRef);
        
        // Clear the credit given marker
        if (refCreditGivenCol) {
          regSheet.getRange(row, refCreditGivenCol).setValue("");
        }
        
        // Notify old referrer about removal
        try {
          var oldCashbackRemoved = (removeResult.count === 0) 
            ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL 
            : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
          
          var removeNotifData = {
            referrerName: removeResult.referrerName,
            referrerCode: oldLockedRef,
            referredName: name || "A participant",
            referredGenId: myGenId,
            newCount: removeResult.count,
            newCashback: removeResult.cashback,
            cashbackRemoved: oldCashbackRemoved
          };
          
          EmailService.sendReferralRemovedNotification(removeResult.referrerEmail, removeNotifData);
        } catch (notifErr) {
          AuditLogService.warn("REF_EDIT_REMOVE_NOTIF_FAIL", "Failed to notify old referrer: " + notifErr);
        }
      }
    }
    
    // === STEP 2: Validate and lock new referral code ===
    var newRefValid = false;
    if (newRefInput) {
      newRefValid = repo.isValidReferralCode(newRefInput, row);
      AuditLogService.info("REF_EDIT_VALIDATE_NEW", 
        "New referral code '" + newRefInput + "' valid: " + newRefValid);
    }
    
    if (newRefValid) {
      // Lock the new referral code
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue(newRefInput);
      
      // === STEP 3: If person is already PAID, give credit to new referrer immediately ===
      if (isPersonPaid) {
        AuditLogService.info("REF_EDIT_ADD_NEW", 
          "Person is PAID, adding credit to new referrer: " + newRefInput);
        
        var referralService = new ReferralService(regSheet);
        var addResult = referralService.updateReferrer(newRefInput, "ADD", myGenId);
        
        if (addResult.ok) {
          // Mark credit as given
          if (refCreditGivenCol) {
            regSheet.getRange(row, refCreditGivenCol).setValue(newRefInput + "|" + Utils.nowTzString());
          }
          
          AuditLogService.info("REF_EDIT_ADD_SUCCESS", 
            "Successfully added credit to " + newRefInput + ". New count: " + addResult.count);
          
          // Notify new referrer
          try {
            var newCashbackEarned = (addResult.count === 1) 
              ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL 
              : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
            
            var addNotifData = {
              referrerName: addResult.referrerName,
              referrerCode: newRefInput,
              referredName: name || "A new participant",
              referredGenId: myGenId,
              newCount: addResult.count,
              newCashback: addResult.cashback,
              cashbackEarned: newCashbackEarned
            };
            
            var notifResult = EmailService.sendReferralSuccessNotification(addResult.referrerEmail, addNotifData);
            if (notifResult.sent) {
              AuditLogService.info("REF_EDIT_ADD_NOTIF_SUCCESS", 
                "Notification sent to new referrer: " + addResult.referrerEmail);
            }
          } catch (notifErr) {
            AuditLogService.warn("REF_EDIT_ADD_NOTIF_FAIL", "Failed to notify new referrer: " + notifErr);
          }
        }
      } else {
        AuditLogService.info("REF_EDIT_DEFERRED", 
          "Person not yet PAID, referral credit deferred until payment verification");
      }
      
      // Update the person's own referral discount
      var refDiscountCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED];
      if (refDiscountCol) {
        regSheet.getRange(row, refDiscountCol).setValue(SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE);
      }
      
    } else {
      // Invalid or empty referral code
      regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.LOCKED_REF).setValue("");
      
      // Clear referral discount
      var refDiscountCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED];
      if (refDiscountCol) {
        regSheet.getRange(row, refDiscountCol).setValue(0);
      }
      
      if (newRefInput) {
        AuditLogService.warn("REF_EDIT_INVALID", 
          "Invalid referral code entered: " + newRefInput);
      }
    }
    
    // === STEP 4: Recalculate final amount and sync to Finance ===
    recalculateAndSyncFinance(regSheet, finSheet, finCols, sysRegCols, row);
  });
  
  AuditLogService.info("REF_EDIT_COMPLETE", 
    "Referral edit processing complete for " + email);
}

/**
 * V18.0: Recalculate final amount after referral changes and sync to Finance
 */
function recalculateAndSyncFinance(regSheet, finSheet, finCols, sysRegCols, row) {
  var repo = new SheetRepository();
  
  // Re-read row data after changes
  var width = regSheet.getLastColumn();
  var rowVals = regSheet.getRange(row, 1, 1, width).getValues()[0];
  
  var email = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
  var competitions = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
  var compCount = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
  var lockedCoupon = rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1];
  var lockedRef = rowVals[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1];
  
  // Get referral discount
  var refDiscountCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED];
  var refDiscount = refDiscountCol ? Number(regSheet.getRange(row, refDiscountCol).getValue() || 0) : 0;
  
  // Calculate pricing
  var pricing = PricingEngine.calculate(compCount, competitions);
  
  // Get coupon discount
  var couponDiscount = 0;
  if (lockedCoupon) {
    var couponSheet = repo.getCouponSheet();
    if (couponSheet) {
      var couponService = new CouponService(couponSheet);
      couponDiscount = couponService.getValueOnly(lockedCoupon);
    }
  }
  
  // Calculate final amount
  var finalAmount = Math.max(0, pricing.finalPrice - couponDiscount - refDiscount);
  
  // Update Registration sheet
  regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT).setValue(finalAmount);
  
  // Sync to Finance Dashboard
  var finRowIndex = repo.findFinanceRowIndexByEmail(email, finCols);
  if (finRowIndex) {
    // Update relevant fields
    if (finCols.RefCode) {
      finSheet.getRange(finRowIndex, finCols.RefCode).setValue(lockedRef || "");
    }
    if (finCols.TotalAmount) {
      // Get cashback earned (as referrer)
      var cashback = Number(rowVals[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
      var netTotal = Math.max(0, finalAmount - cashback);
      finSheet.getRange(finRowIndex, finCols.TotalAmount).setValue(netTotal);
    }
    
    AuditLogService.info("REF_EDIT_FIN_SYNC", 
      "Finance synced for " + email + ": RefCode=" + (lockedRef || "none") + ", FinalAmount=" + finalAmount);
  }

  // V23: Reapply merge group accounting if participant is in a merge group
  try {
    MergeService.reapplyMergeForEmail_(email);
  } catch (mergeErr) {
    AuditLogService.warn("MERGE_REAPPLY_AFTER_REF_EDIT", "err=" + mergeErr);
  }
}

function shouldAttemptPaidSend_(emailSentVal) {
  var v = String(emailSentVal || "").trim();
  if (v === "") return { allow: true, force: false };
  var up = v.toUpperCase();
  if (up.indexOf("ERROR") === 0) return { allow: true, force: true };
  if (up.indexOf("FAILED") === 0) return { allow: true, force: true };
  if (up.indexOf("REVERSED") === 0) return { allow: true, force: true };
  if (up.indexOf("SENT") === 0) return { allow: false, force: false };
  if (up.indexOf("SKIPPED") === 0) return { allow: false, force: false };
  return { allow: false, force: false };
}

function handleFinanceEditSync(e, sysRegCols, finCols, canonicalEditedHeader) {
  var repo = new SheetRepository();
  var finSheet = repo.getFinanceSheet();
  var regSheet = repo.getRegistrationSheet();

  var row = e.range.getRow();
  if (row < 2) return;

  function get(col) { return col ? finSheet.getRange(row, col).getValue() : ""; }
  function set(col, val) { if (col) finSheet.getRange(row, col).setValue(val); }

  var email = get(finCols.Email);
  if (!email) return;

  var status = Utils.normalizeStatusValue(get(finCols.Status));
  var verifier = get(finCols.Verifier);
  var payRef = get(finCols.PayRef);
  var emailSentCell = finCols.EmailSent ? finSheet.getRange(row, finCols.EmailSent) : null;
  var finPaidAtVal = get(finCols.SysPaidAt);

  var regRowIndex = repo.findRegistrationRowIndexByEmail(email);
  var regData = regRowIndex ? repo.getRegistrationByEmail(email) : null;

  TriggerGuard.mute(function () {
    if (regRowIndex && sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.LAST_FIN_STATUS]) {
      regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.LAST_FIN_STATUS]).setValue(status);
    }

    function syncMetaToReg(paidAtValue) {
      if (!regRowIndex) return;
      if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) {
        regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).setValue(paidAtValue || "");
      }
      if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]) {
        regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).setValue(verifier || "");
      }
      if (sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]) {
        regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).setValue(payRef || "");
      }
    }

    if (status === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
      if (!regData) {
        if (emailSentCell) emailSentCell.setValue("ERROR: Reg Not Found");
        AuditLogService.error("PAID_NO_REG", "Finance row " + row + " email=" + email);
        return;
      }

      if (!finPaidAtVal) {
        finPaidAtVal = Utils.nowTzString();
        set(finCols.SysPaidAt, finPaidAtVal);
      }

      var allowedToSendNow =
        (canonicalEditedHeader === "Status") ||
        (canonicalEditedHeader === "Email Sent") ||
        (canonicalEditedHeader === "SYS_PAID_AT");

      if (emailSentCell && allowedToSendNow) {
        var emailSentVal = String(emailSentCell.getValue() || "").trim();
        var decision = shouldAttemptPaidSend_(emailSentVal);

        if (decision.allow) {
          var paidAtDate = Utils.parseMaybeDate(finPaidAtVal) || new Date();
          var p = PricingEngine.calculate("", regData.competitions);
          var normalizedCompetitions = p.normalizedCompetitions || regData.competitions;

          // Get referral discount from registration
          var refDiscountApplied = 0;
          if (regRowIndex && sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
            refDiscountApplied = Number(regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).getValue() || 0);
          }
          
          // V20.0 FIX: Get actual coupon discount value from Coupons sheet
          // V20.1 FIX: Improved lookup with better matching and logging
          var couponDiscountValue = 0;
          var couponCodeUsed = String(regData.couponCode || "").trim();
          
          if (couponCodeUsed) {
            try {
              var couponSheet = repo.getCouponSheet();
              if (couponSheet) {
                var couponData = couponSheet.getDataRange().getValues();
                var couponCodeUpper = couponCodeUsed.toUpperCase();
                
                for (var ci = 1; ci < couponData.length; ci++) {
                  var sheetCode = String(couponData[ci][0] || "").trim().toUpperCase();
                  if (sheetCode === couponCodeUpper) {
                    couponDiscountValue = Number(couponData[ci][1] || 0);
                    Logger.log("Coupon lookup SUCCESS: code=" + couponCodeUsed + ", value=" + couponDiscountValue);
                    break;
                  }
                }
                
                if (couponDiscountValue === 0) {
                  Logger.log("Coupon lookup FAILED: code=" + couponCodeUsed + " not found in Coupons sheet");
                }
              } else {
                Logger.log("Coupon lookup FAILED: Coupons sheet not found");
              }
            } catch (couponErr) {
              Logger.log("Error fetching coupon value: " + couponErr);
            }
          } else {
            Logger.log("No coupon code in registration data");
          }

          var paidData = {
            name: regData.name,
            school: regData.school,
            payMode: regData.payMode,
            competitions: normalizedCompetitions,
            genId: regData.genId,
            finalAmount: regData.finalAmount,
            couponCode: regData.couponCode,
            couponDiscount: couponDiscountValue,  // V20.0 FIX: Actual coupon value
            referralDiscount: refDiscountApplied,
            cashback: regData.cashback,
            paidAt: paidAtDate
          };

          // V22: MERGE-AWARE RECEIPTS (Master Transaction)
          var mergeMeta = MergeService.getMergeMetaForEmail_(email, regRowIndex, regSheet);
          if (mergeMeta && mergeMeta.groupId) {
            // Keep finance meta consistent across group
            try {
              MergeService.propagateFinanceMetaToGroup_(mergeMeta.groupId, {
                payRef: payRef,
                verifier: verifier,
                paidAt: paidAtDate
              });
            } catch (e) {
              AuditLogService.warn("MERGE_META_PROPAGATE_FAIL", "groupId=" + mergeMeta.groupId + " err=" + e);
            }

            if (mergeMeta.role === MergeService.ROLES.MEMBER) {
              emailSentCell.setValue("SKIPPED: MERGED (" + mergeMeta.groupId + ") " + Utils.nowTzString());
            } else {
              var groupSendRes = MergeService.sendGroupPaidReceipt_(mergeMeta.groupId, decision.force);
              emailSentCell.setValue(
                (groupSendRes.skipped ? "SKIPPED" : (groupSendRes.sent ? "SENT" : "ERROR")) +
                ": GROUP " + mergeMeta.groupId + " " + Utils.nowTzString()
              );

              // Mark members as skipped to prevent bulk resend noise
              try { MergeService.markGroupMembersEmailSkipped_(mergeMeta.groupId); } catch (e2) {}
            }
          } else {
            var paidSendRes = EmailService.sendPaidReceipt(email, regData.masterSubject, paidData, true, decision.force);
            emailSentCell.setValue((paidSendRes.skipped ? "SKIPPED" : (paidSendRes.sent ? "SENT" : "ERROR")) + ": " + Utils.nowTzString());
          }

          if (regRowIndex && sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_HASH]) {
            regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_HASH]).setValue(paidSendRes.hash || "");
          }
          if (regRowIndex && paidSendRes.sent && sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT]) {
            regSheet.getRange(regRowIndex, sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT]).setValue(Utils.nowTzString());
          }
        }
      }

      // ===== REFERRAL CREDIT PROCESSING ON PAID (V15.0 - WITH NOTIFICATIONS) =====
      // Only give referral credit when payment is verified
      try {
        if (regRowIndex) {
          var regRowData = regSheet.getRange(regRowIndex, 1, 1, regSheet.getLastColumn()).getValues()[0];
          var lockedRef = String(regRowData[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "").trim();
          var refCreditGivenCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_CREDIT_GIVEN];
          var refCreditGiven = refCreditGivenCol ? String(regSheet.getRange(regRowIndex, refCreditGivenCol).getValue() || "").trim() : "";
          
          if (lockedRef && !refCreditGiven) {
            // This person used a referral code and credit hasn't been given yet
            var referralService = new ReferralService(regSheet);
            var childGenId = regRowData[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "";
            var childName = regRowData[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "";
            var result = referralService.updateReferrer(lockedRef, "ADD", childGenId);
            
            if (result.ok) {
              // Mark that referral credit has been given
              if (refCreditGivenCol) {
                regSheet.getRange(regRowIndex, refCreditGivenCol).setValue(lockedRef + "|" + Utils.nowTzString());
              }
              AuditLogService.info("REF_CREDIT_ON_PAID", "Credited referrer " + lockedRef + " for " + email + " (payment verified)");
              
              // V15.0: Send notification to referrer
              try {
                var cashbackEarned = (result.count === 1) 
                  ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL 
                  : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
                
                var notificationData = {
                  referrerName: result.referrerName,
                  referrerCode: lockedRef,
                  referredName: childName || "A new participant",
                  referredGenId: childGenId,
                  newCount: result.count,
                  newCashback: result.cashback,
                  cashbackEarned: cashbackEarned
                };
                
                var notifResult = EmailService.sendReferralSuccessNotification(result.referrerEmail, notificationData);
                if (notifResult.sent) {
                  AuditLogService.info("REF_NOTIF_SENT", "Referral success notification sent to " + result.referrerEmail);
                } else if (notifResult.skipped) {
                  AuditLogService.info("REF_NOTIF_SKIPPED", "Referral notification skipped: " + notifResult.reason);
                }
              } catch (notifErr) {
                AuditLogService.warn("REF_NOTIF_FAIL", "Failed to send referral notification: " + notifErr);
              }
            }
          }
        }
      } catch (refCreditErr) {
        AuditLogService.error("REF_CREDIT_ON_PAID_FAIL", "Failed to process referral credit for " + email + ": " + refCreditErr);
      }

      syncMetaToReg(finPaidAtVal);
      AuditLogService.info("FIN_TO_REG_SYNC", "PAID meta synced for " + email);
      return;
    }

    var oldStatus = Utils.normalizeStatusValue(e.oldValue);
    if (
      SYSTEM_CONFIG.ADMIN.ENABLE_PAID_REVERSAL &&
      canonicalEditedHeader === "Status" &&
      oldStatus === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD &&
      status !== SYSTEM_CONFIG.ADMIN.TRIGGER_WORD
    ) {
      // ===== REFERRAL CREDIT REMOVAL ON PAID REVERSAL (V15.0 - WITH NOTIFICATIONS) =====
      // Remove referral credit when payment is reversed
      try {
        if (regRowIndex) {
          var regRowData = regSheet.getRange(regRowIndex, 1, 1, regSheet.getLastColumn()).getValues()[0];
          var lockedRef = String(regRowData[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "").trim();
          var refCreditGivenCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_CREDIT_GIVEN];
          var refCreditGiven = refCreditGivenCol ? String(regSheet.getRange(regRowIndex, refCreditGivenCol).getValue() || "").trim() : "";
          
          if (lockedRef && refCreditGiven) {
            // Credit was given, need to remove it
            var referralService = new ReferralService(regSheet);
            var childGenId = regRowData[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "";
            var childName = regRowData[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "";
            
            // Calculate what cashback will be removed (before the update)
            var repoForCalc = new SheetRepository();
            var referrerRowIndex = repoForCalc.findRegistrationRowIndexByGenId(lockedRef);
            var oldCount = 0;
            if (referrerRowIndex) {
              var referrerRow = regSheet.getRange(referrerRowIndex, SYSTEM_CONFIG.COLS.REG.REF_COUNT).getValue();
              oldCount = Number(referrerRow || 0);
            }
            var cashbackRemoved = (oldCount === 1) 
              ? SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.INITIAL 
              : SYSTEM_CONFIG.PRICING.REFERRAL_REWARD.SUBSEQUENT;
            
            var result = referralService.updateReferrer(lockedRef, "REMOVE", childGenId);
            
            if (result.ok) {
              // Clear the referral credit given marker
              if (refCreditGivenCol) {
                regSheet.getRange(regRowIndex, refCreditGivenCol).setValue("");
              }
              AuditLogService.info("REF_CREDIT_REVERSED", "Removed credit from referrer " + lockedRef + " for " + email + " (payment reversed)");
              
              // V15.0: Send notification to referrer about removed credit
              try {
                var notificationData = {
                  referrerName: result.referrerName,
                  referrerCode: lockedRef,
                  referredName: childName || "A participant",
                  referredGenId: childGenId,
                  newCount: result.count,
                  newCashback: result.cashback,
                  cashbackRemoved: cashbackRemoved
                };
                
                var notifResult = EmailService.sendReferralRemovedNotification(result.referrerEmail, notificationData);
                if (notifResult.sent) {
                  AuditLogService.info("REF_REMOVAL_NOTIF_SENT", "Referral removal notification sent to " + result.referrerEmail);
                } else if (notifResult.skipped) {
                  AuditLogService.info("REF_REMOVAL_NOTIF_SKIPPED", "Referral removal notification skipped: " + notifResult.reason);
                }
              } catch (notifErr) {
                AuditLogService.warn("REF_REMOVAL_NOTIF_FAIL", "Failed to send referral removal notification: " + notifErr);
              }
            }
          }
        }
      } catch (refRevErr) {
        AuditLogService.error("REF_CREDIT_REVERSE_FAIL", "Failed to reverse referral credit for " + email + ": " + refRevErr);
      }
      
      if (emailSentCell) emailSentCell.setValue("REVERSED: " + Utils.nowTzString());
      syncMetaToReg("");
      set(finCols.SysPaidAt, "");
      set(finCols.Status, SYSTEM_CONFIG.ADMIN.NOT_YET_WORD);
      AuditLogService.warn("PAID_REVERSAL", "Reversed payment for " + email);
      return;
    }

    syncMetaToReg(finPaidAtVal || "");
  });
}

function handleRegistrationPaidAtEditSync(e, finCols) {
  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!finCols.SysPaidAt) return;

  var row = e.range.getRow();
  if (row < 2) return;

  var email = regSheet.getRange(row, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
  if (!email) return;

  var newPaidAt = e.range.getValue();
  var finRow = repo.findFinanceRowIndexByEmail(email, finCols);
  if (!finRow) return;

  TriggerGuard.mute(function () {
    finSheet.getRange(finRow, finCols.SysPaidAt).setValue(newPaidAt || "");
    if (newPaidAt && Utils.parseMaybeDate(newPaidAt) && finCols.Status) {
      var statusCell = finSheet.getRange(finRow, finCols.Status);
      var currentStatus = Utils.normalizeStatusValue(statusCell.getValue());
      if (currentStatus !== SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
        statusCell.setValue(SYSTEM_CONFIG.ADMIN.TRIGGER_WORD);
        AuditLogService.info("REG_TO_FIN_STATUS", "Auto-set Finance status to PAID for " + email);
      }
    }
  });

  AuditLogService.info("REG_TO_FIN_SYNC", "Synced Registration SYS_PAID_AT -> Finance for " + email);
}

