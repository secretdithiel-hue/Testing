  htmlParts.push('<p style="margin-top: 20px; font-style: italic;">Para sa malayang mga kwento,<br><strong>The Husay Ng Soksay Team</strong></p>');
  htmlParts.push('</div>');
  
  htmlParts.push('</body></html>');
  
  return htmlParts.join('');
}

/**
 * Escape HTML special characters to prevent XSS
 */
function escapeHtml_(text) {
  if (!text) return "";
  return String(text)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

/**
 * Mark payment as resolved - OPTIMIZED
 */
function markPaymentResolved_Optimized(rowIndex) {
  // Clear cache to force refresh
  PVC_Cache.clear();
  
  AuditLogService.info("PAYMENT_VERIFY_RESOLVED", "Row " + rowIndex + " marked as resolved");
  return { success: true, message: "Payment marked as resolved" };
}

/**
 * Send bulk verification emails to all mismatched payments - OPTIMIZED
 * Key improvements:
 * - Batch processing with progress tracking
 * - Proper rate limiting
 * - Error recovery
 */
function sendBulkVerificationEmails_Optimized() {
  var startTime = Date.now();
  var data = getPaymentVerificationData_Optimized();
  
  if (data.error) {
    return { success: false, error: data.error };
  }
  
  var mismatches = [];
  
  for (var i = 0; i < data.payments.length; i++) {
    if (data.payments[i].status === "mismatch" && !data.payments[i].emailSent) {
      mismatches.push(data.payments[i]);
    }
  }
  
  if (mismatches.length === 0) {
    return { success: true, message: "No unsent mismatch emails to send", count: 0 };
  }
  
  // OPTIMIZATION: Process in smaller batches with progress tracking
  var BATCH_SIZE = 5;
  var sent = 0;
  var failed = 0;
  var errors = [];
  var processedIndices = [];
  
  for (var batchStart = 0; batchStart < mismatches.length; batchStart += BATCH_SIZE) {
    var batchEnd = Math.min(batchStart + BATCH_SIZE, mismatches.length);
    var currentBatch = mismatches.slice(batchStart, batchEnd);
    
    // Show progress toast every batch
    SpreadsheetApp.getActiveSpreadsheet().toast(
      "Processing batch " + (Math.floor(batchStart / BATCH_SIZE) + 1) + " of " + Math.ceil(mismatches.length / BATCH_SIZE) + 
      " (" + sent + " sent, " + failed + " failed)", 
      "📧 Bulk Email Progress", 
      3
    );
    
    for (var j = 0; j < currentBatch.length; j++) {
      try {
        var emailContent = {
          subject: "[HUSAY NG SOKSAY] Payment Verification Required - " + currentBatch[j].id,
          items: {
            paymentAmount: true,
            competitions: true,
            couponCode: false,
            referralCode: false,
            paymentMethod: true,
            proofOfPayment: true
          }
        };
        
        sendPaymentVerificationEmail_Optimized(currentBatch[j], emailContent);
        sent++;
        processedIndices.push(batchStart + j);
        
      } catch (e) {
        failed++;
        errors.push({
          email: currentBatch[j].email,
          error: e.toString()
        });
        AuditLogService.error("BULK_VERIFY_FAILED", "Failed for " + currentBatch[j].email + ": " + e.toString());
      }
      
      // Rate limiting - wait between emails (reduced from 2000ms to 1500ms)
      if (j < currentBatch.length - 1) {
        Utilities.sleep(1500);
      }
    }
    
    // Longer wait between batches
    if (batchEnd < mismatches.length) {
      Utilities.sleep(3000);
    }
  }
  
  // Clear cache after bulk operation
  PVC_Cache.clear();
  
  var duration = Date.now() - startTime;
  AuditLogService.info("BULK_VERIFY_COMPLETE", "Sent " + sent + " emails in " + duration + "ms, " + failed + " failed");
  
  return { 
    success: true, 
    message: "Sent " + sent + " emails in " + Math.round(duration / 1000) + " seconds" + (failed > 0 ? ", " + failed + " failed" : ""),
    count: sent,
    failed: failed,
    errors: errors.slice(0, 5), // Return first 5 errors only
    duration: duration
  };
}

