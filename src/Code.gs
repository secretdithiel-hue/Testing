 */
function buildEntireSystem() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var results = [];
  var errors = [];
  
  try {
    // ========================================
    // 1. CREATE/SETUP REGISTRATION SHEET
    // ========================================
