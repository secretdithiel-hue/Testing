/**
 * Apply the QUERY formula to Participant Database sheet
 */
function applyParticipantDatabaseQuery(columns) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var dbSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.PARTICIPANT_DB);
  
  if (!dbSheet) {
    dbSheet = ss.insertSheet(SYSTEM_CONFIG.SHEETS.PARTICIPANT_DB);
  }
  
  // Clear and set up the sheet
  dbSheet.clear();
  
  // Build the QUERY formula
  var sheetName = SYSTEM_CONFIG.SHEETS.REGISTRATION;
  var queryFormula = "=QUERY('" + sheetName + "'!A:AI, \"SELECT " + columns + " WHERE A IS NOT NULL\", 1)";
  
  dbSheet.getRange("A1").setFormula(queryFormula);
  
  // Format
  dbSheet.setFrozenRows(1);
  var numCols = columns.split(",").length;
  var headerRange = dbSheet.getRange(1, 1, 1, numCols);
  headerRange.setBackground("#0891b2")
             .setFontColor("white")
             .setFontWeight("bold")
             .setHorizontalAlignment("center");
  
  // Set column widths
  for (var w = 1; w <= numCols; w++) {
    dbSheet.setColumnWidth(w, 130);
  }
  
  // Add note
  dbSheet.getRange("A1").setNote(
    "📋 QUERY FORMULA\\n" +
    "Columns: " + columns + "\\n\\n" +
    "To change: Admin Center → Dashboards → Setup Participant Database Query"
  );
  
  SpreadsheetApp.flush();
  return true;
}

/**
 * Convert column number to letter (1 = A, 27 = AA, etc.)
 */
function columnToLetter_(column) {
  var letter = '';
  while (column > 0) {
    var temp = (column - 1) % 26;
    letter = String.fromCharCode(temp + 65) + letter;
    column = Math.floor((column - temp - 1) / 26);
  }
  return letter;
}

