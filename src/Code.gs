    schoolRevenue: schoolRevArr.slice(0, 30),
    dailyRevTrend: dailyRevTrend,
    bundleDiscount: bundleDiscount, couponDiscount: couponDiscount,
    refDiscount: refDiscount, cashbackTotal: cashbackTotal,
    mergeGroups: mergeGroups, payments: payments, detectedCols: colMap
  };
}

