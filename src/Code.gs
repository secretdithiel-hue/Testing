    '  if(subjects[cat] !== undefined) document.getElementById("emailSubject").value = subjects[cat];',
    '}',
    '',
    'function execCmd(cmd) { document.execCommand(cmd, false, null); document.getElementById("emailBody").focus(); }',
    'function insertLink() { var url = prompt("Enter URL:"); if(url) document.execCommand("createLink", false, url); }',
    'function insertMerge(tag) { document.execCommand("insertText", false, tag); }',
    '',
    '// Load filter options',
    'google.script.run.withSuccessHandler(function(opts) {',
    '  filterOptions = opts;',
    '  renderCompPills(opts.competitions);',
    '  updateCount();',
    '}).withFailureHandler(function(err) {',
    '  document.getElementById("compFilters").innerHTML = "<span style=\'color:#f87171;font-size:12px;\'>Error: " + err + "</span>";',
    '}).getAnnouncementFilterOptions();',
    '',
    'function renderCompPills(comps) {',
    '  var wrap = document.getElementById("compFilters");',
    '  wrap.innerHTML = "";',
    '  if(!comps || comps.length === 0) { wrap.innerHTML = "<span style=\'color:#64748b;font-size:12px;\'>No competitions found</span>"; return; }',
    '  comps.forEach(function(c) {',
    '    var pill = document.createElement("div");',
    '    pill.className = "comp-pill active";',
    '    pill.dataset.comp = c;',
    '    pill.innerHTML = "<span class=\'dot\'></span>" + c;',
    '    pill.addEventListener("click", function() {',
    '      if(this.classList.contains("active")) { this.classList.remove("active"); this.classList.add("inactive"); }',
    '      else { this.classList.remove("inactive"); this.classList.add("active"); }',
    '      updateCount();',
    '    });',
    '    wrap.appendChild(pill);',
    '  });',
    '}',
    '',
    'function getFilters() {',
    '  var comps = []; var pills = document.querySelectorAll(".comp-pill.active");',
    '  pills.forEach(function(p) { comps.push(p.dataset.comp); });',
    '  var allComps = document.querySelectorAll(".comp-pill").length;',
    '  return {',
    '    source: document.getElementById("fSource").value,',
    '    paymentStatus: document.getElementById("fPayment").value,',
    '    submissionStatus: document.getElementById("fSubStatus").value,',
    '    competitions: comps.length === allComps ? [] : comps,',
    '    specificEmails: specificTags.map(function(t){return t.toLowerCase();})',
    '  };',
    '}',
    '',
    'var specificTags = [];',
    'var liveSearchCache = [];',
    '',
    'function renderTags() {',
    '  var wrap = document.getElementById("specificTagWrap");',
    '  var inp  = document.getElementById("specificInput");',
    '  wrap.querySelectorAll(".spec-tag").forEach(function(t){ t.remove(); });',
    '  specificTags.forEach(function(tag, idx) {',
    '    var chip = document.createElement("span");',
    '    chip.className = "spec-tag";',
    '    chip.setAttribute("style","display:inline-flex;align-items:center;gap:4px;background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.4);border-radius:20px;padding:2px 10px;font-size:12px;color:#a5b4fc;");',
    '    var txt = document.createTextNode(tag + " ");',
    '    var btn = document.createElement("button");',
    '    btn.setAttribute("style","background:none;border:none;color:#818cf8;cursor:pointer;font-size:14px;line-height:1;padding:0;");',
    '    btn.textContent = "\\u00d7";',
    '    btn.dataset.idx = idx;',
    '    btn.addEventListener("click", function(e){ e.stopPropagation(); specificTags.splice(Number(this.dataset.idx),1); renderTags(); });',
    '    chip.appendChild(txt); chip.appendChild(btn);',
    '    wrap.insertBefore(chip, inp);',
    '  });',
    '  var note = document.getElementById("specificNote");',
    '  if(note) note.textContent = specificTags.length > 0 ? "Sending only to " + specificTags.length + " specific address(es)" : "";',
    '  updateCount();',
    '}',
    '',
    'function addTag(val) {',
    '  if(!val || !val.trim()) return;',
    '  val = val.trim().toLowerCase();',
    '  if(specificTags.indexOf(val) < 0) specificTags.push(val);',
    '  document.getElementById("specificInput").value = "";',
    '  hideSuggestions(); renderTags();',
    '}',
    'function specificAll() { specificTags = []; renderTags(); }',
    'function handleSpecificKey(e) {',
    '  var val = document.getElementById("specificInput").value.trim();',
    '  if(e.key === "Enter" || e.key === ",") { e.preventDefault(); addTag(val); }',
    '  if(e.key === "Backspace" && !val && specificTags.length > 0) { specificTags.pop(); renderTags(); }',
    '  if(e.key === "Escape") hideSuggestions();',
    '}',
    'function hideSuggestions() { var b = document.getElementById("specificSuggestions"); if(b) b.style.display="none"; }',
    '',
    'function liveSearch(q) {',
    '  q = (q || "").trim().toLowerCase();',
    '  var box = document.getElementById("specificSuggestions");',
    '  if(!box) return;',
    '  if(!q || liveSearchCache.length === 0) { hideSuggestions(); return; }',
    '  var matches = liveSearchCache.filter(function(r) {',
    '    return (r.email||"").indexOf(q) >= 0 || (r.name||"").toLowerCase().indexOf(q) >= 0;',
    '  }).slice(0, 8);',
    '  if(!matches.length) { hideSuggestions(); return; }',
    '  while(box.firstChild) box.removeChild(box.firstChild);',
    '  matches.forEach(function(r) {',
    '    var d = document.createElement("div");',
    '    d.setAttribute("style","padding:8px 12px;cursor:pointer;border-bottom:1px solid rgba(99,102,241,0.1);font-size:12px;");',
    '    var es = document.createElement("span"); es.setAttribute("style","color:#e2e8f0;"); es.textContent = r.email || "";',
    '    var is = document.createElement("span"); is.setAttribute("style","color:#64748b;margin-left:6px;"); is.textContent = (r.name||"") + (r.participantNum ? " \\u00b7 " + r.participantNum : "");',
    '    d.appendChild(es); d.appendChild(is);',
    '    d.dataset.email = r.email || "";',
    '    d.addEventListener("click", function(){ addTag(this.dataset.email); });',
    '    d.addEventListener("mouseover", function(){ this.style.background="#334155"; });',
    '    d.addEventListener("mouseout", function(){ this.style.background=""; });',
    '    box.appendChild(d);',
    '  });',
    '  box.style.display = "block";',
    '}',
    'document.addEventListener("click", function(e) {',
    '  var w = document.getElementById("specificTagWrap"), b = document.getElementById("specificSuggestions");',
    '  if(w && b && !w.contains(e.target) && !b.contains(e.target)) hideSuggestions();',
    '});',
    '',
    'function updateCount() {',
    '  document.getElementById("recipientCount").textContent = "Loading...";',
    '  var summary = document.querySelector(".recipient-summary");',
    '  google.script.run.withSuccessHandler(function(res) {',
    '    cachedRecipients = res.recipients || [];',
    '    if(liveSearchCache.length === 0) liveSearchCache = cachedRecipients;',
    '    else if(specificTags.length === 0) liveSearchCache = cachedRecipients;',
    '    var countEl = document.getElementById("recipientCount");',
    '    var labelEl = document.querySelector(".recipient-label");',
    '    document.getElementById("sendCount").textContent = res.count;',
    '    if(specificTags.length > 0) {',
    '      countEl.textContent = res.count + " specific recipient" + (res.count !== 1 ? "s" : "");',
    '      countEl.style.color = "#fbbf24";',
    '      if(labelEl) labelEl.innerHTML = "&#x1F3AF; Sending ONLY to selected";',
    '      if(summary) { summary.style.background = "rgba(245,158,11,0.12)"; summary.style.borderColor = "rgba(245,158,11,0.3)"; }',
    '    } else {',
    '      countEl.textContent = res.count + " participant" + (res.count !== 1 ? "s" : "");',
    '      countEl.style.color = "#a5b4fc";',
    '      if(labelEl) labelEl.textContent = "Total Recipients";',
    '      if(summary) { summary.style.background = "rgba(99,102,241,0.08)"; summary.style.borderColor = "rgba(99,102,241,0.15)"; }',
    '    }',
    '  }).withFailureHandler(function(err) {',
    '    document.getElementById("recipientCount").textContent = "Error: " + err;',
    '  }).getAnnouncementRecipients(getFilters());',
    '}',
    '',
    'function doPreview() {',
    '  var cfg = { category: selectedCategory, subject: document.getElementById("emailSubject").value, body: document.getElementById("emailBody").innerHTML, signoff: document.getElementById("emailSignoff").innerHTML };',
    '  var pane = document.getElementById("previewPane");',
    '  pane.style.display = "block";',
    '  pane.innerHTML = "<div style=\'padding:20px;text-align:center;color:#64748b;\'>Loading preview...</div>";',
    '  google.script.run.withSuccessHandler(function(res) {',
    '    if(res.success) { pane.innerHTML = res.html; } else { pane.innerHTML = "<div style=\'padding:20px;color:red;\'>Error: "+res.error+"</div>"; }',
    '  }).withFailureHandler(function(err) {',
    '    pane.innerHTML = "<div style=\'padding:20px;color:red;\'>Error: "+err+"</div>";',
    '  }).previewAnnouncementEmail(cfg);',
    '}',
    '',
    'function doSend() {',
    '  if(cachedRecipients.length === 0) { alert("No recipients selected."); return; }',
    '  var subj = document.getElementById("emailSubject").value.trim();',
    '  if(!subj) { alert("Please enter a subject."); return; }',
    '  if(!confirm("Send " + selectedCategory.toUpperCase() + " announcement to " + cachedRecipients.length + " recipient(s)?\\n\\nSubject: " + subj)) return;',
    '  var btn = document.getElementById("btnSend");',
    '  google.script.run.withSuccessHandler(function(q) {',
    '    if(q.remaining >= 0 && q.remaining < cachedRecipients.length) {',
    '      if(!confirm("\\u26A0\\uFE0F QUOTA WARNING\\n\\nYou have " + q.remaining + " emails remaining but need " + cachedRecipients.length + ".\\n\\nContinue anyway?")) {',
    '        btn.disabled = false; btn.textContent = "Send to All (" + cachedRecipients.length + ")"; return;',
    '      }',
    '    }',
    '    startSending();',
    '  }).withFailureHandler(function() { startSending(); }).getAnnouncementQuota();',
    '',
    '  function startSending() {',
    '    var body = document.getElementById("emailBody").innerHTML;',
    '    var signoff = document.getElementById("emailSignoff").innerHTML;',
    '    btn.disabled = true; btn.textContent = "\\u23F3 Sending...";',
    '    document.getElementById("progressWrap").style.display = "block";',
    '    document.getElementById("resultBox").innerHTML = "";',
    '    var batchSize = 10;',
    '    var totalSent = 0, totalFailed = 0, allErrors = [];',
    '    failedRecipientsCache = [];',
    '    var batches = [];',
    '    for(var i = 0; i < cachedRecipients.length; i += batchSize) batches.push(cachedRecipients.slice(i, i + batchSize));',
    '    function sendBatch(idx) {',
    '      if(idx >= batches.length) {',
    '        document.getElementById("progressBar").style.width = "100%";',
    '        document.getElementById("progressText").textContent = "Done! " + totalSent + " sent, " + totalFailed + " failed.";',
    '        var rb = document.getElementById("resultBox");',
    '        if(totalFailed === 0) {',
    '          rb.innerHTML = "<div class=\'result-box result-success\'>\\u2705 Successfully sent " + totalSent + " announcement email(s)!</div>";',
    '        } else {',
    '          var fh = "<div class=\'result-box result-error\'>\\u26A0\\uFE0F Sent: " + totalSent + " | Failed: " + totalFailed + "<br>" + allErrors.join("<br>") + "</div>";',
    '          fh += "<div style=\'margin-top:8px;display:flex;gap:8px;\'>";',
    '          fh += "<button class=\'btn\' style=\'background:#b45309;color:#fff;padding:8px 16px;font-size:12px;\' onclick=\'doSaveAndSchedule()\'>\\u23F0 Save & Auto-Retry</button>";',
    '          fh += "<button class=\'btn\' style=\'background:#334155;color:#e2e8f0;padding:8px 16px;font-size:12px;\' onclick=\'doSaveForManualRetry()\'>Save for Manual Retry</button>";',
    '          fh += "</div>";',
    '          rb.innerHTML = fh;',
    '        }',
    '        btn.disabled = false; btn.textContent = "Send to All (" + cachedRecipients.length + ")";',
    '        refreshQuota();',
    '        return;',
    '      }',
    '      var pct = Math.round((idx / batches.length) * 100);',
    '      document.getElementById("progressBar").style.width = pct + "%";',
    '      document.getElementById("progressText").textContent = "Batch " + (idx + 1) + "/" + batches.length + " (" + (totalSent + totalFailed) + "/" + cachedRecipients.length + ")";',
    '      google.script.run.withSuccessHandler(function(res) {',
    '        totalSent += res.sent; totalFailed += res.failed; allErrors = allErrors.concat(res.errors || []);',
    '        if(res.failedRecipients) failedRecipientsCache = failedRecipientsCache.concat(res.failedRecipients);',
    '        sendBatch(idx + 1);',
    '      }).withFailureHandler(function(err) {',
    '        totalFailed += batches[idx].length; allErrors.push("Batch error: " + err);',
    '        sendBatch(idx + 1);',
    '      }).sendAnnouncementBatch({ category: selectedCategory, subject: subj, body: body, signoff: signoff, recipients: batches[idx] });',
    '    }',
    '    sendBatch(0);',
    '  }',
    '}',
    '',
    '// ===== QUOTA =====',
    'function refreshQuota() {',
    '  google.script.run.withSuccessHandler(function(q) {',
    '    var numEl = document.getElementById("quotaNum");',
    '    var labelEl = document.getElementById("quotaLabel");',
    '    var barEl = document.getElementById("quotaBarFill");',
    '    var detailEl = document.getElementById("quotaDetail");',
    '    if(q.remaining >= 0) {',
    '      numEl.textContent = q.remaining;',
    '      var total = q.total || 100;',
    '      var used = total - q.remaining;',
    '      var pct = Math.round((q.remaining / total) * 100);',
    '      labelEl.textContent = "emails remaining today";',
    '      detailEl.textContent = used + " used of " + total + " daily limit";',
    '      barEl.style.width = pct + "%";',
    '      if(q.remaining > 50) { numEl.style.color = "#34d399"; barEl.style.background = "linear-gradient(90deg,#10b981,#34d399)"; }',
    '      else if(q.remaining > 10) { numEl.style.color = "#fbbf24"; barEl.style.background = "linear-gradient(90deg,#f59e0b,#fbbf24)"; }',
    '      else { numEl.style.color = "#f87171"; barEl.style.background = "linear-gradient(90deg,#ef4444,#f87171)"; }',
    '    } else { numEl.textContent = "?"; labelEl.textContent = "Unable to check quota"; }',
    '  }).withFailureHandler(function() {',
    '    document.getElementById("quotaNum").textContent = "?";',
    '    document.getElementById("quotaLabel").textContent = "Unable to check quota";',
    '  }).getAnnouncementQuota();',
    '}',
    'refreshQuota();',
    '',
    '// ===== QUEUE =====',
    'function checkQueue() {',
    '  google.script.run.withSuccessHandler(function(res) {',
    '    if(res.found && res.data) {',
