/**
 * Resend all pending referral notifications
 * Sends notifications to referrers who have referrals but no tracked notification
 */
function resendAllPendingReferralNotifications() {
  var ui = SpreadsheetApp.getUi();
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Scanning for pending referral notifications...", "🔗 Checking", -1);
  
  var report = EmailManager.getEmailStatusReport();
  
  if (!report.success) {
    SpreadsheetApp.getActiveSpreadsheet().toast("Error!", "❌", 3);
    ui.alert("❌ Error", report.error, ui.ButtonSet.OK);
    return;
  }
  
  // Find participants with referrals but pending/unknown notification status
  var pendingReferrers = report.participants.filter(function(p) {
    return p.refCount > 0 && p.referralNotif.status !== "SENT";
  });
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Found " + pendingReferrers.length + " pending", "🔗", 3);
  
  if (pendingReferrers.length === 0) {
    ui.alert("✅ All Clear!",
      "No pending referral notifications found.\n\n" +
      "All referrers have been notified!",
      ui.ButtonSet.OK);
    return;
  }
  
  var message = "Found " + pendingReferrers.length + " referrer(s) with pending notifications:\n\n";
  for (var i = 0; i < Math.min(pendingReferrers.length, 5); i++) {
    var p = pendingReferrers[i];
    message += "• " + p.name + " (" + p.refCount + " referral" + (p.refCount > 1 ? "s" : "") + ")\n";
  }
  if (pendingReferrers.length > 5) {
    message += "... and " + (pendingReferrers.length - 5) + " more\n";
  }
  message += "\nSend referral success notifications to all of them?";
  
  var confirm = ui.alert("🔗 Resend Referral Notifications", message, ui.ButtonSet.YES_NO);
  
  if (confirm !== ui.Button.YES) return;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending " + pendingReferrers.length + " notifications... Please wait.", "🔗 Processing", -1);
  
  var sent = 0;
  var failed = 0;
  var skipped = 0;
  var errors = [];
  
  for (var j = 0; j < pendingReferrers.length; j++) {
    var referrer = pendingReferrers[j];
    try {
      var result = EmailManager.resendReferralNotification(referrer.genId, true);
      if (result.success) {
        sent++;
      } else if (result.skipped) {
        skipped++;
      } else {
        failed++;
        errors.push(referrer.name + ": " + (result.error || result.reason || "Unknown"));
      }
    } catch (e) {
      failed++;
      errors.push(referrer.name + ": " + String(e));
    }
    
    // Rate limiting delay
    if (j < pendingReferrers.length - 1) {
      pauseBetweenEmails_();
    }
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Complete!", "🔗 Done", 3);
  
  var resultMsg = "═══════════════════════════════════\n";
  resultMsg += "🔗 REFERRAL NOTIFICATIONS COMPLETE\n";
  resultMsg += "═══════════════════════════════════\n\n";
  resultMsg += "Total Processed: " + pendingReferrers.length + "\n";
  resultMsg += "✅ Sent: " + sent + "\n";
  resultMsg += "⏭️ Skipped: " + skipped + "\n";
  resultMsg += "❌ Failed: " + failed + "\n";
  
  if (errors.length > 0) {
    resultMsg += "\nErrors:\n";
    for (var k = 0; k < Math.min(errors.length, 5); k++) {
      resultMsg += "• " + errors[k] + "\n";
    }
  }
  
  ui.alert("🔗 Results", resultMsg, ui.ButtonSet.OK);
  
  AuditLogService.info("REFNOTIF_BULK_RESEND", 
    "Bulk referral notification: sent=" + sent + ", skipped=" + skipped + ", failed=" + failed);
}

