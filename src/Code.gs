var RateLimiter = (function () {
  var COUNTER_KEY = "HNS_EMAIL_COUNTER";
  var LAST_SEND_KEY = "HNS_LAST_EMAIL_SEND";
  
  function getProps_() {
    return PropertiesService.getScriptProperties();
  }
  
  function canSendEmail() {
    var props = getProps_();
    var now = new Date().getTime();
    
    // Check cooldown
    var lastSend = Number(props.getProperty(LAST_SEND_KEY) || 0);
    var cooldownMs = SYSTEM_CONFIG.ADMIN.RATE_LIMIT.COOLDOWN_MINUTES * 60 * 1000;
    if (now - lastSend < cooldownMs) {
      return { allowed: false, reason: "Cooldown period active" };
    }
    
    // Check hourly limit
    var counterData = props.getProperty(COUNTER_KEY);
    var counter = counterData ? JSON.parse(counterData) : { count: 0, resetAt: 0 };
    
    // Reset counter if hour passed
    if (now > counter.resetAt) {
      counter = { count: 0, resetAt: now + (60 * 60 * 1000) };
    }
    
    if (counter.count >= SYSTEM_CONFIG.ADMIN.RATE_LIMIT.MAX_EMAILS_PER_HOUR) {
      return { allowed: false, reason: "Hourly email limit reached (" + counter.count + "/" + SYSTEM_CONFIG.ADMIN.RATE_LIMIT.MAX_EMAILS_PER_HOUR + ")" };
    }
    
    return { allowed: true, reason: "" };
  }
  
  function recordEmailSent() {
    var props = getProps_();
    var now = new Date().getTime();
    
    props.setProperty(LAST_SEND_KEY, String(now));
    
    var counterData = props.getProperty(COUNTER_KEY);
    var counter = counterData ? JSON.parse(counterData) : { count: 0, resetAt: now + (60 * 60 * 1000) };
    
    if (now > counter.resetAt) {
      counter = { count: 1, resetAt: now + (60 * 60 * 1000) };
    } else {
      counter.count++;
    }
    
    props.setProperty(COUNTER_KEY, JSON.stringify(counter));
  }
  
  function getStatus() {
    var props = getProps_();
    var counterData = props.getProperty(COUNTER_KEY);
    var counter = counterData ? JSON.parse(counterData) : { count: 0, resetAt: 0 };
    return {
      emailsSentThisHour: counter.count,
      maxPerHour: SYSTEM_CONFIG.ADMIN.RATE_LIMIT.MAX_EMAILS_PER_HOUR,
      resetsAt: counter.resetAt ? new Date(counter.resetAt) : null
    };
  }
  
  return {
    canSendEmail: canSendEmail,
    recordEmailSent: recordEmailSent,
    getStatus: getStatus
  };
})();

