/**
 * Get the Google Form linked to this spreadsheet
 */
function getLinkedForm_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var ssId = ss.getId();
  
  // Method 1: Check if there's a form URL in the spreadsheet
  try {
    var formUrl = ss.getFormUrl();
    if (formUrl) {
      return FormApp.openByUrl(formUrl);
    }
  } catch (e) {
    Logger.log("Method 1 failed: " + e);
  }
  
  // Method 2: Look for forms that have this spreadsheet as destination
  try {
    var forms = DriveApp.getFilesByType(MimeType.GOOGLE_FORMS);
    while (forms.hasNext()) {
      var formFile = forms.next();
      try {
        var form = FormApp.openById(formFile.getId());
        var destId = form.getDestinationId();
        if (destId === ssId) {
          return form;
        }
      } catch (formError) {
        // Skip forms we can't access
      }
    }
  } catch (e) {
    Logger.log("Method 2 failed: " + e);
  }
  
  return null;
}

/**
 * Delete a specific form response by email
 */
function deleteFormResponseByEmail_(email) {
  try {
    var form = getLinkedForm_();
    if (!form) return false;
    
    var responses = form.getResponses();
    for (var i = 0; i < responses.length; i++) {
      var response = responses[i];
      var respondentEmail = response.getRespondentEmail();
      
      if (respondentEmail && respondentEmail.toLowerCase() === email.toLowerCase()) {
        // Found the response, delete it
        form.deleteResponse(response.getId());
        Logger.log("Deleted form response for: " + email);
        return true;
      }
    }
    return false;
  } catch (e) {
    Logger.log("Error deleting form response: " + e);
    return false;
  }
}

/**
 * Helper: Delete a single registration row and related data
 */
function deleteRegistrationRow_(sheet, row, email, genId) {
  var result = { financeDeleted: 0, trackingCleared: false };
  
  // Delete from Finance sheet
  if (email) {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    
    if (finSheet) {
      var finData = finSheet.getDataRange().getValues();
      var emailCol = -1;
      
      // Find email column
      for (var c = 0; c < finData[0].length; c++) {
        if (String(finData[0][c]).toLowerCase().indexOf("email") !== -1) {
          emailCol = c;
          break;
        }
      }
      
      if (emailCol >= 0) {
        // Delete matching rows (from bottom to top)
        for (var r = finData.length - 1; r >= 1; r--) {
          if (String(finData[r][emailCol]).toLowerCase() === email.toLowerCase()) {
            finSheet.deleteRow(r + 1);
            result.financeDeleted++;
          }
        }
      }
    }
  }
  
  // Clear email tracking
  if (genId) {
    try {
      ReceiptGuard.clearTracking(genId, "REGCONF");
      ReceiptGuard.clearTracking(genId, "PAID");
      ReceiptGuard.clearTracking("REFNOTIF-" + genId, "REFNOTIF_SUCCESS");
      ReceiptGuard.clearTracking("REFNOTIF-REM-" + genId, "REFNOTIF_REMOVED");
      result.trackingCleared = true;
    } catch (e) {
      Logger.log("Error clearing tracking: " + e);
    }
  }
  
  // Delete the registration row
  sheet.deleteRow(row);
  
  return result;
}

/**
 * Helper: Clear all email tracking from properties
 */
function clearAllEmailTracking_() {
  try {
    var props = PropertiesService.getScriptProperties();
    var allProps = props.getProperties();
    var keysToDelete = [];
    
    for (var key in allProps) {
      if (key.indexOf("RECEIPT_") === 0 || 
          key.indexOf("REGCONF_") === 0 || 
          key.indexOf("PAID_") === 0 ||
          key.indexOf("REFNOTIF") === 0 ||
          key.indexOf("EMAIL_THREAD_") === 0 ||
          key.indexOf("SENT_") === 0) {
        keysToDelete.push(key);
      }
    }
    
    if (keysToDelete.length > 0) {
      props.deleteAllProperties();
      Logger.log("Cleared " + keysToDelete.length + " tracking properties");
    }
  } catch (e) {
    Logger.log("Error clearing tracking: " + e);
  }
}

/**
 * Helper: Clear all cached data
 */
function clearAllCachedData_() {
  try {
    var cache = CacheService.getScriptCache();
    cache.removeAll(["finance_data", "registration_data", "coupon_data"]);
  } catch (e) {
    Logger.log("Error clearing cache: " + e);
  }
}

