var V22_CONFIG = {
  MERGE: {
    REG_HEADERS: {
      GROUP_ID: "SYS_MERGE_GROUP_ID",
      ROLE: "SYS_MERGE_ROLE",
      PRIMARY_EMAIL: "SYS_MERGE_PRIMARY_EMAIL",
      RECEIPT_ID: "SYS_MERGE_RECEIPT_ID",
      UPDATED_AT: "SYS_MERGE_UPDATED_AT"
    },
    ROLES: {
      PRIMARY: "PRIMARY",
      MEMBER: "MEMBER"
    },
    LEDGER_SHEET: "Merge Ledger"
  },
  AUDIT: {
    SHEET: "Admin Audit Log"
  }
};

// ----------------------------------------------------------------------------
// Admin Audit Log (separate from System Logs)
// ----------------------------------------------------------------------------
var AdminAuditService = (function () {
  var SHEET_NAME = V22_CONFIG.AUDIT.SHEET;

  function getOrCreateSheet_() {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sh = ss.getSheetByName(SHEET_NAME);
    if (sh) return sh;

    sh = ss.insertSheet(SHEET_NAME);
    var headers = [
      "Timestamp",
      "Actor",
      "Action",
      "Target Email",
      "Target Gen. ID",
      "Merge Group ID",
      "Diff JSON",
      "Notes"
    ];
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    sh.setFrozenRows(1);
    return sh;
  }

  function safeActor_() {
    try {
      var email = Session.getActiveUser().getEmail();
      return email || "UNKNOWN";
    } catch (e) {
      return "UNKNOWN";
    }
  }

  function log(action, targetEmail, targetGenId, mergeGroupId, diffObj, notes) {
    try {
      var sh = getOrCreateSheet_();
      var row = [
        Utils.nowTzString ? Utils.nowTzString() : new Date().toISOString(),
        safeActor_(),
        action || "",
        targetEmail || "",
        targetGenId || "",
        mergeGroupId || "",
        JSON.stringify(diffObj || {}),
        notes || ""
      ];
      sh.appendRow(row);
    } catch (e) {
      // Never break core flows because audit logging failed
      try { AuditLogService.warn("ADMIN_AUDIT_LOG_FAIL", String(e)); } catch (e2) {}
    }
  }

  return { log: log, ensureSheet: getOrCreateSheet_ };
})();

// ----------------------------------------------------------------------------
// Group thread storage for merge-group emails (stored in Script Properties)
// ----------------------------------------------------------------------------
var GroupThreadService = (function () {
  function props_() { return PropertiesService.getScriptProperties(); }
  function key_(groupId) { return "V22_GROUP_THREAD::" + String(groupId || "").trim(); }

  function get(groupId) {
    var raw = props_().getProperty(key_(groupId)) || "";
    if (!raw) return null;
    try { return JSON.parse(raw); } catch (e) { return null; }
  }

  function set(groupId, threadId, messageId) {
    if (!groupId) return;
    props_().setProperty(key_(groupId), JSON.stringify({
      threadId: threadId || "",
      messageId: messageId || "",
      updatedAt: new Date().toISOString()
    }));
  }

  function clear(groupId) {
    if (!groupId) return;
    props_().deleteProperty(key_(groupId));
  }

  return { get: get, set: set, clear: clear };
})();

// ----------------------------------------------------------------------------
// MergeService (Master Transaction accounting + unified comms)
// ----------------------------------------------------------------------------
var MergeService = (function () {
  var HEADERS = V22_CONFIG.MERGE.REG_HEADERS;
  var ROLES = V22_CONFIG.MERGE.ROLES;
  var MANUAL_TOTAL_HEADER = "SYS_MERGE_MANUAL_TOTAL";  // persisted manual total override
  var BUNDLE_INFO_HEADER = "SYS_MERGE_BUNDLE_INFO";    // failsafe — records what bundle/manual was used

  function repo_() { return new SheetRepository(); }

  function regSheet_() { return repo_().getRegistrationSheet(); }
  function finSheet_() { return repo_().getFinanceSheet(); }
  function couponSheet_() { return repo_().getCouponSheet(); }

  function normalizeEmail_(x) { return Utils.normalizeEmail ? Utils.normalizeEmail(x) : String(x || "").toLowerCase().trim(); }

  function now_() { return Utils.nowTzString ? Utils.nowTzString() : new Date().toISOString(); }

  function newGroupId_() {
    var d = new Date();
    var stamp = Utilities.formatDate(d, SYSTEM_CONFIG.META.TIMEZONE || "GMT", "yyyyMMdd-HHmmss");
    var rand = Math.floor(Math.random() * 1e6).toString().padStart(6, "0");
    return "MTX-" + stamp + "-" + rand;
  }

  function getMergeColsIfPresent_(regSheet) {
    if (!regSheet) return null;
    var map = ColumnManager.headerMap(regSheet);
    if (!map || !map[HEADERS.GROUP_ID]) return null;
    var cols = {};
    cols[HEADERS.GROUP_ID] = map[HEADERS.GROUP_ID] || null;
    cols[HEADERS.ROLE] = map[HEADERS.ROLE] || null;
    cols[HEADERS.PRIMARY_EMAIL] = map[HEADERS.PRIMARY_EMAIL] || null;
    cols[HEADERS.RECEIPT_ID] = map[HEADERS.RECEIPT_ID] || null;
    cols[HEADERS.UPDATED_AT] = map[HEADERS.UPDATED_AT] || null;
    cols[MANUAL_TOTAL_HEADER] = map[MANUAL_TOTAL_HEADER] || null;
    cols[BUNDLE_INFO_HEADER] = map[BUNDLE_INFO_HEADER] || null;
    return cols;
  }

  function ensureMergeCols_(regSheet) {
    if (!regSheet) return null;
    var map = ColumnManager.headerMap(regSheet) || {};
    var need = [HEADERS.GROUP_ID, HEADERS.ROLE, HEADERS.PRIMARY_EMAIL, HEADERS.RECEIPT_ID, HEADERS.UPDATED_AT, MANUAL_TOTAL_HEADER, BUNDLE_INFO_HEADER];
    var missing = [];
    for (var i = 0; i < need.length; i++) {
      if (!map[need[i]]) missing.push(need[i]);
    }
    if (missing.length) {
      var lastCol = regSheet.getLastColumn();
      // Make room first: getRange fails beyond the sheet's last physical column
      if (regSheet.getMaxColumns() < lastCol + missing.length) {
        regSheet.insertColumnsAfter(regSheet.getMaxColumns(), lastCol + missing.length - regSheet.getMaxColumns());
      }
      regSheet.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
      map = ColumnManager.headerMap(regSheet) || {};
    }
    var cols = {};
    for (var j = 0; j < need.length; j++) cols[need[j]] = map[need[j]] || null;
    return cols;
  }

  function getSysCols_(regSheet) {
    // Ensures SYS_ columns exist and returns header->col index map
    return ColumnManager.ensureSysColsOnRegistration(regSheet);
  }

  function getMergeMetaForEmail_(email, regRowIndex, regSheet) {
    try {
      var sheet = regSheet || regSheet_();
      if (!sheet) return null;

      var cols = getMergeColsIfPresent_(sheet);
      if (!cols) return null;

      var rowIdx = regRowIndex || repo_().findRegistrationRowIndexByEmail(email);
      if (!rowIdx) return null;

      var groupId = cols[HEADERS.GROUP_ID] ? String(sheet.getRange(rowIdx, cols[HEADERS.GROUP_ID]).getValue() || "").trim() : "";
      if (!groupId) return null;

      var role = cols[HEADERS.ROLE] ? String(sheet.getRange(rowIdx, cols[HEADERS.ROLE]).getValue() || "").trim() : "";
      var primaryEmail = cols[HEADERS.PRIMARY_EMAIL] ? String(sheet.getRange(rowIdx, cols[HEADERS.PRIMARY_EMAIL]).getValue() || "").trim() : "";
      var receiptId = cols[HEADERS.RECEIPT_ID] ? String(sheet.getRange(rowIdx, cols[HEADERS.RECEIPT_ID]).getValue() || "").trim() : "";

      return {
        groupId: groupId,
        role: role || "",
        primaryEmail: primaryEmail || "",
        receiptId: receiptId || ""
      };
    } catch (e) {
      return null;
    }
  }

  function getLedgerSheet_() {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var name = V22_CONFIG.MERGE.LEDGER_SHEET;
    var sh = ss.getSheetByName(name);
    if (sh) return sh;

    sh = ss.insertSheet(name);
    var headers = [
      "Timestamp",
      "Group ID",
      "Created By",
      "Primary Email",
      "Participant Emails",
      "Snapshot JSON",
      "Notes"
    ];
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    sh.setFrozenRows(1);
    return sh;
  }

  function ledgerAppend_(groupId, primaryEmail, participantEmails, snapshotObj, notes) {
    var sh = getLedgerSheet_();
    var actor = "";
    try { actor = Session.getActiveUser().getEmail() || ""; } catch (e) { actor = ""; }
    sh.appendRow([
      now_(),
      groupId || "",
      actor || "UNKNOWN",
      primaryEmail || "",
      (participantEmails || []).join(", "),
      JSON.stringify(snapshotObj || {}),
      notes || ""
    ]);
  }

  function ledgerFindLatest_(groupId) {
    var sh = getLedgerSheet_();
    var last = sh.getLastRow();
    if (last < 2) return null;
    var data = sh.getRange(2, 1, last - 1, 7).getValues();
    for (var i = data.length - 1; i >= 0; i--) {
      if (String(data[i][1] || "").trim() === String(groupId || "").trim()) {
        var raw = String(data[i][5] || "").trim();
        var snap = null;
        try { snap = raw ? JSON.parse(raw) : null; } catch (e) { snap = null; }
        return {
          rowIndex: i + 2,
          timestamp: data[i][0],
          groupId: data[i][1],
          createdBy: data[i][2],
          primaryEmail: data[i][3],
          participants: String(data[i][4] || "").split(",").map(function (x) { return normalizeEmail_(x); }).filter(function (x) { return x; }),
          snapshot: snap
        };
      }
    }
    return null;
  }

  function getGroupFromRegistration_(groupId, regSheet, mergeCols) {
    var sheet = regSheet || regSheet_();
    if (!sheet) return null;

    var cols = mergeCols || getMergeColsIfPresent_(sheet);
    if (!cols) return null;

    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return null;

    var lastCol = sheet.getLastColumn();
    var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    var header = values[0];

    // Dynamically find columns by header name to avoid config vs actual layout mismatch
    var regHeaderMap = ColumnManager.headerMap(sheet);
    var emailIdx = (regHeaderMap["Email Address"] || regHeaderMap["Email"] || SYSTEM_CONFIG.COLS.REG.EMAIL) - 1;
    var nameIdx = (regHeaderMap["Full Name"] || regHeaderMap["Name"] || SYSTEM_CONFIG.COLS.REG.NAME) - 1;
    var genIdIdx = (regHeaderMap["Gen. ID"] || regHeaderMap["Gen ID"] || SYSTEM_CONFIG.COLS.REG.GEN_ID) - 1;
    var compIdx = (regHeaderMap["Which Competitions"] || regHeaderMap["Competition"] || SYSTEM_CONFIG.COLS.REG.COMPETITION) - 1;
    var finalIdx = (regHeaderMap["Total Fee"] || regHeaderMap["Final Amount"] || SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT) - 1;

    var groupCol = cols[HEADERS.GROUP_ID] ? cols[HEADERS.GROUP_ID] - 1 : -1;
    var roleCol = cols[HEADERS.ROLE] ? cols[HEADERS.ROLE] - 1 : -1;
    var primaryCol = cols[HEADERS.PRIMARY_EMAIL] ? cols[HEADERS.PRIMARY_EMAIL] - 1 : -1;
    var receiptCol = cols[HEADERS.RECEIPT_ID] ? cols[HEADERS.RECEIPT_ID] - 1 : -1;

    var participants = [];
    for (var r = 1; r < values.length; r++) {
      var row = values[r];
      var gid = groupCol >= 0 ? String(row[groupCol] || "").trim() : "";
      if (!gid || gid !== groupId) continue;
      var email = normalizeEmail_(row[emailIdx]);
      if (!email) continue;
      participants.push({
        rowIndex: r + 1,
        email: email,
        name: String(row[nameIdx] || "").trim(),
        genId: String(row[genIdIdx] || "").trim(),
        competitions: String(row[compIdx] || "").trim(),
        finalAmount: Number(row[finalIdx] || 0),
        role: roleCol >= 0 ? String(row[roleCol] || "").trim() : "",
        primaryEmail: primaryCol >= 0 ? String(row[primaryCol] || "").trim() : "",
        receiptId: receiptCol >= 0 ? String(row[receiptCol] || "").trim() : ""
      });
    }

    if (!participants.length) return null;

    // determine primary
    var primary = participants.filter(function (p) { return String(p.role || "").toUpperCase().indexOf(ROLES.PRIMARY) === 0; })[0] || null;
    var primaryEmail = primary ? primary.email : (participants[0].primaryEmail ? normalizeEmail_(participants[0].primaryEmail) : participants[0].email);
    var receiptId = (primary && primary.receiptId) ? primary.receiptId : (participants[0].receiptId || groupId);

    // compute total (fallback: sum of individual amounts)
    var total = 0;
    participants.forEach(function (p) { total += Number(p.finalAmount || 0); });

    // Override with MANUAL_TOTAL from Registration if set (persisted admin override)
    var manualTotalCol = cols[MANUAL_TOTAL_HEADER] ? cols[MANUAL_TOTAL_HEADER] - 1 : -1;
    if (manualTotalCol >= 0 && primary) {
      var mtVal = Number(values[primary.rowIndex - 1][manualTotalCol] || 0);
      if (mtVal > 0) total = mtVal;
    }

    // Fallback — check Finance sheet primary TotalAmount (handles old merges without MANUAL_TOTAL)
    if (manualTotalCol < 0 || !(Number(values[(primary ? primary.rowIndex : participants[0].rowIndex) - 1][manualTotalCol] || 0) > 0)) {
      try {
        var finSh = finSheet_();
        if (finSh) {
          var fCols = ColumnManager.getFinanceCols(finSh);
          if (fCols && fCols.Email && fCols.TotalAmount) {
            var pEmail = primaryEmail;
            var finRow = repo_().findFinanceRowIndexByEmail(pEmail, fCols);
            if (finRow) {
              var finTotal = Number(finSh.getRange(finRow, fCols.TotalAmount).getValue() || 0);
              if (finTotal > 0 && finTotal !== total) {
                total = finTotal;
              }
            }
          }
        }
      } catch (e) { /* fail silently */ }
    }

    return { groupId: groupId, primaryEmail: primaryEmail, receiptId: receiptId, participants: participants, total: total };
  }

  function ensureFinanceRowExists_(finSheet, finCols, email, payload) {
    var rowIndex = repo_().findFinanceRowIndexByEmail(email, finCols);
    if (rowIndex) return rowIndex;

    // Create via upsert (safe)
    FinanceWriter.upsertByEmail(finSheet, finCols, email, payload || { Email: email });
    rowIndex = repo_().findFinanceRowIndexByEmail(email, finCols);
    return rowIndex;
  }

  function applyAccountingToGroup_(groupObj, options) {
    options = options || {};
    var sheet = finSheet_();
    var regSheet = regSheet_();
    if (!sheet || !regSheet) return { applied: false, reason: "Missing sheets" };

    var finCols = ColumnManager.getFinanceCols(sheet);
    if (!finCols || !finCols.Email) return { applied: false, reason: "Missing Finance headers" };

    var groupId = groupObj.groupId;
    var primaryEmail = normalizeEmail_(groupObj.primaryEmail);

    // Dynamically find the Payment Status column by header name (case-insensitive)
    var regHeaderMap = ColumnManager.headerMap(regSheet);
    var payStatusCol = 0;
    var headerKeys = Object.keys(regHeaderMap);
    for (var hi = 0; hi < headerKeys.length; hi++) {
      var hLower = headerKeys[hi].toLowerCase();
      if (hLower.indexOf("payment") >= 0 && hLower.indexOf("status") >= 0) {
        payStatusCol = regHeaderMap[headerKeys[hi]];
        break;
      }
    }

    // Determine payRef/verifier/paidAt from primary (finance takes precedence, then sys cols)
    var sysCols = getSysCols_(regSheet);
    var primaryRegRow = repo_().findRegistrationRowIndexByEmail(primaryEmail);
    var payRef = "";
    var verifier = "";
    var paidAt = "";

    if (primaryRegRow) {
      try {
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]) payRef = String(regSheet.getRange(primaryRegRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).getValue() || "").trim();
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]) verifier = String(regSheet.getRange(primaryRegRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).getValue() || "").trim();
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) paidAt = String(regSheet.getRange(primaryRegRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue() || "").trim();
      } catch (e) {}
    }

    // Apply: primary total = group total, members = 0
    var appliedCount = 0;
    groupObj.participants.forEach(function (p) {
      var email = normalizeEmail_(p.email);
      if (!email) return;
      var isPrimary = (email === primaryEmail);

      var rowIndex = ensureFinanceRowExists_(sheet, finCols, email, {
        Email: email,
        Name: p.name || "",
        GenId: p.genId || ""
      });
      if (!rowIndex) return;

      // Set unified meta
      if (finCols.PayRef && payRef) sheet.getRange(rowIndex, finCols.PayRef).setValue(payRef);
      if (finCols.Verifier && verifier) sheet.getRange(rowIndex, finCols.Verifier).setValue(verifier);
      if (finCols.SysPaidAt && paidAt) sheet.getRange(rowIndex, finCols.SysPaidAt).setValue(paidAt);

      if (finCols.TotalAmount) {
        // Skip overwriting primary's total if preservePrimaryTotal is set (reapply mode)
        if (isPrimary && options.preservePrimaryTotal) {
          // Primary total already correct in Finance — don't touch it
        } else {
          sheet.getRange(rowIndex, finCols.TotalAmount).setValue(isPrimary ? Number(groupObj.total || 0) : 0);
        }
      }

      if (finCols.EmailSent && !isPrimary) {
        sheet.getRange(rowIndex, finCols.EmailSent).setValue("SKIPPED: MERGED (" + groupId + ")");
      }

      // Clear Payment Status on BOTH sheets for non-primary members (primary keeps their status)
      if (!isPrimary) {
        // Clear on Finance sheet (Status column)
        if (finCols.Status) {
          try {
            var finStatusCell = sheet.getRange(rowIndex, finCols.Status);
            finStatusCell.clearDataValidations();
            finStatusCell.clearContent();
          } catch (e) {}
        }

        // Clear on Registration sheet (Payment Status column)
        if (payStatusCol) {
          // Always look the row up by email: p.rowIndex can be stale because merged rows get
          // moved (rearranged) while groups are being reapplied, and a stale index would
          // clear another participant's status.
          var regRowForPay = repo_().findRegistrationRowIndexByEmail(email);
          if (regRowForPay) {
            var payCell = regSheet.getRange(regRowForPay, payStatusCol);
            payCell.clearDataValidations();
            payCell.clearContent();
          }
        }
      }

      appliedCount++;
    });

    return { applied: true, appliedCount: appliedCount };
  }

  // Apply visual formatting to a merge group (bold primary, color banding)
  var GROUP_COLORS_ = ["#E8F0FE", "#FCE8E6", "#FEF7E0", "#E6F4EA", "#F3E8FD", "#FDE7E0", "#E0F2F1", "#FFF3E0"];
  function groupColorForId_(gid) {
    var hash = 0;
    var s = String(gid || "");
    for (var i = 0; i < s.length; i++) { hash = ((hash << 5) - hash) + s.charCodeAt(i); hash |= 0; }
    return GROUP_COLORS_[Math.abs(hash) % GROUP_COLORS_.length];
  }

  function applyMergeFormatting_(groupObj, options) {
    options = options || {};
    var regSheet = options.regSheet || regSheet_();
    var finSheet = options.finSheet || finSheet_();
    if (!regSheet || !finSheet) return;

    var finCols = options.finCols || ColumnManager.getFinanceCols(finSheet);
    var primaryEmail = normalizeEmail_(groupObj.primaryEmail);
    var groupColor = groupColorForId_(groupObj.groupId);
    var participants = groupObj.participants || [];

    participants.forEach(function (p) {
      var email = normalizeEmail_(p.email);
      if (!email) return;
      var isPrimary = (email === primaryEmail);
      var weight = isPrimary ? "bold" : "normal";

      // Registration sheet formatting
      // (looked up by email: p.regRow is stale once merged rows have been moved together,
      // and would colour another participant's row)
      var regRow = repo_().findRegistrationRowIndexByEmail(email);
      if (regRow) {
        try {
          var rr = regSheet.getRange(regRow, 1, 1, regSheet.getLastColumn());
          rr.setBackground(groupColor);
          rr.setFontWeight(weight);
        } catch (e) {}
      }

      // Finance sheet formatting
      if (finCols && finCols.Email) {
        var finRow = repo_().findFinanceRowIndexByEmail(email, finCols);
        if (finRow) {
          try {
            var fr = finSheet.getRange(finRow, 1, 1, finSheet.getLastColumn());
            fr.setBackground(groupColor);
            fr.setFontWeight(weight);
          } catch (e) {}
        }
      }
    });
  }

  // Shared row rearrangement helper — moves member rows to follow primary
  function rearrangeGroupOnSheet_(sheet, emailCol, primaryEmail, memberEmails) {
    for (var k = 0; k < memberEmails.length; k++) {
      var memberEmail = memberEmails[k];

      var pFinder = sheet.getRange(1, emailCol, sheet.getLastRow(), 1)
        .createTextFinder(primaryEmail).matchEntireCell(true).findNext();
      if (!pFinder) break;
      var currentPrimaryRow = pFinder.getRow();

      var mFinder = sheet.getRange(1, emailCol, sheet.getLastRow(), 1)
        .createTextFinder(memberEmail).matchEntireCell(true).findNext();
      if (!mFinder) continue;
      var currentMemberRow = mFinder.getRow();

      var targetIndex = currentPrimaryRow + 1 + k;
      if (currentMemberRow === targetIndex) continue;
      if (targetIndex > sheet.getLastRow() + 1) targetIndex = sheet.getLastRow() + 1;

      try {
        sheet.moveRows(sheet.getRange(currentMemberRow, 1, 1, sheet.getLastColumn()), targetIndex);
      } catch (e) {
        AuditLogService.warn("MERGE_REORDER_FAIL", sheet.getName() + ": " + memberEmail + " err=" + e);
      }
    }
  }

  function reapplyAllMerges(options) {
    options = options || {};
    var regSheet = regSheet_();
    var finSheet = finSheet_();
    if (!regSheet || !finSheet) return { ok: false, error: "Missing sheets" };

    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols) return { ok: true, groups: 0, appliedGroups: 0, message: "No merge columns found." };

    var lastRow = regSheet.getLastRow();
    if (lastRow < 2) return { ok: true, groups: 0, appliedGroups: 0 };

    var lastCol = regSheet.getLastColumn();
    var values = regSheet.getRange(1, 1, lastRow, lastCol).getValues();

    // Dynamically find columns by header name to avoid config vs actual layout mismatch
    var regHeaderMap = ColumnManager.headerMap(regSheet);
    var emailIdx = (regHeaderMap["Email Address"] || regHeaderMap["Email"] || SYSTEM_CONFIG.COLS.REG.EMAIL) - 1;
    var nameIdx = (regHeaderMap["Full Name"] || regHeaderMap["Name"] || SYSTEM_CONFIG.COLS.REG.NAME) - 1;
    var genIdx = (regHeaderMap["Gen. ID"] || regHeaderMap["Gen ID"] || SYSTEM_CONFIG.COLS.REG.GEN_ID) - 1;
    var compIdx = (regHeaderMap["Which Competitions"] || regHeaderMap["Competition"] || SYSTEM_CONFIG.COLS.REG.COMPETITION) - 1;

    var groupCol = cols[HEADERS.GROUP_ID] ? cols[HEADERS.GROUP_ID] - 1 : -1;
    var roleCol = cols[HEADERS.ROLE] ? cols[HEADERS.ROLE] - 1 : -1;
    var primaryCol = cols[HEADERS.PRIMARY_EMAIL] ? cols[HEADERS.PRIMARY_EMAIL] - 1 : -1;
    var receiptCol = cols[HEADERS.RECEIPT_ID] ? cols[HEADERS.RECEIPT_ID] - 1 : -1;
    var manualTotalCol = cols[MANUAL_TOTAL_HEADER] ? cols[MANUAL_TOTAL_HEADER] - 1 : -1;

    var groups = {};
    for (var r = 1; r < values.length; r++) {
      var row = values[r];
      var gid = groupCol >= 0 ? String(row[groupCol] || "").trim() : "";
      if (!gid) continue;
      var email = normalizeEmail_(row[emailIdx]);
      if (!email) continue;
      if (!groups[gid]) groups[gid] = { groupId: gid, participants: [], total: 0, primaryEmail: "", receiptId: "" };

      var role = roleCol >= 0 ? String(row[roleCol] || "").trim() : "";
      var pEmail = primaryCol >= 0 ? String(row[primaryCol] || "").trim() : "";
      var rId = receiptCol >= 0 ? String(row[receiptCol] || "").trim() : "";

      var p = {
        rowIndex: r + 1,
        email: email,
        name: String(row[nameIdx] || "").trim(),
        genId: String(row[genIdx] || "").trim(),
        competitions: String(row[compIdx] || "").trim(),
        role: role
      };

      groups[gid].participants.push(p);

      if (!groups[gid].primaryEmail) {
        if (role && role.toUpperCase().indexOf(ROLES.PRIMARY) === 0) groups[gid].primaryEmail = email;
        else if (pEmail) groups[gid].primaryEmail = normalizeEmail_(pEmail);
      }
      if (!groups[gid].receiptId) groups[gid].receiptId = rId || gid;
    }

    var gids = Object.keys(groups);
    var applied = 0;
    var finCols = ColumnManager.getFinanceCols(finSheet);
    for (var i = 0; i < gids.length; i++) {
      var g = groups[gids[i]];
      // fallback primary
      if (!g.primaryEmail) {
        var p0 = g.participants[0] || null;
        g.primaryEmail = p0 ? p0.email : "";
      }

      // --- TOTAL RESOLUTION (preserve existing Finance total) ---
      // Priority 1: Manual total override from SYS_MERGE_MANUAL_TOTAL
      // Priority 2: Existing Finance TotalAmount for primary (don't recalculate)
      var resolvedTotal = 0;
      var preservePrimary = false;

      // Check manual total override first
      if (manualTotalCol >= 0 && g.primaryEmail) {
        var pp = g.participants.filter(function(x) { return x.email === g.primaryEmail; })[0];
        if (pp) {
          var mt = Number(values[pp.rowIndex - 1][manualTotalCol] || 0);
          if (mt > 0) resolvedTotal = mt;
        }
      }

      // If no manual total, read existing Finance amount for primary (preserve it)
      if (resolvedTotal === 0 && finCols && finCols.TotalAmount && g.primaryEmail) {
        try {
          var pFinRow = repo_().findFinanceRowIndexByEmail(g.primaryEmail, finCols);
          if (pFinRow) {
            var existingTotal = Number(finSheet.getRange(pFinRow, finCols.TotalAmount).getValue() || 0);
            if (existingTotal > 0) {
              resolvedTotal = existingTotal;
              preservePrimary = true;  // Don't overwrite — it's already correct
            }
          }
        } catch (e) {}
      }

      g.total = resolvedTotal;

      try {
        applyAccountingToGroup_(g, { silent: true, preservePrimaryTotal: preservePrimary });
        applied++;
        // Re-apply formatting (bold primary + group color)
        try { applyMergeFormatting_(g); } catch (fmtErr) {}
        // Re-arrange rows on both sheets
        try {
          var memberEmails = g.participants.filter(function(x) { return x.email !== g.primaryEmail; }).map(function(x) { return x.email; });
          rearrangeGroupOnSheet_(regSheet, emailIdx + 1, g.primaryEmail, memberEmails);
          if (finCols && finCols.Email) {
            rearrangeGroupOnSheet_(finSheet, finCols.Email, g.primaryEmail, memberEmails);
          }
        } catch (reorderErr) {
          AuditLogService.warn("MERGE_REORDER_GROUP_FAIL", "groupId=" + g.groupId + " err=" + reorderErr);
        }
      } catch (e) {
        AuditLogService.warn("MERGE_APPLY_GROUP_FAIL", "groupId=" + g.groupId + " err=" + e);
      }
    }

    var msg = "Reapplied " + applied + " merge group(s).";
    if (!options.silent) {
      try { SpreadsheetApp.getActiveSpreadsheet().toast("✅ " + msg, "Merge", 5); } catch (e2) {}
    }

    return { ok: true, groups: gids.length, appliedGroups: applied, message: msg };
  }

  // Reapply merge accounting for a single email (called after Finance overwrites)
  function reapplyMergeForEmail_(email) {
    email = normalizeEmail_(email);
    if (!email) return;

    var regSheet = regSheet_();
    if (!regSheet) return;

    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols || !cols[HEADERS.GROUP_ID]) return;

    var regRow = repo_().findRegistrationRowIndexByEmail(email);
    if (!regRow) return;

    var groupId = String(regSheet.getRange(regRow, cols[HEADERS.GROUP_ID]).getValue() || "").trim();
    if (!groupId) return;

    var groupObj = getGroupFromRegistration_(groupId, regSheet, cols);
    if (!groupObj || !groupObj.participants || groupObj.participants.length < 2) return;

    applyAccountingToGroup_(groupObj, { silent: true });
  }

  function propagateFinanceMetaToGroup_(groupId, meta) {
    meta = meta || {};
    var regSheet = regSheet_();
    var finSheet = finSheet_();
    if (!regSheet || !finSheet) return;

    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols) return;

    var groupObj = getGroupFromRegistration_(groupId, regSheet, cols);
    if (!groupObj) return;

    var finCols = ColumnManager.getFinanceCols(finSheet);
    var sysCols = getSysCols_(regSheet);

    groupObj.participants.forEach(function (p) {
      var email = normalizeEmail_(p.email);
      if (!email) return;

      // Finance
      var finRow = repo_().findFinanceRowIndexByEmail(email, finCols);
      if (finRow) {
        if (finCols.PayRef && meta.payRef !== undefined) finSheet.getRange(finRow, finCols.PayRef).setValue(meta.payRef || "");
        if (finCols.Verifier && meta.verifier !== undefined) finSheet.getRange(finRow, finCols.Verifier).setValue(meta.verifier || "");
        if (finCols.SysPaidAt && meta.paidAt !== undefined) finSheet.getRange(finRow, finCols.SysPaidAt).setValue(meta.paidAt || "");
      }

      // Registration SYS_
      var regRow = repo_().findRegistrationRowIndexByEmail(email);
      if (regRow) {
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF] && meta.payRef !== undefined) {
          regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).setValue(meta.payRef || "");
        }
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER] && meta.verifier !== undefined) {
          regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).setValue(meta.verifier || "");
        }
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT] && meta.paidAt !== undefined) {
          regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).setValue(meta.paidAt || "");
        }

        // Merge updated_at
        var mergeCols = ensureMergeCols_(regSheet);
        if (mergeCols && mergeCols[HEADERS.UPDATED_AT]) {
          regSheet.getRange(regRow, mergeCols[HEADERS.UPDATED_AT]).setValue(now_());
        }
      }
    });
  }

