/** Swap the old dialog palette for the HNS one, outside any embedded email. */
function applyAdminBrandTheme_(html) {
  var parts = String(html).split(EMAIL_EMBED_START_);
  function recolour(chunk) {
    return chunk
      .replace(/#[0-9a-fA-F]{6}\b/g, function (hex) { return ADMIN_THEME_HEX_MAP_[hex.toLowerCase()] || hex; })
      // Translucent white was how the dark dialogs drew faint panels, borders and grey text; on
      // paper the same job needs translucent indigo. (Nearly solid white is white text on a
      // coloured button and stays.) Light black shading becomes a lighter indigo shade.
      .replace(/rgba\(\s*255\s*,\s*255\s*,\s*255\s*,\s*([\d.]+)\s*\)/g, function (all, a) {
        return Number(a) < 0.85 ? "rgba(26,0,171," + a + ")" : all;
      })
      .replace(/rgba\(\s*0\s*,\s*0\s*,\s*0\s*,\s*([\d.]+)\s*\)/g, function (all, a) {
        return Number(a) <= 0.3 ? "rgba(26,0,171," + Math.round(Number(a) * 50) / 100 + ")" : all;
      })
      .replace(/(rgba?\(\s*)(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/g, function (all, open, r, g, b) {
        var to = ADMIN_THEME_RGB_MAP_[r + "," + g + "," + b];
        return to ? open + to : all;
      });
  }
  function themed(chunk) { return fixLowContrast_(recolour(chunk)); }
  var out = themed(parts[0]);
  for (var i = 1; i < parts.length; i++) {
    var end = parts[i].indexOf(EMAIL_EMBED_END_);
    out += EMAIL_EMBED_START_ + (end < 0 ? parts[i] : parts[i].slice(0, end) + themed(parts[i].slice(end)));
  }
  return out;
}

/**
 * Colour pairs that read well on the dark page can end up too close after the swap (dark text
 * on a dark button, white text on a paper card). Wherever one CSS rule or style attribute sets
 * both a solid background and a text colour with less than 3:1 contrast, the text becomes white
 * on a dark background or indigo ink on a light one.
 */
function fixLowContrast_(chunk) {
  function rgb(c) {
    c = String(c).toLowerCase();
    if (c === "white") c = "#ffffff";
    if (/^#[0-9a-f]{3}$/.test(c)) c = "#" + c.charAt(1) + c.charAt(1) + c.charAt(2) + c.charAt(2) + c.charAt(3) + c.charAt(3);
    if (!/^#[0-9a-f]{6}$/.test(c)) return null;
    return [1, 3, 5].map(function (k) { return parseInt(c.substr(k, 2), 16) / 255; });
  }
  function lum(v) {
    var l = v.map(function (x) { return x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); });
    return 0.2126 * l[0] + 0.7152 * l[1] + 0.0722 * l[2];
  }
  var bgRe = /background(?:-color)?\s*:\s*(?:linear-gradient\([^,]*,\s*)?(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{3}|white)\b/i;
  var fgRe = /(^|[;{\s"'])color\s*:\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{3}|white)\b/i;
  function fix(decl) {
    var bg = bgRe.exec(decl), fg = fgRe.exec(decl);
    if (!bg || !fg) return decl;
    var b = rgb(bg[1]), f = rgb(fg[2]);
    if (!b || !f) return decl;
    var lb = lum(b), lf = lum(f);
    if ((Math.max(lb, lf) + 0.05) / (Math.min(lb, lf) + 0.05) >= 3) return decl;
    var better = lb < 0.4 ? "#ffffff" : "#14006e";
    return decl.slice(0, fg.index) + fg[1] + "color:" + better + decl.slice(fg.index + fg[0].length);
  }
  return chunk
    .replace(/\{([^{}]*)\}/g, function (all, decl) { return "{" + fix(decl) + "}"; })
    .replace(/style="([^"]*)"/g, function (all, decl) { return 'style="' + fix(decl) + '"'; });
}

/**
 * Finishes a dialog: adds the shared base layer (so every dialog has the same font, dark
 * surfaces, form controls, scrollbars and focus rings), the HNS brand theme, and, when a
 * guide page is given, the small "Guide" link that opens the System Guide on the page about
 * that tool.
 * @param {string} html      the dialog's HTML
 * @param {string=} guideTab page of the guide: start, daily, prices, register, pay, email,
 *                           submit, groups, codes, menu, sheets or help. Empty = no link.
 */
function withGuideLink_(html, guideTab) {
  var branded = SYSTEM_CONFIG.BRAND.ADMIN_THEME !== "classic";
  var text = withGuideLinkUnthemed_(html, guideTab, branded);
  return branded ? applyAdminBrandTheme_(text) : text;
}

function withGuideLinkUnthemed_(html, guideTab, branded) {
  var text = String(html);
  var base = '<style id="admin-base">' + getAdminBaseCss_() + '</style>';
  if (branded) {
    var fam = function (f) { return encodeURIComponent(f).replace(/%20/g, "+"); };
    base += '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=' + fam(SYSTEM_CONFIG.BRAND.DISPLAY_FONT) +
      '&family=' + fam(SYSTEM_CONFIG.BRAND.BODY_FONT) + ':wght@400;500;600;700;800&display=swap">';
  }

  // Some dialogs were written without a charset tag; make sure symbols and the peso sign
  // are always read as UTF-8. The base layer goes first so the dialog's own styles win.
  var headAt = text.search(/<head[^>]*>/i);
  var headBits = (/<meta[^>]+charset/i.test(text) ? '' : '<meta charset="utf-8">') + base;
  if (headAt >= 0) {
    var headEnd = text.indexOf(">", headAt) + 1;
    text = text.slice(0, headEnd) + headBits + text.slice(headEnd);
  } else {
    text = headBits + text;
  }

  if (branded) {
    var brandCss = '<style id="admin-brand">' + getAdminBrandCss_() + '</style>';
    var headClose = text.search(/<\/head>/i);
    text = headClose >= 0 ? text.slice(0, headClose) + brandCss + text.slice(headClose) : brandCss + text;
  }

  var tab = String(guideTab || "").replace(/[^a-z]/g, "");
  if (!tab) return text;
  var link =
    '<div style="position:fixed;left:10px;bottom:8px;z-index:2147483000;font-family:Arial,sans-serif;">' +
    '<a href="#" title="Open the System Guide on the page about this tool" ' +
    'onclick="if(confirm(\'Open the System Guide? This window will close.\')){google.script.run.showSystemIntroduction(\'' + tab + '\');}return false;" ' +
    'style="display:inline-block;padding:4px 10px;border-radius:12px;background:rgba(22,27,34,0.92);color:#c9d1d9;font-size:11px;line-height:1.4;text-decoration:none;border:1px solid #30363d;">' +
    '&#x2753; Guide</a></div>';
  var at = text.lastIndexOf("</body>");
  return at >= 0 ? text.slice(0, at) + link + text.slice(at) : text + link;
}

/**
 * The inner part of an email (a whole HTML document) made safe to show inside a dialog:
 * its html / head / body tags are dropped and any style rule aimed at "body" is aimed at
 * the white preview sheet instead, so the email cannot restyle the dialog around it.
 */
function emailHtmlForEmbedding_(html) {
  var text = String(html || "");
  var styles = (text.match(/<style[\s\S]*?<\/style>/gi) || []).join("")
    .replace(/(^|[},\s>])(?:html\s+)?body(?=[\s,{])/gi, "$1.ui-paper");
  var bodyMatch = /<body[^>]*>([\s\S]*)<\/body>/i.exec(text);
  var inner = bodyMatch
    ? bodyMatch[1]
    : text.replace(/<!DOCTYPE[^>]*>/i, "").replace(/<\/?html[^>]*>/gi, "").replace(/<head[\s\S]*?<\/head>/i, "").replace(/<style[\s\S]*?<\/style>/gi, "");
  return styles + inner;
}

/**
 * A dialog that shows one email the way the recipient will see it, framed like a mail window.
 * @param {string} title      what is being previewed
 * @param {string} emailHtml  the email's HTML
 * @param {string=} note      what to tell the admin above the preview
 */
function buildEmailPreviewDialog_(title, emailHtml, note) {
  var esc = Utils.escapeHtml;
  var body =
    uiCallout_("", "&#x1F441;&#xFE0F;", "<b>Preview only.</b> " + esc(note || "It uses sample data. No email was sent.")) +
