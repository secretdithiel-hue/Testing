 * Get System Updater HTML dialog
 */
function getSystemUpdaterHtml_(sheetName, selectionType) {
  var selectionDesc = "";
  switch (selectionType.type) {
    case "WHOLE_SHEET": selectionDesc = "Entire sheet (" + selectionType.rows + " rows)"; break;
    case "SINGLE_ROW": selectionDesc = "Row " + selectionType.row; break;
    case "SINGLE_COLUMN": selectionDesc = "Column " + selectionType.col + " (" + selectionType.rows + " cells)"; break;
    case "RANGE": selectionDesc = "Range: " + selectionType.rows + " rows × " + selectionType.cols + " columns"; break;
    case "MULTIPLE_ROWS": selectionDesc = "Rows " + selectionType.startRow + " to " + (selectionType.startRow + selectionType.rows - 1); break;
    default: selectionDesc = "Selected area";
  }
  
  // Determine sheet type and available actions
  var sheetType = detectSheetType_(sheetName);
  var actionsHtml = getActionsForSheetType_(sheetType);
  
  return '<!DOCTYPE html><html><head><style>' +
    'body { font-family: "Segoe UI", Arial, sans-serif; padding: 20px; background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: white; margin: 0; min-height: 100vh; }' +
    'h1 { margin: 0 0 5px 0; font-size: 28px; }' +
