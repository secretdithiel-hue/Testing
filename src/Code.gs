/**
 * Auto-detect columns and generate SYSTEM_CONFIG code
 */
function autoDetectColumnMapping() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  
  if (!regSheet) {
    ui.alert("❌ Error", "Registration sheet not found!", ui.ButtonSet.OK);
    return;
  }
  
  var lastCol = regSheet.getLastColumn();
  if (lastCol === 0) {
    ui.alert("❌ Error", "Registration sheet has no columns!", ui.ButtonSet.OK);
    return;
  }
  
  var headers = regSheet.getRange(1, 1, 1, lastCol).getValues()[0];
  
  // Define mapping patterns (header text -> config key)
  var patterns = [
    { pattern: /^timestamp$/i, key: "TIMESTAMP" },
    { pattern: /^email/i, key: "EMAIL" },
    { pattern: /full\s*name$/i, key: "NAME" },
    { pattern: /school\s*name/i, key: "SCHOOL" },
    { pattern: /how\s*many.*competition/i, key: "COMPETITION_COUNT" },
    { pattern: /which.*competition/i, key: "COMPETITION" },
    { pattern: /mode.*payment/i, key: "PAY_MODE" },
    { pattern: /proof.*payment/i, key: "PAY_PROOF" },
    { pattern: /^referral\s*code$/i, key: "REF_INPUT" },
    { pattern: /^coupon\s*code$/i, key: "COUPON_INPUT" },
    { pattern: /^gen\.?\s*id$/i, key: "GEN_ID" },
    { pattern: /^base\s*fee$/i, key: "BASE_FEE" },
    { pattern: /^bundle\s*discount$/i, key: "BUNDLE_DISCOUNT" },
    { pattern: /^coupon\s*discount$/i, key: "COUPON_DISCOUNT" },
    { pattern: /^referral\s*discount$/i, key: "REF_DISCOUNT" },
    { pattern: /^total\s*fee$/i, key: "TOTAL_FEE" },
    { pattern: /^payment\s*status$/i, key: "PAYMENT_STATUS" },
    { pattern: /^referral\s*count$/i, key: "REF_COUNT" },
    { pattern: /^referral\s*earnings$/i, key: "REF_EARNINGS" },
    { pattern: /^cashback$/i, key: "CASHBACK" },
    { pattern: /^email\s*sent$/i, key: "EMAIL_SENT" },
    { pattern: /^or\s*email\s*sent$/i, key: "OR_EMAIL_SENT" },
    { pattern: /^remarks$/i, key: "REMARKS" },
    { pattern: /^locked[_\s]*coupon$/i, key: "LOCKED_COUPON" },
    { pattern: /^locked[_\s]*ref$/i, key: "LOCKED_REF" },
    { pattern: /^master[_\s]*subject$/i, key: "MASTER_SUBJECT" },
    { pattern: /^final[_\s]*amount$/i, key: "FINAL_AMOUNT" },
    { pattern: /^sys[_\s]*processed$/i, key: "SYS_PROCESSED" },
    { pattern: /^sys[_\s]*referrer[_\s]*credited$/i, key: "SYS_REFERRER_CREDITED" },
    { pattern: /^sys[_\s]*ref[_\s]*notif/i, key: "SYS_REF_NOTIF_SENT" },
    { pattern: /^sys[_\s]*paid[_\s]*at$/i, key: "SYS_PAID_AT" },
    { pattern: /^sys[_\s]*verifier$/i, key: "SYS_VERIFIER" },
    { pattern: /^sys[_\s]*ref[_\s]*discount$/i, key: "SYS_REF_DISCOUNT" },
    { pattern: /^sys[_\s]*ref[_\s]*credit/i, key: "SYS_REF_CREDIT_GIVEN" },
    { pattern: /^sys[_\s]*email[_\s]*thread/i, key: "SYS_EMAIL_THREAD_ID" }
  ];
  
  // Detect columns
  var detected = {};
  var unmatched = [];
  
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i] || "").trim();
    if (!h) continue;
    
    var matched = false;
    for (var p = 0; p < patterns.length; p++) {
      if (patterns[p].pattern.test(h)) {
        detected[patterns[p].key] = i + 1;
        matched = true;
        break;
      }
    }
    
    if (!matched) {
      unmatched.push({ col: i + 1, header: h });
    }
  }
  
  // Build HTML report
  var html = '<div class="ui-grid" style="margin-bottom:14px;">' +
    uiStat_(Object.keys(detected).length, "System columns found", "ok") +
    uiStat_(unmatched.length, "Not used by the system", "") +
    '</div>';

  // Generate config code
  var configCode = "COLS: {\n  REG: {\n";
  var sortedKeys = Object.keys(detected).sort(function(a, b) {
    return detected[a] - detected[b];
  });
  
  for (var k = 0; k < sortedKeys.length; k++) {
    var key = sortedKeys[k];
    configCode += "    " + key + ": " + detected[key] + ",\n";
  }
  configCode += "  }\n}";
  
  html += '<div class="ui-card">' +
    '<h2 class="ui-card-title">Generated COLS.REG block</h2>' +
    '<p class="ui-hint" style="margin:0 0 10px;">Copy this over the COLS.REG part of SYSTEM_CONFIG:</p>' +
    '<pre class="ui-code">' + Utils.escapeHtml(configCode) + '</pre>' +
    '</div>';
  
  // Missing important columns warning
  var criticalMissing = [];
  var critical = ["GEN_ID", "TOTAL_FEE", "PAYMENT_STATUS", "LOCKED_COUPON", "LOCKED_REF"];
  for (var c = 0; c < critical.length; c++) {
    if (!detected[critical[c]]) {
      criticalMissing.push(critical[c]);
    }
  }
  
  if (criticalMissing.length > 0) {
    html += '<div class="warning">' +
      '<strong>⚠️ Missing Critical Columns:</strong> ' + criticalMissing.join(", ") + '<br>' +
      'Run ' + Utils.escapeHtml(getMenuPathText_("checkAndFixColumns")) + ' to add these automatically!' +
      '</div>';
  } else {
    html += '<div class="success">' +
      '<strong>✅ All critical columns found!</strong> Your sheet structure looks good.' +
      '</div>';
  }
  
  // Unmatched columns
  if (unmatched.length > 0) {
    html += '<div class="ui-card">' +
      '<h2 class="ui-card-title">Columns the system does not use<span class="count">' + unmatched.length + '</span></h2>' +
      '<p class="ui-hint" style="margin:0 0 10px;">Usually questions that only the form needs.</p>' +
      '<ul style="font-size:12px; max-height:150px; overflow-y:auto;">';
    for (var u = 0; u < unmatched.length; u++) {
      html += '<li><b>' + columnToLetter_(unmatched[u].col) + '</b> ' + Utils.escapeHtml(String(unmatched[u].header)) + '</li>';
    }
    html += '</ul></div>';
  }
  
  var dialog = HtmlService.createHtmlOutput(withGuideLink_(buildAdminDialog_({
      icon: "&#x1F50E;",
      title: "Auto-detected column mapping",
      subtitle: "Read from the headers of " + SYSTEM_CONFIG.SHEETS.REGISTRATION,
      actions: '<button class="ui-btn" onclick="google.script.host.close()">Close</button>',
      body: html
    }), "sheets"))
    .setWidth(680)
    .setHeight(620);
  ui.showModalDialog(dialog, "🔎 Auto-Detect Column Mapping");
}

/**
 * Quick test of column functionality
 */
function testColumnAccess() {
  var ui = SpreadsheetApp.getUi();
  
  var result = ColumnStructure.testColumnFunctionality();
  
  var lines = [];
  lines.push("🧪 COLUMN FUNCTIONALITY TEST");
  lines.push("============================");
  lines.push("");
  
  for (var i = 0; i < result.tests.length; i++) {
    var test = result.tests[i];
    lines.push(test.status + " " + test.name);
    if (test.value) {
      lines.push("    Value: " + test.value);
    }
    if (test.message) {
      lines.push("    " + test.message);
    }
    lines.push("");
  }
  
  if (result.warning) {
    lines.push("⚠️ " + result.warning);
  }
  
  var title = result.success ? "✅ All Tests Passed" : "⚠️ Some Issues Found";
  ui.alert(title, lines.join("\n"), ui.ButtonSet.OK);
  AuditLogService.info("COL_TEST", result.success ? "All tests passed" : "Some tests failed");
}

/**
 * Shows detailed column mapping for debugging
 */
function showColumnMapping() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);

  if (!regSheet) {
    ui.alert("❌ Error", "Registration sheet not found!", ui.ButtonSet.OK);
    return;
  }

  var lastCol = regSheet.getLastColumn();
  var headers = lastCol > 0 ? regSheet.getRange(1, 1, 1, lastCol).getValues()[0] : [];
  var esc = Utils.escapeHtml;

  // Every setting that points at a column (some columns have two names, e.g. TOTAL_FEE / FINAL_AMOUNT)
  var keysByCol = {};
  function note(col, key) { if (col) (keysByCol[col] = keysByCol[col] || []).push(key); }
  Object.keys(SYSTEM_CONFIG.COLS.REG).forEach(function (key) { if (!/^CATEGORIES_/.test(key)) note(SYSTEM_CONFIG.COLS.REG[key], key); });
  Object.keys(SYSTEM_CONFIG.SYS_REG_COLS || {}).forEach(function (key) { note(SYSTEM_CONFIG.SYS_REG_COLS[key], key); });
  Object.keys(SYSTEM_CONFIG.SYS_REG_COLS_END || {}).forEach(function (key) { note(SYSTEM_CONFIG.SYS_REG_COLS_END[key], key); });

  var used = 0;
  var rows = [];
  for (var i = 0; i < headers.length; i++) {
    var col = i + 1;
    var header = String(headers[i] === null || headers[i] === undefined ? "" : headers[i]).trim();
    var keys = keysByCol[col] || [];
    if (keys.length) used++;
    rows.push([
      '<b>' + columnToLetter_(col) + '</b> <span class="ui-muted">' + col + '</span>',
      header ? esc(header.length > 80 ? header.substring(0, 80) + "…" : header) : '<span class="ui-muted">(empty)</span>',
      keys.length ? '<code>' + esc(keys.join(" / ")) + '</code>' : '<span class="ui-muted">—</span>'
    ]);
  }

  var body =
    '<div class="ui-grid" style="margin-bottom:14px;">' +
      uiStat_(lastCol, "Columns in the sheet", "info") +
      uiStat_(used, "Used by the system", "ok") +
      uiStat_(lastCol - used, "Form-only columns", "") +
    '</div>' +
    '<p class="ui-lead">Each column of <b>' + esc(SYSTEM_CONFIG.SHEETS.REGISTRATION) + '</b>, with the setting that points at it. ' +
    'A header that does not match its setting means a column was moved.</p>' +
    '<div class="ui-scroll" style="max-height:none;">' + uiTable_(["Column", "Header in the sheet", "Setting"], rows, "The sheet has no columns yet.") + '</div>';

  var html = HtmlService.createHtmlOutput(withGuideLink_(buildAdminDialog_({
      icon: "&#x1F4CB;",
      title: "Column headers",
      subtitle: SYSTEM_CONFIG.SHEETS.REGISTRATION,
      actions: '<button class="ui-btn" onclick="google.script.host.close()">Close</button>',
      body: body
    }), "sheets"))
    .setWidth(640)
    .setHeight(640)
    .setTitle("Column Mapping");

  ui.showModalDialog(html, "📋 Column Mapping");
}

