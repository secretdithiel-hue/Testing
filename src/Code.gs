 */
function buildAnnouncementHtml_(category, subject, body, recipientData) {
  var BLUE = "#1E4FB8";
  var GOLD = "#FFD700";
  var contactConfig = SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.CONTACT || {};
  var esc = Utils.escapeHtml;

  // Category banner colors
  var banners = {
    general:     { color: "#1E4FB8", icon: "📢", label: "GENERAL ANNOUNCEMENT" },
    reminder:    { color: "#D97706", icon: "⏰", label: "DEADLINE REMINDER" },
    competition: { color: "#7C3AED", icon: "🏆", label: "COMPETITION UPDATE" },
    payment:     { color: "#059669", icon: "💰", label: "PAYMENT NOTICE" },
    custom:      { color: "#475569", icon: "✉️", label: "ANNOUNCEMENT" }
  };
  var banner = banners[category] || banners.custom;

  // Merge field replacement
  var mergedBody = body
    .replace(/\{\{NAME\}\}/gi, esc(recipientData.name || "Participant"))
    .replace(/\{\{GEN_ID\}\}/gi, esc(recipientData.genId || "N/A"))
    .replace(/\{\{COMPETITION\}\}/gi, esc(recipientData.competition || "N/A"))
    .replace(/\{\{SCHOOL\}\}/gi, esc(recipientData.school || "N/A"))
    .replace(/\{\{REGION\}\}/gi, esc(recipientData.region || "N/A"))
    .replace(/\{\{PARTICIPANT_NUM\}\}/gi, esc(recipientData.participantNum || "N/A"));

  var h = [];
  h.push('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">');
  h.push('<title>' + esc(subject) + '</title></head>');
  h.push('<body style="margin:0;padding:0;background:#f1f5f9;font-family:Verdana,Geneva,sans-serif;">');
  h.push('<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f1f5f9;"><tr><td align="center" style="padding:20px 10px;">');
  h.push('<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);">');

  // Header (shared)
  h.push('<tr><td>');
  h.push('<div style="background-color:' + BLUE + ';padding:16px 10px;text-align:center;border-bottom:6px solid ' + GOLD + ';">');
  h.push('<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 auto;max-width:600px;">');
  h.push('<tr>');
  h.push('<td width="20%" align="center" valign="middle" style="padding:0 5px;"><img src="cid:uplb_logo" alt="UPLB Sociology Society" style="max-width:70px;height:auto;display:block;margin:0 auto;"></td>');
  h.push('<td width="60%" align="center" valign="middle" style="padding:0 5px;">');
  h.push('<div style="color:' + GOLD + ';font-family:Times New Roman,serif;font-size:24px;letter-spacing:2px;font-weight:800;">HUSAY NG SOKSAY</div>');
  h.push('<div style="margin-top:4px;color:#ffffff;font-size:11px;letter-spacing:1px;">UPLB SOCIOLOGY SOCIETY</div>');
  h.push('</td>');
  h.push('<td width="20%" align="center" valign="middle" style="padding:0 5px;"><img src="cid:husay_logo" alt="Husay ng Soksay" style="max-width:70px;height:auto;display:block;margin:0 auto;"></td>');
  h.push('</tr></table></div>');
  h.push('</td></tr>');

  // Category Banner
  h.push('<tr><td>');
  h.push('<div style="background:' + banner.color + ';padding:14px 20px;text-align:center;">');
  h.push('<span style="color:#ffffff;font-size:16px;font-weight:bold;letter-spacing:1px;">' + banner.icon + ' ' + banner.label + '</span>');
  h.push('</div></td></tr>');



  // Body content
  h.push('<tr><td style="padding:16px 30px 20px;">');
  h.push('<div style="font-size:14px;line-height:1.6;color:#1e293b;">');
