/**
 * Resend all pending OR emails (PAID but OR not sent)
 */
function resendAllPendingOREmails() {
  var ui = SpreadsheetApp.getUi();
  
  var report = EmailManager.getEmailStatusReport();
  
  if (!report.success) {
    ui.alert("❌ Error", report.error, ui.ButtonSet.OK);
    return;
  }
  
  var pending = report.issues.pendingPaidReceipts;
  
  if (pending.length === 0) {
    ui.alert("✅ All Clear!",
      "No pending OR emails found.\n\n" +
      "All PAID participants have received their Acknowledgement Receipts.",
      ui.ButtonSet.OK);
    return;
  }
  
  var message = "Found " + pending.length + " PAID participant(s) without OR emails:\n\n";
  for (var i = 0; i < Math.min(pending.length, 5); i++) {
    message += "• " + pending[i].name + " (" + pending[i].email + ")\n";
  }
  if (pending.length > 5) {
    message += "... and " + (pending.length - 5) + " more\n";
  }
  message += "\nSend Acknowledgement Receipt emails to all of them?";
  
  var confirm = ui.alert("📧 Resend Pending OR Emails", message, ui.ButtonSet.YES_NO);
  
  if (confirm !== ui.Button.YES) return;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending " + pending.length + " emails... Please wait.", "📧 Processing", -1);
  
  var sent = 0;
  var failed = 0;
  var errors = [];
  
  for (var j = 0; j < pending.length; j++) {
    var p = pending[j];
    try {
      var result = EmailManager.resendPaidReceipt(p.email, true);
      if (result.success) {
        sent++;
      } else {
        failed++;
        errors.push(p.email + ": " + (result.error || result.reason || "Unknown"));
      }
    } catch (e) {
      failed++;
      errors.push(p.email + ": " + String(e));
    }
    
    if (j < pending.length - 1) {
      Utilities.sleep(1500);
    }
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Complete!", "📧 Done", 3);
  
  var resultMsg = "═══════════════════════════════════\n";
  resultMsg += "📧 RESEND PENDING OR COMPLETE\n";
  resultMsg += "═══════════════════════════════════\n\n";
  resultMsg += "✅ Sent: " + sent + "\n";
  resultMsg += "❌ Failed: " + failed + "\n";
  
  if (errors.length > 0) {
    resultMsg += "\nErrors:\n";
    for (var k = 0; k < Math.min(errors.length, 5); k++) {
      resultMsg += "• " + errors[k] + "\n";
    }
  }
  
  ui.alert("📧 Results", resultMsg, ui.ButtonSet.OK);
}

