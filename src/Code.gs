var ColumnStructure = (function() {
  
  /**
   * Tests if the system can correctly read data from configured columns
   */
  function testColumnFunctionality() {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    
    if (!regSheet) {
      return { success: false, error: "Registration sheet not found" };
    }
    
    var tests = [];
    var lastRow = regSheet.getLastRow();
    
    if (lastRow < 2) {
      return {
        success: true,
        tests: [{ name: "Data Check", status: "⚠️ NO DATA", message: "No data rows to test" }],
        warning: "No data rows found. Column structure looks OK but cannot verify data access."
      };
    }
    
    // Read first data row
    var testRow = 2;
    var rowData = regSheet.getRange(testRow, 1, 1, regSheet.getLastColumn()).getValues()[0];
    
    // Test each key column
    var columnTests = [
      { key: "EMAIL", col: SYSTEM_CONFIG.COLS.REG.EMAIL, validator: function(v) { return v && String(v).indexOf("@") > 0; } },
      { key: "NAME", col: SYSTEM_CONFIG.COLS.REG.NAME, validator: function(v) { return v && String(v).trim().length > 0; } },
      { key: "GEN_ID", col: SYSTEM_CONFIG.COLS.REG.GEN_ID, validator: function(v) { return true; } } // May be empty for new rows
    ];
    
    for (var i = 0; i < columnTests.length; i++) {
      var ct = columnTests[i];
      var value = rowData[ct.col - 1];
      var isValid = ct.validator(value);
      
      tests.push({
        name: ct.key + " (Col " + ct.col + ")",
        value: value ? String(value).substring(0, 30) : "(empty)",
        status: isValid ? "✅ OK" : "⚠️ CHECK",
        message: isValid ? "Value accessible" : "Value may be in wrong column or empty"
      });
    }
    
    // Test Finance sheet
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    if (finSheet) {
      tests.push({
        name: "Finance Sheet",
        status: "✅ EXISTS",
        message: "'" + SYSTEM_CONFIG.SHEETS.FINANCE + "' found"
      });
    } else {
      tests.push({
        name: "Finance Sheet",
        status: "⚠️ MISSING",
        message: "'" + SYSTEM_CONFIG.SHEETS.FINANCE + "' not found - create it with " + getMenuPathText_("showSystemBuilder")
      });
    }
    
    // Test Coupon sheet
    var coupSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.COUPONS);
    if (coupSheet) {
      tests.push({
        name: "Coupon Sheet",
        status: "✅ EXISTS",
        message: "'" + SYSTEM_CONFIG.SHEETS.COUPONS + "' found"
      });
    } else {
      tests.push({
        name: "Coupon Sheet",
        status: "⚠️ MISSING",
        message: "'" + SYSTEM_CONFIG.SHEETS.COUPONS + "' not found - create it with " + getMenuPathText_("showSystemBuilder")
      });
    }
    
    var allPassed = tests.every(function(t) { return t.status === "✅ OK" || t.status === "✅ EXISTS"; });
    
    return {
      success: allPassed,
      tests: tests
    };
  }
  
  return {
    testColumnFunctionality: testColumnFunctionality
  };
})();

