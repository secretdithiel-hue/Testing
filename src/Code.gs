var ReceiptGuard = (function () {
  function props_() { return PropertiesService.getScriptProperties(); }
  function key_(genId, kind) { return "RECEIPT_HASH::" + kind + "::" + String(genId || "").trim(); }
  function metaKey_(genId, kind) { return "RECEIPT_META::" + kind + "::" + String(genId || "").trim(); }

  function getLast_(genId, kind) {
    var hash = props_().getProperty(key_(genId, kind)) || "";
    var meta = props_().getProperty(metaKey_(genId, kind)) || "";
    var metaObj = {};
    try { metaObj = meta ? JSON.parse(meta) : {}; } catch (e) {}
    return { hash: hash, meta: metaObj };
  }

  function setLast(genId, kind, hash, metaObj) {
    props_().setProperty(key_(genId, kind), hash || "");
    props_().setProperty(metaKey_(genId, kind), JSON.stringify(metaObj || {}));
  }
  
  function clearTracking(genId, kind) {
    props_().deleteProperty(key_(genId, kind));
    props_().deleteProperty(metaKey_(genId, kind));
  }

  function shouldSkipDuplicate(genId, kind, newHash) {
    var last = getLast_(genId, kind);
    if (!last.hash) return { skip: false, reason: "" };
    if (last.hash !== newHash) return { skip: false, reason: "" };

    var lastSentAt = (last.meta && last.meta.sentAt) ? new Date(last.meta.sentAt) : null;
    if (!lastSentAt || isNaN(lastSentAt.getTime())) return { skip: false, reason: "" };

    var hours = Utils.hoursBetween(new Date(), lastSentAt);
    if (hours <= SYSTEM_CONFIG.ADMIN.DUPLICATE_SEND_WINDOW_HOURS) {
      return { skip: true, reason: "Duplicate within " + SYSTEM_CONFIG.ADMIN.DUPLICATE_SEND_WINDOW_HOURS + "h" };
    }
    return { skip: false, reason: "" };
  }

  return { setLast: setLast, shouldSkipDuplicate: shouldSkipDuplicate, clearTracking: clearTracking };
})();

