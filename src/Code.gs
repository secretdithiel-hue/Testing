/**
 * Get details of all entries within a single submission row (for Entry Editor).
 * @param {number} rowIndex
 */
function getSubmissionEntryDetails(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");
  
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;
  
  var email = String(rowVals[S.EMAIL - 1] || "").trim();
  var rawCompType = String(rowVals[S.COMPETITION_TYPE - 1] || "").trim();
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  
  var partNumsRaw = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var partNums = partNumsRaw.split(/\s*,\s*/).filter(function(n) { return n.length > 0; });

  var entries = [];
  var PREFIXES = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;
  
  for (var i = 0; i < compTypes.length; i++) {
    var compName = compTypes[i];
    var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compName];
    if (!compMap) continue; // Unrecognized
    
    // Find matching participant number based on prefix
    var expectedPrefix = PREFIXES[compMap.key];
    var pNum = "";
    for (var j = 0; j < partNums.length; j++) {
      if (partNums[j].indexOf(expectedPrefix + "-") === 0) {
        pNum = partNums[j];
        break;
      }
    }
    
    // Get basic details
    var name = compMap.nameCol ? String(rowVals[S[compMap.nameCol] - 1] || "").trim() : "";
    var region = compMap.regionCol ? String(rowVals[S[compMap.regionCol] - 1] || "").trim() : "";
    var school = compMap.schoolCol ? String(rowVals[S[compMap.schoolCol] - 1] || "").trim() : "";
    var title = compMap.titleCol ? String(rowVals[S[compMap.titleCol] - 1] || "").trim() : "";
    
    // Get file links (original uploaded files)
    var files = [];
    if (compMap.fileCols) {
      for (var f = 0; f < compMap.fileCols.length; f++) {
        var fileLink = String(rowVals[S[compMap.fileCols[f]] - 1] || "").trim();
        if (fileLink) files.push(fileLink);
      }
    }
    
    entries.push({
      competition: compName,
      key: compMap.key,
      participantNum: pNum || "Not Generated",
      name: name,
      region: region,
      school: school,
      title: title,
      files: files,
      canRemove: compTypes.length > 1 // Can only remove if there's more than 1 entry left
    });
  }

  return {
    success: true,
    data: {
      row: rowIndex,
      email: email,
      timestamp: String(rowVals[S.TIMESTAMP - 1] || ""),
      totalEntries: compTypes.length,
      entries: entries
    }
  };
}

/**
 * Remove a specific competition entry from a submission row.
 * Clears data columns, updates col E, removes participant numbers, and trashes anon files.
 * @param {number} rowIndex
 * @param {string} competitionName
 */
function removeSubmissionEntry(rowIndex, competitionName) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var range = subSheet.getRange(rowIndex, 1, 1, width);
  var rowVals = range.getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;
  
  // 1. Validate multiple entries exist
  var rawCompType = String(rowVals[S.COMPETITION_TYPE - 1] || "").trim();
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  if (compTypes.length <= 1) {
    throw new Error("Cannot remove the only remaining entry.");
  }
  
  // Find the exact name as it appears in the map (handle casing)
  var targetCompName = competitionName;
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[competitionName];
  if (!compMap) {
    var mapKeys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
    for (var k = 0; k < mapKeys.length; k++) {
      if (mapKeys[k].toUpperCase() === competitionName.toUpperCase()) {
        targetCompName = mapKeys[k];
        compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[targetCompName];
        break;
      }
    }
  }
  if (!compMap) throw new Error("Unrecognized competition: " + competitionName);

  // 2. Remove from COMPETITION_TYPE list
  var newCompTypes = [];
  for (var i = 0; i < compTypes.length; i++) {
    if (compTypes[i].toUpperCase() !== targetCompName.toUpperCase()) {
      newCompTypes.push(compTypes[i]);
    }
  }
  rowVals[S.COMPETITION_TYPE - 1] = newCompTypes.join(", ");
  
  // 3. Clear the data columns for this competition
  var keysToClear = [
    compMap.nameCol, compMap.regionCol, compMap.schoolCol, compMap.adviserCol, 
    compMap.facebookCol, compMap.contactCol, compMap.titleCol
  ];
  if (compMap.fileCols) {
    for (var fc = 0; fc < compMap.fileCols.length; fc++) keysToClear.push(compMap.fileCols[fc]);
  }
  
  for (var c = 0; c < keysToClear.length; c++) {
    var colKey = keysToClear[c];
    if (colKey && S[colKey]) {
      rowVals[S[colKey] - 1] = "";
    }
  }
  
  // 4. Handle Participant Numbers (SYS_PARTICIPANT_NUM)
  var pPrefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[compMap.key];
  var removedPNum = "";
  var partNumsRaw = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  if (partNumsRaw) {
    var pNums = partNumsRaw.split(/\s*,\s*/).filter(function(n) { return n.length > 0; });
    var newPNums = [];
    for (var n = 0; n < pNums.length; n++) {
      if (pNums[n].indexOf(pPrefix + "-") === 0) {
        removedPNum = pNums[n];
      } else {
        newPNums.push(pNums[n]);
      }
    }
    if (sysCols["SYS_PARTICIPANT_NUM"]) {
      rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] = newPNums.join(", ");
    }
  }
  
  // 5. Cleanup Anonymized Files (SYS_ANON_FILE_IDS)
  var anonIdsRaw = sysCols["SYS_ANON_FILE_IDS"] ? String(rowVals[sysCols["SYS_ANON_FILE_IDS"] - 1] || "").trim() : "";
  var trashedCount = 0;
  if (anonIdsRaw && removedPNum) {
    var anonIds = anonIdsRaw.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
    var keptIds = [];
    var removedIds = [];
    
    // Finding file ownership via DriveApp is slow, so we check if the filename starts with the removed participant number
    for (var a = 0; a < anonIds.length; a++) {
      try {
        var f = DriveApp.getFileById(anonIds[a]);
        if (f.getName().indexOf(removedPNum + "_") === 0 || f.getName().indexOf(removedPNum + ".") === 0) {
          f.setTrashed(true);
          trashedCount++;
          removedIds.push(anonIds[a]);
        } else {
          keptIds.push(anonIds[a]);
        }
      } catch (e) {
        // If file doesn't exist or no permission, assume it stays (or is already gone)
        keptIds.push(anonIds[a]);
      }
    }
    if (sysCols["SYS_ANON_FILE_IDS"]) {
      rowVals[sysCols["SYS_ANON_FILE_IDS"] - 1] = keptIds.join(", ");
    }
  }
  
  // Write everything back to the sheet
  range.setValues([rowVals]);
  
  // Audit log
  var email = String(rowVals[S.EMAIL - 1] || "").trim();
  AuditLogService.info("SUB_REMOVE_ENTRY", "Row " + rowIndex + " (" + email + "): Removed " + targetCompName + " (" + (removedPNum || "No ID") + "). Trashed " + trashedCount + " anon file(s).");
  
  return { 
    success: true, 
    removedCompetition: targetCompName,
    removedParticipantNum: removedPNum,
    remainingEntries: newCompTypes.length
  };
}

/**
 * Send a correction request email for a selected flagged submission.
 * Can be used standalone or called from flagSubmission.
 */
function sendCorrectionRequest() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  var reason = sysCols["SYS_FLAG_REASON"] ? String(rowVals[sysCols["SYS_FLAG_REASON"] - 1] || "").trim() : "";
  if (!reason) {
    var response = ui.prompt(
      "📨 Send Correction Request",
      "No flag reason found. Enter the issue to communicate to the participant:",
      ui.ButtonSet.OK_CANCEL
    );
    if (response.getSelectedButton() !== ui.Button.OK) return;
    reason = response.getResponseText().trim();
    if (!reason) { ui.alert("❌ Reason is required."); return; }
    // Also flag the row if not already flagged
    if (sysCols["SYS_SUB_STATUS"]) subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).setValue("FLAGGED");
    if (sysCols["SYS_FLAG_REASON"]) subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).setValue(reason);
    if (sysCols["SYS_FLAG_DATE"]) subSheet.getRange(row, sysCols["SYS_FLAG_DATE"]).setValue(Utils.nowTzString());
  }

  sendCorrectionRequestEmail_(subSheet, sysCols, row, rowVals, reason);
  ui.alert("✅ Correction request email sent.");
}

/**
 * Internal: Build and send a correction request email.
 */
function sendCorrectionRequestEmail_(subSheet, sysCols, row, rowVals, reason) {
  var S = SYSTEM_CONFIG.COLS.SUB;
  var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  var partNum = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var rawCompType = String(rowVals[S.COMPETITION_TYPE - 1] || "").trim();
  var esc = Utils.escapeHtml;

  // Get participant name from first competition
  var participantName = "";
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  for (var ci = 0; ci < compTypes.length; ci++) {
    var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compTypes[ci]];
    if (compMap && compMap.nameCol) {
      var nc = S[compMap.nameCol];
      if (nc) { participantName = String(rowVals[nc - 1] || "").trim(); if (participantName) break; }
    }
  }

  var eventName = SYSTEM_CONFIG.META.NAME;
  var orgName = SYSTEM_CONFIG.META.ORG;
  var BLUE = "#2563eb";
  var AMBER = "#d97706";

  // Build professional HTML email
  var h = [];
  h.push('<!DOCTYPE html><html><body style="margin:0;padding:0;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">');
  h.push('<table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;"><tr><td align="center" style="padding:20px;">');
  h.push('<table width="600" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);">');

  // Header
  h.push('<tr><td style="background:linear-gradient(135deg, ' + AMBER + ', #b45309);padding:28px 30px;text-align:center;">');
  h.push('<h1 style="color:#fff;margin:0;font-size:22px;">⚠️ Submission Correction Required</h1>');
  h.push('<p style="color:rgba(255,255,255,0.9);margin:8px 0 0;font-size:14px;">' + esc(eventName) + '</p>');
  h.push('</td></tr>');

  // Body
  h.push('<tr><td style="padding:30px;">');
  h.push('<p style="font-size:15px;margin:0 0 15px;">Dear <b>' + esc(participantName || "Participant") + '</b>,</p>');
  h.push('<p style="font-size:14px;margin:0 0 20px;line-height:1.6;">Thank you for your submission. After reviewing your entry, our team has identified an issue that needs to be corrected before your submission can be fully processed.</p>');

  // Issue box
  h.push('<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;"><tr>');
  h.push('<td style="background:#fef3c7;border-left:4px solid ' + AMBER + ';padding:16px 20px;border-radius:0 8px 8px 0;">');
  h.push('<p style="font-size:13px;color:#92400e;margin:0 0 4px;font-weight:bold;">⚠️ ISSUE IDENTIFIED</p>');
  h.push('<p style="font-size:14px;color:#78350f;margin:0;line-height:1.5;">' + esc(reason) + '</p>');
  h.push('</td></tr></table>');

  // Submission details table
  var thStyle = 'align="left" style="background:#f8fafc;padding:10px 12px;border:1px solid #e6e8ec;width:40%;font-weight:bold;"';
  var tdStyle = 'style="padding:10px 12px;border:1px solid #e6e8ec;"';

  h.push('<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:0 0 20px;">');
  if (partNum) h.push('<tr><th ' + thStyle + '>Participant No.</th><td ' + tdStyle + '>' + esc(partNum) + '</td></tr>');
  h.push('<tr><th ' + thStyle + '>Competition</th><td ' + tdStyle + '>' + esc(rawCompType) + '</td></tr>');
  if (participantName) h.push('<tr><th ' + thStyle + '>Name</th><td ' + tdStyle + '>' + esc(participantName) + '</td></tr>');
  h.push('</table>');

  // What to do section
  h.push('<div style="background:#eff6ff;border-radius:8px;padding:16px 20px;margin:0 0 20px;">');
  h.push('<p style="font-size:13px;color:' + BLUE + ';margin:0 0 8px;font-weight:bold;">📝 WHAT TO DO</p>');
  h.push('<ol style="font-size:14px;color:#1e3a5f;margin:0;padding-left:20px;line-height:1.8;">');
  h.push('<li>Review the issue described above</li>');
  h.push('<li>Correct your submission accordingly (e.g., re-upload files with personal information removed)</li>');
  h.push('<li>Edit your Google Form response to update your entry</li>');
  h.push('<li>Reply to this email once corrections are made</li>');
  h.push('</ol></div>');

  h.push('<p style="font-size:13px;color:#64748b;margin:0 0 5px;line-height:1.5;">Please make the corrections as soon as possible. If you have any questions, reply to this email.</p>');
  h.push('</td></tr>');

  // Footer
  h.push('<tr><td style="background:#f8fafc;padding:20px 30px;text-align:center;border-top:1px solid #e6e8ec;">');
