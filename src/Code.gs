    SpreadsheetApp.getActiveSpreadsheet().toast("Clearing form responses...", "🧹", -1);
    
    // Delete all form responses
    form.deleteAllResponses();
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "✅", 3);
    
    ui.alert(
      "✅ Form Responses Cleared!",
      "Deleted " + responseCount + " form responses.\n\n" +
      "✅ All emails can now re-submit the form!\n\n" +
      "Note: Sheet data is NOT affected.\n" +
      "Clear sheet data separately if needed.",
      ui.ButtonSet.OK
    );
    
  } catch (e) {
    Logger.log("Form clear error: " + e);
    ui.alert(
      "❌ Error",
      "Could not clear form responses: " + e.message + "\n\n" +
      "Try clearing manually:\n" +
      "1. Open Google Form\n" +
      "2. Go to Responses tab\n" +
      "3. Click ⋮ → Delete all responses",
      ui.ButtonSet.OK
    );
  }
}

/**
 * Full system reset - clears ALL data from ALL sheets AND form
 */
function fullSystemReset() {
  var ui = SpreadsheetApp.getUi();
  
  var confirm1 = ui.alert(
    "💣 FULL SYSTEM RESET",
    "⚠️ DANGER! This will DELETE ALL DATA from:\n\n" +
    "• Registration sheet\n" +
    "• Finance sheet\n" +
    "• Any extra 'Form Responses' sheets\n" +
    "• Google Form responses\n" +
    "• All email tracking\n\n" +
    "(Coupons sheet will NOT be affected)\n\n" +
    "⚠️ THIS CANNOT BE UNDONE!\n\n" +
    "Continue?",
    ui.ButtonSet.YES_NO
  );
  
  if (confirm1 !== ui.Button.YES) return;
  
  var typeConfirm = ui.prompt(
    "💣 Final Confirmation",
    "Type RESET EVERYTHING to confirm:",
    ui.ButtonSet.OK_CANCEL
  );
  
  if (typeConfirm.getSelectedButton() !== ui.Button.OK || 
      typeConfirm.getResponseText().toUpperCase() !== "RESET EVERYTHING") {
    ui.alert("Cancelled", "Reset cancelled.", ui.ButtonSet.OK);
    return;
  }
  
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regCount = 0;
    var finCount = 0;
    var formCount = 0;
    var orphanedCount = 0;
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Resetting system...", "💣", -1);
    
    // 1. Clear Registration sheet data (keep sheet)
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    if (regSheet && regSheet.getLastRow() > 1) {
      regCount = regSheet.getLastRow() - 1;
      deleteAllDataRows_(regSheet);
    }
    
    // 2. Clear Finance sheet data (keep sheet)
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    if (finSheet && finSheet.getLastRow() > 1) {
      finCount = finSheet.getLastRow() - 1;
      deleteAllDataRows_(finSheet);
    }
    
    // 3. DELETE any orphaned Form Responses sheets entirely
    var sheets = ss.getSheets();
    for (var i = sheets.length - 1; i >= 0; i--) {
      var name = sheets[i].getName();
      if (name.indexOf("Form Responses") !== -1 && name !== SYSTEM_CONFIG.SHEETS.REGISTRATION) {
        try {
          ss.deleteSheet(sheets[i]);
          orphanedCount++;
        } catch (e) {
          Logger.log("Could not delete sheet: " + name);
        }
      }
    }
    
    // 4. Clear Form responses from the actual form
    try {
      var form = getLinkedForm_();
      if (form) {
        formCount = form.getResponses().length;
        form.deleteAllResponses();
      }
    } catch (formError) {
      Logger.log("Could not clear form: " + formError);
    }
    
    // 5. Clear all email tracking
    clearAllEmailTracking_();
    clearAllCachedData_();
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Reset complete!", "✅", 3);
    
    ui.alert(
      "✅ System Reset Complete",
      "Deleted:\n" +
      "• " + regCount + " registration rows\n" +
      "• " + finCount + " finance rows\n" +
      "• " + orphanedCount + " orphaned 'Form Responses' sheets\n" +
      "• " + formCount + " form responses\n" +
      "• All email tracking\n\n" +
      "✅ System is ready for fresh registrations!\n\n" +
      "Test by submitting the form.",
      ui.ButtonSet.OK
    );
    
  } catch (e) {
    ui.alert("❌ Error", "Failed to reset: " + e.message, ui.ButtonSet.OK);
  }
}

