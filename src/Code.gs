/**
 * Server-side: Send announcement emails to filtered recipients.
 * Called iteratively from the client via google.script.run for progress tracking.
 * @param {Object} config - { category, subject, body, recipients: [{email,name,...}] }
 * @returns {Object} { sent, failed, errors[] }
 */
function sendAnnouncementBatch(config) {
  var sent = 0;
  var failed = 0;
  var errors = [];
  var failedRecipients = [];
  var senderName = SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME;

  try {
    var inlineImages = {};
    try { inlineImages = LogoService.getInlineImages(); } catch (e) {}

    var recipients = config.recipients || [];
    for (var i = 0; i < recipients.length; i++) {
      var r = recipients[i];
      try {
        r._signoff = config.signoff || "";
        var emailHtml = buildAnnouncementHtml_(config.category, config.subject, config.body, r);

        // Try threading if the recipient has a Gen ID
        var threaded = false;
        if (r.genId) {
          try {
            var threadInfo = EmailThreadService.getThreadInfo(r.genId);
            if (threadInfo && threadInfo.threadId) {
              EmailThreadService.sendReplyEmail(r.email, config.subject, emailHtml, inlineImages, threadInfo.threadId, threadInfo.messageId, senderName);
              threaded = true;
            }
          } catch (te) { /* fallback to direct send */ }
        }
        if (!threaded) {
          MailApp.sendEmail({ to: r.email, subject: config.subject, htmlBody: emailHtml, inlineImages: inlineImages, name: senderName });
        }

        AuditLogService.info("ANNOUNCE_SENT", config.category.toUpperCase() + " | To: " + r.email + " | Subject: " + config.subject);
        sent++;

        // Rate limiting
        if (i < recipients.length - 1) Utilities.sleep(1500);
      } catch (sendErr) {
        failed++;
        failedRecipients.push(r);
        errors.push(r.email + ": " + sendErr.toString());
        AuditLogService.error("ANNOUNCE_ERROR", "Failed to send to " + r.email + ": " + sendErr);
      }
    }
  } catch (outerErr) {
    errors.push("Batch error: " + outerErr.toString());
  }

  return { sent: sent, failed: failed, errors: errors, failedRecipients: failedRecipients };
}

/**
 * Get remaining daily email quota.
 */
function getAnnouncementQuota() {
  try {
    var remaining = MailApp.getRemainingDailyQuota();
    // Infer total: Workspace = 1500, consumer = 100
    var total = remaining > 100 ? 1500 : 100;
    // Check if we stored the baseline total before
    var props = PropertiesService.getScriptProperties();
    var storedTotal = props.getProperty("ANNOUNCEMENT_QUOTA_TOTAL");
    if (storedTotal) {
      total = Number(storedTotal);
    } else if (remaining > 0) {
      // First time: store the inferred total
      props.setProperty("ANNOUNCEMENT_QUOTA_TOTAL", String(total));
    }
    return { remaining: remaining, total: total, error: null };
  } catch (e) {
    return { remaining: -1, total: 100, error: e.toString() };
  }
}

/**
 * Save failed recipients to ScriptProperties for retry later.
 */
function saveFailedAnnouncementRecipients(config) {
  try {
    var props = PropertiesService.getScriptProperties();
    var data = {
      category: config.category,
      subject: config.subject,
      body: config.body,
      signoff: config.signoff || "",
      recipients: config.recipients,
      savedAt: new Date().toISOString()
    };
    props.setProperty("ANNOUNCE_FAILED_QUEUE", JSON.stringify(data));
    AuditLogService.info("ANNOUNCE_QUEUE_SAVED", "Saved " + config.recipients.length + " failed recipients for retry.");
    return { success: true, count: config.recipients.length };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Load previously failed recipients from ScriptProperties.
 */
function getFailedAnnouncementRecipients() {
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty("ANNOUNCE_FAILED_QUEUE");
    if (!raw) return { found: false, data: null };
    var data = JSON.parse(raw);
    return { found: true, data: data };
  } catch (e) {
    return { found: false, error: e.toString() };
  }
}

/**
 * Clear the failed recipients queue.
 */
function clearFailedAnnouncementQueue() {
  try {
    PropertiesService.getScriptProperties().deleteProperty("ANNOUNCE_FAILED_QUEUE");
    return { success: true };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Schedule a retry of failed announcement emails for tomorrow.
 * Creates a time-based trigger that fires after midnight (when quota resets ~4 PM PHT / midnight PT).
 */
function scheduleAnnouncementRetry() {
  try {
    // Delete any existing announcement triggers
    var triggers = ScriptApp.getProjectTriggers();
    for (var t = 0; t < triggers.length; t++) {
      if (triggers[t].getHandlerFunction() === "processScheduledAnnouncementQueue") {
        ScriptApp.deleteTrigger(triggers[t]);
      }
    }
    // Create trigger for ~6 hours from now (gives time for quota reset)
    ScriptApp.newTrigger("processScheduledAnnouncementQueue")
      .timeBased()
      .after(6 * 60 * 60 * 1000) // 6 hours
      .create();
    AuditLogService.info("ANNOUNCE_SCHEDULED", "Scheduled retry trigger in ~6 hours.");
    return { success: true };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Process the scheduled queue — called by time trigger.
 */
function processScheduledAnnouncementQueue() {
  try {
    var queueData = getFailedAnnouncementRecipients();
    if (!queueData.found || !queueData.data) {
      AuditLogService.info("ANNOUNCE_QUEUE_EMPTY", "No queued announcements to process.");
      return;
    }
    var config = queueData.data;
    var quota = MailApp.getRemainingDailyQuota();
    if (quota < config.recipients.length) {
      AuditLogService.warn("ANNOUNCE_QUEUE_INSUFFICIENT_QUOTA", "Need " + config.recipients.length + " sends but only " + quota + " remaining. Will retry later.");
      // Re-schedule for later
      scheduleAnnouncementRetry();
      return;
    }

    AuditLogService.info("ANNOUNCE_QUEUE_START", "Processing " + config.recipients.length + " queued announcements. Quota: " + quota);
    var result = sendAnnouncementBatch(config);
    AuditLogService.info("ANNOUNCE_QUEUE_DONE", "Queued send complete: " + result.sent + " sent, " + result.failed + " failed.");

    if (result.failed === 0) {
      clearFailedAnnouncementQueue();
    } else if (result.failedRecipients && result.failedRecipients.length > 0) {
      // Save remaining failures and reschedule
      config.recipients = result.failedRecipients;
      saveFailedAnnouncementRecipients(config);
      scheduleAnnouncementRetry();
    }
  } catch (e) {
    AuditLogService.error("ANNOUNCE_QUEUE_ERROR", "Queue processing failed: " + e);
  }
}

/**
 * Schedule an announcement to be sent at a future time.
 * Saves the draft config to ScriptProperties and creates a time-based trigger.
 */
function scheduleAnnouncementSend(config) {
  try {
    if (!config || !config.sendAt) return { success: false, error: "No scheduled time provided." };
    var sendAt = new Date(config.sendAt);
    if (isNaN(sendAt.getTime())) return { success: false, error: "Invalid date/time." };
    var now = new Date();
    if (sendAt <= now) return { success: false, error: "Scheduled time must be in the future." };

    // Generate unique ID for this scheduled send
    var schedId = "SCHED_" + now.getTime();

    // Save draft to ScriptProperties
    var draft = {
      id: schedId,
      category: config.category || "general",
      subject: config.subject || "",
      body: config.body || "",
      signoff: config.signoff || "",
      filters: config.filters || {},
      sendAt: sendAt.toISOString(),
      recipientCount: config.recipientCount || 0,
      createdAt: now.toISOString()
    };

    var props = PropertiesService.getScriptProperties();
    var existing = [];
    try {
      var raw = props.getProperty("ANNOUNCEMENT_SCHEDULED_SENDS");
      if (raw) existing = JSON.parse(raw);
    } catch (e) {}
    existing.push(draft);
    props.setProperty("ANNOUNCEMENT_SCHEDULED_SENDS", JSON.stringify(existing));

    // Create time-based trigger
    var delayMs = sendAt.getTime() - now.getTime();
    ScriptApp.newTrigger("processScheduledAnnouncement")
      .timeBased()
      .after(delayMs)
      .create();

    AuditLogService.info("ANNOUNCE_SCHEDULE_CREATE", "Scheduled announcement '" + config.subject + "' for " + sendAt.toISOString() + " (ID: " + schedId + ")");
    return { success: true, id: schedId };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Process a scheduled announcement — called by time trigger.
 * Retrieves the oldest pending scheduled send, re-fetches recipients, and sends.
 */
function processScheduledAnnouncement() {
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty("ANNOUNCEMENT_SCHEDULED_SENDS");
    if (!raw) { AuditLogService.info("ANNOUNCE_SCHED_EMPTY", "No scheduled sends to process."); return; }
    var scheduled = JSON.parse(raw);
    if (scheduled.length === 0) { AuditLogService.info("ANNOUNCE_SCHED_EMPTY", "No scheduled sends to process."); return; }

    // Take the first (oldest) scheduled send
    var draft = scheduled.shift();
    props.setProperty("ANNOUNCEMENT_SCHEDULED_SENDS", JSON.stringify(scheduled));

    AuditLogService.info("ANNOUNCE_SCHED_START", "Processing scheduled announcement: " + draft.subject + " (ID: " + draft.id + ")");

    // Re-fetch recipients using the saved filters
    var recipientResult = getAnnouncementRecipients(draft.filters || {});
    var recipients = recipientResult.recipients || [];

    if (recipients.length === 0) {
      AuditLogService.warn("ANNOUNCE_SCHED_NO_RECIPIENTS", "Scheduled announcement '" + draft.subject + "' had 0 recipients with current filters. Skipping.");
      return;
    }

    // Check quota
    var quota = MailApp.getRemainingDailyQuota();
    if (quota < recipients.length) {
      AuditLogService.warn("ANNOUNCE_SCHED_QUOTA", "Need " + recipients.length + " sends but only " + quota + " remaining. Re-scheduling.");
      // Put it back and re-schedule for later
      scheduled.unshift(draft);
      props.setProperty("ANNOUNCEMENT_SCHEDULED_SENDS", JSON.stringify(scheduled));
      scheduleAnnouncementRetry();
      return;
    }

    // Send in batches
    var batchSize = 10;
    var totalSent = 0;
    var totalFailed = 0;
    var failedRecipients = [];

    for (var i = 0; i < recipients.length; i += batchSize) {
      var batch = recipients.slice(i, i + batchSize);
      var batchConfig = {
        category: draft.category,
        subject: draft.subject,
        body: draft.body,
        signoff: draft.signoff,
        recipients: batch
      };
      try {
        var result = sendAnnouncementBatch(batchConfig);
        totalSent += result.sent;
        totalFailed += result.failed;
        if (result.failedRecipients) failedRecipients = failedRecipients.concat(result.failedRecipients);
      } catch (batchErr) {
        totalFailed += batch.length;
        failedRecipients = failedRecipients.concat(batch);
      }
    }

    AuditLogService.info("ANNOUNCE_SCHED_DONE", "Scheduled send complete: " + totalSent + " sent, " + totalFailed + " failed."); 

    // Save failures for retry if needed
    if (failedRecipients.length > 0) {
      saveFailedAnnouncementRecipients({
        category: draft.category,
        subject: draft.subject,
        body: draft.body,
        signoff: draft.signoff,
        recipients: failedRecipients
      });
    }
  } catch (e) {
    AuditLogService.error("ANNOUNCE_SCHED_ERROR", "Scheduled announcement processing failed: " + e);
  }
}

/**
 * Get all pending scheduled announcements.
 */
function getScheduledAnnouncements() {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty("ANNOUNCEMENT_SCHEDULED_SENDS");
    if (!raw) return [];
    var scheduled = JSON.parse(raw);
    // Return only future ones (filter out past ones that haven't been cleaned up)
    var now = new Date();
    return scheduled.filter(function(s) {
      return new Date(s.sendAt) > now;
    }).map(function(s) {
      return {
        id: s.id,
        subject: s.subject,
        category: s.category,
        sendAt: s.sendAt,
        recipientCount: s.recipientCount,
        createdAt: s.createdAt
      };
    });
  } catch (e) {
    return [];
  }
}

/**
 * Cancel a scheduled announcement by its ID.
 */
function cancelScheduledAnnouncement(schedId) {
  try {
    var props = PropertiesService.getScriptProperties();
    var raw = props.getProperty("ANNOUNCEMENT_SCHEDULED_SENDS");
    if (!raw) return { success: false, error: "No scheduled sends found." };
    var scheduled = JSON.parse(raw);
    var idx = -1;
    for (var i = 0; i < scheduled.length; i++) {
      if (scheduled[i].id === schedId) { idx = i; break; }
    }
    if (idx < 0) return { success: false, error: "Scheduled send not found." };

    var removed = scheduled.splice(idx, 1)[0];
    props.setProperty("ANNOUNCEMENT_SCHEDULED_SENDS", JSON.stringify(scheduled));

    // Try to remove the trigger (best effort — can't guarantee which trigger maps to which schedule)
    // Clean up oldest processScheduledAnnouncement trigger if no more schedules
    if (scheduled.length === 0) {
      var triggers = ScriptApp.getProjectTriggers();
      for (var t = 0; t < triggers.length; t++) {
        if (triggers[t].getHandlerFunction() === "processScheduledAnnouncement") {
          ScriptApp.deleteTrigger(triggers[t]);
        }
      }
    }

    AuditLogService.info("ANNOUNCE_SCHED_CANCEL", "Cancelled scheduled announcement: " + removed.subject + " (ID: " + schedId + ")");
    return { success: true };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Get available regions and competitions for filter dropdowns.
 */
function getAnnouncementFilterOptions() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    var regions = {};
    var competitions = {};

    if (regSheet && regSheet.getLastRow() > 1) {
      var R = SYSTEM_CONFIG.COLS.REG;
      var data = regSheet.getRange(2, 1, regSheet.getLastRow() - 1, Math.max(R.REGION, R.COMPETITION)).getValues();
      for (var i = 0; i < data.length; i++) {
        var reg = String(data[i][R.REGION - 1] || "").trim();
        var comp = String(data[i][R.COMPETITION - 1] || "").trim();
        if (reg) regions[reg] = (regions[reg] || 0) + 1;
        if (comp) {
          var parts = comp.split(/\s*,\s*/);
          for (var p = 0; p < parts.length; p++) {
            if (parts[p]) competitions[parts[p]] = (competitions[parts[p]] || 0) + 1;
          }
        }
      }
    }

    return {
      regions: Object.keys(regions).sort(),
      competitions: Object.keys(competitions).sort()
    };
  } catch (e) {
    return { regions: [], competitions: [] };
  }
}

