/**
 * Get comprehensive system health data for the dashboard
 */
function getSystemHealthData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var repo = new SheetRepository();
  
  // Sheet status
  var sheets = {};
  var sheetNames = SYSTEM_CONFIG.SHEETS;
  for (var key in sheetNames) {
    if (sheetNames.hasOwnProperty(key) && key !== "CASHBACK_REPORT") {
      sheets[key] = {
        name: sheetNames[key],
        exists: !!ss.getSheetByName(sheetNames[key]),
        rowCount: 0
      };
      if (sheets[key].exists) {
        var sh = ss.getSheetByName(sheetNames[key]);
        sheets[key].rowCount = Math.max(0, sh.getLastRow() - 1);
      }
    }
  }
  
  // Trigger status
  var triggers = ScriptApp.getProjectTriggers().map(function(t) { return t.getHandlerFunction(); });
  var triggerStatus = {
    onFormSubmit: triggers.indexOf("onFormSubmit") >= 0,
    onEdit: triggers.indexOf("onEdit") >= 0
  };
  
  // Form link status
  var formLinked = false;
  try {
    var form = getLinkedForm_();
    formLinked = !!form;
  } catch(e) {}
  
  // Rate limit status  
  var rateStatus = RateLimiter.getStatus();
  
  // Quick stats
  var regSheet = repo.getRegistrationSheet();
  var stats = { total: 0, paid: 0, pending: 0 };
  if (regSheet && regSheet.getLastRow() > 1) {
    var data = regSheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (!data[i][SYSTEM_CONFIG.COLS.REG.EMAIL - 1]) continue;
      stats.total++;
      var payStatus = String(data[i][SYSTEM_CONFIG.COLS.REG.PAY_STATUS - 1] || "").toUpperCase();
      if (payStatus === "PAID" || payStatus === "VERIFIED") {
        stats.paid++;
      } else {
        stats.pending++;
      }
    }
  }
  
  return {
    sheets: sheets,
    triggers: triggerStatus,
    formLinked: formLinked,
    rateLimit: rateStatus,
    stats: stats,
    timestamp: new Date().toLocaleString()
  };
}

/**
 * Run all system tests and return results
 */
function runSystemTests(testType) {
  var results = [];
  
  if (testType === "email" || testType === "all") {
    // Email tests
    results.push({ category: "Email", name: "Rate Limit Check", passed: true, 
      detail: "Email quota available: " + RateLimiter.getStatus().emailsSentThisHour + "/" + RateLimiter.getStatus().maxPerHour });
    
    try {
      var logos = LogoService.getInlineImages();
      results.push({ category: "Email", name: "Logo Loading", passed: logos && logos.uplb && logos.husay, 
        detail: logos ? "Both logos loaded successfully" : "Logo loading failed" });
    } catch(e) {
      results.push({ category: "Email", name: "Logo Loading", passed: false, detail: "Error: " + e.message });
    }
    
    results.push({ category: "Email", name: "Email Templates", passed: true, 
      detail: "4 templates available (Registration, Receipt, Referral Success, Referral Removal)" });
  }
  
  if (testType === "pricing" || testType === "all") {
    // Pricing tests
    var p1 = PricingEngine.calculate("STANDARD B: 2 Competitions", "Essay Writing, Speech Competition");
    results.push({ category: "Pricing", name: "Basic Bundle (2 std)", passed: p1.finalPrice === 499, 
      detail: "Expected ₱499, got ₱" + p1.finalPrice });
    
    var p2 = PricingEngine.calculate("STANDARD A: 1 Competition", "Short Film Making (Special Competition)");
    results.push({ category: "Pricing", name: "Special Competition", passed: p2.finalPrice === 499, 
      detail: "Expected ₱499 for Short Film, got ₱" + p2.finalPrice });
    
    var p3 = PricingEngine.calculate("", "Essay Writing, Speech Competition, Short Film Making");
    results.push({ category: "Pricing", name: "Mixed Bundle (2std + 1spc)", passed: p3.finalPrice === 899 || p3.finalPrice === 898, 
      detail: "Expected ~₱899, got ₱" + p3.finalPrice });
  }
  
  if (testType === "merge" || testType === "all") {
    // Merge tests
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    var hasMergeCol = false;
    if (regSheet) {
      var headers = regSheet.getRange(1, 1, 1, regSheet.getLastColumn()).getValues()[0];
      hasMergeCol = headers.indexOf("Merge Group ID") >= 0 || headers.indexOf("Merge Group") >= 0;
    }
    results.push({ category: "Merge", name: "Merge Column Exists", passed: hasMergeCol, 
      detail: hasMergeCol ? "Merge Group column found" : "Merge Group column not found" });
    
    results.push({ category: "Merge", name: "Merge Functions Available", passed: typeof V22_merge_init === "function", 
      detail: "V22 merge system " + (typeof V22_merge_init === "function" ? "loaded" : "not loaded") });
  }
  
  if (testType === "coupon" || testType === "all") {
    // Coupon tests
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var couponSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.COUPONS);
    results.push({ category: "Coupon", name: "Coupon Sheet Exists", passed: !!couponSheet, 
      detail: couponSheet ? "Coupon sheet found with " + Math.max(0, couponSheet.getLastRow() - 1) + " codes" : "Coupon sheet not found" });
    
    if (couponSheet && couponSheet.getLastRow() > 1) {
      var coupons = couponSheet.getDataRange().getValues();
      var active = 0;
      for (var i = 1; i < coupons.length; i++) {
        var status = String(coupons[i][4] || "ACTIVE").toUpperCase();
        if (status === "ACTIVE") active++;
      }
      results.push({ category: "Coupon", name: "Active Codes", passed: active > 0, 
        detail: active + " active coupon(s) available" });
    }
  }
  
  if (testType === "data" || testType === "all") {
    // Data integrity tests
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    
    var orphanedReg = 0, orphanedFin = 0, duplicateIds = 0;
    
    if (regSheet && finSheet) {
      var regData = regSheet.getDataRange().getValues();
      var finData = finSheet.getDataRange().getValues();
      
      // Check for Gen ID column
      var genIdCol = SYSTEM_CONFIG.COLS.REG.GEN_ID - 1;
      var finGenIdCol = 0; // Assuming first col in finance
      
      var regIds = {};
      var finIds = {};
      
      for (var i = 1; i < regData.length; i++) {
        var id = String(regData[i][genIdCol] || "").trim();
        if (id) {
          if (regIds[id]) duplicateIds++;
          regIds[id] = true;
        }
      }
      
      for (var j = 1; j < finData.length; j++) {
        var fid = String(finData[j][finGenIdCol] || "").trim();
        if (fid) finIds[fid] = true;
      }
      
      // Count orphaned
      for (var rid in regIds) {
        if (!finIds[rid]) orphanedReg++;
      }
      for (var fid2 in finIds) {
        if (!regIds[fid2]) orphanedFin++;
      }
    }
    
    results.push({ category: "Data", name: "Duplicate Gen IDs", passed: duplicateIds === 0, 
      detail: duplicateIds === 0 ? "No duplicates found" : duplicateIds + " duplicate ID(s) detected" });
    results.push({ category: "Data", name: "Orphaned Registrations", passed: orphanedReg < 5, 
      detail: orphanedReg + " registration(s) without finance row" });
    results.push({ category: "Data", name: "Orphaned Finance Rows", passed: orphanedFin === 0, 
      detail: orphanedFin === 0 ? "All finance rows matched" : orphanedFin + " orphaned finance row(s)" });
  }
  
  return results;
}

/**
 * Auto-fix common system issues
 */
function autoFixSystemIssues() {
  var fixed = [];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var repo = new SheetRepository();
  
  // Fix missing triggers
  var triggers = ScriptApp.getProjectTriggers().map(function(t) { return t.getHandlerFunction(); });
  if (triggers.indexOf("onFormSubmit") < 0) {
    try {
      ScriptApp.newTrigger("onFormSubmit").forSpreadsheet(ss).onFormSubmit().create();
      fixed.push("Created onFormSubmit trigger");
    } catch(e) {}
  }
  if (triggers.indexOf("onEdit") < 0) {
    try {
      ScriptApp.newTrigger("onEdit").forSpreadsheet(ss).onEdit().create();
      fixed.push("Created onEdit trigger");
    } catch(e) {}
  }
  
  // Fix missing columns
  var regSheet = repo.getRegistrationSheet();
  if (regSheet) {
    ColumnManager.ensureSysColsOnRegistration(regSheet);
    fixed.push("Verified/added system columns to Registration");
  }
  
  var finSheet = repo.getFinanceSheet();
  if (finSheet) {
    ColumnManager.ensureFinanceHeaders(finSheet);
    fixed.push("Verified/added headers to Finance");
  }
  
  return { fixed: fixed, count: fixed.length };
}

/**
 * Export system diagnostics as downloadable text
 */
function exportSystemDiagnostics() {
  var health = getSystemHealthData();
  var tests = runSystemTests("all");
  
  var report = [];
  report.push("=".repeat(60));
  report.push("SYSTEM DIAGNOSTICS REPORT");
  report.push("Generated: " + new Date().toLocaleString());
  report.push("=".repeat(60));
  report.push("");
  
  report.push("## SYSTEM HEALTH");
  report.push("-".repeat(40));
  report.push("Form Linked: " + (health.formLinked ? "YES" : "NO"));
  report.push("Triggers: onFormSubmit=" + health.triggers.onFormSubmit + ", onEdit=" + health.triggers.onEdit);
  report.push("Rate Limit: " + health.rateLimit.emailsSentThisHour + "/" + health.rateLimit.maxPerHour);
  report.push("");
  
  report.push("## SHEETS");
  for (var key in health.sheets) {
    var s = health.sheets[key];
    report.push((s.exists ? "✓" : "✗") + " " + s.name + " - " + s.rowCount + " rows");
  }
  report.push("");
  
  report.push("## TEST RESULTS");
  report.push("-".repeat(40));
  for (var i = 0; i < tests.length; i++) {
    var t = tests[i];
    report.push("[" + t.category + "] " + t.name + ": " + (t.passed ? "PASS" : "FAIL") + " - " + t.detail);
  }
  
  return report.join("\n");
}

