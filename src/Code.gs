/**
 * Detect sheet type based on name
 */
function detectSheetType_(sheetName) {
  var nameUpper = sheetName.toUpperCase();
  
  if (nameUpper.indexOf("FORM RESPONSES") >= 0 || nameUpper === "REGISTRATION" || 
      nameUpper === SYSTEM_CONFIG.SHEETS.REGISTRATION.toUpperCase()) {
    return {
      type: "REGISTRATION",
      name: "📝 Registration",
      actions: ["GEN_ID", "PRICING", "DISCOUNTS", "PAYMENT_STATUS", "REFERRALS", "SYNC_FINANCE"]
    };
  } else if (nameUpper.indexOf("FINANCE") >= 0 || nameUpper.indexOf("FINANCIAL") >= 0 ||
             nameUpper === SYSTEM_CONFIG.SHEETS.FINANCE.toUpperCase()) {
    return {
      type: "FINANCE",
      name: "💰 Finance",
      actions: ["SYNC_FROM_REG", "UPDATE_STATUS", "CALC_TOTALS"]
    };
  } else if (nameUpper.indexOf("COUPON") >= 0 || nameUpper === SYSTEM_CONFIG.SHEETS.COUPONS.toUpperCase()) {
    return {
      type: "COUPONS",
      name: "🎟️ Coupons",
      actions: ["UPDATE_USAGE", "VALIDATE_CODES", "CHECK_EXPIRY"]
    };
  } else if (nameUpper.indexOf("PARTICIPANT") >= 0 || nameUpper.indexOf("DATABASE") >= 0) {
    return {
      type: "PARTICIPANT_DB",
      name: "📊 Participant Database",
      actions: ["REFRESH_QUERY", "VALIDATE_DATA"]
    };
  } else {
    return {
      type: "UNKNOWN",
      name: "📄 " + sheetName,
      actions: ["SCAN_EMPTY", "TRIM_SPACES"]
    };
  }
}

