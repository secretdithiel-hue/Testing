/**
 * Manually scan a selected submission's document files for PII.
 * Checks all scannable columns for participant name, school, and adviser in file content.
 */
function scanSubmissionForPii() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  var S = SYSTEM_CONFIG.COLS.SUB;
  var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP;

  // Determine competitions to scan
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var detectedComps = DepersonalizationService.detectCompetitionsFromData(rowVals);
  var allComps = {};
  var compList = [];
  compTypes.concat(detectedComps).forEach(function(c) {
    if (c && !allComps[c]) { allComps[c] = true; compList.push(c); }
  });

  if (compList.length === 0) {
    ui.alert("❌ No competitions detected for row " + row + ".");
    return;
  }

  // Scan all scannable files across all competitions
  var allMatches = [];
  var filesScanned = 0;
  var filesSkipped = 0;
  var errors = [];

  for (var ci = 0; ci < compList.length; ci++) {
    var entry = compMap[compList[ci]];
    if (!entry || !entry.scannableCols || entry.scannableCols.length === 0) continue;

    // Get PII search terms
    var participantName = "";
    if (entry.nameCol) {
      var nc = S[entry.nameCol];
      if (nc) participantName = String(rowVals[nc - 1] || "").trim();
    }
    var schoolName = "";
    if (entry.schoolCol) {
      var sc = S[entry.schoolCol];
      if (sc) schoolName = String(rowVals[sc - 1] || "").trim();
    }
    var adviserName = "";
    if (entry.adviserCol) {
      var ac = S[entry.adviserCol];
      if (ac) adviserName = String(rowVals[ac - 1] || "").trim();
    }

    for (var fi = 0; fi < entry.scannableCols.length; fi++) {
      var colKey = entry.scannableCols[fi];
      var colNum = S[colKey];
      if (!colNum) continue;
      var cellVal = String(rowVals[colNum - 1] || "").trim();
      if (!cellVal) { filesSkipped++; continue; }
      var fileId = DepersonalizationService.extractFileId(cellVal);
      if (!fileId) { filesSkipped++; continue; }

      try {
        var scanResult = DepersonalizationService.scanDocumentForPii(fileId, participantName, schoolName, adviserName);
        filesScanned++;
        if (scanResult.flagged) {
          allMatches = allMatches.concat(scanResult.matches);
        }
        if (scanResult.error) {
          errors.push(colKey + ": " + scanResult.error);
        }
      } catch (e) {
        errors.push(colKey + ": " + e);
      }
    }
  }

  // Build results
  var msg = "🔍 PII Scan Results for Row " + row + "\n\n";
  msg += "Files scanned: " + filesScanned + "\n";
  msg += "Files skipped (empty): " + filesSkipped + "\n";
  if (errors.length > 0) msg += "Errors: " + errors.length + "\n";
  msg += "\n";

  if (allMatches.length > 0) {
    msg += "⚠️ PII FOUND (" + allMatches.length + " match(es)):\n";
    for (var mi = 0; mi < allMatches.length; mi++) {
      msg += "  • " + allMatches[mi] + "\n";
    }
  } else {
    msg += "✅ No PII detected in scanned documents.";
  }

  if (errors.length > 0) {
    msg += "\n\n⚠️ Scan Errors:\n";
    for (var ei = 0; ei < errors.length; ei++) {
      msg += "  • " + errors[ei] + "\n";
    }
  }

  AuditLogService.info("PII_MANUAL_SCAN", "Row " + row + ": " + filesScanned + " files scanned, " + allMatches.length + " PII matches");

  if (allMatches.length > 0) {
    var flagIt = ui.alert(
      "🔍 PII Detected",
      msg + "\n\nWould you like to flag this submission and send a correction request?",
      ui.ButtonSet.YES_NO
    );
    if (flagIt === ui.Button.YES) {
      var flagReason = "PII found in documents: " + allMatches.join("; ");
      if (sysCols["SYS_SUB_STATUS"]) subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).setValue("FLAGGED");
      if (sysCols["SYS_FLAG_REASON"]) subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).setValue(flagReason);
      if (sysCols["SYS_FLAG_DATE"]) subSheet.getRange(row, sysCols["SYS_FLAG_DATE"]).setValue(Utils.nowTzString());
      sendCorrectionRequestEmail_(subSheet, sysCols, row, rowVals, flagReason);
      ui.alert("✅ Flagged and correction request sent to " + email);
    }
  } else {
    ui.alert("🔍 PII Scan Complete", msg, ui.ButtonSet.OK);
  }
}

/**
 * Helper: Get the anonymized folder ID for a competition key.
 * Checks Script Properties first, falls back to hardcoded config.
 */
function getAnonFolderId_(competitionKey) {
  var propKey = "ANON_FOLDER_" + competitionKey;
  var fromProps = PropertiesService.getScriptProperties().getProperty(propKey);
  if (fromProps) return fromProps;
  return SYSTEM_CONFIG.DEPERSONALIZATION.ANON_FOLDERS[competitionKey] || "";
}

