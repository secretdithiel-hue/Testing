/**
 * Main System Updater function - works on any sheet
 */
function runSystemUpdater() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  var sheetName = sheet.getName();
  var selection = sheet.getActiveRange();
  
  // Determine what's selected
  var selectionType = getSelectionType_(selection, sheet);
  
  // Show dialog
  var html = HtmlService.createHtmlOutput(getSystemUpdaterHtml_(sheetName, selectionType))
    .setWidth(700)
    .setHeight(600);
  ui.showModalDialog(html, "🔄 System Updater");
}

/**
 * Determine selection type
 */
function getSelectionType_(selection, sheet) {
  var numRows = selection.getNumRows();
  var numCols = selection.getNumColumns();
  var totalRows = sheet.getLastRow();
  var totalCols = sheet.getLastColumn();
  var startRow = selection.getRow();
  var startCol = selection.getColumn();
  
  if (numRows >= totalRows - 1 && numCols >= totalCols) {
    return { type: "WHOLE_SHEET", rows: totalRows - 1, cols: totalCols };
  } else if (numRows === 1 && numCols >= totalCols * 0.8) {
    return { type: "SINGLE_ROW", row: startRow, cols: numCols };
  } else if (numCols === 1 && numRows >= totalRows * 0.8) {
    return { type: "SINGLE_COLUMN", col: startCol, rows: numRows };
  } else if (numRows > 1 && numCols > 1) {
    return { type: "RANGE", startRow: startRow, startCol: startCol, rows: numRows, cols: numCols };
  } else if (numRows > 1) {
    return { type: "MULTIPLE_ROWS", startRow: startRow, rows: numRows };
  } else {
    return { type: "SINGLE_ROW", row: startRow, cols: numCols };
  }
}

