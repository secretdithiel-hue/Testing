/**
 * Server-side cleanup: remove mismatched participant numbers.
 * Called from the audit report dialog.
 * @param {Object[]} issueData - Array of { row, num } to remove
 * @returns {string} Summary message
 */
function executeParticipantNumberCleanup(issueData) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  if (!subSheet) throw new Error("Submission sheet not found.");

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var partNumCol = sysCols["SYS_PARTICIPANT_NUM"];
  if (!partNumCol) throw new Error("SYS_PARTICIPANT_NUM column not found.");

  // Group issues by row
  var byRow = {};
  for (var i = 0; i < issueData.length; i++) {
    var r = issueData[i].row;
    if (!byRow[r]) byRow[r] = [];
    byRow[r].push(issueData[i].num);
  }

  var fixedCount = 0;
  var rows = Object.keys(byRow);
  for (var ri = 0; ri < rows.length; ri++) {
    var rowNum = parseInt(rows[ri], 10);
    var numsToRemove = byRow[rowNum];
    var currentVal = String(subSheet.getRange(rowNum, partNumCol).getValue() || "").trim();
    if (!currentVal) continue;

    var currentNums = currentVal.split(/\s*,\s*/).filter(function(n) { return n.trim().length > 0; });
    var remaining = currentNums.filter(function(n) {
      return numsToRemove.indexOf(n.trim()) < 0;
    });

    var newVal = remaining.join(", ");
    subSheet.getRange(rowNum, partNumCol).setValue(newVal);
    fixedCount += numsToRemove.length;

    AuditLogService.info("AUDIT_CLEANUP", "Row " + rowNum + ": Removed [" + numsToRemove.join(", ") + "] → Remaining: [" + newVal + "]");
  }

  SpreadsheetApp.flush();
  AuditLogService.info("AUDIT_CLEANUP_DONE", "Removed " + fixedCount + " mismatched participant number(s) across " + rows.length + " row(s).");
  return "Cleaned up " + fixedCount + " participant number(s) across " + rows.length + " row(s). Refresh the sheet to see changes.";
}

