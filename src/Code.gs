// ============================================================================
// PART 15: DATA INTEGRITY CHECKER (NEW)
// ============================================================================

var DataIntegrity = (function() {
  /**
   * Validates a registration row has all required data
   */
  function validateRegistrationRow(rowVals) {
    var issues = [];
    
    var email = rowVals[SYSTEM_CONFIG.COLS.REG.EMAIL - 1];
    if (!email || !Utils.isValidEmail(email)) {
      issues.push("Invalid or missing email");
    }
    
    var name = rowVals[SYSTEM_CONFIG.COLS.REG.NAME - 1];
    if (!name || String(name).trim().length < 2) {
      issues.push("Invalid or missing name");
    }
    
    var competitions = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
    var compCount = rowVals[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
    if (!competitions && !compCount) {
      issues.push("No competition selection");
    }
    
    return {
      valid: issues.length === 0,
      issues: issues
    };
  }
  
  /**
   * Checks for orphaned finance rows (no matching registration)
   */
  function findOrphanedFinanceRows() {
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    
    if (!regSheet || !finSheet) return [];
    
    var finCols = ColumnManager.getFinanceCols(finSheet);
    
    // Build set of registration emails
    var regEmails = {};
    var regLastRow = regSheet.getLastRow();
    if (regLastRow >= 2) {
      var regData = regSheet.getRange(2, SYSTEM_CONFIG.COLS.REG.EMAIL, regLastRow - 1, 1).getValues();
      for (var i = 0; i < regData.length; i++) {
        var email = Utils.normalizeEmail(regData[i][0]);
        if (email) regEmails[email] = true;
      }
    }
    
    // Find finance rows without matching registration
    var orphans = [];
    var finLastRow = finSheet.getLastRow();
    if (finLastRow >= 2 && finCols.Email) {
      var finData = finSheet.getRange(2, finCols.Email, finLastRow - 1, 1).getValues();
      for (var j = 0; j < finData.length; j++) {
        var finEmail = Utils.normalizeEmail(finData[j][0]);
        if (finEmail && !regEmails[finEmail]) {
          orphans.push({ row: j + 2, email: finEmail });
        }
      }
    }
    
    return orphans;
  }
  
  return {
    validateRegistrationRow: validateRegistrationRow,
    findOrphanedFinanceRows: findOrphanedFinanceRows
  };
})();

// ============================================================================
// PART 16: CLEANUP UTILITIES (NEW)
// ============================================================================

function cleanupOrphanedFinanceRows() {
  var ui = SpreadsheetApp.getUi();
  
  var orphans = DataIntegrity.findOrphanedFinanceRows();
  
  if (orphans.length === 0) {
    ui.alert("✅ No orphaned finance rows found.");
    return;
  }
  
  var message = "Found " + orphans.length + " orphaned finance row(s):\n\n";
  for (var i = 0; i < Math.min(orphans.length, 10); i++) {
    message += "• Row " + orphans[i].row + ": " + orphans[i].email + "\n";
  }
  if (orphans.length > 10) {
    message += "... and " + (orphans.length - 10) + " more.\n";
  }
  message += "\nDo you want to remove these rows?";
  
  var confirm = ui.alert("Orphaned Finance Rows", message, ui.ButtonSet.YES_NO);
  if (confirm !== ui.Button.YES) return;
  
  var repo = new SheetRepository();
  var finSheet = repo.getFinanceSheet();
  
  // Delete from bottom to top to preserve row indices
  orphans.sort(function(a, b) { return b.row - a.row; });
  
  for (var j = 0; j < orphans.length; j++) {
    finSheet.deleteRow(orphans[j].row);
  }
  
  AuditLogService.info("CLEANUP_ORPHANS", "Removed " + orphans.length + " orphaned finance rows.");
  ui.alert("✅ Removed " + orphans.length + " orphaned finance row(s).");
}

function resetRateLimiter() {
  var ui = SpreadsheetApp.getUi();
  var confirm = ui.alert(
    "Reset Rate Limiter?",
    "This will reset the email rate limit counter. Use only if you're sure emails were not actually sent.",
    ui.ButtonSet.YES_NO
  );
  
  if (confirm !== ui.Button.YES) return;
  
  var props = PropertiesService.getScriptProperties();
  var keys = props.getKeys();
  
  for (var i = 0; i < keys.length; i++) {
    // The limiter's two keys are HNS_EMAIL_COUNTER and HNS_LAST_EMAIL_SEND
    if (keys[i].indexOf("EMAIL_RATE_") === 0 || keys[i].indexOf("HNS_EMAIL_") === 0 || keys[i] === "HNS_LAST_EMAIL_SEND") {
      props.deleteProperty(keys[i]);
    }
  }
  
  AuditLogService.info("RATE_LIMIT_RESET", "Rate limiter counters cleared.");
  ui.alert("✅ Rate limiter has been reset.");
}

