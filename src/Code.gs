/**
 * ALTERNATIVE TO ROW REARRANGING: Visual Group Indicators
 * Adds color coding and formatting to show which rows belong to the same merge group
 * UPDATED: Now works on BOTH Registration and Financial Dashboard sheets
 */
function addMergeGroupIndicators() {
  var ui = SpreadsheetApp.getUi();
  var lock = LockService.getScriptLock();
  
  if (ui.alert("Add Visual Merge Indicators?", 
      "This will add color-coded backgrounds and borders to merged groups in BOTH:\n" +
      "• Registration sheet (Registration Form)\n" +
      "• Financial Dashboard sheet\n\n" +
      "Each merge group will have a unique color, making it easy to see which participants belong together.\n\nContinue?", 
      ui.ButtonSet.YES_NO) != ui.Button.YES) return;

  if (!lock.tryLock(30000)) {
    ui.alert("System is busy. Please try again later.");
    return;
  }
  
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast("Applying merge indicators...", "Visual Indicators", -1);
    
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var repo = new SheetRepository();
    
    // Get both sheets
    var regSheet = repo.getRegistrationSheet();
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    
    if (!finSheet) {
      ui.alert("Financial Dashboard sheet not found. Only Registration sheet will be colored.");
    }
    
    var regData = regSheet.getDataRange().getValues();
    var regMap = ColumnManager.headerMap(regSheet);
    
    var colGroup = regMap[V22_CONFIG.MERGE.REG_HEADERS.GROUP_ID];
    var colRole = regMap[V22_CONFIG.MERGE.REG_HEADERS.ROLE];
    var colEmail = SYSTEM_CONFIG.COLS.REG.EMAIL;
    
    if (!colGroup || !colRole) {
      ui.alert("Merge columns (Group ID/Role) not found. Please run 'Open Merge Interface' first to initialize.");
      return;
    }
    
    // Define color palette for groups (pastel colors for better readability)
    var colors = [
      "#FFE5E5", // Light red
      "#E5F5FF", // Light blue
      "#E5FFE5", // Light green
      "#FFF5E5", // Light orange
      "#FFE5FF", // Light pink
      "#FFFFE5", // Light yellow
      "#E5E5FF", // Light purple
      "#E5FFFF", // Light cyan
      "#FFE5F5", // Light magenta
      "#F5FFE5"  // Light lime
    ];
    
    // === STEP 1: Apply to Registration Sheet ===
    SpreadsheetApp.getActiveSpreadsheet().toast("Applying to Registration sheet...", "Visual Indicators", -1);
    
    // Reset all backgrounds to white
    var lastRow = regSheet.getLastRow();
    if (lastRow > 1) {
      regSheet.getRange(2, 1, lastRow - 1, regSheet.getLastColumn()).setBackground("white");
      regSheet.getRange(2, 1, lastRow - 1, regSheet.getLastColumn()).setBorder(null, null, null, null, null, null);
    }
    
    // Group rows by merge group ID  in Registration
    var groupRows = {}; // { groupId: [rowIndex1, rowIndex2, ...] }
    var colorIndex = {};
    var nextColorIdx = 0;
    
    for (var i = 1; i < regData.length; i++) {
      var gid = String(regData[i][colGroup-1] || "").trim();
      var email = String(regData[i][colEmail-1] || "").trim();
      
      if (!gid || !email) continue;
      
      if (!groupRows[gid]) {
        groupRows[gid] = [];
        colorIndex[gid] = colors[nextColorIdx % colors.length];
        nextColorIdx++;
      }
      
      groupRows[gid].push(i + 1); // +1 for 1-indexed rows
    }
    
    // Apply colors and borders to each group in Registration
    var groupCount = 0;
    for (var gid in groupRows) {
      if (!groupRows.hasOwnProperty(gid)) continue;
      
      var rows = groupRows[gid];
      if (rows.length < 2) continue; // Skip single-participant "groups"
      
      var color = colorIndex[gid];
      
      // Apply background color to all rows in the group
      rows.forEach(function(rowNum) {
        var range = regSheet.getRange(rowNum, 1, 1, regSheet.getLastColumn());
        range.setBackground(color);
      });
      
      // Add thick borders around the entire group
      var firstRow = Math.min.apply(null, rows);
      var lastRow = Math.max.apply(null, rows);
      var groupRange = regSheet.getRange(firstRow, 1, lastRow - firstRow + 1, regSheet.getLastColumn());
      
      groupRange.setBorder(
        true,  // top
        true,  // left
        true,  // bottom
        true,  // right
        null,  // vertical inner
        null,  // horizontal inner
        "#333333", // color
        SpreadsheetApp.BorderStyle.SOLID_THICK
      );
      
      groupCount++;
    }
    
    // === STEP 2: Apply to Financial Dashboard ===
    if (finSheet) {
      SpreadsheetApp.getActiveSpreadsheet().toast("Applying to Financial Dashboard...", "Visual Indicators", -1);
      
      var finData = finSheet.getDataRange().getValues();
      var finMap = ColumnManager.headerMap(finSheet);
      
      // Financial Dashboard uses "Email" column to match
      var finEmailCol = null;
      for (var col in finMap) {
        if (col.toLowerCase().indexOf("email") !== -1) {
          finEmailCol = finMap[col];
          break;
        }
      }
      
      if (!finEmailCol) {
        ui.alert("Warning: Could not find Email column in Financial Dashboard. Skipping Financial Dashboard coloring.");
      } else {
        // Reset Financial Dashboard backgrounds
        var finLastRow = finSheet.getLastRow();
        if (finLastRow > 1) {
          finSheet.getRange(2, 1, finLastRow - 1, finSheet.getLastColumn()).setBackground("white");
          finSheet.getRange(2, 1, finLastRow - 1, finSheet.getLastColumn()).setBorder(null, null, null, null, null, null);
        }
        
        // Build email-to-group mapping from Registration
        var emailToGroup = {};
        for (var r = 1; r < regData.length; r++) {
          var gid = String(regData[r][colGroup-1] || "").trim();
          var email = String(regData[r][colEmail-1] || "").trim().toLowerCase();
          if (gid && email) {
            emailToGroup[email] = gid;
          }
        }
        
        // Apply colors to Financial Dashboard rows based on email match
        var finGroupRows = {}; // { groupId: [rowIndex1, ...] }
        for (var f = 1; f < finData.length; f++) {
          var finEmail = String(finData[f][finEmailCol-1] || "").trim().toLowerCase();
          if (!finEmail) continue;
          
          var matchedGid = emailToGroup[finEmail];
          if (!matchedGid) continue;
          
          if (!finGroupRows[matchedGid]) {
            finGroupRows[matchedGid] = [];
          }
          finGroupRows[matchedGid].push(f + 1);
        }
        
        // Apply colors and borders in Financial Dashboard
        for (var fgid in finGroupRows) {
          if (!finGroupRows.hasOwnProperty(fgid)) continue;
          
          var frows = finGroupRows[fgid];
          if (frows.length < 2) continue;
          
          var fcolor = colorIndex[fgid]; // Use same color as Registration
          
          frows.forEach(function(rowNum) {
            var range = finSheet.getRange(rowNum, 1, 1, finSheet.getLastColumn());
            range.setBackground(fcolor);
          });
          
          var firstFinRow = Math.min.apply(null, frows);
          var lastFinRow = Math.max.apply(null, frows);
          var finGroupRange = finSheet.getRange(firstFinRow, 1, lastFinRow - firstFinRow + 1, finSheet.getLastColumn());
          
          finGroupRange.setBorder(
            true, true, true, true, null, null,
            "#333333",
            SpreadsheetApp.BorderStyle.SOLID_THICK
          );
        }
      }
    }
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Applied indicators to " + groupCount + " groups.", "Success", 3);
    ui.alert("✅ Visual Indicators Applied!\n\n" +
             "Applied color coding and borders to " + groupCount + " merge groups in:\n" +
             "• Registration sheet\n" +
             (finSheet ? "• Financial Dashboard sheet\n\n" : "\n") +
             "Each group has a unique background color and is surrounded by a thick border.");
    
  } catch (e) {
    ui.alert("Error: " + e);
    Logger.log("Error in addMergeGroupIndicators: " + e);
  } finally {
    lock.releaseLock();
  }
}

/**
 * Remove all merge group visual indicators
 * UPDATED: Now removes from BOTH Registration and Financial Dashboard
 */
function removeMergeGroupIndicators() {
  var ui = SpreadsheetApp.getUi();
  
  if (ui.alert("Remove Visual Indicators?", 
      "This will reset all backgrounds and borders in:\n" +
      "• Registration sheet\n" +
      "• Financial Dashboard sheet\n\nContinue?", 
      ui.ButtonSet.YES_NO) != ui.Button.YES) return;
  
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var repo = new SheetRepository();
    
    // Reset Registration sheet
    SpreadsheetApp.getActiveSpreadsheet().toast("Clearing Registration sheet...", "Remove Indicators", -1);
    var regSheet = repo.getRegistrationSheet();
    var lastRow = regSheet.getLastRow();
    
    if (lastRow > 1) {
      regSheet.getRange(2, 1, lastRow - 1, regSheet.getLastColumn()).setBackground("white");
      regSheet.getRange(2, 1, lastRow - 1, regSheet.getLastColumn()).setBorder(null, null, null, null, null, null);
    }
    
    // Reset Financial Dashboard
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    if (finSheet) {
      SpreadsheetApp.getActiveSpreadsheet().toast("Clearing Financial Dashboard...", "Remove Indicators", -1);
      var finLastRow = finSheet.getLastRow();
      
      if (finLastRow > 1) {
        finSheet.getRange(2, 1, finLastRow - 1, finSheet.getLastColumn()).setBackground("white");
        finSheet.getRange(2, 1, finLastRow - 1, finSheet.getLastColumn()).setBorder(null, null, null, null, null, null);
      }
    }
    
    ui.alert("✅ Visual indicators removed from all sheets.");
  } catch (e) {
    ui.alert("Error: " + e);
  }
}


