    '    document.getElementById("sendCount").textContent = d.recipients.length;',
    '    google.script.run.withSuccessHandler(function() { doSend(); }).clearFailedAnnouncementQueue();',
    '  }).getFailedAnnouncementRecipients();',
    '}',
    'function doScheduleRetry() {',
    '  google.script.run.withSuccessHandler(function(res) {',
