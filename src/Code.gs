function cleanupOrphanedFinanceRows() {
  var ui = SpreadsheetApp.getUi();
  
  var orphans = DataIntegrity.findOrphanedFinanceRows();
  
  if (orphans.length === 0) {
    ui.alert("✅ No orphaned finance rows found.");
    return;
  }
  
  var message = "Found " + orphans.length + " orphaned finance row(s):\n\n";
  for (var i = 0; i < Math.min(orphans.length, 10); i++) {
    message += "• Row " + orphans[i].row + ": " + orphans[i].email + "\n";
  }
  if (orphans.length > 10) {
    message += "... and " + (orphans.length - 10) + " more.\n";
  }
  message += "\nDo you want to remove these rows?";
  
  var confirm = ui.alert("Orphaned Finance Rows", message, ui.ButtonSet.YES_NO);
  if (confirm !== ui.Button.YES) return;
  
  var repo = new SheetRepository();
  var finSheet = repo.getFinanceSheet();
  
  // Delete from bottom to top to preserve row indices
  orphans.sort(function(a, b) { return b.row - a.row; });
  
  for (var j = 0; j < orphans.length; j++) {
    finSheet.deleteRow(orphans[j].row);
  }
  
  AuditLogService.info("CLEANUP_ORPHANS", "Removed " + orphans.length + " orphaned finance rows.");
  ui.alert("✅ Removed " + orphans.length + " orphaned finance row(s).");
}

