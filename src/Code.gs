    if (/COMPETITION/i.test(hh) && /WHICH|SELECT|CHOOSE/i.test(hh)) colMap.competition = i;
    if (/^FULL\s*NAME$/i.test(hh) || hh === "NAME") colMap.name = i;
    if (/PAYMENT.*STATUS|STATUS.*PAYMENT/i.test(hh)) colMap.payStatus = i;
    if (/TOTAL.*FEE|FINAL.*AMOUNT|TOTAL.*AMOUNT/i.test(hh)) colMap.totalFee = i;
    if (/BASE.*FEE/i.test(hh)) colMap.baseFee = i;
    if (/BUNDLE.*DISCOUNT/i.test(hh)) colMap.bundleDisc = i;
