var ColumnManager = (function () {
  function headerMap(sheet) {
    var lastCol = sheet.getLastColumn();
    if (lastCol < 1) return {};
    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    var map = {};
    for (var i = 0; i < headers.length; i++) {
      var key = String(headers[i] || "").trim();
      if (key) map[key] = i + 1;
    }
    return map;
  }

  function ensureHeaders(sheet, headerList) {
    var existing = headerMap(sheet);
    var toCreate = [];
    for (var i = 0; i < headerList.length; i++) {
      if (!existing[headerList[i]]) toCreate.push(headerList[i]);
    }
    if (toCreate.length) {
      var lastCol = sheet.getLastColumn();
      sheet.insertColumnsAfter(lastCol, toCreate.length);
      sheet.getRange(1, lastCol + 1, 1, toCreate.length).setValues([toCreate]);
      AuditLogService.info("HEADERS_CREATED", sheet.getName() + ": " + toCreate.join(", "));
      return headerMap(sheet);
    }
    return existing;
  }

  function ensureSysColsOnRegistration(regSheet) {
    var vals = [];
    for (var k in SYSTEM_CONFIG.SYS_REG_HEADERS) {
      if (SYSTEM_CONFIG.SYS_REG_HEADERS.hasOwnProperty(k)) {
        vals.push(SYSTEM_CONFIG.SYS_REG_HEADERS[k]);
      }
    }
    return ensureHeaders(regSheet, vals);
  }

  function ensureFinanceHeaders(finSheet) {
    return ensureHeaders(finSheet, SYSTEM_CONFIG.FINANCE_HEADERS.REQUIRED);
  }

  function resolveFinanceCol(finHeaderMap, canonicalHeader) {
    if (finHeaderMap[canonicalHeader]) return finHeaderMap[canonicalHeader];
    var aliases = SYSTEM_CONFIG.FINANCE_HEADERS.ALIASES || {};
    for (var alias in aliases) {
      if (aliases.hasOwnProperty(alias)) {
        if (aliases[alias] === canonicalHeader && finHeaderMap[alias]) {
          return finHeaderMap[alias];
        }
      }
    }
    return null;
  }

  function getFinanceCols(finSheet) {
    var map = ensureFinanceHeaders(finSheet);
    function get(h) { return resolveFinanceCol(map, h); }
    return {
      map: map,
      Timestamp: get("Timestamp"),
      Email: get("Email"),
      Name: get("Name"),
      PaymentMode: get("Payment Mode"),
      ProofLink: get("Proof Link"),
      RefCode: get("Ref Code"),
      CouponCode: get("Coupon Code"),
      GenId: get("Gen. ID"),
      RefCount: get("Ref Count"),
      Cashback: get("Cashback"),
      TotalAmount: get("Total Amount"),
      Status: get("Status"),
      Verifier: get("Verifier"),
      PayRef: get("Pay Ref"),
      EmailSent: get("Email Sent"),
      SysPaidAt: get("SYS_PAID_AT")
    };
  }

  // V23: Ensure SYS columns exist on Submissions sheet (Submission Form)
  function ensureSysColsOnSubmissions(subSheet) {
    if (!subSheet) return {};
    var headers = SYSTEM_CONFIG.DEPERSONALIZATION.SYS_HEADERS;
    var lastCol = subSheet.getLastColumn();
    var existingHeaders = lastCol > 0 ? subSheet.getRange(1, 1, 1, lastCol).getValues()[0] : [];
    var colMap = {};
    
    // Map existing headers
    for (var i = 0; i < existingHeaders.length; i++) {
      var h = String(existingHeaders[i]).trim();
      if (h) colMap[h] = i + 1;
    }
    
    // Create missing SYS columns
    for (var j = 0; j < headers.length; j++) {
      if (!colMap[headers[j]]) {
        lastCol++;
        subSheet.getRange(1, lastCol).setValue(headers[j]).setFontWeight("bold").setBackground("#333333").setFontColor("#FFFFFF");
        colMap[headers[j]] = lastCol;
        AuditLogService.info("SYS_COL_CREATED", "Created " + headers[j] + " at col " + lastCol + " on Submissions sheet");
      }
    }
    
    return colMap;
  }

  return {
    headerMap: headerMap,
    ensureSysColsOnRegistration: ensureSysColsOnRegistration,
    ensureSysColsOnSubmissions: ensureSysColsOnSubmissions,
    ensureFinanceHeaders: ensureFinanceHeaders,
    getFinanceCols: getFinanceCols
  };
})();

