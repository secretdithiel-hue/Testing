    '    else { alert("Error: " + res.error); }',
    '  }).scheduleAnnouncementRetry();',
    '}',
    'function doClearQueue() {',
    '  if(!confirm("Clear the queued failed emails? They will NOT be retried.")) return;',
    '  google.script.run.withSuccessHandler(function() {',
    '    document.getElementById("retryBanner").style.display = "none"; alert("Queue cleared.");',
    '  }).clearFailedAnnouncementQueue();',
    '}',
    'function doSaveAndSchedule() {',
    '  var fd = { category: selectedCategory, subject: document.getElementById("emailSubject").value, body: document.getElementById("emailBody").innerHTML, signoff: document.getElementById("emailSignoff").innerHTML, recipients: failedRecipientsCache };',
    '  google.script.run.withSuccessHandler(function(res) {',
