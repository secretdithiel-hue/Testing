  h.push('function esc(s){');
  h.push('  var out = "", ch, i;');
  h.push('  s = String(s||"");');
  h.push('  for (i = 0; i < s.length; i++) {');
  h.push('    ch = s.charAt(i);');
  h.push('    if (ch === "&") out += "&amp;";');
  h.push('    else if (ch === "<") out += "&lt;";');
  h.push('    else if (ch === ">") out += "&gt;";');
  h.push('    else if (ch === \'"\') out += "&quot;";');
  h.push('    else if (ch === "\'") out += "&#39;";');
  h.push('    else out += ch;');
  h.push('  }');
  h.push('  return out;');
  h.push('}');
