/**
 * Execute the system update with selected actions
 */
function executeSystemUpdate(selectedActions) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  var sheetName = sheet.getName();
  var selection = sheet.getActiveRange();
  var sheetType = detectSheetType_(sheetName);
  
  var results = {
    scanned: 0,
    updated: 0,
    errors: 0,
    details: []
  };
  
  // Determine rows to process
  var startRow = Math.max(2, selection.getRow()); // Skip header
  var numRows = selection.getNumRows();
  if (selection.getRow() === 1) numRows--; // Adjust if header selected
  var endRow = startRow + numRows - 1;
  
  // If whole sheet or large selection, process all data rows
  if (selection.getNumRows() >= sheet.getLastRow() - 1) {
    startRow = 2;
    endRow = sheet.getLastRow();
  }
  
  results.scanned = endRow - startRow + 1;
  
  // Execute based on sheet type
  switch (sheetType.type) {
    case "REGISTRATION":
      results = executeRegistrationUpdate_(sheet, startRow, endRow, selectedActions, results);
      break;
    case "FINANCE":
      results = executeFinanceUpdate_(sheet, startRow, endRow, selectedActions, results);
      break;
    case "COUPONS":
      results = executeCouponsUpdate_(sheet, startRow, endRow, selectedActions, results);
      break;
    case "PARTICIPANT_DB":
      results = executeParticipantDbUpdate_(sheet, selectedActions, results);
      break;
    default:
      results = executeGenericUpdate_(sheet, startRow, endRow, selectedActions, results);
  }
  
  // Build result HTML
  return buildUpdateResultHtml_(results, sheetType);
}

/**
 * Execute Registration sheet updates
 */
function executeRegistrationUpdate_(sheet, startRow, endRow, actions, results) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
  var couponSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.COUPONS);
  
  // Load coupon data for discount lookups
  var couponMap = {};
  if (couponSheet && couponSheet.getLastRow() > 1) {
    var couponData = couponSheet.getDataRange().getValues();
    for (var c = 1; c < couponData.length; c++) {
      var code = String(couponData[c][0] || "").trim().toUpperCase();
      if (code) {
        couponMap[code] = Number(couponData[c][1] || 0);
      }
    }
  }
  
  // Build existing Gen IDs map for referral validation
  var existingGenIds = {};
  var genIdCol = SYSTEM_CONFIG.COLS.REG.GEN_ID;
  if (sheet.getLastRow() > 1) {
    var genIdData = sheet.getRange(2, genIdCol, sheet.getLastRow() - 1, 1).getValues();
    for (var g = 0; g < genIdData.length; g++) {
      var gid = String(genIdData[g][0] || "").trim().toUpperCase();
      if (gid) existingGenIds[gid] = g + 2;
    }
  }
  
  // Process each row
  for (var row = startRow; row <= endRow; row++) {
    try {
      var rowData = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
      var updates = {};
      var rowUpdated = false;
      
      // Skip if no email (empty row)
      var email = String(rowData[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
      if (!email) continue;
      
      // ===== GEN_ID =====
      if (actions.indexOf("GEN_ID") >= 0) {
        var currentGenId = String(rowData[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "").trim();
        if (!currentGenId || !/^REF-[A-Z0-9]{8}$/i.test(currentGenId)) {
          var newGenId = IdGenerator.generate();
          sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).setValue(newGenId);
          results.details.push("Row " + row + ": Generated Gen ID " + newGenId);
          rowUpdated = true;
          existingGenIds[newGenId.toUpperCase()] = row;
        }
      }
      
      // ===== PRICING =====
      if (actions.indexOf("PRICING") >= 0) {
        var competitions = String(rowData[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "").trim();
        if (competitions) {
          var pricing = PricingEngine.calculate("", competitions);
          
          var currentBaseFee = Number(rowData[SYSTEM_CONFIG.COLS.REG.BASE_FEE - 1] || 0);
          var currentBundleDisc = Number(rowData[SYSTEM_CONFIG.COLS.REG.BUNDLE_DISCOUNT - 1] || 0);
          
          if (currentBaseFee !== pricing.rawTotal || currentBundleDisc !== pricing.bundleDiscount) {
            sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.BASE_FEE).setValue(pricing.rawTotal);
            sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.BUNDLE_DISCOUNT).setValue(pricing.bundleDiscount);
            results.details.push("Row " + row + ": Updated pricing (Base: ₱" + pricing.rawTotal + ", Bundle Disc: ₱" + pricing.bundleDiscount + ")");
            rowUpdated = true;
          }
        }
      }
      
      // ===== DISCOUNTS =====
      if (actions.indexOf("DISCOUNTS") >= 0) {
        // Coupon discount
        var lockedCoupon = String(rowData[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || "").trim().toUpperCase();
        var currentCouponDisc = Number(rowData[SYSTEM_CONFIG.COLS.REG.COUPON_DISCOUNT - 1] || 0);
        
        if (lockedCoupon && couponMap[lockedCoupon] && currentCouponDisc !== couponMap[lockedCoupon]) {
          sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.COUPON_DISCOUNT).setValue(couponMap[lockedCoupon]);
          results.details.push("Row " + row + ": Applied coupon discount ₱" + couponMap[lockedCoupon]);
          rowUpdated = true;
        }
        
        // Referral discount
        var lockedRef = String(rowData[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "").trim().toUpperCase();
        var currentRefDisc = Number(rowData[SYSTEM_CONFIG.COLS.REG.REF_DISCOUNT - 1] || 0);
        var expectedRefDisc = lockedRef && existingGenIds[lockedRef] ? (SYSTEM_CONFIG.PRICING.REFERRAL_DISCOUNT_PER_USE || 50) : 0;
        
        if (expectedRefDisc > 0 && currentRefDisc !== expectedRefDisc) {
          sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.REF_DISCOUNT).setValue(expectedRefDisc);
          results.details.push("Row " + row + ": Applied referral discount ₱" + expectedRefDisc);
          rowUpdated = true;
        }
        
        // Recalculate Total Fee
        var baseFee = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.BASE_FEE).getValue() || 0);
        var bundleDisc = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.BUNDLE_DISCOUNT).getValue() || 0);
        var couponDisc = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.COUPON_DISCOUNT).getValue() || 0);
        var refDisc = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.REF_DISCOUNT).getValue() || 0);
        
        // If no base fee, calculate from competitions
        if (!baseFee) {
          var comps = String(rowData[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "").trim();
          if (comps) {
            var p = PricingEngine.calculate("", comps);
            baseFee = p.finalPrice; // Use bundle price
          }
        }
        
        var totalFee = Math.max(0, baseFee - bundleDisc - couponDisc - refDisc);
        var currentTotal = Number(rowData[SYSTEM_CONFIG.COLS.REG.TOTAL_FEE - 1] || 0);
        
        if (Math.abs(totalFee - currentTotal) > 1) {
          sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.TOTAL_FEE).setValue(totalFee);
          results.details.push("Row " + row + ": Updated Total Fee to ₱" + totalFee);
          rowUpdated = true;
        }
      }
      
      // ===== PAYMENT_STATUS =====
      if (actions.indexOf("PAYMENT_STATUS") >= 0) {
        var currentStatus = String(rowData[SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS - 1] || "").trim();
        if (!currentStatus) {
          sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS).setValue("NOT YET");
          results.details.push("Row " + row + ": Set Payment Status to NOT YET");
          rowUpdated = true;
        }
      }
      
      // ===== REFERRALS =====
      if (actions.indexOf("REFERRALS") >= 0) {
        var myGenId = String(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue() || "").trim().toUpperCase();
        if (myGenId) {
          // Count how many people used this Gen ID as referral
          var refCount = 0;
          var lockedRefCol = SYSTEM_CONFIG.COLS.REG.LOCKED_REF;
          var allLockedRefs = sheet.getRange(2, lockedRefCol, sheet.getLastRow() - 1, 1).getValues();
          
          for (var r = 0; r < allLockedRefs.length; r++) {
            if (String(allLockedRefs[r][0] || "").trim().toUpperCase() === myGenId) {
              refCount++;
            }
          }
          
          var currentRefCount = Number(rowData[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
          if (refCount !== currentRefCount) {
            sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.REF_COUNT).setValue(refCount);
            
            // Calculate earnings: ₱50 first + ₱10 each additional
            var earnings = refCount > 0 ? 50 + Math.max(0, refCount - 1) * 10 : 0;
            sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.CASHBACK).setValue(earnings);
            
            results.details.push("Row " + row + ": Updated Referral Count to " + refCount + ", Earnings ₱" + earnings);
            rowUpdated = true;
          }
        }
      }
      
      // ===== SYNC_FINANCE =====
      if (actions.indexOf("SYNC_FINANCE") >= 0 && finSheet) {
        var genId = String(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue() || "").trim();
        var name = String(rowData[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "").trim();
        var totalFee = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.TOTAL_FEE).getValue() || 0);
        
        if (genId && email) {
          // Check if exists in Finance
          var finData = finSheet.getDataRange().getValues();
          var existsInFin = false;
          for (var f = 1; f < finData.length; f++) {
            if (String(finData[f][1] || "").toLowerCase().trim() === email.toLowerCase()) {
              existsInFin = true;
              break;
            }
          }
          
          if (!existsInFin) {
            finSheet.appendRow([
              name,
              email,
              genId,
              new Date(),
              totalFee,
              "NOT YET",
              ""
            ]);
            results.details.push("Row " + row + ": Added to Finance sheet");
            rowUpdated = true;
          }
        }
      }
      
      if (rowUpdated) results.updated++;
      
    } catch (e) {
      results.errors++;
      results.details.push("Row " + row + ": ERROR - " + e.message);
    }
  }
  
  return results;
}

/**
 * Execute Finance sheet updates
 */
function executeFinanceUpdate_(sheet, startRow, endRow, actions, results) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  
  // Build registration data map by email
  var regMap = {};
  if (regSheet && regSheet.getLastRow() > 1) {
    var regData = regSheet.getDataRange().getValues();
    for (var r = 1; r < regData.length; r++) {
      var email = String(regData[r][SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").toLowerCase().trim();
      if (email) {
        regMap[email] = {
          name: regData[r][SYSTEM_CONFIG.COLS.REG.NAME - 1],
          genId: regData[r][SYSTEM_CONFIG.COLS.REG.GEN_ID - 1],
          totalFee: regData[r][SYSTEM_CONFIG.COLS.REG.TOTAL_FEE - 1],
          status: regData[r][SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS - 1]
        };
      }
    }
  }
  
  for (var row = startRow; row <= endRow; row++) {
    try {
      var rowData = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
      var email = String(rowData[1] || "").toLowerCase().trim(); // Email is typically column B
      var rowUpdated = false;
      
      if (!email) continue;
      
      // ===== SYNC_FROM_REG =====
      if (actions.indexOf("SYNC_FROM_REG") >= 0 && regMap[email]) {
        var reg = regMap[email];
        
        // Update name if empty
        if (!rowData[0] && reg.name) {
          sheet.getRange(row, 1).setValue(reg.name);
          rowUpdated = true;
        }
        
        // Update Gen ID if empty
        if (!rowData[2] && reg.genId) {
          sheet.getRange(row, 3).setValue(reg.genId);
          rowUpdated = true;
        }
        
        // Update Amount if empty
        if (!rowData[4] && reg.totalFee) {
          sheet.getRange(row, 5).setValue(reg.totalFee);
          rowUpdated = true;
        }
        
        if (rowUpdated) {
          results.details.push("Row " + row + ": Synced data from Registration");
        }
      }
      
      // ===== UPDATE_STATUS =====
      if (actions.indexOf("UPDATE_STATUS") >= 0) {
        var currentStatus = String(rowData[5] || "").trim();
        if (!currentStatus) {
          sheet.getRange(row, 6).setValue("NOT YET");
          results.details.push("Row " + row + ": Set status to NOT YET");
          rowUpdated = true;
        }
      }
      
      if (rowUpdated) results.updated++;
      
    } catch (e) {
      results.errors++;
      results.details.push("Row " + row + ": ERROR - " + e.message);
    }
  }
  
  return results;
}

/**
 * Execute Coupons sheet updates
 */
function executeCouponsUpdate_(sheet, startRow, endRow, actions, results) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  
  // Count coupon usage from Registration
  var couponUsage = {};
  if (regSheet && regSheet.getLastRow() > 1) {
    var lockedCouponCol = SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON;
    var couponData = regSheet.getRange(2, lockedCouponCol, regSheet.getLastRow() - 1, 1).getValues();
    for (var c = 0; c < couponData.length; c++) {
      var code = String(couponData[c][0] || "").trim().toUpperCase();
      if (code) {
        couponUsage[code] = (couponUsage[code] || 0) + 1;
      }
    }
  }
  
  for (var row = startRow; row <= endRow; row++) {
    try {
      var rowData = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
      var code = String(rowData[0] || "").trim().toUpperCase();
      var rowUpdated = false;
      
      if (!code) continue;
      
      // ===== UPDATE_USAGE =====
      if (actions.indexOf("UPDATE_USAGE") >= 0) {
        var actualUsage = couponUsage[code] || 0;
        var currentUsage = Number(rowData[5] || 0);
        
        if (actualUsage !== currentUsage) {
          sheet.getRange(row, 6).setValue(actualUsage);
          results.details.push("Row " + row + " (" + code + "): Updated usage from " + currentUsage + " to " + actualUsage);
          rowUpdated = true;
        }
      }
      
      // ===== CHECK_EXPIRY =====
      if (actions.indexOf("CHECK_EXPIRY") >= 0) {
        var endDate = rowData[3];
        if (endDate instanceof Date && endDate < new Date()) {
          var currentStatus = String(rowData[6] || "").toUpperCase();
          if (currentStatus !== "EXPIRED") {
            sheet.getRange(row, 7).setValue("EXPIRED");
            results.details.push("Row " + row + " (" + code + "): Marked as EXPIRED");
            rowUpdated = true;
          }
        }
      }
      
      if (rowUpdated) results.updated++;
      
    } catch (e) {
      results.errors++;
      results.details.push("Row " + row + ": ERROR - " + e.message);
    }
  }
  
  return results;
}

/**
 * Execute Participant Database updates
 */
function executeParticipantDbUpdate_(sheet, actions, results) {
  // ===== REFRESH_QUERY =====
  if (actions.indexOf("REFRESH_QUERY") >= 0) {
    var a1Value = sheet.getRange("A1").getFormula();
    if (a1Value && a1Value.indexOf("QUERY") >= 0) {
      // Re-set the formula to force refresh
      sheet.getRange("A1").setFormula(a1Value);
      results.details.push("Refreshed QUERY formula");
      results.updated++;
    } else {
      results.details.push("No QUERY formula found in A1");
    }
  }
  
  return results;
}

/**
 * Execute generic updates for unknown sheets
 */
function executeGenericUpdate_(sheet, startRow, endRow, actions, results) {
  for (var row = startRow; row <= endRow; row++) {
    try {
      var rowData = sheet.getRange(row, 1, 1, sheet.getLastColumn()).getValues()[0];
      var rowUpdated = false;
      
      // ===== TRIM_SPACES =====
      if (actions.indexOf("TRIM_SPACES") >= 0) {
        for (var col = 0; col < rowData.length; col++) {
          var val = rowData[col];
          if (typeof val === "string" && val !== val.trim()) {
            sheet.getRange(row, col + 1).setValue(val.trim());
            rowUpdated = true;
          }
        }
        if (rowUpdated) {
          results.details.push("Row " + row + ": Trimmed whitespace");
        }
      }
      
      // ===== SCAN_EMPTY =====
      if (actions.indexOf("SCAN_EMPTY") >= 0) {
        var emptyCols = [];
        for (var col = 0; col < rowData.length; col++) {
          if (rowData[col] === "" || rowData[col] === null || rowData[col] === undefined) {
            emptyCols.push(col + 1);
          }
        }
        if (emptyCols.length > 0) {
          results.details.push("Row " + row + ": Empty cells in columns " + emptyCols.join(", "));
        }
      }
      
      if (rowUpdated) results.updated++;
      
    } catch (e) {
      results.errors++;
    }
  }
  
  return results;
}

