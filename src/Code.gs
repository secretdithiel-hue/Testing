function rebuildFinanceDashboardFull() {
  var ui = SpreadsheetApp.getUi();

  try {
    var ok = ui.alert(
      "Full Rebuild Finance Dashboard?",
      "This will rebuild Finance from Registration, preserve admin fields, keep dropdown validation working, and run QA checks.\nContinue?",
      ui.ButtonSet.YES_NO
    );
    if (ok !== ui.Button.YES) return;

    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    if (!regSheet || !finSheet) throw new Error("Missing Registration or Finance sheet.");

    ColumnManager.ensureSysColsOnRegistration(regSheet);
    var finCols = ColumnManager.getFinanceCols(finSheet);

    // Cache existing admin fields by email
    var metaCache = buildFinanceMetaCache_(finSheet, finCols);

    // Read registration
    var regLastRow = regSheet.getLastRow();
    if (regLastRow < 2) {
      ui.alert("No registration data found.");
      return;
    }

    var regLastCol = regSheet.getLastColumn();
    var regData = regSheet.getRange(2, 1, regLastRow - 1, regLastCol).getValues();

    var regSysCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regPaidAtCol = regSysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT];

    // Build payloads in order
    var payloads = [];
    for (var i = 0; i < regData.length; i++) {
      var rr = regData[i];
      var email = String(rr[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
      if (!email) continue;

      var key = email.toLowerCase();
      var cached = metaCache[key] || {
        Status: SYSTEM_CONFIG.ADMIN.NOT_YET_WORD,
        Verifier: "",
        PayRef: "",
        EmailSent: "",
        SysPaidAt: ""
      };

      var regPaidAtVal = regPaidAtCol ? rr[regPaidAtCol - 1] : "";
      var status = cached.Status || SYSTEM_CONFIG.ADMIN.NOT_YET_WORD;
      if (regPaidAtVal) status = SYSTEM_CONFIG.ADMIN.TRIGGER_WORD;

      // Calculate NET total (original payment - cashback earned)
      var originalPayment = Number(rr[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
      var cashbackEarned = Number(rr[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
      var netTotalAmount = Math.max(0, originalPayment - cashbackEarned);

      payloads.push({
        Timestamp: rr[SYSTEM_CONFIG.COLS.REG.TIMESTAMP - 1] || new Date(),
        Email: email,
        Name: rr[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "",
        PaymentMode: rr[SYSTEM_CONFIG.COLS.REG.PAY_MODE - 1] || "",
        ProofLink: rr[SYSTEM_CONFIG.COLS.REG.PAY_PROOF - 1] || "",
        RefCode: rr[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || rr[SYSTEM_CONFIG.COLS.REG.REF_INPUT - 1] || "",
        CouponCode: rr[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || rr[SYSTEM_CONFIG.COLS.REG.COUPON_INPUT - 1] || "",
        GenId: rr[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "",
        RefCount: rr[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0,
        Cashback: cashbackEarned,
        TotalAmount: netTotalAmount,
        Status: status,
        Verifier: cached.Verifier || "",
        PayRef: cached.PayRef || "",
        EmailSent: cached.EmailSent || "",
        SysPaidAt: cached.SysPaidAt || (regPaidAtVal || "")
      });
    }

    // Ensure enough rows + buffer for future entries
    var buffer = 100;
    ensureFinanceRowCapacity_(finSheet, 1 + payloads.length + buffer);

    // Copy Row2 validations down to all rows
    applyFinanceTemplateValidations_(finSheet);

    // Clear content (keep validations)
    clearFinanceDataRange_(finSheet, finSheet.getMaxRows() - 1);

    // Write bulk
    writeFinancePayloadsSequential_(finSheet, finCols, payloads);

    AuditLogService.info("FIN_REBUILD_FULL", "Rebuilt rows=" + payloads.length + " buffer=" + buffer);

    // QA
    var qa = validateFinanceDashboard_({ silent: true });
    // V22: Reapply merge group accounting (prevents merged totals from being overwritten by Rebuild)
    try {
      MergeService.reapplyAllMerges({ silent: true });
    } catch (e) {
      AuditLogService.warn("MERGE_REAPPLY_AFTER_REBUILD_FAIL", String(e));
    }

ui.alert(
      "✅ Full rebuild completed.\n" +
      "Rows rebuilt: " + payloads.length + "\n\n" +
      "QA Summary:\n" +
      "• Issues: " + qa.issueCount + "\n" +
      "• Report Sheet: " + qa.reportSheetName
    );

  } catch (err) {
    AuditLogService.error("FIN_REBUILD_FULL_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ Full rebuild failed:\n" + String(err));
  }
}

function validateFinanceDashboard() {
  var ui = SpreadsheetApp.getUi();
  try {
    var qa = validateFinanceDashboard_({ silent: false });
    ui.alert(
      "✅ QA completed.\n" +
      "Issues: " + qa.issueCount + "\n" +
      "Report Sheet: " + qa.reportSheetName
    );
  } catch (err) {
    AuditLogService.error("FIN_QA_FAIL", err && err.stack ? err.stack : String(err));
    ui.alert("❌ QA failed:\n" + String(err));
  }
}

function validateFinanceDashboard_(opts) {
  opts = opts || {};
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet || !finSheet) throw new Error("Missing Registration or Finance sheet.");

  ColumnManager.ensureSysColsOnRegistration(regSheet);
  var finCols = ColumnManager.getFinanceCols(finSheet);

  var reportName = "Finance QA Report";
  var report = ss.getSheetByName(reportName);
  if (!report) report = ss.insertSheet(reportName);
  report.clearContents();

  var rows = [];
  rows.push(["TYPE", "EMAIL", "DETAILS", "SUGGESTED FIX"]);

  // Registration expected map
  var regLastRow = regSheet.getLastRow();
  var regData = (regLastRow >= 2)
    ? regSheet.getRange(2, 1, regLastRow - 1, regSheet.getLastColumn()).getValues()
    : [];

  var regByEmail = {};
  for (var i = 0; i < regData.length; i++) {
    var rr = regData[i];
    var email = String(rr[SYSTEM_CONFIG.COLS.REG.EMAIL - 1] || "").trim();
    if (!email) continue;

    var key = email.toLowerCase();
    if (regByEmail[key]) {
      rows.push(["DUP_REG_EMAIL", email, "Duplicate email in Registration.", "Resolve duplicates in Registration sheet."]);
      continue;
    }

    var q1 = rr[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
    var q2 = rr[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
    var pricing = PricingEngine.calculate(q1, q2);

    regByEmail[key] = {
      email: email,
      expectedFinal: Number(rr[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0),
      normalizedCompetitions: pricing.normalizedCompetitions || String(q2 || "")
    };
  }

  // Finance checks
  var finLastRow = finSheet.getLastRow();
  var finLastCol = finSheet.getLastColumn();
  var finData = (finLastRow >= 2)
    ? finSheet.getRange(2, 1, finLastRow - 1, finLastCol).getValues()
    : [];

  var seenFinance = {};
  var validStatuses = {};
  validStatuses[SYSTEM_CONFIG.ADMIN.TRIGGER_WORD] = true;
  validStatuses[SYSTEM_CONFIG.ADMIN.NOT_YET_WORD] = true;

  for (var r = 0; r < finData.length; r++) {
    var row = finData[r];
    var emailCell = finCols.Email ? String(row[finCols.Email - 1] || "").trim() : "";
    if (!emailCell) continue;

    var key2 = emailCell.toLowerCase();
    if (seenFinance[key2]) {
      rows.push(["DUP_FIN_EMAIL", emailCell, "Duplicate email in Finance Dashboard.", "Run Full Rebuild."]);
    }
    seenFinance[key2] = true;

    // Status validation
    var statusCell = finCols.Status ? String(row[finCols.Status - 1] || "").trim() : "";
    if (statusCell && !validStatuses[statusCell]) {
      rows.push(["BAD_STATUS", emailCell, "Invalid Status: " + statusCell, 'Use only: "PAID" or "NOT YET PAID".']);
    }

    // Amount validation
    var reg = regByEmail[key2];
    if (!reg) {
      rows.push(["FIN_NO_REG", emailCell, "Finance row exists but no matching Registration row.", "Check email mismatch / remove orphan row."]);
      continue;
    }

    if (finCols.TotalAmount) {
      var finAmt = Number(row[finCols.TotalAmount - 1] || 0);
      if (Math.abs(finAmt - reg.expectedFinal) > 0.0001) {
        rows.push(["AMOUNT_MISMATCH", emailCell, "Finance Total=" + finAmt + " but Registration Final=" + reg.expectedFinal, "Run Force Reprocess or Full Rebuild."]);
      }
    }
  }

  // Missing coverage
  var regKeys = Object.keys(regByEmail);
  for (var j = 0; j < regKeys.length; j++) {
    if (!seenFinance[regKeys[j]]) {
      rows.push(["MISSING_IN_FIN", regByEmail[regKeys[j]].email, "Registrant missing in Finance.", "Run Full Rebuild."]);
    }
  }

  report.getRange(1, 1, rows.length, 4).setValues(rows);
  report.getRange(1, 1, 1, 4).setFontWeight("bold");
  report.autoResizeColumns(1, 4);

  var issueCount = Math.max(0, rows.length - 1);
  AuditLogService.info("FIN_QA_DONE", "Issues=" + issueCount);

  return { issueCount: issueCount, reportSheetName: reportName };
}

// ============================================================================
// PART 11.6: HELPER FUNCTIONS FOR REBUILD
// ============================================================================

function buildFinanceMetaCache_(finSheet, finCols) {
  var metaCache = {};
  var lastRow = finSheet.getLastRow();
  var lastCol = finSheet.getLastColumn();
  if (lastRow < 2 || !finCols.Email) return metaCache;

  var data = finSheet.getRange(2, 1, lastRow - 1, lastCol).getValues();
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var email = String(row[finCols.Email - 1] || "").trim().toLowerCase();
    if (!email) continue;

    metaCache[email] = {
      Status: Utils.normalizeStatusValue(finCols.Status ? row[finCols.Status - 1] : SYSTEM_CONFIG.ADMIN.NOT_YET_WORD),
      Verifier: finCols.Verifier ? row[finCols.Verifier - 1] : "",
      PayRef: finCols.PayRef ? row[finCols.PayRef - 1] : "",
      EmailSent: finCols.EmailSent ? row[finCols.EmailSent - 1] : "",
      SysPaidAt: finCols.SysPaidAt ? row[finCols.SysPaidAt - 1] : ""
    };
  }
  return metaCache;
}

function ensureFinanceRowCapacity_(finSheet, requiredTotalRows) {
  var current = finSheet.getMaxRows();
  if (current >= requiredTotalRows) return;
  finSheet.insertRowsAfter(current, requiredTotalRows - current);
}

function applyFinanceTemplateValidations_(finSheet) {
  var lastCol = finSheet.getLastColumn();
  if (finSheet.getMaxRows() < 2) finSheet.insertRowsAfter(1, 1);

  var template = finSheet.getRange(2, 1, 1, lastCol);
  var validations = template.getDataValidations();
  if (!validations || !validations.length) return;

  var targetRows = finSheet.getMaxRows() - 1;
  if (targetRows <= 1) return;

  var matrix = [];
  for (var r = 0; r < targetRows; r++) matrix.push(validations[0]);
  finSheet.getRange(2, 1, targetRows, lastCol).setDataValidations(matrix);
}

function clearFinanceDataRange_(finSheet, rowCount) {
  var lastCol = finSheet.getLastColumn();
  if (rowCount <= 0) return;
  finSheet.getRange(2, 1, rowCount, lastCol).clearContent();
}

function writeFinancePayloadsSequential_(finSheet, finCols, payloads) {
  var lastCol = finSheet.getLastColumn();
  if (!payloads || !payloads.length) return;

  var out = [];
  for (var i = 0; i < payloads.length; i++) {
    var p = payloads[i];
    var row = new Array(lastCol);
    for (var c = 0; c < lastCol; c++) row[c] = "";

    function set(col, val) { if (col) row[col - 1] = (val === undefined || val === null) ? "" : val; }

    set(finCols.Timestamp, p.Timestamp);
    set(finCols.Email, String(p.Email || "").trim());
    set(finCols.Name, p.Name);
    set(finCols.PaymentMode, p.PaymentMode);
    set(finCols.ProofLink, p.ProofLink);
    set(finCols.RefCode, p.RefCode);
    set(finCols.CouponCode, p.CouponCode);
    set(finCols.GenId, p.GenId);
    set(finCols.RefCount, p.RefCount);
    set(finCols.Cashback, p.Cashback);
    set(finCols.TotalAmount, p.TotalAmount);
    set(finCols.Status, Utils.normalizeStatusValue(p.Status));
    set(finCols.Verifier, p.Verifier);
    set(finCols.PayRef, p.PayRef);
    set(finCols.EmailSent, p.EmailSent);
    set(finCols.SysPaidAt, p.SysPaidAt);

    out.push(row);
  }

  finSheet.getRange(2, 1, out.length, lastCol).setValues(out);
}

