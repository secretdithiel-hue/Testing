          (p.mergeGroupId ? ('<span class="tag warn">MERGED: ' + esc(p.mergeGroupId) + '</span>') : '') +
        '</div>';

      var right=document.createElement('div');
      var btn=document.createElement('button');
      btn.className='btn small';
      btn.textContent='Load';
      btn.onclick=(function(email){ return function(){ loadRecord(email); }; })(p.email);
      right.appendChild(btn);

      div.appendChild(left);
      div.appendChild(right);
      root.appendChild(div);
    });
    setStatus('Found ' + list.length + ' result(s).');
  }

  function loadRecord(email){
    setStatus('Loading...');
    google.script.run.withSuccessHandler(function(rec){
      loaded = rec;
      if(!rec || !rec.ok){
        setStatus('Load failed: ' + (rec && rec.error ? rec.error : 'Unknown'));
        return;
      }
      var r=rec.record;
      document.getElementById('recordHint').innerHTML = 'Loaded: <b>' + esc(r.registration.name||'') + '</b> <span class="muted">&lt;' + esc(r.registration.email||'') + '&gt;</span>';
      document.getElementById('name').value = r.registration.name||'';
      document.getElementById('email').value = r.registration.email||'';
      
      // Update check boxes
      var cStr = r.registration.competitions || "";
      var cArr = cStr.split(",").map(function(s){ return s.trim().toLowerCase(); });
      var checks = document.querySelectorAll('input[name="compCheck"]');
      checks.forEach(function(ck){
         // Partial match or Exact? Exact usually. 
         // "Short Film Making" vs "Short Film Making (Group)".
         // Let's do exact match from value.
         ck.checked = cArr.indexOf(ck.value.toLowerCase().trim()) > -1;
      });

      document.getElementById('finalAmount').value = (r.registration.finalAmount||'');
      document.getElementById('finStatus').value = (r.finance.status||'');
      document.getElementById('finTotal').value = '';
      document.getElementById('payRef').value = (r.finance.payRef || r.registration.sysPayRef || '');
      document.getElementById('verifier').value = (r.finance.verifier || r.registration.sysVerifier || '');
      document.getElementById('paidAt').value = (r.finance.sysPaidAt || r.registration.sysPaidAt || '');
      document.getElementById('notes').value = '';

      // Merge info
      if(r.merge && r.merge.groupId){
        document.getElementById('mergeInfo').textContent = 'MERGE GROUP: ' + r.merge.groupId + ' | ROLE: ' + (r.merge.role||'') + ' | PRIMARY: ' + (r.merge.primaryEmail||'');
      } else {
        document.getElementById('mergeInfo').textContent = '';
      }
      setStatus('Ready.');
    }).withFailureHandler(function(err){
      setStatus('Error: ' + err);
    }).V22_editor_loadRecord(email);
  }

  function getUpdates(){
    // Gather checkboxes
    var checked = [];
    document.querySelectorAll('input[name="compCheck"]:checked').forEach(function(ck){
      checked.push(ck.value);
    });
    var compStr = checked.join(", ");

    return {
      name: (document.getElementById('name').value||'').trim(),
      email: (document.getElementById('email').value||'').trim(),
      competitions: compStr,
      finalAmount: document.getElementById('finalAmount').value,
      finStatus: (document.getElementById('finStatus').value||'').trim(),
      finTotal: document.getElementById('finTotal').value,
      payRef: (document.getElementById('payRef').value||'').trim(),
      verifier: (document.getElementById('verifier').value||'').trim(),
      paidAt: (document.getElementById('paidAt').value||'').trim(),
      notes: (document.getElementById('notes').value||'').trim()
    };
  }

  function previewDiff(){
    if(!loaded || !loaded.ok){ setStatus('Load a record first.'); return; }
    var u = getUpdates();
    setStatus('Building diff...');
    google.script.run.withSuccessHandler(function(res){
      openModal('Preview Changes', res && res.html ? res.html : '<div class="muted">No diff.</div>');
      setStatus('Diff ready.');
    }).withFailureHandler(function(err){
      setStatus('Error: ' + err);
    }).V22_editor_previewDiff({ originalEmail: loaded.record.registration.email, updates: u });
  }

  function save(resendType){
    if(!loaded || !loaded.ok){ setStatus('Load a record first.'); return; }
    setStatus('Saving...');
    google.script.run.withSuccessHandler(function(res){
      if(res && res.ok){
        setStatus('✅ Saved. ' + (res.message || ''));
        // refresh loaded record
        loadRecord((document.getElementById('email').value||loaded.record.registration.email).trim());
      } else {
        setStatus('❌ Save failed: ' + (res && res.error ? res.error : 'Unknown'));
      }
    }).withFailureHandler(function(err){
      setStatus('Error: ' + err);
    }).V22_editor_saveEdits({ originalEmail: loaded.record.registration.email, updates: getUpdates(), resend: resendType });
  }

  function previewEmail(kind){
    if(!loaded || !loaded.ok){ setStatus('Load a record first.'); return; }
    var email = loaded.record.registration.email;
    setStatus('Generating preview...');
    google.script.run.withSuccessHandler(function(res){
      openModal(kind==='AR'?'Receipt Preview':'Registration Email Preview', res && res.html ? '<div class="email-paper">' + res.html + '</div>' : '<div class="muted">No preview.</div>');
      setStatus('Preview ready.');
    }).withFailureHandler(function(err){
      setStatus('Error: ' + err);
    }).V22_editor_previewEmail({ email: email, kind: kind });
  }

  function openModal(title, html){
    document.getElementById('modalTitle').textContent = title || 'Preview';
    document.getElementById('modalBody').innerHTML = html || '';
    document.getElementById('overlay').style.display='flex';
  }
  function closeModal(){
    document.getElementById('overlay').style.display='none';
    document.getElementById('modalBody').innerHTML='';
  }

  function money(n){
    n = Number(n||0);
    try { return new Intl.NumberFormat('en-PH', {style:'currency', currency:'PHP'}).format(n); }
    catch(e){ return '₱' + n.toFixed(2); }
  }
  function esc(s){
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  // Auto-search on load
  setTimeout(searchNow, 300);
</script>
</body>
</html>
`;
}

