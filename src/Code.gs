function V22_editor_loadRecord(emailOrQuery) {
  var q = String(emailOrQuery || "").trim();
  if (!q) return { ok: false, error: "Empty query." };

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet) return { ok: false, error: "Registration sheet not found." };

  // Find reg row by email first, else by genId
  var rowIndex = repo.findRegistrationRowIndexByEmail(q);
  if (!rowIndex) {
    // search by gen id
    var lastRow = regSheet.getLastRow();
    if (lastRow >= 2) {
      var genCol = SYSTEM_CONFIG.COLS.REG.GEN_ID;
      var genVals = regSheet.getRange(2, genCol, lastRow - 1, 1).getValues();
      for (var i = 0; i < genVals.length; i++) {
        if (String(genVals[i][0] || "").trim() === q) {
          rowIndex = i + 2;
          break;
        }
      }
    }
  }
  if (!rowIndex) return { ok: false, error: "Record not found." };

  var row = repo.getRegistrationRow(rowIndex);
  var regEmail = Utils.normalizeEmail(row[SYSTEM_CONFIG.COLS.REG.EMAIL - 1]);
  var regName = String(row[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "").trim();
  var genId = String(row[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "").trim();
  var competitions = String(row[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1] || "").trim();
  var finalAmount = Number(row[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0);
  var paymentStatus = String(row[SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS - 1] || "").trim();

  // SYS cols
  var sysCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
  var sysPayRef = sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF] ? String(regSheet.getRange(rowIndex, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).getValue() || "").trim() : "";
  var sysVerifier = sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER] ? String(regSheet.getRange(rowIndex, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).getValue() || "").trim() : "";
  var sysPaidAt = sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT] ? String(regSheet.getRange(rowIndex, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue() || "").trim() : "";

  // Finance
  var finance = { rowIndex: null, email: regEmail, name: regName, status: "", totalAmount: "", verifier: "", payRef: "", emailSent: "", sysPaidAt: "" };
  if (finSheet) {
    var finCols = ColumnManager.getFinanceCols(finSheet);
    var finRow = repo.findFinanceRowIndexByEmail(regEmail, finCols);
    if (finRow) {
      finance.rowIndex = finRow;
      function getF(col) { return col ? finSheet.getRange(finRow, col).getValue() : ""; }
      finance = {
        rowIndex: finRow,
        email: regEmail,
        name: finCols.Name ? getF(finCols.Name) : regName,
        status: finCols.Status ? String(getF(finCols.Status) || "").trim() : "",
        totalAmount: finCols.TotalAmount ? getF(finCols.TotalAmount) : "",
        verifier: finCols.Verifier ? String(getF(finCols.Verifier) || "").trim() : "",
        payRef: finCols.PayRef ? String(getF(finCols.PayRef) || "").trim() : "",
        emailSent: finCols.EmailSent ? String(getF(finCols.EmailSent) || "").trim() : "",
        sysPaidAt: finCols.SysPaidAt ? String(getF(finCols.SysPaidAt) || "").trim() : ""
      };
    }
  }

  // Merge meta (if exists)
  var merge = MergeService.getMergeMetaForEmail_(regEmail, rowIndex, regSheet) || {};

  return {
    ok: true,
    record: {
      registration: {
        rowIndex: rowIndex,
        email: regEmail,
        name: regName,
        genId: genId,
        competitions: competitions,
        finalAmount: finalAmount,
        paymentStatus: paymentStatus,
        sysPayRef: sysPayRef,
        sysVerifier: sysVerifier,
        sysPaidAt: sysPaidAt
      },
      finance: finance,
      merge: merge
    }
  };
}

function V22_editor_previewDiff(payload) {
  payload = payload || {};
  var originalEmail = Utils.normalizeEmail(payload.originalEmail || "");
  var updates = payload.updates || {};

  var rec = V22_editor_loadRecord(originalEmail);
  if (!rec.ok) return { html: "<div class='muted'>Record not found.</div>" };

  var r = rec.record;
  var diffs = [];

  function addDiff(label, oldVal, newVal) {
    if (String(oldVal || "") === String(newVal || "")) return;
    diffs.push({ label: label, oldVal: oldVal, newVal: newVal });
  }

  addDiff("Name", r.registration.name, updates.name);
  addDiff("Email", r.registration.email, updates.email);
  addDiff("Competitions", r.registration.competitions, updates.competitions);
  addDiff("Registration Final Amount", r.registration.finalAmount, updates.finalAmount);
  addDiff("Finance Status", r.finance.status, updates.finStatus);
  if (updates.finTotal !== "" && updates.finTotal !== null && updates.finTotal !== undefined) {
    addDiff("Finance Total Amount", r.finance.totalAmount, updates.finTotal);
  }
  addDiff("Pay Ref", (r.finance.payRef || r.registration.sysPayRef), updates.payRef);
  addDiff("Verifier", (r.finance.verifier || r.registration.sysVerifier), updates.verifier);
  addDiff("SYS_PAID_AT", (r.finance.sysPaidAt || r.registration.sysPaidAt), updates.paidAt);

  if (!diffs.length) return { html: "<div class='muted'>No changes detected.</div>" };

  var html = diffs.map(function (d) {
    return '<div class="diffRow">' +
      '<div class="diffKey">' + Utils.escapeHtml(d.label) + '</div>' +
      '<div class="muted"><b>From:</b> ' + Utils.escapeHtml(String(d.oldVal)) + '</div>' +
      '<div class="muted"><b>To:</b> ' + Utils.escapeHtml(String(d.newVal)) + '</div>' +
    '</div>';
  }).join("");

  return { html: html };
}

function V22_editor_previewEmail(payload) {
  payload = payload || {};
  var email = Utils.normalizeEmail(payload.email || "");
  var kind = String(payload.kind || "AR").toUpperCase();

  var rec = V22_editor_loadRecord(email);
  if (!rec.ok) return { html: "<div class='muted'>Record not found.</div>" };

  // If merged member, show group receipt preview instead for AR
  if (kind === "AR" && rec.record.merge && rec.record.merge.groupId) {
    if (String(rec.record.merge.role || "").toUpperCase() === MergeService.ROLES.MEMBER) {
      // show group preview
      var groupObj = MergeService.getGroupFromRegistration_(rec.record.merge.groupId, new SheetRepository().getRegistrationSheet(), null);
      if (groupObj) {
        var meta = (function () {
          return { payRef: rec.record.finance.payRef || rec.record.registration.sysPayRef || "", verifier: rec.record.finance.verifier || rec.record.registration.sysVerifier || "", paidAt: rec.record.finance.sysPaidAt || rec.record.registration.sysPaidAt || new Date() };
        })();
        var thisPart = null;
      for (var fi = 0; fi < groupObj.participants.length; fi++) {
        if (groupObj.participants[fi].email && normalizeEmail_(groupObj.participants[fi].email) === normalizeEmail_(email)) { thisPart = groupObj.participants[fi]; break; }
      }
      if (!thisPart) thisPart = groupObj.participants[0];
      return { html: MergeService.buildGroupReceiptHtml_(groupObj, thisPart, meta) };
      }
    }
  }

  // Build single receipt or registration email using existing builders
  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var regData = repo.getRegistrationByEmail(email);
  if (!regData) return { html: "<div class='muted'>Registration data missing.</div>" };

  if (kind === "RR") {
    var pricing = PricingEngine.calculate("", regData.competitions);
    var normalizedCompetitions = pricing.normalizedCompetitions || regData.competitions;

    // Coupon discount
    var couponValue = 0;
    try {
      var cs = new CouponService(repo.getCouponSheet(), { lazyLoad: true });
      couponValue = cs.getValueOnly(regData.couponCode || "");
    } catch (e) {}

    // Referral discount
    var sysCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regRow = repo.findRegistrationRowIndexByEmail(email);
    var refDisc = 0;
    if (regRow && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
      refDisc = Number(regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).getValue() || 0);
    }

    var html = EmailBuilder.buildRegistrationConfirmedHtml(regData, pricing, couponValue, refDisc, { preview: true });
    return { html: html };
  }

  // AR preview
  var paidData = {
    name: regData.name,
    school: regData.school,
    payMode: regData.payMode,
    competitions: regData.competitions,
    genId: regData.genId,
    finalAmount: regData.finalAmount,
    couponCode: regData.couponCode,
    couponDiscount: 0,
    referralDiscount: 0,
    cashback: regData.cashback,
    paidAt: new Date()
  };

  // coupon discount
  try {
    var cs2 = new CouponService(repo.getCouponSheet(), { lazyLoad: true });
    paidData.couponDiscount = cs2.getValueOnly(regData.couponCode || "");
  } catch (e2) {}

  // referral discount
  try {
    var sysCols2 = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regRow2 = repo.findRegistrationRowIndexByEmail(email);
    if (regRow2 && sysCols2[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
      paidData.referralDiscount = Number(regSheet.getRange(regRow2, sysCols2[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).getValue() || 0);
    }
  } catch (e3) {}

  var html2 = EmailBuilder.buildReceiptHtml(paidData, true, { preview: true });
  return { html: html2 };
}

function V22_editor_saveEdits(payload) {
  payload = payload || {};
  var originalEmail = Utils.normalizeEmail(payload.originalEmail || "");
  var updates = payload.updates || {};
  var resend = String(payload.resend || "NONE").toUpperCase();

  var repo = new SheetRepository();
  var regSheet = repo.getRegistrationSheet();
  var finSheet = repo.getFinanceSheet();
  if (!regSheet) return { ok: false, error: "Registration sheet not found." };

  var regRow = repo.findRegistrationRowIndexByEmail(originalEmail);
  if (!regRow) return { ok: false, error: "Record not found: " + originalEmail };

  var sysCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
  var finCols = finSheet ? ColumnManager.getFinanceCols(finSheet) : null;

  // Current snapshot for diff + audit
  var before = V22_editor_loadRecord(originalEmail);
  if (!before.ok) return { ok: false, error: before.error };

  var mergeMeta = before.record.merge || {};
  var groupId = mergeMeta.groupId || "";
  var isMergedMember = groupId && String(mergeMeta.role || "").toUpperCase() === MergeService.ROLES.MEMBER;

  // Apply updates (Registration)
  var newName = String(updates.name || "").trim();
  var newEmail = Utils.normalizeEmail(updates.email || "");
  var newCompetitions = (updates.competitions !== undefined) ? String(updates.competitions || "").trim() : null;
  var newFinalAmount = (updates.finalAmount !== "" && updates.finalAmount !== null && updates.finalAmount !== undefined) ? Number(updates.finalAmount) : null;
  var newFinStatus = String(updates.finStatus || "").trim();
  var newFinTotal = (updates.finTotal !== "" && updates.finTotal !== null && updates.finTotal !== undefined) ? Number(updates.finTotal) : null;
  var newPayRef = String(updates.payRef || "").trim();
  var newVerifier = String(updates.verifier || "").trim();
  var newPaidAt = String(updates.paidAt || "").trim();

  // Validate email change conflicts
  if (newEmail && newEmail !== originalEmail) {
    var conflict = repo.findRegistrationRowIndexByEmail(newEmail);
    if (conflict) return { ok: false, error: "Cannot change email. Target email already exists: " + newEmail };
  }

  TriggerGuard.mute(function () {
    if (newName) regSheet.getRange(regRow, SYSTEM_CONFIG.COLS.REG.NAME).setValue(newName);
    if (newEmail && newEmail !== originalEmail) regSheet.getRange(regRow, SYSTEM_CONFIG.COLS.REG.EMAIL).setValue(newEmail);
    if (newCompetitions !== null) regSheet.getRange(regRow, SYSTEM_CONFIG.COLS.REG.COMPETITION).setValue(newCompetitions);
    if (newFinalAmount !== null && !isNaN(newFinalAmount)) regSheet.getRange(regRow, SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT).setValue(newFinalAmount);

    // SYS meta
    if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF] && newPayRef) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).setValue(newPayRef);
    if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER] && newVerifier) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).setValue(newVerifier);
    if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT] && newPaidAt) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).setValue(newPaidAt);
  });

  // Apply updates (Finance)
  if (finSheet && finCols && finCols.Email) {
    var finRow = repo.findFinanceRowIndexByEmail(originalEmail, finCols);
    if (!finRow && newEmail) finRow = repo.findFinanceRowIndexByEmail(newEmail, finCols);

    if (finRow) {
      TriggerGuard.mute(function () {
        if (finCols.Name && newName) finSheet.getRange(finRow, finCols.Name).setValue(newName);
        if (finCols.Email && newEmail && newEmail !== originalEmail) finSheet.getRange(finRow, finCols.Email).setValue(newEmail);

        if (finCols.TotalAmount) {
          if (newFinTotal !== null && !isNaN(newFinTotal)) {
            finSheet.getRange(finRow, finCols.TotalAmount).setValue(newFinTotal);
          } else if (newFinalAmount !== null && !isNaN(newFinalAmount)) {
            // keep finance aligned with reg if override not provided
            finSheet.getRange(finRow, finCols.TotalAmount).setValue(newFinalAmount);
          }
        }

        if (finCols.Status && newFinStatus) finSheet.getRange(finRow, finCols.Status).setValue(newFinStatus);
        if (finCols.PayRef && newPayRef) finSheet.getRange(finRow, finCols.PayRef).setValue(newPayRef);
        if (finCols.Verifier && newVerifier) finSheet.getRange(finRow, finCols.Verifier).setValue(newVerifier);
        if (finCols.SysPaidAt && newPaidAt) finSheet.getRange(finRow, finCols.SysPaidAt).setValue(newPaidAt);
      });
    }
  }

  // If this record is in a merge group, keep group accounting consistent
  try {
    if (groupId) {
      MergeService.reapplyAllMerges({ silent: true });
      if (newPayRef || newVerifier || newPaidAt) {
        MergeService.propagateFinanceMetaToGroup_(groupId, { payRef: newPayRef || undefined, verifier: newVerifier || undefined, paidAt: newPaidAt || undefined });
      }
    }
  } catch (e) {
    AuditLogService.warn("MERGE_REAPPLY_AFTER_EDIT_FAIL", String(e));
  }

  // Build diff for audit
  var afterEmail = newEmail || originalEmail;
  var after = V22_editor_loadRecord(afterEmail);
  var diff = { before: before.record, after: after.ok ? after.record : null };

  AdminAuditService.log("MANUAL_EDIT_SAVE", afterEmail, before.record.registration.genId || "", groupId, diff, updates.notes || "");

  // Optional resend
  var resendResult = null;
  if (resend === "AR") {
    if (isMergedMember) {
      resendResult = { ok: false, error: "This record is a MERGED MEMBER. Send the GROUP receipt instead." };
    } else if (groupId) {
      resendResult = MergeService.sendGroupPaidReceipt_(groupId, true, false);
    } else {
      // Send individual receipt (force)
      try {
        var regData = repo.getRegistrationByEmail(afterEmail);
        if (regData) {
          var pricing = PricingEngine.calculate("", regData.competitions);
          var normalizedCompetitions = pricing.normalizedCompetitions || regData.competitions;

          // referral discount
          var refDisc = 0;
          var rRow = repo.findRegistrationRowIndexByEmail(afterEmail);
          if (rRow && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
            refDisc = Number(regSheet.getRange(rRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).getValue() || 0);
          }

          // coupon discount
          var couponVal = 0;
          try {
            var cs = new CouponService(repo.getCouponSheet(), { lazyLoad: true });
            couponVal = cs.getValueOnly(regData.couponCode || "");
          } catch (e2) {}

          var paidAtDate = new Date();
          if (newPaidAt) paidAtDate = Utils.parseMaybeDate(newPaidAt) || new Date();

          var paidData = {
            name: regData.name,
            school: regData.school,
            payMode: regData.payMode,
            competitions: normalizedCompetitions,
            genId: regData.genId,
            finalAmount: regData.finalAmount,
            couponCode: regData.couponCode,
            couponDiscount: couponVal,
            referralDiscount: refDisc,
            cashback: regData.cashback,
            paidAt: paidAtDate
          };

          resendResult = EmailService.sendPaidReceipt(afterEmail, regData.masterSubject, paidData, true, true);
        } else {
          resendResult = { ok: false, error: "Registration data missing for resend." };
        }
      } catch (e3) {
        resendResult = { ok: false, error: String(e3) };
      }
    }
  } else if (resend === "RR") {
    if (isMergedMember) {
      resendResult = { ok: false, error: "This record is a MERGED MEMBER. Resend should be handled by the PRIMARY contact." };
    } else if (groupId) {
      // For now, use individual resend to primary contact (you can customize to group email)
      resendResult = { ok: false, error: "Group Registration Confirmation resend not implemented. Use PRIMARY contact RR if needed." };
    } else {
      try {
        var regData2 = repo.getRegistrationByEmail(afterEmail);
        if (regData2) {
          var pricing2 = PricingEngine.calculate("", regData2.competitions);

          // coupon discount
          var couponVal2 = 0;
          try {
            var cs2 = new CouponService(repo.getCouponSheet(), { lazyLoad: true });
            couponVal2 = cs2.getValueOnly(regData2.couponCode || "");
          } catch (e4) {}

          // referral discount
          var refDisc2 = 0;
          var rRow2 = repo.findRegistrationRowIndexByEmail(afterEmail);
          if (rRow2 && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]) {
            refDisc2 = Number(regSheet.getRange(rRow2, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED]).getValue() || 0);
          }

          resendResult = EmailService.sendRegistrationConfirmed(afterEmail, regData2.masterSubject, regData2, pricing2, couponVal2, refDisc2);
        } else {
          resendResult = { ok: false, error: "Registration data missing for resend." };
        }
      } catch (e5) {
        resendResult = { ok: false, error: String(e5) };
      }
    }
  }

  var msg = "Saved.";
  if (resendResult && resendResult.sent) msg += " Email sent.";
  if (resendResult && resendResult.skipped) msg += " Email skipped.";
  if (resendResult && resendResult.error) msg += " Resend error: " + resendResult.error;

  return { ok: true, message: msg, resend: resendResult };
}

