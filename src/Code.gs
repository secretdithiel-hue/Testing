  // UPGRADED: Include referral discount in receipt itemization (V20 - red strikethrough for discounts)
  // V20.0 FIX: Now accepts actual couponDiscount value instead of reverse-calculating
  function buildItemRows_(competitions, finalAmount, couponCode, referralDiscount, couponDiscountValue) {
    var pricing = PricingEngine.calculate("", competitions);
    var normalized = pricing.normalizedCompetitions || "";
    var picks = normalized ? normalized.split(",") : [];
    var rows = "";

    // Competition items
    for (var i = 0; i < picks.length; i++) {
      var canon = String(picks[i] || "").trim();
      if (!canon) continue;
      var price = Number(SYSTEM_CONFIG.PRICING.SINGLE[canon] || 0);
      if (!price) continue;
      rows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + escapeHtml_(canonicalToDisplayLabel_(canon)) + '</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + fmtMoney2_(price) + '</td>' +
        '</tr>';
    }

    // Bundle discount (red with strikethrough)
    if (pricing.bundleDiscount > 0) {
      rows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">Less: Bundle Discount</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;color:#dc2626;text-decoration:line-through;">' + fmtMoney2_(-pricing.bundleDiscount) + '</td>' +
        '</tr>';
    }

    // Referral discount (red with strikethrough)
    var refDisc = Number(referralDiscount || 0);
    if (refDisc > 0) {
      rows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">Less: Referral Discount</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;color:#dc2626;text-decoration:line-through;">' + fmtMoney2_(-refDisc) + '</td>' +
        '</tr>';
    }

    // Coupon discount (red with strikethrough)
    // V20.0 FIX: Use the passed couponDiscountValue if available, otherwise calculate from finalAmount
    // V20.1 FIX: Cap coupon discount to prevent showing more than actual remaining amount
    var couponDiscount = 0;
    var remainingAfterBundle = Math.max(0, Number(pricing.finalPrice || 0) - Number(refDisc || 0));
    
    if (typeof couponDiscountValue === 'number' && couponDiscountValue > 0) {
      // Use the explicit coupon discount value, but cap it at remaining amount
      couponDiscount = Math.min(couponDiscountValue, remainingAfterBundle);
    } else if (couponCode) {
      // Fallback: Calculate from the difference (for backwards compatibility)
      // This assumes: finalAmount = pricing.finalPrice - bundleDiscount - refDiscount - couponDiscount
      // So: couponDiscount = pricing.finalPrice - refDiscount - finalAmount
      var calculatedCoupon = Math.max(0, Number(pricing.finalPrice || 0) - Number(refDisc || 0) - Number(finalAmount || 0));
      // V20.1 FIX: If calculated coupon seems unreasonably high (more than 50% of bundle price), 
      // it's probably a calculation error - cap it
      if (calculatedCoupon > remainingAfterBundle * 0.5 && calculatedCoupon > 200) {
        // Something is wrong - the coupon discount shouldn't be more than half the bundle price
        // Try to look up the actual coupon value
        try {
          var ss = SpreadsheetApp.getActiveSpreadsheet();
          var couponSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.COUPONS);
          if (couponSheet && couponCode) {
            var couponData = couponSheet.getDataRange().getValues();
            for (var ci = 1; ci < couponData.length; ci++) {
              if (String(couponData[ci][0] || "").toUpperCase().trim() === String(couponCode).toUpperCase().trim()) {
                calculatedCoupon = Number(couponData[ci][1] || 0);
                break;
              }
            }
          }
        } catch (e) {
          Logger.log("Coupon lookup error: " + e);
        }
      }
      couponDiscount = Math.min(calculatedCoupon, remainingAfterBundle);
    }
    
    if (couponDiscount > 0) {
      // Validate coupon code - should not be a date/timestamp
      var codeShown = couponCode || "";
      // If it looks like a date (contains "GMT" or "Jan/Feb/etc" or is a Date object string), don't show it
      if (codeShown && (
          String(codeShown).indexOf("GMT") >= 0 || 
          String(codeShown).indexOf("Standard Time") >= 0 ||
          String(codeShown).match(/^\w{3}\s+\w{3}\s+\d/) ||
          String(codeShown).length > 30
      )) {
        codeShown = "APPLIED";
      }
      if (!codeShown) codeShown = "APPLIED";
      rows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">Less: Coupon Discount (' + escapeHtml_(codeShown) + ')</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;color:#dc2626;text-decoration:line-through;">' + fmtMoney2_(-couponDiscount) + '</td>' +
        '</tr>';
    }

    if (!rows) {
      rows =
        '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">Registration Fee</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + fmtMoney2_(Number(finalAmount || 0)) + '</td>' +
        '</tr>';
    }

    return rows;
  }

  function buildReceiptHtml(data, isUpdate, options) {
    options = options || {};
    var headerTitle = "ACKNOWLEDGEMENT RECEIPT";
    var verifiedDate = data.paidAt ? Utils.formatDate(data.paidAt) : Utils.formatDate(new Date());

    var pricing = PricingEngine.calculate("", data.competitions);
    var normalizedCompetitions = pricing.normalizedCompetitions || data.competitions || "";
    
    // V20.0 FIX: Pass actual coupon discount value to buildItemRows_
    var couponDiscountValue = Number(data.couponDiscount || 0);
    var itemRows = buildItemRows_(normalizedCompetitions, data.finalAmount, data.couponCode, data.referralDiscount || 0, couponDiscountValue);

    // Validate cashback - must be a reasonable number (not garbage data from wrong column)
    var cashbackVal = Number(data.cashback || 0);
    var cashbackNote = '';
    if (cashbackVal > 0 && cashbackVal < 100000) {
      // Valid cashback amount (less than ₱100,000 as sanity check)
      cashbackNote = '<p style="text-align:center;font-size:11px;color:#888;margin-top:15px;font-style:italic;">*Referral cashback: ' + Utils.formatCurrency(cashbackVal) + ' (processed separately after the registration period).</p>';
    } else {
      // No cashback or invalid value
      cashbackNote = '<p style="text-align:center;font-size:11px;color:#888;margin-top:15px;font-style:italic;">*Referral cashback rewards are processed separately after the registration period.</p>';
    }

    var uplbSrc = "cid:uplb_logo";
    var husaySrc = "cid:husay_logo";
    if (options.preview) {
      var urls = LogoService.getPreviewDataUrls();
      uplbSrc = urls.uplb || "";
      husaySrc = urls.husay || "";
    }

    var html = receiptTemplateHtml_();
    
    // Validate genId - should not be a date/timestamp
    var displayGenId = data.genId || "—";
    if (String(displayGenId).indexOf("GMT") >= 0 || 
        String(displayGenId).indexOf("Standard Time") >= 0 ||
        String(displayGenId).match(/^\w{3}\s+\w{3}\s+\d/)) {
      displayGenId = "—";
    }
    
    html = html.split("__GEN_ID__").join(escapeHtml_(displayGenId));
    html = html.split("__DATE_VERIFIED__").join(escapeHtml_(verifiedDate));
    html = html.split("__HEADER_TITLE__").join(escapeHtml_(headerTitle));
    html = html.split("__NAME__").join(escapeHtml_(data.name || ""));
    html = html.split("__SCHOOL__").join(escapeHtml_(data.school || ""));
    html = html.split("__PAYMODE__").join(escapeHtml_(data.payMode || ""));
    html = html.split("__ITEM_ROWS__").join(itemRows);
    html = html.split("__TOTAL_PAID__").join(escapeHtml_(Utils.formatCurrency(data.finalAmount)));
    html = html.split("__GROUP_ID_ROW__").join("");
    html = html.split("__GROUP_BREAKDOWN__").join(cashbackNote);
    
    // Build email spiel section (NEW FORMAT - appears BEFORE receipt)
    var emailSpiel = "";
    if (SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL && SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.ENABLED) {
      var spielConfig = SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL;
      var spielTitle = spielConfig.TITLE || "IMPORTANT PARTICIPANT INFORMATION";
      var spielContent = spielConfig.CONTENT || [];
      
      // Section Title
      emailSpiel = '<h3 style="font-size:14px;font-weight:bold;margin:20px 0 10px 0;">' + spielTitle + '</h3>';
      
      // Dear [Name] greeting
      emailSpiel += '<p style="font-size:14px;margin:15px 0;">Dear <b>' + escapeHtml_(data.name || "") + '</b>,</p>';
      
      // Payment confirmation with competitions list
      emailSpiel += '<p style="font-size:14px;margin:15px 0;">We have successfully confirmed your payment of <b>' + Utils.formatCurrency(data.finalAmount) + '</b> and we are pleased to inform your official registration in the following competition/s:</p>';
      
      // Competitions list
      var compList = normalizedCompetitions ? normalizedCompetitions.split(",") : [];
      if (compList.length > 0) {
        emailSpiel += '<ul style="margin:10px 0 10px 20px;padding:0;">';
        for (var c = 0; c < compList.length; c++) {
          var compName = String(compList[c] || "").trim();
          if (compName) {
            emailSpiel += '<li style="margin:5px 0;">' + escapeHtml_(canonicalToDisplayLabel_(compName)) + '</li>';
          }
        }
        emailSpiel += '</ul>';
      }
      
      // Referral code section
      emailSpiel += '<p style="font-size:13px;color:#555;margin:15px 0;">Under this message, you will also be provided by a unique referral code, which your friends or colleagues can use upon their registration to avail our discounted offers.</p>';
      emailSpiel += '<h4 style="font-size:14px;font-weight:bold;margin:20px 0 10px 0;">REFERRAL CODE</h4>';
      emailSpiel += '<div style="background:#f3f4f6;border:1px dashed #cbd5e1;padding:12px;border-radius:10px;font-family:monospace;font-size:14px;word-break:break-word;">' + escapeHtml_(displayGenId) + '</div>';
      
      // Horizontal divider
      emailSpiel += '<div style="height:1px;background:#e6e8ec;margin:15px 0;"></div>';
      
      // Main content paragraphs
      for (var i = 0; i < spielContent.length; i++) {
        var line = spielContent[i];
        if (line === "") {
          emailSpiel += '<br>';
        } else {
          emailSpiel += '<p style="font-size:14px;margin:8px 0;line-height:1.5;">' + line + '</p>';
        }
      }
      
      // Confidentiality callout
      if (spielConfig.CONFIDENTIALITY_NOTE) {
        emailSpiel += '<div style="background:#fff7ed;border:1px solid #fed7aa;padding:12px;border-radius:10px;font-size:13px;margin:15px 0;">' +
          '<b>Confidentiality reminder:</b> ' + spielConfig.CONFIDENTIALITY_NOTE + '</div>';
