function reapplyAllMergeGroups() {
  var ui = SpreadsheetApp.getUi();
  try {
    var res = MergeService.reapplyAllMerges({ silent: true });
    ui.alert("✅ " + (res && res.message ? res.message : "Reapplied merges."));
  } catch (e) {
    ui.alert("❌ Reapply failed: " + e);
  }
}

function promptUnmergeGroup() {
  var ui = SpreadsheetApp.getUi();
  var resp = ui.prompt("🔓 Unmerge Group", "Enter the Merge Group ID (e.g., MTX-20260202-101500-000123):", ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;
  var gid = String(resp.getResponseText() || "").trim();
  if (!gid) return ui.alert("No group id provided.");

  var modeChoice = ui.alert("Unmerge Mode", "YES = Restore Snapshot (recommended)\nNO = Recompute from Registration", ui.ButtonSet.YES_NO_CANCEL);
  if (modeChoice === ui.Button.CANCEL) return;
  var mode = (modeChoice === ui.Button.YES) ? "RESTORE_SNAPSHOT" : "RECOMPUTE_FROM_REG";

  var res = MergeService.unmergeGroup(gid, mode);
  if (res.ok) {
    ui.alert("✅ Unmerged group " + gid + "\nRestored rows: " + (res.restored || 0) + "\nMode: " + res.mode);
  } else {
    ui.alert("❌ Unmerge failed:\n" + (res.error || "Unknown error"));
  }
}

// ----------------------------------------------------------------------------
// V22: Patch missing EmailService.sendThreadedEmail (used by Payment Verification Center)
// ----------------------------------------------------------------------------
if (typeof EmailService !== "undefined" && !EmailService.sendThreadedEmail) {
  EmailService.sendThreadedEmail = function (options, threadInfoOrNull) {
    options = options || {};
    var to = options.to || options.recipient || "";
    var subject = options.subject || "";
    var htmlBody = options.htmlBody || "";
    var inlineImages = options.inlineImages || null;
    var senderName = options.name || SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME;

    var threadInfo = null;
    if (threadInfoOrNull) {
      try {
        threadInfo = (typeof threadInfoOrNull === "string") ? JSON.parse(threadInfoOrNull) : threadInfoOrNull;
      } catch (e) {
        threadInfo = null;
      }
    }

    try {
      if (threadInfo && threadInfo.threadId && threadInfo.messageId) {
        return EmailThreadService.sendReplyEmail(to, subject, htmlBody, inlineImages, threadInfo.threadId, threadInfo.messageId, senderName);
      }
      // First email
      return EmailThreadService.sendFirstEmail(to, subject, htmlBody, inlineImages);
    } catch (e2) {
      // fallback
      try {
        var opts = { htmlBody: htmlBody, name: senderName };
        if (inlineImages && Object.keys(inlineImages).length) opts.inlineImages = inlineImages;
        GmailApp.sendEmail(to, subject, "", opts);
        return { success: true, method: "gmailapp_fallback" };
      } catch (e3) {
        return { success: false, error: String(e3) };
      }
    }
  };
}

