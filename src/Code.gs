      '<table style="width:100%;border-collapse:collapse;margin-bottom:10px;font-size:14px;">' +
      '<tr><td style="padding:8px 0;text-align:left;">Bundle Fee</td><td style="padding:8px 0;text-align:right;font-weight:bold;">' + bundleFee + '</td></tr>' +
      '<tr><td style="padding:8px 0;text-align:left;">Referral Discount</td><td style="padding:8px 0;text-align:right;font-weight:bold;color:#28a745;">' + referralDiscountStr + '</td></tr>' +
      '<tr><td style="padding:8px 0;text-align:left;">Coupon Discount</td><td style="padding:8px 0;text-align:right;font-weight:bold;color:#28a745;">' + couponDisc + '</td></tr>' +
      '<tr style="font-size:16px;font-weight:bold;"><td style="border-top:1px solid #dddddd;padding-top:15px;">TOTAL DUE</td><td style="border-top:1px solid #dddddd;padding-top:15px;text-align:right;color:' + HEADER_BLUE + ';">' + totalDue + '</td></tr>' +
      '</table>' +
      refLine +
      couponLine +
      '<div class="referral-box" style="border:2px dashed #007bff;background-color:#e9f5ff;padding:15px;text-align:center;border-radius:5px;">' +
      '<div style="font-size:13px;color:#007bff;margin-bottom:5px;font-weight:bold;">Your Referral Code (Share to earn cashback!)</div>' +
      '<div class="referral-code" style="font-size:22px;font-weight:bold;color:#333333;letter-spacing:1px;">' + genId + '</div>' +
      '</div>' +
      gpbHtml +
      '<div style="background:#e9f5ff;border:1px solid #1E4FB8;padding:15px;border-radius:5px;text-align:center;margin-top:20px;">' +
      '<div style="font-size:13px;color:#1E4FB8;font-weight:bold;">Please settle your payment soon.</div>' +
      '<div style="font-size:12px;color:#666;margin-top:5px;">You will receive an Acknowledgement Receipt once confirmed.</div>' +
      '</div>' +
      '</div></div></body></html>'
    );
  }

  function getGroupMetaForEmailing_(groupObj) {
    var regSheet = regSheet_();
    if (!regSheet) return { payRef: "", verifier: "", paidAt: "" };
    var sysCols = getSysCols_(regSheet);
    var primaryRow = repo_().findRegistrationRowIndexByEmail(groupObj.primaryEmail);
    var payRef = "", verifier = "", paidAt = "";
    if (primaryRow) {
      try {
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]) payRef = String(regSheet.getRange(primaryRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).getValue() || "").trim();
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]) verifier = String(regSheet.getRange(primaryRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).getValue() || "").trim();
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) paidAt = regSheet.getRange(primaryRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue() || "";
      } catch (e) {}
    }
    return { payRef: payRef, verifier: verifier, paidAt: paidAt };
  }

  // ---- Merge execution ----
  function mergeParticipants(emails, primaryEmail, options) {
    options = options || {};
    var regSheet = regSheet_();
    var finSheet = finSheet_();
    if (!regSheet || !finSheet) return { ok: false, error: "Missing Registration/Finance sheet." };

    // Normalize and unique emails
    var uniq = {};
    (emails || []).forEach(function (e) {
      var n = normalizeEmail_(e);
      if (n) uniq[n] = true;
    });
    var list = Object.keys(uniq);
    if (list.length < 2) return { ok: false, error: "Select at least 2 participants to merge." };

    var primary = normalizeEmail_(primaryEmail || list[0]);
    if (!uniq[primary]) primary = list[0];

    var mergeCols = ensureMergeCols_(regSheet);
    var sysCols = getSysCols_(regSheet);
    var finCols = ColumnManager.getFinanceCols(finSheet);

    // Dynamically find the Payment Status column by header name (case-insensitive)
    var regHeaderMap = ColumnManager.headerMap(regSheet);
    var payStatusCol = 0;
    var headerKeys = Object.keys(regHeaderMap);
    for (var hi = 0; hi < headerKeys.length; hi++) {
      var hLower = headerKeys[hi].toLowerCase();
      if (hLower.indexOf("payment") >= 0 && hLower.indexOf("status") >= 0) {
        payStatusCol = regHeaderMap[headerKeys[hi]];
        break;
      }
    }

    // Determine groupId/receiptId
    var groupId = options.groupId ? String(options.groupId).trim() : newGroupId_();
    var receiptId = options.receiptId ? String(options.receiptId).trim() : groupId;

    // Snapshot for rollback
    var snapshot = { groupId: groupId, createdAt: now_(), participants: [] };

    // Gather participant data + compute total
    var total = 0;
    var participantRows = [];
    for (var i = 0; i < list.length; i++) {
      var email = list[i];
      var regRow = repo_().findRegistrationRowIndexByEmail(email);
      if (!regRow) return { ok: false, error: "Registration row not found for: " + email };

      var rowVals = repo_().getRegistrationRow(regRow);
      var p = {
        email: email,
        regRow: regRow,
        name: String(rowVals[(regHeaderMap["Full Name"] || regHeaderMap["Name"] || SYSTEM_CONFIG.COLS.REG.NAME) - 1] || "").trim(),
        genId: String(rowVals[(regHeaderMap["Gen. ID"] || regHeaderMap["Gen ID"] || SYSTEM_CONFIG.COLS.REG.GEN_ID) - 1] || "").trim(),
        competitions: String(rowVals[(regHeaderMap["Which Competitions"] || regHeaderMap["Competition"] || SYSTEM_CONFIG.COLS.REG.COMPETITION) - 1] || "").trim(),
        finalAmount: Number(rowVals[(regHeaderMap["Total Fee"] || regHeaderMap["Final Amount"] || SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT) - 1] || 0)
      };
      total += Number(p.finalAmount || 0);
      participantRows.push(p);

      // Finance snapshot
      var finRow = repo_().findFinanceRowIndexByEmail(email, finCols);
      var finSnap = {};
      if (finRow) {
        function getF(col) { return col ? finSheet.getRange(finRow, col).getValue() : ""; }
        finSnap = {
          rowIndex: finRow,
          TotalAmount: finCols.TotalAmount ? getF(finCols.TotalAmount) : "",
          Status: finCols.Status ? getF(finCols.Status) : "",
          Verifier: finCols.Verifier ? getF(finCols.Verifier) : "",
          PayRef: finCols.PayRef ? getF(finCols.PayRef) : "",
          EmailSent: finCols.EmailSent ? getF(finCols.EmailSent) : "",
          SysPaidAt: finCols.SysPaidAt ? getF(finCols.SysPaidAt) : ""
        };
      }

      // Reg snapshot (merge cols + sys meta + payment status)
      var regSnap = {
        merge: {
          groupId: mergeCols[HEADERS.GROUP_ID] ? regSheet.getRange(regRow, mergeCols[HEADERS.GROUP_ID]).getValue() : "",
          role: mergeCols[HEADERS.ROLE] ? regSheet.getRange(regRow, mergeCols[HEADERS.ROLE]).getValue() : "",
          primaryEmail: mergeCols[HEADERS.PRIMARY_EMAIL] ? regSheet.getRange(regRow, mergeCols[HEADERS.PRIMARY_EMAIL]).getValue() : "",
          receiptId: mergeCols[HEADERS.RECEIPT_ID] ? regSheet.getRange(regRow, mergeCols[HEADERS.RECEIPT_ID]).getValue() : "",
          updatedAt: mergeCols[HEADERS.UPDATED_AT] ? regSheet.getRange(regRow, mergeCols[HEADERS.UPDATED_AT]).getValue() : ""
        },
        sys: {
          payRef: sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF] ? regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).getValue() : "",
          verifier: sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER] ? regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).getValue() : "",
          paidAt: sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT] ? regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue() : ""
        },
        paymentStatus: payStatusCol ? String(rowVals[payStatusCol - 1] || "").trim() : ""
      };

      snapshot.participants.push({ email: email, regRow: regRow, finRow: finRow || null, fin: finSnap, reg: regSnap });
    }

    // Override total if manual provided
    var hasManualTotal = false;
    if (options.manualTotal !== undefined && options.manualTotal !== null && options.manualTotal !== "") {
      var manual = Number(options.manualTotal);
      if (!isNaN(manual)) {
        total = manual;
        hasManualTotal = true;
        AuditLogService.info("MERGE_MANUAL_TOTAL", "Overriding group total to " + total + " for groupId=" + groupId);
      }
    }

    // Determine unified payRef/verifier/paidAt
    var unifiedPayRef = String(options.payRef || "").trim();
    var unifiedVerifier = String(options.verifier || "").trim();
    var unifiedPaidAt = options.paidAt || "";

    if (!unifiedPayRef) {
      // Try primary finance payref, then reg sys payref
      var pFinRow = repo_().findFinanceRowIndexByEmail(primary, finCols);
      if (pFinRow && finCols.PayRef) unifiedPayRef = String(finSheet.getRange(pFinRow, finCols.PayRef).getValue() || "").trim();
      if (!unifiedPayRef) {
        var pRegRow = repo_().findRegistrationRowIndexByEmail(primary);
        if (pRegRow && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]) {
          unifiedPayRef = String(regSheet.getRange(pRegRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).getValue() || "").trim();
        }
      }
    }

    if (!unifiedVerifier) {
      var pRegRow2 = repo_().findRegistrationRowIndexByEmail(primary);
      if (pRegRow2 && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]) {
        unifiedVerifier = String(regSheet.getRange(pRegRow2, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).getValue() || "").trim();
      }
    }

    if (!unifiedPaidAt) {
      var pRegRow3 = repo_().findRegistrationRowIndexByEmail(primary);
      if (pRegRow3 && sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) {
        unifiedPaidAt = regSheet.getRange(pRegRow3, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).getValue() || "";
      }
    }

    // Apply merge metadata on Registration + unify SYS meta
    TriggerGuard.mute(function () {
      for (var j = 0; j < participantRows.length; j++) {
        var p = participantRows[j];
        var isPrimary = (p.email === primary);

        if (mergeCols[HEADERS.GROUP_ID]) regSheet.getRange(p.regRow, mergeCols[HEADERS.GROUP_ID]).setValue(groupId);
        
        // Feature 4: Role Handling
        var roleVal = isPrimary ? ROLES.PRIMARY : ROLES.MEMBER;
        if (isPrimary && options.primaryRole && options.primaryRole !== "STUDENT") {
          roleVal += " (" + options.primaryRole + ")";
        }
        if (mergeCols[HEADERS.ROLE]) regSheet.getRange(p.regRow, mergeCols[HEADERS.ROLE]).setValue(roleVal);

        if (mergeCols[HEADERS.PRIMARY_EMAIL]) regSheet.getRange(p.regRow, mergeCols[HEADERS.PRIMARY_EMAIL]).setValue(primary);
        if (mergeCols[HEADERS.RECEIPT_ID]) regSheet.getRange(p.regRow, mergeCols[HEADERS.RECEIPT_ID]).setValue(receiptId);
        if (mergeCols[HEADERS.UPDATED_AT]) regSheet.getRange(p.regRow, mergeCols[HEADERS.UPDATED_AT]).setValue(now_());
        if (mergeCols[MANUAL_TOTAL_HEADER]) regSheet.getRange(p.regRow, mergeCols[MANUAL_TOTAL_HEADER]).setValue(isPrimary && hasManualTotal ? total : "");
        // V23: Failsafe — store human-readable bundle/manual info on primary
        if (mergeCols[BUNDLE_INFO_HEADER] && isPrimary) {
          var bundleInfoVal = "";
          if (options.bundleInfo) {
            bundleInfoVal = "BUNDLE: " + options.bundleInfo;
          } else if (hasManualTotal) {
            bundleInfoVal = "MANUAL: \u20B1" + total;
          } else {
            bundleInfoVal = "SUM: \u20B1" + total;
          }
          regSheet.getRange(p.regRow, mergeCols[BUNDLE_INFO_HEADER]).setValue(bundleInfoVal);
        }

        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF] && unifiedPayRef) {
          regSheet.getRange(p.regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).setValue(unifiedPayRef);
        }
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER] && unifiedVerifier) {
          regSheet.getRange(p.regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).setValue(unifiedVerifier);
        }
        if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT] && unifiedPaidAt) {
          regSheet.getRange(p.regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).setValue(unifiedPaidAt);
        }

        // Clear Payment Status for non-primary members (primary keeps their status)
        if (!isPrimary && payStatusCol) {
          var payCell = regSheet.getRange(p.regRow, payStatusCol);
          payCell.clearDataValidations();
          payCell.clearContent();
        }
      }

      // ROW REORDERING (Feature 5)
      // Move member rows to follow primary row immediately.
      // Strategy: Handle row shifts dynamically by re-finding rows on each step.
      participantRows.sort(function(a, b) { return a.regRow - b.regRow; }); // initial sort by original pos
      
      // We need to move members one by one to (PrimaryRow + 1 + i)
      // But moving a row changes the index of PrimaryRow if the moved row was above it.
      // So we must re-find PrimaryRow and MemberRow every time.
      
      var emailsToOrder = participantRows.filter(function(p){ return p.email !== primary; }).map(function(p){ return p.email; });

      for (var k = 0; k < emailsToOrder.length; k++) {
        var memberEmail = emailsToOrder[k];
        
        // Find current Primary Row (restrict to Email column)
        var pFinder = regSheet.getRange(1, SYSTEM_CONFIG.COLS.REG.EMAIL, regSheet.getLastRow(), 1)
          .createTextFinder(primary).matchEntireCell(true).findNext();
        if (!pFinder) break; 
        var currentPrimaryRow = pFinder.getRow();
        
        // Find current Member Row
        var mFinder = regSheet.getRange(1, SYSTEM_CONFIG.COLS.REG.EMAIL, regSheet.getLastRow(), 1)
          .createTextFinder(memberEmail).matchEntireCell(true).findNext();
        if (!mFinder) continue; 
        var currentMemberRow = mFinder.getRow();
        
        // Calculate Target: Primary + 1 (for first member), etc.
        // Note: moveRows accounts for index shifts automatically when dest > src.
        var targetIndex = currentPrimaryRow + 1 + k;
        
        if (currentMemberRow === targetIndex) continue; // Already in place
        
        // Check for boundary to avoid errors
        if (targetIndex > regSheet.getLastRow() + 1) targetIndex = regSheet.getLastRow() + 1;

        try {
          regSheet.moveRows(regSheet.getRange(currentMemberRow, 1, 1, regSheet.getLastColumn()), targetIndex);
        } catch (e) {
          AuditLogService.warn("MERGE_REORDER_FAIL", "Could not move " + memberEmail + " to " + targetIndex + ": " + e);
        }
      }
    });

    // Apply accounting on Finance
    var groupObj = {
      groupId: groupId,
      receiptId: receiptId,
      primaryEmail: primary,
      participants: participantRows,
      total: total
    };

    TriggerGuard.mute(function () {
      // Unify payref/verifier/paidAt and set totals (primary sum, members 0)
      participantRows.forEach(function (p) {
        var email = p.email;
        var isPrimary = (email === primary);

        var rowIndex = ensureFinanceRowExists_(finSheet, finCols, email, {
          Email: email,
          Name: p.name || "",
          GenId: p.genId || ""
        });

        if (!rowIndex) return;

        if (finCols.PayRef && unifiedPayRef) finSheet.getRange(rowIndex, finCols.PayRef).setValue(unifiedPayRef);
        if (finCols.Verifier && unifiedVerifier) finSheet.getRange(rowIndex, finCols.Verifier).setValue(unifiedVerifier);
        if (finCols.SysPaidAt && unifiedPaidAt) finSheet.getRange(rowIndex, finCols.SysPaidAt).setValue(unifiedPaidAt);

        if (finCols.TotalAmount) finSheet.getRange(rowIndex, finCols.TotalAmount).setValue(isPrimary ? total : 0);

        if (finCols.EmailSent) {
          if (isPrimary) {
            if (options.resetEmailTracking) {
              finSheet.getRange(rowIndex, finCols.EmailSent).setValue(""); // allow group send
            }
          } else {
            finSheet.getRange(rowIndex, finCols.EmailSent).setValue("SKIPPED: MERGED (" + groupId + ")");
          }
        }
      });
    });

    // V23: Finance row rearrangement (mirror Registration reordering)
    TriggerGuard.mute(function () {
      if (!finCols || !finCols.Email) return;
      var finEmailCol = finCols.Email;

      var finMemberEmails = participantRows.filter(function(p) { return p.email !== primary; }).map(function(p) { return p.email; });

      for (var fk = 0; fk < finMemberEmails.length; fk++) {
        var fMemberEmail = finMemberEmails[fk];

        // Find current Primary Finance Row
        var fpFinder = finSheet.getRange(1, finEmailCol, finSheet.getLastRow(), 1)
          .createTextFinder(primary).matchEntireCell(true).findNext();
        if (!fpFinder) break;
        var currentFinPrimaryRow = fpFinder.getRow();

        // Find current Member Finance Row
        var fmFinder = finSheet.getRange(1, finEmailCol, finSheet.getLastRow(), 1)
          .createTextFinder(fMemberEmail).matchEntireCell(true).findNext();
        if (!fmFinder) continue;
        var currentFinMemberRow = fmFinder.getRow();

        var finTargetIndex = currentFinPrimaryRow + 1 + fk;
        if (currentFinMemberRow === finTargetIndex) continue;
        if (finTargetIndex > finSheet.getLastRow() + 1) finTargetIndex = finSheet.getLastRow() + 1;

        try {
          finSheet.moveRows(finSheet.getRange(currentFinMemberRow, 1, 1, finSheet.getLastColumn()), finTargetIndex);
        } catch (e) {
          AuditLogService.warn("MERGE_FIN_REORDER_FAIL", "Could not move " + fMemberEmail + " to " + finTargetIndex + ": " + e);
        }
      }
    });

    // V23: Apply visual formatting (bold primary + group color banding)
    TriggerGuard.mute(function () {
      applyMergeFormatting_(groupObj, { regSheet: regSheet, finSheet: finSheet, finCols: finCols });
    });

    // Record ledger snapshot
    ledgerAppend_(groupId, primary, list, snapshot, "Merged via V22 Merge UI");

    AdminAuditService.log("MERGE_CREATE", primary, "", groupId, {
      primaryEmail: primary,
      participants: list,
      total: total,
      payRef: unifiedPayRef
    }, "Master Transaction created.");

    return { ok: true, groupId: groupId, primaryEmail: primary, receiptId: receiptId, total: total, payRef: unifiedPayRef };
  }

  // Feature 3: Send Group "Registration Received" Email
  // Sends personalized Registration Received to EACH participant in the group
  function sendGroupRegistrationReceived_(groupId, forceSend) {
    var regSheet = regSheet_();
    if (!regSheet) return { sent: false, error: "Missing Registration sheet." };
    var cols = getMergeColsIfPresent_(regSheet);
    var groupObj = getGroupFromRegistration_(groupId, regSheet, cols);
    if (!groupObj) return { sent: false, error: "Group not found." };

    var inlineImages = LogoService.getInlineImages ? LogoService.getInlineImages() : null;
    var REG = SYSTEM_CONFIG.COLS.REG;
    var results = [];

    for (var i = 0; i < groupObj.participants.length; i++) {
      var p = groupObj.participants[i];
      var email = normalizeEmail_(p.email);
      if (!email) continue;

      // Enrich participant data from registration row
      var regRow = p.rowIndex || repo_().findRegistrationRowIndexByEmail(email);
      var rowVals = regRow ? regSheet.getRange(regRow, 1, 1, regSheet.getLastColumn()).getValues()[0] : null;

      var enriched = {
        email: email,
        name: p.name || "",
        genId: p.genId || "",
        competitions: p.competitions || "",
        finalAmount: p.finalAmount || 0,
        role: p.role || "",
        couponCode: rowVals ? String(rowVals[REG.COUPON_INPUT - 1] || "").trim() : "",
        refCodeUsed: rowVals ? String(rowVals[REG.REF_INPUT - 1] || "").trim() : "",
        couponDiscount: rowVals ? Number(rowVals[REG.COUPON_DISCOUNT - 1] || 0) : 0,
        refDiscount: rowVals ? Number(rowVals[REG.REF_DISCOUNT - 1] || 0) : 0
      };

      var subject = "Registration Received \u2014 " + groupObj.groupId;
      var html = buildGroupRegReceivedHtml_(groupObj, enriched, { preview: false });

      var result = sendGroupEmailWithGuard_(email, subject, html, groupObj.groupId, "REG_RECEIVED_GROUP", inlineImages, forceSend);
      results.push({ email: email, result: result });
    }

    return { sent: true, groupId: groupId, results: results };
  }

  function markGroupMembersEmailSkipped_(groupId) {
    var regSheet = regSheet_();
    var finSheet = finSheet_();
    if (!regSheet || !finSheet) return;
    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols) return;

    var groupObj = getGroupFromRegistration_(groupId, regSheet, cols);
    if (!groupObj) return;

    var finCols = ColumnManager.getFinanceCols(finSheet);
    groupObj.participants.forEach(function (p) {
      if (normalizeEmail_(p.email) === normalizeEmail_(groupObj.primaryEmail)) return;
      var finRow = repo_().findFinanceRowIndexByEmail(p.email, finCols);
      if (finRow && finCols.EmailSent) finSheet.getRange(finRow, finCols.EmailSent).setValue("SKIPPED: MERGED (" + groupId + ")");
    });
  }

  function unmergeGroup(groupId, mode, customAmountsByEmail) {
    mode = mode || "RESTORE_SNAPSHOT";
    var regSheet = regSheet_();
    var finSheet = finSheet_();
    if (!regSheet || !finSheet) return { ok: false, error: "Missing sheets." };

    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols) return { ok: false, error: "Merge columns not found. Nothing to unmerge." };

    var entry = ledgerFindLatest_(groupId);
    var participants = [];
    var usedLedger = false;

    if (entry && entry.snapshot && entry.snapshot.participants && entry.snapshot.participants.length) {
      // Use ledger snapshot (original behavior)
      participants = entry.snapshot.participants;
      usedLedger = true;
    } else {
      // Fallback: discover group members directly from Registration sheet
      var liveGroup = getGroupFromRegistration_(groupId, regSheet, cols);
      if (!liveGroup || !liveGroup.participants || !liveGroup.participants.length) {
        return { ok: false, error: "Group not found in ledger or registration sheet: " + groupId };
      }
      // Build synthetic participant list from live registration data
      participants = liveGroup.participants.map(function (p) {
        return { email: p.email, reg: null, fin: null };
      });
      // Force RECOMPUTE_FROM_REG since we have no snapshot to restore
      mode = "RECOMPUTE_FROM_REG";
    }

    var finCols = ColumnManager.getFinanceCols(finSheet);
    var sysCols = getSysCols_(regSheet);

    TriggerGuard.mute(function () {
      participants.forEach(function (p) {
        var email = normalizeEmail_(p.email);
        if (!email) return;

        // Clear merge columns
        var regRow = repo_().findRegistrationRowIndexByEmail(email);
        if (regRow) {
          if (cols[HEADERS.GROUP_ID]) regSheet.getRange(regRow, cols[HEADERS.GROUP_ID]).setValue("");
          if (cols[HEADERS.ROLE]) regSheet.getRange(regRow, cols[HEADERS.ROLE]).setValue("");
          if (cols[HEADERS.PRIMARY_EMAIL]) regSheet.getRange(regRow, cols[HEADERS.PRIMARY_EMAIL]).setValue("");
          if (cols[HEADERS.RECEIPT_ID]) regSheet.getRange(regRow, cols[HEADERS.RECEIPT_ID]).setValue("");
          if (cols[HEADERS.UPDATED_AT]) regSheet.getRange(regRow, cols[HEADERS.UPDATED_AT]).setValue(now_());

          // Restore SYS meta (optional)
          if (mode === "RESTORE_SNAPSHOT" && p.reg && p.reg.sys) {
            if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAY_REF]).setValue(p.reg.sys.payRef || "");
            if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.VERIFIER]).setValue(p.reg.sys.verifier || "");
            if (sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]) regSheet.getRange(regRow, sysCols[SYSTEM_CONFIG.SYS_REG_HEADERS.PAID_AT]).setValue(p.reg.sys.paidAt || "");
          }

          // Restore Payment Status from snapshot (both modes)
          if (SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS && p.reg && p.reg.paymentStatus !== undefined) {
            regSheet.getRange(regRow, SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS).setValue(p.reg.paymentStatus || "");
          }
        }

        // Restore finance
        var finRow = repo_().findFinanceRowIndexByEmail(email, finCols);
        if (finRow) {
          if (mode === "RESTORE_SNAPSHOT" && p.fin) {
            if (finCols.TotalAmount) finSheet.getRange(finRow, finCols.TotalAmount).setValue(p.fin.TotalAmount || "");
            if (finCols.Status) finSheet.getRange(finRow, finCols.Status).setValue(p.fin.Status || "");
            if (finCols.Verifier) finSheet.getRange(finRow, finCols.Verifier).setValue(p.fin.Verifier || "");
            if (finCols.PayRef) finSheet.getRange(finRow, finCols.PayRef).setValue(p.fin.PayRef || "");
            if (finCols.EmailSent) finSheet.getRange(finRow, finCols.EmailSent).setValue(p.fin.EmailSent || "");
            if (finCols.SysPaidAt) finSheet.getRange(finRow, finCols.SysPaidAt).setValue(p.fin.SysPaidAt || "");
          } else if (mode === "RECOMPUTE_FROM_REG") {
            // Default: set finance Total Amount = registration final amount
            var regRow2 = repo_().findRegistrationRowIndexByEmail(email);
            var rowVals = regRow2 ? repo_().getRegistrationRow(regRow2) : null;
            var finalAmt = rowVals ? Number(rowVals[SYSTEM_CONFIG.COLS.REG.FINAL_AMOUNT - 1] || 0) : 0;
            if (customAmountsByEmail && customAmountsByEmail[email] !== undefined) {
              finalAmt = Number(customAmountsByEmail[email] || 0);
            }
            if (finCols.TotalAmount) finSheet.getRange(finRow, finCols.TotalAmount).setValue(finalAmt);
            if (finCols.EmailSent) finSheet.getRange(finRow, finCols.EmailSent).setValue("");
          }
        }
      });
    });

    // Clear group thread info
    GroupThreadService.clear(groupId);

    AdminAuditService.log("MERGE_UNMERGE", "", "", groupId, { mode: mode }, "Unmerged group.");
    return { ok: true, groupId: groupId, mode: mode, restored: participants.length };
  }

  // ---- Group send: Paid receipt ----
  function sendGroupPaidReceipt_(groupId, forceSend, sendToAll) {
    sendToAll = !!sendToAll;
    var regSheet = regSheet_();
    if (!regSheet) return { sent: false, skipped: false, reason: "Missing Registration sheet." };

    var cols = getMergeColsIfPresent_(regSheet);
    if (!cols) return { sent: false, skipped: false, reason: "Merge columns not found." };

    var groupObj = getGroupFromRegistration_(groupId, regSheet, cols);
    if (!groupObj) return { sent: false, skipped: false, reason: "Group not found: " + groupId };

    var meta = getGroupMetaForEmailing_(groupObj);
    var inlineImages = LogoService.getInlineImages ? LogoService.getInlineImages() : null;

    // Send personalized AR to EACH participant individually
    var results = [];
    for (var i = 0; i < groupObj.participants.length; i++) {
      var p = groupObj.participants[i];
      if (!p.email) continue;
      var recipientEmail = normalizeEmail_(p.email);
      if (!recipientEmail) continue;
      var subject = "\uD83E\uDDFE Acknowledgement Receipt \u2014 " + (p.name || recipientEmail);
      var html = buildGroupReceiptHtml_(groupObj, p, { payRef: meta.payRef, verifier: meta.verifier, paidAt: meta.paidAt });
      results.push(sendGroupEmailWithGuard_(recipientEmail, subject, html, groupObj.groupId, "PAID_GROUP", inlineImages, forceSend));
    }

    // If sent to primary only, mark members as skipped (optional)
    try { markGroupMembersEmailSkipped_(groupId); } catch (e) {}

    // Update Status, Email Sent, and SYS_PAID_AT for all group participants
    var sentAny = results.some(function (r) { return !!r.sent; });
    if (sentAny) {
      try {
        var regHeaderMap = ColumnManager.headerMap(regSheet);
        var payStatusCol = regHeaderMap["Status"] || regHeaderMap["Payment Status"] || SYSTEM_CONFIG.COLS.REG.PAYMENT_STATUS;
        var emailSentCol = regHeaderMap["Email Sent"] || SYSTEM_CONFIG.COLS.REG.EMAIL_SENT;
        var sysPaidAtCol = regHeaderMap["SYS_PAID_AT"] || null;
        var nowStr = Utils.nowTzString();
        var sentStamp = "SENT: " + nowStr;

        for (var ps = 0; ps < groupObj.participants.length; ps++) {
          var pRow = groupObj.participants[ps].rowIndex;
          if (!pRow) continue;
          if (payStatusCol) regSheet.getRange(pRow, payStatusCol).setValue("PAID");
          if (emailSentCol) regSheet.getRange(pRow, emailSentCol).setValue(sentStamp);
          if (sysPaidAtCol) regSheet.getRange(pRow, sysPaidAtCol).setValue(nowStr);
        }
        SpreadsheetApp.flush();
      } catch (e) {
        Logger.log("Group post-send update error: " + e.message);
      }
    }

    // Return summary
    var skippedAll = results.every(function (r) { return !!r.skipped; });
    return { sent: sentAny, skipped: skippedAll, results: results };
  }

  function sendGroupEmailWithGuard_(recipient, subject, htmlBody, groupId, kind, inlineImages, forceSend) {
    kind = kind || "GEN_GROUP";
    forceSend = !!forceSend;

    // Rate limiting check
    var rateCheck = RateLimiter.canSendEmail ? RateLimiter.canSendEmail() : { allowed: true };
    if (rateCheck && rateCheck.allowed === false && !forceSend) {
      return { sent: false, skipped: true, reason: rateCheck.reason || "Rate limited" };
    }

    var payload = {
      kind: kind,
      recipient: recipient || "",
      subject: subject || "",
      genId: groupId || "",
      hint: (htmlBody || "").slice(0, 180)
    };
    var hash = Utils.hashReceiptPayload ? Utils.hashReceiptPayload(payload) : String(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, JSON.stringify(payload)));

    if (!forceSend) {
      var skip = ReceiptGuard.shouldSkipDuplicate ? ReceiptGuard.shouldSkipDuplicate(groupId, kind, hash) : { skip: false };
      if (skip && skip.skip) {
        return { sent: false, skipped: true, reason: skip.reason || "Duplicate" };
      }
    }

    var threadInfo = GroupThreadService.get(groupId);
    var result = null;
    var method = "unknown";

    try {
      if (threadInfo && threadInfo.threadId && threadInfo.messageId) {
        result = EmailThreadService.sendReplyEmail(
          recipient,
          subject,
          htmlBody,
          inlineImages,
          threadInfo.threadId,
          threadInfo.messageId,
          SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME
        );
        if (result && result.success) method = result.method || "reply";
      } else {
        result = EmailThreadService.sendFirstEmail(recipient, subject, htmlBody, inlineImages);
        if (result && result.success) {
          method = result.method || "first";
          if (result.threadId && result.rfc822MessageId) {
            GroupThreadService.set(groupId, result.threadId, result.rfc822MessageId);
          }
        }
      }

      // Fallback
      if (!result || !result.success) {
        var opts = { htmlBody: htmlBody, name: SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME };
        if (inlineImages && Object.keys(inlineImages).length) opts.inlineImages = inlineImages;
        GmailApp.sendEmail(recipient, subject, "", opts);
        method = "gmailapp_fallback";
        result = { success: true };
      }

      if (RateLimiter.recordEmailSent) RateLimiter.recordEmailSent();

      if (ReceiptGuard.setLast) {
        ReceiptGuard.setLast(groupId, kind, hash, {
          sentAt: new Date().toISOString(),
          recipient: recipient,
          subject: subject,
          forced: forceSend,
          method: method
        });
      }

      return { sent: true, skipped: false, method: method };
    } catch (e) {
      return { sent: false, skipped: false, reason: String(e) };
    }
  }

  // ---- Public API ----
  return {
    HEADERS: HEADERS,
    ROLES: ROLES,
    getMergeMetaForEmail_: getMergeMetaForEmail_,
    ensureMergeCols_: ensureMergeCols_,
    reapplyAllMerges: reapplyAllMerges,
    reapplyMergeForEmail_: reapplyMergeForEmail_,
    mergeParticipants: mergeParticipants,
    unmergeGroup: unmergeGroup,
    sendGroupPaidReceipt_: sendGroupPaidReceipt_,
    buildGroupReceiptHtml_: buildGroupReceiptHtml_,
    buildGroupRegReceivedHtml_: buildGroupRegReceivedHtml_, 
    getGroupFromRegistration_: getGroupFromRegistration_,
    propagateFinanceMetaToGroup_: propagateFinanceMetaToGroup_,
    markGroupMembersEmailSkipped_: markGroupMembersEmailSkipped_,
    sendGroupRegistrationReceived_: sendGroupRegistrationReceived_
  };
})();

