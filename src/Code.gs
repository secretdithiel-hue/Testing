    if (/EMAIL/i.test(hh) && !/SENT/i.test(hh) && !/THREAD/i.test(hh)) colMap.email = colMap.email || i;
  });

  var ci = {
    name: colMap.name !== undefined ? colMap.name : C.NAME - 1,
    school: colMap.school !== undefined ? colMap.school : C.SCHOOL - 1,
    region: colMap.region !== undefined ? colMap.region : C.REGION - 1,
    grade: colMap.grade !== undefined ? colMap.grade : C.GRADE_LEVEL - 1,
    sex: colMap.sex !== undefined ? colMap.sex : C.SEX - 1,
    age: colMap.age !== undefined ? colMap.age : C.AGE - 1,
    comp: colMap.competition !== undefined ? colMap.competition : C.COMPETITION - 1,
    payStatus: colMap.payStatus !== undefined ? colMap.payStatus : C.PAYMENT_STATUS - 1,
    totalFee: colMap.totalFee !== undefined ? colMap.totalFee : C.TOTAL_FEE - 1,
    baseFee: colMap.baseFee !== undefined ? colMap.baseFee : C.BASE_FEE - 1,
    bundleDisc: colMap.bundleDisc !== undefined ? colMap.bundleDisc : C.BUNDLE_DISCOUNT - 1,
    couponDisc: colMap.couponDisc !== undefined ? colMap.couponDisc : C.COUPON_DISCOUNT - 1,
    refDisc: colMap.refDisc !== undefined ? colMap.refDisc : C.REF_DISCOUNT - 1,
    cashback: colMap.cashback !== undefined ? colMap.cashback : C.CASHBACK - 1,
    payMode: colMap.payMode !== undefined ? colMap.payMode : C.PAY_MODE - 1,
    genId: colMap.genId !== undefined ? colMap.genId : C.GEN_ID - 1,
    email: colMap.email !== undefined ? colMap.email : C.EMAIL - 1
  };

  var totalRegs = 0, schools = [], regions = [], grades = [], sexes = [], ages = [];
  var competitions = {}, dailyCounts = {}, calendarData = {}, statusCounts = { paid: 0, unpaid: 0 };
  var regsWithDate = [];

  rows.forEach(function(row) {
    var name = String(row[ci.name] || "").trim();
    if (!name) return;
    totalRegs++;

    var ts = row[0]; // Timestamp is always col A
    var dateKey = "";
    if (ts) {
      var d = new Date(ts);
      if (!isNaN(d.getTime())) {
        dateKey = Utilities.formatDate(d, SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd");
        dailyCounts[dateKey] = (dailyCounts[dateKey] || 0) + 1;
        calendarData[dateKey] = (calendarData[dateKey] || 0) + 1;
      }
    }

    var school = String(row[ci.school] || "").trim();
    if (school) schools.push(school);

    var region = String(row[ci.region] || "").trim();
    if (region) regions.push(region);

    var grade = String(row[ci.grade] || "").trim();
    if (grade) grades.push(grade);

    var sex = String(row[ci.sex] || "").trim();
    if (sex) sexes.push(sex);

    var age = Number(row[ci.age] || 0);
    if (age > 0) ages.push(age);

    var comp = String(row[ci.comp] || "");
    comp.split(",").forEach(function(c) {
      var ct = c.trim();
      if (ct) competitions[ct] = (competitions[ct] || 0) + 1;
    });

    var status = String(row[ci.payStatus] || "").trim().toUpperCase();
    if (status === "PAID") statusCounts.paid++;
    else statusCounts.unpaid++;

    regsWithDate.push({ date: dateKey, school: school, region: region, comp: comp });
  });

  var schoolClusters = dashboardClusterSchools_(schools);
  var regionMap = {};
  regions.forEach(function(r) { var nr = dashboardNormalizeRegion_(r); regionMap[nr] = (regionMap[nr] || 0) + 1; });
  var gradeMap = {};
  grades.forEach(function(g) { gradeMap[g] = (gradeMap[g] || 0) + 1; });
  var sexMap = {};
  sexes.forEach(function(s) { var ns = s.charAt(0).toUpperCase() + s.slice(1).toLowerCase(); sexMap[ns] = (sexMap[ns] || 0) + 1; });
  var ageMap = {};
  ages.forEach(function(a) {
    var r = a < 13 ? "Under 13" : a < 16 ? "13-15" : a < 19 ? "16-18" : a < 22 ? "19-21" : "22+";
    ageMap[r] = (ageMap[r] || 0) + 1;
  });

  var dailyKeys = Object.keys(dailyCounts).sort();
  var dailyTrend = dailyKeys.map(function(k) { return { date: k, count: dailyCounts[k] }; });

  var now = new Date();
  var todayKey = Utilities.formatDate(now, SYSTEM_CONFIG.META.TIMEZONE, "yyyy-MM-dd");
  var todayCount = dailyCounts[todayKey] || 0;

  var last7 = 0, prev7 = 0;
  dailyKeys.forEach(function(k) {
    var diff = (now.getTime() - new Date(k).getTime()) / 86400000;
    if (diff <= 7) last7 += dailyCounts[k];
    else if (diff <= 14) prev7 += dailyCounts[k];
  });
  var growthRate = prev7 > 0 ? Math.round(((last7 - prev7) / prev7) * 100) : (last7 > 0 ? 100 : 0);
  var avgPerDay = Math.round((totalRegs / (dailyKeys.length || 1)) * 10) / 10;

  return {
    totalRegs: totalRegs, uniqueSchools: schoolClusters.length,
    totalCompetitions: Object.keys(competitions).length,
    avgPerDay: avgPerDay, growthRate: growthRate, todayCount: todayCount,
    competitions: competitions, regionMap: regionMap,
    schoolClusters: schoolClusters.slice(0, 50),
    dailyTrend: dailyTrend, calendarData: calendarData,
    gradeMap: gradeMap, sexMap: sexMap, ageMap: ageMap,
    statusCounts: statusCounts, detectedCols: colMap
  };
}

