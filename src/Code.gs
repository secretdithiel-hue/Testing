// ============================================================================

/**
 * Email Thread Manager - Keeps all emails in one thread FOR BOTH sender AND recipient
 * Uses direct Gmail API calls via UrlFetchApp for proper MIME construction
 */
var EmailThreadService = (function() {
  
  /**
   * Get the stored thread info for a participant
   */
  function getThreadInfo(genId) {
    if (!genId) return null;
    
    try {
      var repo = new SheetRepository();
      var regSheet = repo.getRegistrationSheet();
      var data = regSheet.getDataRange().getValues();
      var headers = data[0];
      
      var genIdCol = SYSTEM_CONFIG.COLS.REG.GEN_ID - 1;
      var threadIdCol = -1;
      
      for (var h = 0; h < headers.length; h++) {
        if (String(headers[h]).trim() === SYSTEM_CONFIG.SYS_REG_HEADERS.EMAIL_THREAD_ID) {
          threadIdCol = h;
          break;
        }
      }
      
      if (threadIdCol < 0) return null;
      
      for (var i = 1; i < data.length; i++) {
        if (String(data[i][genIdCol]).trim() === genId) {
          var stored = String(data[i][threadIdCol] || "").trim();
          if (!stored) return null;
          
          try {
            return JSON.parse(stored);
          } catch (e) {
            return { threadId: stored, messageId: null };
          }
        }
      }
    } catch (e) {
      Logger.log("Error getting thread info: " + e);
    }
    
    return null;
  }
  
  /**
   * Store thread info for a participant
   */
  function setThreadInfo(genId, threadId, messageId) {
    if (!genId || !threadId) return false;
    
    try {
      var repo = new SheetRepository();
      var regSheet = repo.getRegistrationSheet();
      var data = regSheet.getDataRange().getValues();
      var headers = data[0];
      
      var genIdCol = SYSTEM_CONFIG.COLS.REG.GEN_ID - 1;
      var threadIdCol = -1;
      
      for (var h = 0; h < headers.length; h++) {
        if (String(headers[h]).trim() === SYSTEM_CONFIG.SYS_REG_HEADERS.EMAIL_THREAD_ID) {
          threadIdCol = h;
          break;
        }
      }
      
      if (threadIdCol < 0) {
        var lastCol = regSheet.getLastColumn();
        regSheet.getRange(1, lastCol + 1).setValue(SYSTEM_CONFIG.SYS_REG_HEADERS.EMAIL_THREAD_ID);
        threadIdCol = lastCol;
      }
      
      for (var i = 1; i < data.length; i++) {
        if (String(data[i][genIdCol]).trim() === genId) {
          var info = JSON.stringify({ threadId: threadId, messageId: messageId });
          regSheet.getRange(i + 1, threadIdCol + 1).setValue(info);
          return true;
        }
      }
    } catch (e) {
      Logger.log("Error setting thread info: " + e);
    }
    
    return false;
  }
  
  /**
   * Get the RFC822 Message-ID from a Gmail message
   */
  function getMessageIdFromGmail(gmailMessageId) {
    try {
      var message = Gmail.Users.Messages.get('me', gmailMessageId, { format: 'metadata', metadataHeaders: ['Message-Id', 'Message-ID'] });
      if (message.payload && message.payload.headers) {
        for (var i = 0; i < message.payload.headers.length; i++) {
          var header = message.payload.headers[i];
          if (header.name.toLowerCase() === 'message-id') {
            return header.value;
          }
        }
      }
    } catch (e) {
      Logger.log("Error getting message ID: " + e);
    }
    return null;
  }
  
  /**
   * Build proper RFC2822 MIME message with inline images and threading headers
   */
  function buildMimeMessage(recipient, subject, htmlBody, inlineImages, inReplyTo, references, senderName) {
    var boundary = "----=_Part_" + Utilities.getUuid().replace(/-/g, '');
    // Effective user = the account the script (and its triggers) runs as, i.e. the real sender.
    // getActiveUser() can be blank inside triggers, which produces an invalid From header.
    var senderEmail = Session.getEffectiveUser().getEmail() || Session.getActiveUser().getEmail();
    var fromName = senderName || SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME;
    
    var mimeLines = [];
    
    // Headers
    mimeLines.push("MIME-Version: 1.0");
    mimeLines.push("From: =?UTF-8?B?" + Utilities.base64Encode(fromName, Utilities.Charset.UTF_8) + "?= <" + senderEmail + ">");
    mimeLines.push("To: " + recipient);
    mimeLines.push("Subject: =?UTF-8?B?" + Utilities.base64Encode(subject, Utilities.Charset.UTF_8) + "?=");
    
    // Threading headers - CRITICAL for recipient-side threading
    if (inReplyTo) {
      mimeLines.push("In-Reply-To: " + inReplyTo);
    }
    if (references) {
      mimeLines.push("References: " + references);
    }
    
    // Check if we have inline images
    var hasInlineImages = inlineImages && Object.keys(inlineImages).length > 0;
    
    if (hasInlineImages) {
      mimeLines.push("Content-Type: multipart/related; boundary=\"" + boundary + "\"");
      mimeLines.push("");
      
      // HTML part
      mimeLines.push("--" + boundary);
      mimeLines.push("Content-Type: text/html; charset=\"UTF-8\"");
      mimeLines.push("Content-Transfer-Encoding: base64");
      mimeLines.push("");
      mimeLines.push(Utilities.base64Encode(htmlBody, Utilities.Charset.UTF_8));
      
      // Inline image parts
      for (var cid in inlineImages) {
        var blob = inlineImages[cid];
        mimeLines.push("");
        mimeLines.push("--" + boundary);
        mimeLines.push("Content-Type: " + blob.getContentType());
        mimeLines.push("Content-Transfer-Encoding: base64");
        mimeLines.push("Content-ID: <" + cid + ">");
        mimeLines.push("Content-Disposition: inline; filename=\"" + cid + "\"");
        mimeLines.push("");
        
        // Split base64 into 76-character lines (RFC 2045)
        var b64 = Utilities.base64Encode(blob.getBytes());
        var b64Lines = b64.match(/.{1,76}/g) || [b64];
        mimeLines.push(b64Lines.join("\r\n"));
      }
      
      mimeLines.push("");
      mimeLines.push("--" + boundary + "--");
    } else {
      mimeLines.push("Content-Type: text/html; charset=\"UTF-8\"");
      mimeLines.push("Content-Transfer-Encoding: base64");
      mimeLines.push("");
      mimeLines.push(Utilities.base64Encode(htmlBody, Utilities.Charset.UTF_8));
    }
    
    return mimeLines.join("\r\n");
  }
  
  /**
   * Send email using Gmail API via UrlFetchApp (supports all headers)
   */
  function sendViaGmailApi(mimeMessage, threadId) {
    try {
      var url = "https://www.googleapis.com/upload/gmail/v1/users/me/messages/send?uploadType=media";
      
      if (threadId) {
        url += "&threadId=" + threadId;
      }
      
      var response = UrlFetchApp.fetch(url, {
        method: "POST",
        headers: {
          "Authorization": "Bearer " + ScriptApp.getOAuthToken(),
          "Content-Type": "message/rfc822"
        },
        payload: mimeMessage,
        muteHttpExceptions: true
      });
      
      var responseCode = response.getResponseCode();
      var responseText = response.getContentText();
      
      Logger.log("Gmail API response code: " + responseCode);
      
      if (responseCode === 200) {
        var result = JSON.parse(responseText);
        return { 
          success: true, 
          messageId: result.id, 
          threadId: result.threadId,
          method: "gmail_api_urlfetch"
        };
      } else {
        Logger.log("Gmail API error: " + responseText);
        return { success: false, error: responseText };
      }
    } catch (e) {
      Logger.log("UrlFetchApp error: " + e);
      return { success: false, error: String(e) };
    }
  }
  
  /**
   * Send first email and capture thread info
   */
  function sendFirstEmail(recipient, subject, htmlBody, inlineImages, senderName) {
    try {
      var mimeMessage = buildMimeMessage(recipient, subject, htmlBody, inlineImages, null, null, senderName);
      var result = sendViaGmailApi(mimeMessage, null);
      
      if (result.success) {
        // Get the RFC822 Message-ID for future threading
        var rfc822MessageId = getMessageIdFromGmail(result.messageId);
        result.rfc822MessageId = rfc822MessageId;
        Logger.log("First email sent - ThreadId: " + result.threadId + ", RFC822 Message-ID: " + rfc822MessageId);
      }
      
      return result;
    } catch (e) {
      Logger.log("sendFirstEmail error: " + e);
      return { success: false, error: String(e) };
    }
  }
  
  /**
   * Send reply email with proper threading headers
   */
  function sendReplyEmail(recipient, subject, htmlBody, inlineImages, threadId, originalMessageId, senderName) {
    try {
      var mimeMessage = buildMimeMessage(
        recipient, 
        subject, 
        htmlBody, 
        inlineImages, 
        originalMessageId,  // In-Reply-To
        originalMessageId,  // References
        senderName
      );
      
      var result = sendViaGmailApi(mimeMessage, threadId);
      
      if (result.success) {
        Logger.log("Reply sent - ThreadId: " + result.threadId + ", In-Reply-To: " + originalMessageId);
      }
      
      return result;
    } catch (e) {
      Logger.log("sendReplyEmail error: " + e);
      return { success: false, error: String(e) };
    }
  }
  
  return {
    getThreadInfo: getThreadInfo,
    setThreadInfo: setThreadInfo,
    getMessageIdFromGmail: getMessageIdFromGmail,
    buildMimeMessage: buildMimeMessage,
    sendViaGmailApi: sendViaGmailApi,
    sendFirstEmail: sendFirstEmail,
    sendReplyEmail: sendReplyEmail
  };
})();

var EmailService = (function () {
  
  /**
   * Core email sending function with proper threading via Gmail API
   */
  function sendWithGuard_(recipient, subject, htmlBody, genId, kind, inlineImages, forceSend, isFirstEmail, threadGenId) {
    kind = kind || "GEN";
    forceSend = !!forceSend;
    isFirstEmail = !!isFirstEmail;
    threadGenId = threadGenId || genId;

    // Rate limiting check
    var rateCheck = RateLimiter.canSendEmail();
    if (!rateCheck.allowed && !forceSend) {
      AuditLogService.warn("EMAIL_RATE_LIMITED", "genId=" + genId + " reason=" + rateCheck.reason);
      return { sent: false, skipped: true, hash: "", reason: rateCheck.reason };
    }

    var payload = {
      kind: kind,
      recipient: recipient || "",
      subject: subject || "",
      genId: genId || "",
      hint: (htmlBody || "").slice(0, 180)
    };

    var hash = Utils.hashReceiptPayload(payload);

    if (!forceSend) {
      var skip = ReceiptGuard.shouldSkipDuplicate(genId, kind, hash);
      if (skip.skip) {
        AuditLogService.warn("EMAIL_SKIPPED_DUP", "genId=" + genId + " kind=" + kind + " reason=" + skip.reason);
        return { sent: false, skipped: true, hash: hash, reason: skip.reason };
      }
    }

    try {
      var result = null;
      var sendMethod = "unknown";
      
      if (isFirstEmail) {
        // FIRST EMAIL: Send and capture thread info
        result = EmailThreadService.sendFirstEmail(recipient, subject, htmlBody, inlineImages);
        
        if (result.success) {
          sendMethod = result.method || "first_email";
          
          // Store thread info for future replies
          if (result.threadId && threadGenId) {
            EmailThreadService.setThreadInfo(threadGenId, result.threadId, result.rfc822MessageId);
            AuditLogService.info("EMAIL_THREAD_CREATED", 
              "genId=" + genId + " threadId=" + result.threadId + " msgId=" + result.rfc822MessageId);
          }
        }
      } else {
        // REPLY EMAIL: Send with threading headers
        var threadInfo = threadGenId ? EmailThreadService.getThreadInfo(threadGenId) : null;
        
        if (threadInfo && threadInfo.threadId && threadInfo.messageId) {
          result = EmailThreadService.sendReplyEmail(
            recipient,
            subject,
            htmlBody,
            inlineImages,
            threadInfo.threadId,
            threadInfo.messageId
          );
          
          if (result.success) {
            sendMethod = result.method || "reply";
            AuditLogService.info("EMAIL_REPLY_SENT", 
              "genId=" + genId + " threadId=" + threadInfo.threadId + " inReplyTo=" + threadInfo.messageId);
          }
        } else {
          // No thread info - send as new email
          AuditLogService.warn("EMAIL_NO_THREAD_INFO", "genId=" + genId + " - sending as new email");
          result = EmailThreadService.sendFirstEmail(recipient, subject, htmlBody, inlineImages);
          sendMethod = "no_thread_fallback";
        }
      }
      
      // Fallback to GmailApp if Gmail API failed
      if (!result || !result.success) {
        AuditLogService.warn("EMAIL_API_FALLBACK", "genId=" + genId + " - using GmailApp fallback");
        
        var opts = { htmlBody: htmlBody, name: SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME };
        if (inlineImages && Object.keys(inlineImages).length) opts.inlineImages = inlineImages;
        
        GmailApp.sendEmail(recipient, subject, "", opts);
        sendMethod = "gmailapp_fallback";
        result = { success: true };
      }

      // Record for rate limiting
      RateLimiter.recordEmailSent();

      ReceiptGuard.setLast(genId, kind, hash, { 
        sentAt: new Date().toISOString(), 
        recipient: recipient, 
        subject: subject, 
        forced: forceSend,
        method: sendMethod
      });
      
      AuditLogService.info("EMAIL_SENT", 
        "kind=" + kind + " to=" + recipient + " genId=" + genId + " method=" + sendMethod);
        
      return { sent: true, skipped: false, hash: hash, reason: "" };
    } catch (e) {
      AuditLogService.error("EMAIL_FAIL", "kind=" + kind + " to=" + recipient + " err=" + e);
      return { sent: false, skipped: false, hash: hash, reason: String(e) };
    }
  }

