/**
 * Repair form link by moving data from orphaned Form Responses sheets
 */
function repairFormLink() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // Find orphaned Form Responses sheets
  var orphanedSheets = [];
  var sheets = ss.getSheets();
  
  // Only tabs fed by the registration form qualify. A "Form Responses" tab of the Submission
  // form (e.g. after linking a copied form) would otherwise be moved into Registration.
  var regForSkip = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
  var subForSkip = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  var regFormUrl = regForSkip ? formIdFromUrl_(regForSkip.getFormUrl()) : "";
  var subFormUrl = subForSkip ? formIdFromUrl_(subForSkip.getFormUrl()) : "";

  for (var i = 0; i < sheets.length; i++) {
    var name = sheets[i].getName();
    if (name.indexOf("Form Responses") !== -1 && name !== SYSTEM_CONFIG.SHEETS.REGISTRATION) {
      var thisFormUrl = formIdFromUrl_(sheets[i].getFormUrl());
      if (thisFormUrl && ((subFormUrl && thisFormUrl === subFormUrl) || (regFormUrl && thisFormUrl !== regFormUrl))) continue;
      if (detectFormSheetKind_(sheets[i]) === "SUBMISSION") continue;
      var lastRow = sheets[i].getLastRow();
      if (lastRow > 1) {
        orphanedSheets.push({ sheet: sheets[i], name: name, rows: lastRow - 1 });
      }
    }
  }
  
  if (orphanedSheets.length === 0) {
    ui.alert("ℹ️ No Orphaned Sheets", 
      "No extra Form Responses sheets found with data.\n\n" +
      "If form still isn't working, try " + getMenuPathText_("forceRelinkForm") + ".",
      ui.ButtonSet.OK);
    return;
  }
  
  var msg = "Found " + orphanedSheets.length + " sheet(s) with data:\n\n";
  for (var i = 0; i < orphanedSheets.length; i++) {
    msg += "• " + orphanedSheets[i].name + " (" + orphanedSheets[i].rows + " rows)\n";
  }
  msg += "\nMove this data to Registration and delete these sheets?";
  
  if (ui.alert("🔧 Repair Form Link", msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  
  try {
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    var totalMoved = 0;
    
    for (var i = 0; i < orphanedSheets.length; i++) {
      var src = orphanedSheets[i].sheet;
      var lastRow = src.getLastRow();
      var lastCol = src.getLastColumn();
      
      if (lastRow > 1) {
        var data = src.getRange(2, 1, lastRow - 1, lastCol).getValues();
        var destRow = regSheet.getLastRow() + 1;
        regSheet.getRange(destRow, 1, data.length, data[0].length).setValues(data);
        totalMoved += data.length;
      }
      ss.deleteSheet(src);
    }
    
    ui.alert("✅ Repair Complete",
      "Moved " + totalMoved + " rows to Registration.\n" +
      "Deleted " + orphanedSheets.length + " extra sheet(s).\n\n" +
      "Test by submitting the form again.",
      ui.ButtonSet.OK);
  } catch (e) {
    ui.alert("❌ Error", e.message, ui.ButtonSet.OK);
  }
}

/**
 * Force re-link form to this spreadsheet
 */
function forceRelinkForm() {
  var ui = SpreadsheetApp.getUi();
  
  if (ui.alert("🔗 Force Re-link Form",
    "This will:\n\n" +
    "1. Find the linked Google Form\n" +
    "2. Unlink it from current destination\n" +
    "3. Re-link it to this spreadsheet\n\n" +
    "Continue?",
    ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast("Finding form...", "🔍", -1);
    
    var form = getLinkedForm_();
    if (!form) {
      ui.alert("❌ No Form Found",
        "Could not find a linked form.\n\n" +
        "Manually link the form:\n" +
        "1. Open Google Form\n" +
        "2. Responses tab → Spreadsheet icon\n" +
        "3. Select this spreadsheet",
        ui.ButtonSet.OK);
      return;
    }
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Re-linking...", "🔗", -1);
    
    // Unlink
    try { form.removeDestination(); } catch (e) {}
    Utilities.sleep(1000);
    
    // Re-link
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
    
    Utilities.sleep(2000);
    SpreadsheetApp.flush();
    
    // Check result
    var sheets = ss.getSheets();
    var newDest = null;
    for (var i = 0; i < sheets.length; i++) {
      try {
        if (sheets[i].getFormUrl()) {
          newDest = sheets[i].getName();
          break;
        }
      } catch (e) {}
    }
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "✅", 2);
    
    if (newDest) {
      ui.alert("✅ Form Re-linked!",
        "Form now writes to: " + newDest + "\n\n" +
        (newDest !== SYSTEM_CONFIG.SHEETS.REGISTRATION ? 
          "⚠️ Note: This is a NEW sheet. Check it for submissions." :
          "✅ Writing to Registration sheet correctly."),
        ui.ButtonSet.OK);
    } else {
      ui.alert("⚠️ Partial Success",
        "Form was re-linked but destination unclear.\n" +
        "Test by submitting the form.",
        ui.ButtonSet.OK);
    }
  } catch (e) {
    ui.alert("❌ Error", e.message, ui.ButtonSet.OK);
  }
}

/**
 * Delete selected row from Registration and corresponding Finance entry
 */
function deleteSelectedRow() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var row = SpreadsheetApp.getActiveRange().getRow();
  
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    ui.alert("⚠️ Wrong Sheet", "Please select a row in the Registration sheet.", ui.ButtonSet.OK);
    return;
  }
  
  if (row < 2) {
    ui.alert("⚠️ Invalid Row", "Please select a data row (not the header).", ui.ButtonSet.OK);
    return;
  }
  
  // Get row data for confirmation
  var email = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
  var name = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.NAME).getValue();
  var genId = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue();
  
  if (!email && !name) {
    ui.alert("⚠️ Empty Row", "This row appears to be empty.", ui.ButtonSet.OK);
    return;
  }
  
  var confirm = ui.alert(
    "🗑️ Delete Registration?",
    "This will DELETE the following registration:\n\n" +
    "Row: " + row + "\n" +
    "Name: " + (name || "N/A") + "\n" +
    "Email: " + (email || "N/A") + "\n" +
    "Gen ID: " + (genId || "N/A") + "\n\n" +
    "This will also:\n" +
    "• Delete corresponding Finance entry\n" +
    "• Clear email tracking\n" +
    "• Clear form response for this email\n\n" +
    "⚠️ This action CANNOT be undone!\n\n" +
    "Continue?",
    ui.ButtonSet.YES_NO
  );
  
  if (confirm !== ui.Button.YES) return;
  
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast("Deleting...", "🗑️", -1);
    
    var deletedInfo = deleteRegistrationRow_(sheet, row, email, genId);
    
    // Also try to delete form response
    var formCleared = false;
    if (email) {
      formCleared = deleteFormResponseByEmail_(email);
    }
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "✅", 3);
    
    ui.alert(
      "✅ Deleted Successfully",
      "Registration deleted:\n\n" +
      "• Registration row deleted\n" +
      "• Finance entries deleted: " + deletedInfo.financeDeleted + "\n" +
      "• Email tracking cleared: " + (deletedInfo.trackingCleared ? "Yes" : "No") + "\n" +
      "• Form response cleared: " + (formCleared ? "Yes" : "No (may need manual)") + "\n\n" +
      (formCleared ? "✅ This email can now re-register!" : "⚠️ If re-registration doesn't work, manually clear form response."),
      ui.ButtonSet.OK
    );
  } catch (e) {
    ui.alert("❌ Error", "Failed to delete: " + e.message, ui.ButtonSet.OK);
    Logger.log("Delete error: " + e);
  }
}

/**
 * Delete multiple selected rows
 */
function deleteSelectedRows() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var range = SpreadsheetApp.getActiveRange();
  
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    ui.alert("⚠️ Wrong Sheet", "Please select rows in the Registration sheet.", ui.ButtonSet.OK);
    return;
  }
  
  var startRow = range.getRow();
  var numRows = range.getNumRows();
  var endRow = startRow + numRows - 1;
  
  if (startRow < 2) {
    startRow = 2;
    numRows = endRow - startRow + 1;
  }
  
  if (numRows < 1 || startRow < 2) {
    ui.alert("⚠️ Invalid Selection", "Please select data rows (not including header).", ui.ButtonSet.OK);
    return;
  }
  
  // Collect info about rows to delete
  var rowsInfo = [];
  var emails = [];
  for (var r = startRow; r <= endRow; r++) {
    var email = sheet.getRange(r, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
    var name = sheet.getRange(r, SYSTEM_CONFIG.COLS.REG.NAME).getValue();
    if (email || name) {
      rowsInfo.push("Row " + r + ": " + (name || "N/A") + " (" + (email || "N/A") + ")");
      if (email) emails.push(email);
    }
  }
  
  if (rowsInfo.length === 0) {
    ui.alert("⚠️ No Data", "Selected rows appear to be empty.", ui.ButtonSet.OK);
    return;
  }
  
  var confirm = ui.alert(
    "🗑️ Delete " + rowsInfo.length + " Registrations?",
    "This will DELETE the following registrations:\n\n" +
    rowsInfo.slice(0, 10).join("\n") + 
    (rowsInfo.length > 10 ? "\n... and " + (rowsInfo.length - 10) + " more" : "") + "\n\n" +
    "⚠️ This action CANNOT be undone!",
    ui.ButtonSet.YES_NO
  );
  
  if (confirm !== ui.Button.YES) return;
  
  var typeConfirm = ui.prompt(
    "⚠️ Final Confirmation",
    "Type DELETE to confirm deletion of " + rowsInfo.length + " rows:",
    ui.ButtonSet.OK_CANCEL
  );
  
  if (typeConfirm.getSelectedButton() !== ui.Button.OK || 
      typeConfirm.getResponseText().toUpperCase() !== "DELETE") {
    ui.alert("Cancelled", "Deletion cancelled.", ui.ButtonSet.OK);
    return;
  }
  
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast("Deleting rows...", "🗑️", -1);
    
    var totalDeleted = 0;
    var totalFinance = 0;
    
    // Delete from bottom to top to preserve row numbers
    for (var r = endRow; r >= startRow; r--) {
      var email = sheet.getRange(r, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
      var genId = sheet.getRange(r, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue();
      
      if (email || genId) {
        var result = deleteRegistrationRow_(sheet, r, email, genId);
        totalDeleted++;
        totalFinance += result.financeDeleted;
      }
    }
    
    // Try to clear form responses for all emails
    var formCleared = 0;
    for (var i = 0; i < emails.length; i++) {
      if (deleteFormResponseByEmail_(emails[i])) {
        formCleared++;
      }
    }
    
    SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "✅", 3);
    
    ui.alert(
      "✅ Deleted Successfully",
      "Deleted " + totalDeleted + " registrations.\n" +
      "Finance entries deleted: " + totalFinance + "\n" +
      "Form responses cleared: " + formCleared + "/" + emails.length + "\n\n" +
      (formCleared === emails.length ? "✅ All emails can now re-register!" : "⚠️ Some may need manual form clearing."),
      ui.ButtonSet.OK
    );
    
  } catch (e) {
    ui.alert("❌ Error", "Failed to delete: " + e.message, ui.ButtonSet.OK);
  }
}

/**
 * Delete every data row (row 2 down) of a sheet.
 * Sheets refuses to delete ALL non-frozen rows, so one blank row is added first when the
 * data reaches the very last row of the sheet.
 */
function deleteAllDataRows_(sheet) {
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;
  if (sheet.getMaxRows() <= lastRow) sheet.insertRowAfter(sheet.getMaxRows());
  sheet.deleteRows(2, lastRow - 1);
  return lastRow - 1;
}

