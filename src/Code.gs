/**
 * Email Manager - Comprehensive email tracking, status checking, and resending
 */
var EmailManager = (function() {
  
  /**
   * Email type definitions with their tracking keys
   */
  var EMAIL_TYPES = {
    REGISTRATION: {
      name: "Registration Confirmation",
      description: "Sent when someone registers via the form",
      trackingKey: "REGCONF",
      icon: "📝"
    },
    PAID_RECEIPT: {
      name: "Acknowledgement Receipt (AR)",
      description: "Sent when payment is verified (Status = PAID)",
      trackingKey: "PAID",
      icon: "🧾"
    },
    REFERRAL_SUCCESS: {
      name: "Referral Success Notification",
      description: "Sent to referrer when their referral's payment is verified",
      trackingKey: "REFNOTIF_SUCCESS",
      icon: "🎉"
    },
    REFERRAL_REMOVED: {
      name: "Referral Removal Notification",
      description: "Sent to referrer when a referral is removed/reversed",
      trackingKey: "REFNOTIF_REMOVED",
      icon: "📤"
    }
  };
  
  /**
   * Email status categories
   */
  var STATUS = {
    SENT: "SENT",
    ERROR: "ERROR",
    FAILED: "FAILED",
    SKIPPED: "SKIPPED",
    PENDING: "PENDING",
    NOT_APPLICABLE: "N/A"
  };
  
  /**
   * Parse email status from a cell value
   */
  function parseEmailStatus_(cellValue) {
    if (!cellValue) return { status: STATUS.PENDING, timestamp: null, details: "" };
    
    var val = String(cellValue).trim();
    var upper = val.toUpperCase();
    var timestamp = null;
    
    // Extract timestamp if present (format: "STATUS: YYYY-MM-DD HH:MM:SS")
    var timestampMatch = val.match(/:\s*(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})/);
    if (timestampMatch) {
      timestamp = timestampMatch[1];
    }
    
    if (upper.indexOf("SENT") === 0) return { status: STATUS.SENT, timestamp: timestamp, details: val };
    if (upper.indexOf("ERROR") === 0) return { status: STATUS.ERROR, timestamp: timestamp, details: val };
    if (upper.indexOf("FAILED") === 0) return { status: STATUS.FAILED, timestamp: timestamp, details: val };
    if (upper.indexOf("SKIPPED") === 0) return { status: STATUS.SKIPPED, timestamp: timestamp, details: val };
    if (upper.indexOf("REVERSED") === 0) return { status: STATUS.PENDING, timestamp: timestamp, details: val };
    
    return { status: STATUS.PENDING, timestamp: null, details: val };
  }
  
  /**
   * Check if an email was sent using ReceiptGuard tracking
   */
  var propsSnapshot_ = null; // set only while getEmailStatusReport() is running

  function checkReceiptGuard_(genId, emailType) {
    var trackingKey = EMAIL_TYPES[emailType] ? EMAIL_TYPES[emailType].trackingKey : emailType;
    var key = "RECEIPT_HASH::" + trackingKey + "::" + genId;
    var metaKey = "RECEIPT_META::" + trackingKey + "::" + genId;
    
    // During a full report every tracking entry comes from one bulk read
    // (two property reads per participant per email type made the report very slow)
    var hash, metaStr;
    if (propsSnapshot_) {
      hash = propsSnapshot_[key];
      metaStr = propsSnapshot_[metaKey];
    } else {
      hash = PropertiesService.getScriptProperties().getProperty(key);
      metaStr = PropertiesService.getScriptProperties().getProperty(metaKey);
    }
    
    if (!hash) {
      return { tracked: false, sent: false };
    }
    
    var meta = {};
    try { meta = metaStr ? JSON.parse(metaStr) : {}; } catch (e) {}
    
    return {
      tracked: true,
      sent: true,
      hash: hash,
      sentAt: meta.sentAt || "Unknown",
      recipient: meta.recipient || "Unknown",
      count: meta.count   // referral notifications: how many referrals the last notice covered
    };
  }
  
  /**
   * Get comprehensive email status report for all participants
   */
  function getEmailStatusReport() {
    try {
      propsSnapshot_ = PropertiesService.getScriptProperties().getProperties();
      return buildEmailStatusReport_();
    } finally {
      propsSnapshot_ = null;
    }
  }

  function buildEmailStatusReport_() {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var regSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.REGISTRATION);
    var finSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.FINANCE);
    
    if (!regSheet) {
      return { success: false, error: "Registration sheet not found" };
    }
    
    var report = {
      success: true,
      timestamp: new Date(),
      summary: {
        total: 0,
        registration: { sent: 0, error: 0, failed: 0, skipped: 0, pending: 0 },
        paidReceipt: { sent: 0, error: 0, failed: 0, skipped: 0, pending: 0, notApplicable: 0 },
        referralNotif: { sent: 0, pending: 0 }
      },
      participants: [],
      issues: {
        registrationErrors: [],
        paidReceiptErrors: [],
        pendingPaidReceipts: []
      }
    };
    
    var regLastRow = regSheet.getLastRow();
    if (regLastRow < 2) {
      return report;
    }
    
    var sysRegCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regData = regSheet.getRange(2, 1, regLastRow - 1, regSheet.getLastColumn()).getValues();
    
    // Get finance data
    var financeByEmail = {};
    var finCols = null;
    if (finSheet) {
      finCols = ColumnManager.getFinanceCols(finSheet);
      var finLastRow = finSheet.getLastRow();
      if (finLastRow >= 2) {
        var finData = finSheet.getRange(2, 1, finLastRow - 1, finSheet.getLastColumn()).getValues();
        for (var f = 0; f < finData.length; f++) {
          var finEmail = Utils.normalizeEmail(finData[f][finCols.Email - 1]);
          if (finEmail) {
            financeByEmail[finEmail] = {
              row: f + 2,
              data: finData[f],
              status: Utils.normalizeStatusValue(finData[f][finCols.Status - 1]),
              emailSent: finData[f][finCols.EmailSent - 1] || ""
            };
          }
        }
      }
    }
    
    // Process each registration
    for (var i = 0; i < regData.length; i++) {
      var row = regData[i];
      var rowIndex = i + 2;
      
      var email = Utils.normalizeEmail(row[SYSTEM_CONFIG.COLS.REG.EMAIL - 1]);
      var name = row[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "";
      var genId = row[SYSTEM_CONFIG.COLS.REG.GEN_ID - 1] || "";
      var refCount = Number(row[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
      
      if (!email) continue;
      
      report.summary.total++;
      
      var participant = {
        row: rowIndex,
        email: email,
        name: name,
        genId: genId,
        refCount: refCount,
        registration: { status: STATUS.PENDING, details: "" },
        paidReceipt: { status: STATUS.NOT_APPLICABLE, details: "" },
        referralNotif: { status: STATUS.NOT_APPLICABLE, details: "" }
      };
      
      // === Check Registration Email Status ===
      var regGuard = checkReceiptGuard_(genId, "REGISTRATION");
      if (regGuard.sent) {
        participant.registration.status = STATUS.SENT;
        participant.registration.details = "Sent: " + regGuard.sentAt;
        report.summary.registration.sent++;
      } else if (genId) {
        // Has GenID but no tracking - check RECEIPT_SENT_AT column
        var receiptSentAtCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT];
        if (receiptSentAtCol) {
          var sentAtVal = row[receiptSentAtCol - 1];
          if (sentAtVal) {
            participant.registration.status = STATUS.SENT;
            participant.registration.details = "Sent: " + sentAtVal;
            report.summary.registration.sent++;
          } else {
            participant.registration.status = STATUS.PENDING;
            participant.registration.details = "Not tracked";
            report.summary.registration.pending++;
          }
        } else {
          report.summary.registration.pending++;
        }
      } else {
        report.summary.registration.pending++;
      }
      
      // === Check Acknowledgement Receipt (AR) Email Status ===
      var finInfo = financeByEmail[email];
      if (finInfo && finInfo.status === SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
        // Payment verified - check OR email
        var orGuard = checkReceiptGuard_(genId, "PAID_RECEIPT");
        var orCellStatus = parseEmailStatus_(finInfo.emailSent);
        
        if (orGuard.sent || orCellStatus.status === STATUS.SENT) {
          participant.paidReceipt.status = STATUS.SENT;
          participant.paidReceipt.details = orGuard.sent ? ("Sent: " + orGuard.sentAt) : orCellStatus.details;
          report.summary.paidReceipt.sent++;
        } else if (orCellStatus.status === STATUS.ERROR) {
          participant.paidReceipt.status = STATUS.ERROR;
          participant.paidReceipt.details = orCellStatus.details;
          report.summary.paidReceipt.error++;
          report.issues.paidReceiptErrors.push({
            row: rowIndex,
            email: email,
            name: name,
            genId: genId,
            details: orCellStatus.details
          });
        } else if (orCellStatus.status === STATUS.FAILED) {
          participant.paidReceipt.status = STATUS.FAILED;
          participant.paidReceipt.details = orCellStatus.details;
          report.summary.paidReceipt.failed++;
          report.issues.paidReceiptErrors.push({
            row: rowIndex,
            email: email,
            name: name,
            genId: genId,
            details: orCellStatus.details
          });
        } else if (orCellStatus.status === STATUS.SKIPPED) {
          participant.paidReceipt.status = STATUS.SKIPPED;
          participant.paidReceipt.details = orCellStatus.details;
          report.summary.paidReceipt.skipped++;
        } else {
          // PAID but no OR email sent
          participant.paidReceipt.status = STATUS.PENDING;
          participant.paidReceipt.details = "PAID but OR not sent";
          report.summary.paidReceipt.pending++;
          report.issues.pendingPaidReceipts.push({
            row: rowIndex,
            email: email,
            name: name,
            genId: genId,
            details: "Payment verified but OR email pending"
          });
        }
      } else {
        participant.paidReceipt.status = STATUS.NOT_APPLICABLE;
        participant.paidReceipt.details = finInfo ? "Status: " + finInfo.status : "Not in Finance";
        report.summary.paidReceipt.notApplicable++;
      }
      
      // === Check Referral Notification Status ===
      if (refCount > 0) {
        var refGuard = checkReceiptGuard_(genId, "REFERRAL_SUCCESS");
        // Notified, and that notice covered all the referrals they have now
        var refNotified = refGuard.sent &&
          !(refGuard.count !== undefined && refGuard.count !== null && Number(refGuard.count) < refCount);
        if (refNotified) {
          participant.referralNotif.status = STATUS.SENT;
          participant.referralNotif.details = "Has " + refCount + " referral(s), notified";
          report.summary.referralNotif.sent++;
        } else {
          participant.referralNotif.status = STATUS.PENDING;
          participant.referralNotif.details = "Has " + refCount + " referral(s), status unknown";
          report.summary.referralNotif.pending++;
        }
      }
      
      report.participants.push(participant);
    }
    
    return report;
  }
  
  /**
   * Get list of emails that need resending (errors, failed, pending OR)
   */
  function getEmailsNeedingResend() {
    var report = getEmailStatusReport();
    if (!report.success) return report;
    
    return {
      success: true,
      paidReceiptErrors: report.issues.paidReceiptErrors,
      pendingPaidReceipts: report.issues.pendingPaidReceipts,
      registrationErrors: report.issues.registrationErrors,
      totalIssues: report.issues.paidReceiptErrors.length + 
                   report.issues.pendingPaidReceipts.length + 
                   report.issues.registrationErrors.length
    };
  }
  
  /**
   * Resend Acknowledgement Receipt email for a specific participant
   */
  function resendPaidReceipt(email, forceSend) {
    forceSend = (forceSend !== false);
    
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    var finSheet = repo.getFinanceSheet();
    
    if (!regSheet || !finSheet) {
      return { success: false, error: "Required sheets not found" };
    }
    
    var regData = repo.getRegistrationByEmail(email);
    if (!regData) {
      return { success: false, error: "Registration not found for " + email };
    }
    
    var finCols = ColumnManager.getFinanceCols(finSheet);
    var finRowIndex = repo.findFinanceRowIndexByEmail(email, finCols);
    
    if (!finRowIndex) {
      return { success: false, error: "Finance record not found for " + email };
    }
    
    var finRow = finSheet.getRange(finRowIndex, 1, 1, finSheet.getLastColumn()).getValues()[0];
    var status = Utils.normalizeStatusValue(finRow[finCols.Status - 1]);
    
    if (status !== SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) {
      return { success: false, error: "Payment not verified for " + email + " (Status: " + status + ")" };
    }
    
    // Get paid date
    var paidAtVal = finRow[finCols.SysPaidAt - 1];
    var paidAtDate = Utils.parseMaybeDate(paidAtVal) || new Date();
    
    // Get discounts
    var sysRegCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regRowIndex = repo.findRegistrationRowIndexByEmail(email);
    var regRowData = regSheet.getRange(regRowIndex, 1, 1, regSheet.getLastColumn()).getValues()[0];
    
    var refDiscountCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED];
    var refDiscountApplied = refDiscountCol ? Number(regRowData[refDiscountCol - 1] || 0) : 0;
    
    var p = PricingEngine.calculate("", regData.competitions);
    
    // Actual coupon value from the Coupon Manager sheet (the lookup every feature shares)
    var couponDiscountValue = regData.couponCode ? getCouponValue_(regData.couponCode, repo.getCouponSheet()) : 0;
    
    var paidData = {
      name: regData.name,
      school: regData.school,
      payMode: regData.payMode,
      competitions: p.normalizedCompetitions || regData.competitions,
      genId: regData.genId,
      finalAmount: regData.finalAmount,
      couponCode: regData.couponCode,
      couponDiscount: couponDiscountValue,  // FIX: Actual coupon value
      referralDiscount: refDiscountApplied,
      cashback: regData.cashback,
      paidAt: paidAtDate
    };
    
    AuditLogService.info("EMAIL_RESEND_OR", "Attempting to resend OR to " + email + " (force=" + forceSend + ")");
    
    // If force send, clear tracking first
    if (forceSend && regData.genId) {
      clearEmailTracking(regData.genId, "PAID_RECEIPT");
    }
    
    var result = EmailService.sendPaidReceipt(email, regData.masterSubject, paidData, true, forceSend);
    
    // Update Email Sent column in Finance
    if (finCols.EmailSent) {
      var statusText = (result.skipped ? "SKIPPED" : (result.sent ? "SENT" : "ERROR")) + ": " + Utils.nowTzString();
      if (!result.sent && !result.skipped && result.reason) {
        statusText += " - " + result.reason;
      }
      finSheet.getRange(finRowIndex, finCols.EmailSent).setValue(statusText);
    }
    
    return {
      success: result.sent,
      skipped: result.skipped || false,
      reason: result.reason || "",
      email: email
    };
  }
  
  /**
   * Resend Registration Confirmation email
   */
  function resendRegistrationEmail(email, forceSend) {
    forceSend = (forceSend !== false);
    
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    
    if (!regSheet) {
      return { success: false, error: "Registration sheet not found" };
    }
    
    var regData = repo.getRegistrationByEmail(email);
    if (!regData) {
      return { success: false, error: "Registration not found for " + email };
    }
    
    var sysRegCols = ColumnManager.ensureSysColsOnRegistration(regSheet);
    var regRowIndex = repo.findRegistrationRowIndexByEmail(email);
    var regRowData = regSheet.getRange(regRowIndex, 1, 1, regSheet.getLastColumn()).getValues()[0];
    
    // Get pricing
    var compCount = regRowData[SYSTEM_CONFIG.COLS.REG.COMPETITION_COUNT - 1];
    var competitions = regRowData[SYSTEM_CONFIG.COLS.REG.COMPETITION - 1];
    var pricing = PricingEngine.calculate(compCount, competitions);
    
    // Get discounts
    var lockedCoupon = regRowData[SYSTEM_CONFIG.COLS.REG.LOCKED_COUPON - 1] || "";
    var couponDiscount = 0;
    if (lockedCoupon) {
      var couponSheet = repo.getCouponSheet();
      if (couponSheet) {
        var couponService = new CouponService(couponSheet);
        couponDiscount = couponService.getValueOnly(lockedCoupon);
      }
    }
    
    var refDiscountCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.REF_DISCOUNT_APPLIED];
    var refDiscount = refDiscountCol ? Number(regRowData[refDiscountCol - 1] || 0) : 0;
    
    var lockedRef = regRowData[SYSTEM_CONFIG.COLS.REG.LOCKED_REF - 1] || "";
    
    var emailData = {
      name: regData.name,
      genId: regData.genId,
      couponCode: lockedCoupon,
      finalAmount: regData.finalAmount,
      refCodeUsed: lockedRef
    };
    
    AuditLogService.info("EMAIL_RESEND_REG", "Attempting to resend registration email to " + email);
    
    // If force send, clear tracking first
    if (forceSend && regData.genId) {
      clearEmailTracking(regData.genId, "REGISTRATION");
    }
    
    var result = EmailService.sendRegistrationConfirmed(email, regData.masterSubject, emailData, pricing, couponDiscount, refDiscount);
    
    // Update tracking column
    if (result.sent) {
      var receiptSentAtCol = sysRegCols[SYSTEM_CONFIG.SYS_REG_HEADERS.RECEIPT_SENT_AT];
      if (receiptSentAtCol) {
        regSheet.getRange(regRowIndex, receiptSentAtCol).setValue(Utils.nowTzString());
      }
    }
    
    return {
      success: result.sent,
      skipped: result.skipped || false,
      reason: result.reason || "",
      email: email
    };
  }
  
  /**
   * Resend Referral Notification to a referrer
   */
  function resendReferralNotification(referrerGenId, forceSend) {
    forceSend = (forceSend !== false);
    
    var repo = new SheetRepository();
    var regSheet = repo.getRegistrationSheet();
    
    if (!regSheet) {
      return { success: false, error: "Registration sheet not found" };
    }
    
    var rowIndex = repo.findRegistrationRowIndexByGenId(referrerGenId);
    if (!rowIndex) {
      return { success: false, error: "Referrer not found: " + referrerGenId };
    }
    
    var rowData = regSheet.getRange(rowIndex, 1, 1, regSheet.getLastColumn()).getValues()[0];
    
    var referrerEmail = Utils.normalizeEmail(rowData[SYSTEM_CONFIG.COLS.REG.EMAIL - 1]);
    var referrerName = rowData[SYSTEM_CONFIG.COLS.REG.NAME - 1] || "";
    var refCount = Number(rowData[SYSTEM_CONFIG.COLS.REG.REF_COUNT - 1] || 0);
    var cashback = Number(rowData[SYSTEM_CONFIG.COLS.REG.CASHBACK - 1] || 0);
    var masterSubject = rowData[SYSTEM_CONFIG.COLS.REG.MASTER_SUBJECT - 1] || "";
    
    if (refCount === 0) {
      return { success: false, error: "Referrer has no referrals" };
    }
    
    // If force send, clear tracking first
    if (forceSend) {
      clearEmailTracking(referrerGenId, "REFERRAL_SUCCESS");
    }
    
    var notificationData = {
      referrerName: referrerName,
      referrerCode: referrerGenId,
      referredName: "Your referral(s)",
      referredGenId: "",
      newCount: refCount,
      newCashback: cashback,
      cashbackEarned: cashback
    };
    
    AuditLogService.info("EMAIL_RESEND_REF", "Attempting to resend referral notification to " + referrerEmail);
    
    var result = EmailService.sendReferralSuccessNotification(referrerEmail, notificationData);
    
    return {
      success: result.sent,
      skipped: result.skipped || false,
      reason: result.reason || "",
      email: referrerEmail
    };
  }
  
  /**
   * Bulk resend all failed/error/pending OR emails
   */
  function resendAllFailedEmails(emailType) {
    var resendList = getEmailsNeedingResend();
    if (!resendList.success) return resendList;
    
    var toResend = [];
    
    if (emailType === "PAID_RECEIPT" || emailType === "ALL") {
      toResend = toResend.concat(resendList.paidReceiptErrors);
      toResend = toResend.concat(resendList.pendingPaidReceipts);
    }
    
    if (toResend.length === 0) {
      return { success: true, message: "No emails need resending", results: { sent: 0, failed: 0, skipped: 0 } };
    }
    
    var results = {
      total: toResend.length,
      sent: 0,
      failed: 0,
      skipped: 0,
      details: []
    };
    
    for (var i = 0; i < toResend.length; i++) {
      var item = toResend[i];
      
      try {
        var result = resendPaidReceipt(item.email, true);
        
        if (result.success) {
          results.sent++;
          results.details.push({ email: item.email, status: "SENT" });
        } else if (result.skipped) {
          results.skipped++;
          results.details.push({ email: item.email, status: "SKIPPED", reason: result.reason });
        } else {
          results.failed++;
          results.details.push({ email: item.email, status: "FAILED", reason: result.error || result.reason });
        }
      } catch (e) {
        results.failed++;
        results.details.push({ email: item.email, status: "ERROR", reason: String(e) });
      }
      
      // Rate limiting delay
      if (i < toResend.length - 1) {
        pauseBetweenEmails_();
      }
    }
    
    AuditLogService.info("EMAIL_BULK_RESEND", 
      "Bulk resend complete: " + results.sent + " sent, " + results.skipped + " skipped, " + results.failed + " failed");
    
    return {
      success: true,
      results: results
    };
  }
  
  /**
   * Verify if an email was sent (check ReceiptGuard)
   */
  function verifyEmailSent(genId, emailType) {
    return checkReceiptGuard_(genId, emailType);
  }
  
  /**
   * Clear email tracking to allow resend
   */
  function clearEmailTracking(genId, emailType) {
    var trackingKey = EMAIL_TYPES[emailType] ? EMAIL_TYPES[emailType].trackingKey : emailType;
    var key = "RECEIPT_HASH::" + trackingKey + "::" + genId;
    var metaKey = "RECEIPT_META::" + trackingKey + "::" + genId;
    
    PropertiesService.getScriptProperties().deleteProperty(key);
    PropertiesService.getScriptProperties().deleteProperty(metaKey);
    
    AuditLogService.info("EMAIL_TRACKING_CLEARED", "Cleared tracking for " + genId + " type=" + emailType);
    
    return { success: true };
  }
  
  /**
   * Clear all email tracking for a participant
   */
  function clearAllEmailTracking(genId) {
    var types = ["REGCONF", "PAID", "REFNOTIF_SUCCESS", "REFNOTIF_REMOVED"];
    for (var i = 0; i < types.length; i++) {
      clearEmailTracking(genId, types[i]);
    }
    return { success: true };
  }
  
  return {
    EMAIL_TYPES: EMAIL_TYPES,
    STATUS: STATUS,
    getEmailStatusReport: getEmailStatusReport,
    getEmailsNeedingResend: getEmailsNeedingResend,
    resendPaidReceipt: resendPaidReceipt,
    resendRegistrationEmail: resendRegistrationEmail,
    resendReferralNotification: resendReferralNotification,
    resendAllFailedEmails: resendAllFailedEmails,
    verifyEmailSent: verifyEmailSent,
    clearEmailTracking: clearEmailTracking,
    clearAllEmailTracking: clearAllEmailTracking
  };
})();

// ============================================================================
// PART 19.1: EMAIL MANAGEMENT UI FUNCTIONS
// ============================================================================

/**
 * Show Email Status Dashboard - Main overview of all email statuses
 */
function showEmailDashboard() {
  var ui = SpreadsheetApp.getUi();
  SpreadsheetApp.getActiveSpreadsheet().toast("Reading the email status of every participant...", "📧 Email Status", 5);

  var report = EmailManager.getEmailStatusReport();

  if (!report.success) {
    ui.alert("❌ Error", report.error, ui.ButtonSet.OK);
    return;
  }

  var esc = Utils.escapeHtml;
  var s = report.summary;
  var issues = report.issues || {};
  var receiptErrors = issues.paidReceiptErrors || [];
  var pendingReceipts = issues.pendingPaidReceipts || [];
  var issueCount = receiptErrors.length + pendingReceipts.length;

  function typeCard(title, stats) {
    return uiCard_(title, '<div class="ui-grid" style="grid-template-columns:repeat(auto-fit,minmax(92px,1fr));">' + stats.join('') + '</div>');
  }
  function peopleTable(list) {
    var rows = list.slice(0, 15).map(function (p) {
      return [esc("Row " + p.row), '<b>' + esc(p.name || "") + '</b>', esc(p.email || "")];
    });
    var more = list.length > 15 ? '<div class="ui-hint">and ' + (list.length - 15) + ' more</div>' : '';
    return uiTable_(["Where", "Name", "Email"], rows) + more;
  }

  var body = '';
  body += issueCount === 0
    ? uiCallout_("ok", "&#x2705;", "<b>Nothing needs attention.</b> Every " + esc(SYSTEM_CONFIG.ADMIN.TRIGGER_WORD) + " participant has their receipt.")
    : uiCallout_("warn", "&#x26A0;&#xFE0F;", "<b>" + issueCount + " receipt" + (issueCount === 1 ? "" : "s") + " need attention.</b> They are listed below with the tools that fix them.");

  body += typeCard("Registration Received", [
    uiStat_(s.registration.sent, "Sent", "ok"),
    uiStat_(s.registration.error, "Error", "bad"),
    uiStat_(s.registration.failed, "Failed", "bad"),
    uiStat_(s.registration.skipped, "Skipped", "warn"),
    uiStat_(s.registration.pending, "Pending / unknown", "warn")
  ]);
  body += typeCard("Acknowledgement Receipt", [
    uiStat_(s.paidReceipt.sent, "Sent", "ok"),
    uiStat_(s.paidReceipt.error, "Error", "bad"),
    uiStat_(s.paidReceipt.failed, "Failed", "bad"),
    uiStat_(s.paidReceipt.skipped, "Skipped", "warn"),
    uiStat_(s.paidReceipt.pending, "Paid, not sent", "warn"),
    uiStat_(s.paidReceipt.notApplicable, "Not paid yet", "")
  ]);
  body += typeCard("Referral notifications", [
    uiStat_(s.referralNotif.sent, "Sent", "ok"),
    uiStat_(s.referralNotif.pending, "Pending / unknown", "warn")
  ]);

  if (receiptErrors.length) {
    body += uiCard_("Receipts that failed", peopleTable(receiptErrors) +
      '<div class="ui-hint">Fix the cause (usually a mistyped address), then run ' + esc(getMenuPathText_("resendAllFailedEmails")) + '.</div>', String(receiptErrors.length));
  }
  if (pendingReceipts.length) {
    body += uiCard_(SYSTEM_CONFIG.ADMIN.TRIGGER_WORD + " but no receipt sent", peopleTable(pendingReceipts) +
      '<div class="ui-hint">Send them with ' + esc(getMenuPathText_("resendAllPendingOREmails")) + ', or one at a time with ' + esc(getMenuPathText_("resendSelectedRowEmailMenu")) + '.</div>', String(pendingReceipts.length));
  }

  var html = HtmlService.createHtmlOutput(withGuideLink_(buildAdminDialog_({
      icon: "&#x1F4E7;",
      title: "Email status",
      subtitle: s.total + " participant" + (s.total === 1 ? "" : "s") + " · read at " + Utils.nowTzString(),
      actions: '<button class="ui-btn" onclick="google.script.host.close()">Close</button>',
      body: body
    }), "email"))
    .setWidth(680)
    .setHeight(640)
    .setTitle("Email Dashboard");

  ui.showModalDialog(html, "📧 Email Status Dashboard");

  AuditLogService.info("EMAIL_DASHBOARD_VIEWED", "Dashboard viewed. Issues: " + issueCount);
}

/**
 * Resend all failed/error/pending OR emails
 */
function resendAllFailedEmails() {
  var ui = SpreadsheetApp.getUi();
  
  var resendList = EmailManager.getEmailsNeedingResend();
  
  if (!resendList.success) {
    ui.alert("❌ Error", resendList.error, ui.ButtonSet.OK);
    return;
  }
  
  var totalIssues = resendList.totalIssues;
  var orErrors = resendList.paidReceiptErrors.length;
  var orPending = resendList.pendingPaidReceipts.length;
  
  if (totalIssues === 0) {
    ui.alert("✅ All Clear!", 
      "No emails need to be resent.\n\n" +
      "All Acknowledgement Receipts for PAID participants have been sent successfully!",
      ui.ButtonSet.OK);
    return;
  }
  
  var message = "Found " + totalIssues + " email(s) that need attention:\n\n";
  message += "🧾 Acknowledgement Receipt (AR):\n";
  message += "   • " + orErrors + " with errors/failures\n";
  message += "   • " + orPending + " pending (PAID but not sent)\n\n";
  
  if (orErrors > 0) {
    message += "Error emails:\n";
    for (var i = 0; i < Math.min(orErrors, 3); i++) {
      var item = resendList.paidReceiptErrors[i];
      message += "• " + item.name + " (" + item.email + ")\n";
    }
    if (orErrors > 3) message += "... and " + (orErrors - 3) + " more\n";
    message += "\n";
  }
  
  message += "Do you want to resend ALL failed/pending OR emails?\n";
  message += "(This will clear tracking and force resend)";
  
  var confirm = ui.alert("📧 Resend Failed Emails", message, ui.ButtonSet.YES_NO);
  
  if (confirm !== ui.Button.YES) {
    return;
  }
  
  // Show processing message
  SpreadsheetApp.getActiveSpreadsheet().toast("Resending " + totalIssues + " emails... Please wait.", "📧 Processing", -1);
  
  var results = EmailManager.resendAllFailedEmails("PAID_RECEIPT");
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Complete!", "📧 Done", 3);
  
  if (!results.success) {
    ui.alert("❌ Error", results.error || "Unknown error occurred", ui.ButtonSet.OK);
    return;
  }
  
  var r = results.results;
  var resultMsg = "═══════════════════════════════════\n";
  resultMsg += "📧 RESEND COMPLETE\n";
  resultMsg += "═══════════════════════════════════\n\n";
  resultMsg += "Total Processed: " + r.total + "\n";
  resultMsg += "✅ Successfully Sent: " + r.sent + "\n";
  resultMsg += "⏭️ Skipped (duplicate): " + r.skipped + "\n";
  resultMsg += "❌ Failed: " + r.failed + "\n";
  
  if (r.failed > 0) {
    resultMsg += "\nFailed emails:\n";
    for (var j = 0; j < r.details.length; j++) {
      var detail = r.details[j];
      if (detail.status === "FAILED" || detail.status === "ERROR") {
        resultMsg += "• " + detail.email + ": " + (detail.reason || "Unknown error") + "\n";
      }
    }
  }
  
  ui.alert("📧 Resend Results", resultMsg, ui.ButtonSet.OK);
}

/**
 * Resend email for currently selected row
 */
function resendSelectedRowEmail() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var row = SpreadsheetApp.getActiveRange().getRow();
  
  if (row < 2) {
    ui.alert("⚠️ Invalid Selection", "Please select a data row (not the header).", ui.ButtonSet.OK);
    return;
  }
  
  var sheetName = sheet.getName();
  var email = "";
  var genId = "";
  var name = "";
  
  if (sheetName === SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    email = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
    genId = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue();
    name = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.NAME).getValue();
  } else if (sheetName === SYSTEM_CONFIG.SHEETS.FINANCE) {
    var finCols = ColumnManager.getFinanceCols(sheet);
    email = sheet.getRange(row, finCols.Email).getValue();
    genId = sheet.getRange(row, finCols.GenId).getValue();
    name = sheet.getRange(row, finCols.Name).getValue();
  } else {
    ui.alert("⚠️ Wrong Sheet", 
      "Please select a row in:\n• " + SYSTEM_CONFIG.SHEETS.REGISTRATION + "\n• " + SYSTEM_CONFIG.SHEETS.FINANCE,
      ui.ButtonSet.OK);
    return;
  }
  
  email = Utils.normalizeEmail(email);
  
  if (!email) {
    ui.alert("⚠️ No Email", "Could not find email in selected row.", ui.ButtonSet.OK);
    return;
  }
  
  var choice = ui.alert("📧 Select Email Type for: " + name,
    "Email: " + email + "\nGen ID: " + genId + "\n\n" +
    "Which email do you want to resend?\n\n" +
    "• YES = Acknowledgement Receipt (AR)\n" +
    "• NO = Registration Confirmation\n" +
    "• CANCEL = Cancel",
    ui.ButtonSet.YES_NO_CANCEL);
  
  if (choice === ui.Button.CANCEL) return;
  
  // Confirm force send
  var forceConfirm = ui.alert("⚠️ Force Resend",
    "This will clear email tracking and send the email even if it was already sent.\n\n" +
    "This may result in duplicate emails. Continue?",
    ui.ButtonSet.YES_NO);
  
  if (forceConfirm !== ui.Button.YES) return;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending email to " + email + "...", "📧 Processing", -1);
  
  var result;
  if (choice === ui.Button.YES) {
    result = EmailManager.resendPaidReceipt(email, true);
  } else {
    result = EmailManager.resendRegistrationEmail(email, true);
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "📧", 3);
  
  if (result.success) {
    ui.alert("✅ Email Sent", 
      "Email successfully sent to:\n" + email,
      ui.ButtonSet.OK);
  } else if (result.skipped) {
    ui.alert("⏭️ Email Skipped", 
      "Email was skipped.\n\nReason: " + (result.reason || "Duplicate prevention"),
      ui.ButtonSet.OK);
  } else {
    ui.alert("❌ Email Failed", 
      "Failed to send email to " + email + "\n\nError: " + (result.error || result.reason || "Unknown error"),
      ui.ButtonSet.OK);
  }
}

