/** Opens the Premium Analytics Dashboard */
function AdminDashboard_showAnalytics() {
  var data = AdminDashboard_getAnalyticsData();
  if (data.error) { SpreadsheetApp.getUi().alert("Error: " + data.error); return; }
  var dj = JSON.stringify(data);
  var css = dashboardUltimateCss_();
  var js = dashboardUltimateJs_();
  var mapSvg = dashboardPhMapSvg_();

  var compEntries = Object.keys(data.competitions).map(function(k) { return { name: k, count: data.competitions[k] }; });
  compEntries.sort(function(a,b) { return b.count - a.count; });
  var regionEntries = Object.keys(data.regionMap).map(function(k) { return { name: k, count: data.regionMap[k] }; });
  regionEntries.sort(function(a,b) { return b.count - a.count; });
  var gradeEntries = Object.keys(data.gradeMap).map(function(k) { return { name: k, count: data.gradeMap[k] }; });
  gradeEntries.sort(function(a,b) { return b.count - a.count; });
  var sexEntries = Object.keys(data.sexMap).map(function(k) { return { name: k, count: data.sexMap[k] }; });
  var ageEntries = Object.keys(data.ageMap).map(function(k) { return { name: k, count: data.ageMap[k] }; });

  var h = [];
  h.push('<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">');
  h.push('<title>Analytics Dashboard</title>');
  h.push('<style>' + css + '</style>');
  h.push('</head><body>');
  // Animated BG orbs
  h.push('<div class="bg-orbs"><span></span><span></span><span></span></div>');

  // Header
  h.push('<div class="dash-header">');
  h.push('<h1>&#x1F4CA; Analytics Command Center</h1>');
  h.push('<div class="header-right">');
  h.push('<select class="date-select" onchange="DASH.applyDateFilter(this.value)">');
  h.push('<option value="all">All Time</option><option value="7">Last 7 Days</option>');
  h.push('<option value="15">Last 15 Days</option><option value="30">Last 30 Days</option>');
  h.push('<option value="90">Last 90 Days</option><option value="custom">Custom Range</option></select>');
  h.push('<div id="customDateRange"><input type="date" id="dateStart"><span style="color:var(--text3)">to</span>');
