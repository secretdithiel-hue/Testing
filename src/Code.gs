/**
 * Get submission dashboard data for the HTML UI.
 */
function getSubmissionDashboardData() {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) return { error: "Submission Form sheet not found", submissions: [], stats: {} };

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) return { error: null, submissions: [], stats: { total: 0, processed: 0, pending: 0, flagged: 0, errors: 0 } };

  var width = subSheet.getLastColumn();
  var allData = subSheet.getRange(2, 1, lastRow - 1, width).getValues();
  var S = SYSTEM_CONFIG.COLS.SUB;
  var submissions = [];
  var stats = { total: 0, processed: 0, pending: 0, flagged: 0, errors: 0 };

  for (var i = 0; i < allData.length; i++) {
    var r = allData[i];
    var rowIndex = i + 2;
    var email = String(r[S.EMAIL - 1] || "").trim();
    var rawCompType = getSubmissionCompetitionTypes_(r).join(", ");
    var partNum = sysCols["SYS_PARTICIPANT_NUM"] ? String(r[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
    var status = sysCols["SYS_SUB_STATUS"] ? String(r[sysCols["SYS_SUB_STATUS"] - 1] || "").trim() : "";
    var deperson = sysCols["SYS_DEPERSONALIZED"] ? String(r[sysCols["SYS_DEPERSONALIZED"] - 1] || "").trim() : "";
    var genId = sysCols["SYS_MATCHED_GEN_ID"] ? String(r[sysCols["SYS_MATCHED_GEN_ID"] - 1] || "").trim() : "";
    var confSent = sysCols["SYS_CONFIRMATION_SENT"] ? String(r[sysCols["SYS_CONFIRMATION_SENT"] - 1] || "").trim() : "";
    var timestamp = String(r[S.TIMESTAMP - 1] || "");

    // Parse multiple competitions from column E
    var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
    var compDisplay = compTypes.length > 0 ? compTypes[0] : rawCompType;
    if (compTypes.length > 1) compDisplay += " (+" + (compTypes.length - 1) + ")";

    // Get participant name from the first recognized competition column
    var participantName = "";
    for (var ci = 0; ci < compTypes.length; ci++) {
      var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compTypes[ci]];
      if (compMap && compMap.nameCol) {
        var nc = S[compMap.nameCol];
        if (nc) {
          participantName = String(r[nc - 1] || "").trim();
          if (participantName) break;
        }
      }
    }

    stats.total++;
    if (status === "PROCESSED") stats.processed++;
    else if (status === "PENDING") stats.pending++;
    else if (status === "FLAGGED") stats.flagged++;
    else if (status === "ERROR") stats.errors++;
    else stats.pending++;

    submissions.push({
      row: rowIndex,
      email: email,
      name: participantName,
      competition: compDisplay,
      competitionCount: compTypes.length,
      participantNum: partNum,
      status: status || "UNPROCESSED",
      depersonalized: deperson,
      genId: genId,
      confirmationSent: confSent,
      timestamp: timestamp,
      flagReason: sysCols["SYS_FLAG_REASON"] ? String(r[sysCols["SYS_FLAG_REASON"] - 1] || "").trim() : "",
      flagDate: sysCols["SYS_FLAG_DATE"] ? String(r[sysCols["SYS_FLAG_DATE"] - 1] || "").trim() : ""
    });
  }

  return { error: null, submissions: submissions, stats: stats };
}

/**
 * Reprocess all pending/unprocessed/error submissions.
 */
function reprocessAllPendingSubmissions() {
  var ui = SpreadsheetApp.getUi();
  var confirm = ui.alert("Reprocess All Pending", "This will reprocess all submissions with status PENDING, UNPROCESSED, or ERROR. Continue?", ui.ButtonSet.YES_NO);
  if (confirm !== ui.Button.YES) return;

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) { ui.alert("❌ Submission Form sheet not found."); return; }

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) { ui.alert("No submissions found."); return; }

  var statusCol = sysCols["SYS_SUB_STATUS"];
  var numCol = sysCols["SYS_PARTICIPANT_NUM"];
  var processed = 0;
  var errors = 0;

  for (var row = 2; row <= lastRow; row++) {
    var currentStatus = statusCol ? String(subSheet.getRange(row, statusCol).getValue() || "").trim() : "";
    var currentNum = numCol ? String(subSheet.getRange(row, numCol).getValue() || "").trim() : "";
    if (currentStatus === "PROCESSED" || currentStatus === "FLAGGED") continue;
    if (currentNum && currentStatus === "PROCESSED") continue;

    try {
      var result = DepersonalizationService.reprocessSubmission(subSheet, sysCols, row, repo);
      if (result.success) processed++;
      else errors++;
    } catch (e) {
      AuditLogService.error("REPROCESS_ERR", "Row " + row + ": " + e);
      errors++;
    }
  }

  ui.alert("✅ Reprocessing Complete", "Processed: " + processed + "\nErrors: " + errors, ui.ButtonSet.OK);
}

/**
 * Reprocess the currently selected row on the Submissions sheet.
 */
function reprocessSelectedSubmission() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row (not the header)."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var result = DepersonalizationService.reprocessSubmission(subSheet, sysCols, row, repo);

  if (result.success) {
    clearNotProcessedNotes_(subSheet.getRange(row, 1));
    ui.alert("✅ Row " + row + " reprocessed successfully.\n\nParticipant Number: " + result.participantNum + "\nStatus: " + result.status);
  } else {
    ui.alert("❌ Reprocessing failed: " + (result.error || "Unknown error"));
  }
}

/**
 * Resend submission confirmation email for the selected row.
 */
function resendSubmissionConfirmation() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  var S = SYSTEM_CONFIG.COLS.SUB;
  var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var partNumRaw = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var genId = sysCols["SYS_MATCHED_GEN_ID"] ? String(rowVals[sysCols["SYS_MATCHED_GEN_ID"] - 1] || "").trim() : "";

  if (!partNumRaw) { ui.alert("❌ No participant number assigned. Please reprocess this row first."); return; }

  // Parse multiple competition types and participant numbers
  var competitionTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var participantNums = partNumRaw.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });

  // Build a prefix-to-participantNum map for matching
  var numByPrefix = {};
  for (var pi = 0; pi < participantNums.length; pi++) {
    var pParts = participantNums[pi].split("-");
    if (pParts.length >= 1) numByPrefix[pParts[0]] = participantNums[pi];
  }

  var emailsSent = 0;
  var errors = [];

  try {
    // Build email previews for ALL competitions BEFORE showing or sending anything
    var previews = []; // { partNum, subject, htmlBody, compType }
    for (var ci = 0; ci < competitionTypes.length; ci++) {
      var compType = competitionTypes[ci].trim();
      var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compType];
      if (!compMap) {
        var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
        for (var k = 0; k < keys.length; k++) {
          if (keys[k].toUpperCase() === compType.toUpperCase()) { compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]]; compType = keys[k]; break; }
        }
      }
      if (!compMap) { errors.push("Unknown: " + compType); continue; }
      var partNum = pickParticipantNumFor_(compMap.key, participantNums, competitionTypes.length);
      if (!partNum) { errors.push("No number for: " + compType); continue; }
      var participantName = "";
      if (compMap.nameCol) { var nc = S[compMap.nameCol]; if (nc) participantName = String(rowVals[nc - 1] || "").trim(); }
      var result = {
        participantNum: partNum, competitionType: compType, matchedGenId: genId,
        participantName: participantName, email: email, status: "PROCESSED",
        piiResult: { flagged: false, matches: [] }, fileCount: 0
      };
      previews.push({
        partNum: partNum,
        subject: SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + partNum + "]",
        htmlBody: buildSubmissionConfirmationHtml_(result),
        compType: compType
      });
    }

    if (previews.length === 0) {
      ui.alert("No emails to send." + (errors.length ? "\nErrors: " + errors.join(", ") : ""));
      return;
    }

    // Build tab-strip for multi-competition rows; single-comp shows inline subject
    var tabStrip = "";
    var tabPanels = "";
    for (var tp = 0; tp < previews.length; tp++) {
      var isAct = tp === 0;
      tabStrip += "<button class='etab' onclick='showTab(" + tp + ")' style='background:" + (isAct ? "#1d4ed8" : "#334155") + ";color:" + (isAct ? "#fff" : "#94a3b8") + ";'>" + previews[tp].partNum + "</button>";
      tabPanels += "<div id='epanel-" + tp + "' style='display:" + (isAct ? "block" : "none") + ";'><iframe srcdoc='" + previews[tp].htmlBody.replace(/'/g, "&#39;") + "' style='width:100%;height:370px;border:none;background:#ffffff;'><\/iframe><\/div>";
    }
    var compSummary = previews.length === 1
      ? "<div class='lbl' style='margin-top:6px;'>Subject<\/div><div class='val' style='font-size:12px;color:#8b949e;'>" + previews[0].subject + "<\/div>"
      : "<div class='lbl' style='margin-top:6px;'>Competitions<\/div><div class='val' style='font-size:12px;color:#8b949e;'>" + previews.map(function(p){return p.partNum+" ("+p.compType+")";}).join(" | ") + "<\/div>";

    var dlgHtml = "<!DOCTYPE html><html><head><meta charset='UTF-8'><style>" +
      "body{margin:0;font-family:'Google Sans',Arial,sans-serif;background:#0d1117;color:#e6edf3;}" +
      ".header{padding:14px 18px;background:#161b22;border-bottom:1px solid rgba(255,255,255,0.08);}" +
      ".lbl{font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.8px;margin-bottom:2px;}" +
      ".val{font-size:13px;color:#e6edf3;}" +
      ".tabs{display:flex;gap:6px;padding:10px 16px 0;}" +
      ".etab{padding:5px 12px;border:none;border-radius:6px 6px 0 0;cursor:pointer;font-size:12px;font-weight:600;}" +
      ".preview-box{padding:0 16px 10px;}" +
      ".footer{padding:12px 16px;background:#161b22;border-top:1px solid rgba(255,255,255,0.08);display:flex;justify-content:space-between;align-items:center;}" +
      ".btn{padding:8px 18px;border:none;border-radius:7px;cursor:pointer;font-size:13px;font-weight:600;}" +
      "<\/style><\/head><body>" +
      "<div class='header'><div class='lbl'>To<\/div><div class='val'>" + email + "<\/div>" + compSummary + "<\/div>" +
      (previews.length > 1 ? "<div class='tabs'>" + tabStrip + "<\/div>" : "") +
      "<div class='preview-box' style='margin-top:8px;'>" + tabPanels + "<\/div>" +
      "<div class='footer'><span style='font-size:11px;color:#8b949e;'>" + previews.length + " email(s) will be sent<\/span>" +
      "<div style='display:flex;gap:8px;'>" +
      "<button class='btn' style='background:#21262d;color:#e6edf3;' onclick='google.script.host.close()'>&#10005; Cancel<\/button>" +
      "<button class='btn' id='sendBtn' style='background:linear-gradient(135deg,#1f6feb,#1f6feb);color:#fff;' onclick='doSend()'>\u2709\ufe0f Confirm &amp; Send<\/button>" +
      "<\/div><\/div>" +
      "<script>function showTab(i){document.querySelectorAll('[id^=epanel-]').forEach(function(el){el.style.display='none';});document.getElementById('epanel-'+i).style.display='block';document.querySelectorAll('.etab').forEach(function(b,idx){b.style.background=idx===i?'#1d4ed8':'#334155';b.style.color=idx===i?'#fff':'#94a3b8';});}" +
      "function doSend(){var b=document.getElementById('sendBtn');b.disabled=true;b.textContent='Sending...';google.script.run.withSuccessHandler(function(){google.script.host.close();}).withFailureHandler(function(e){b.disabled=false;b.textContent='\u2709\ufe0f Confirm & Send';alert('Failed: '+e.message);}).confirmAndSendSubmissionEmail(" + row + ");}" +
      "<\/script><\/body><\/html>";

    SpreadsheetApp.getUi().showModalDialog(
      HtmlService.createHtmlOutput(withGuideLink_(dlgHtml, "submit")).setWidth(760).setHeight(530),
      "\uD83D\uDCE7 Email Preview — " + email + " (Row " + row + ")"
    );
  } catch (e) {
    ui.alert("\u274C Error building email preview: " + e);
  }
}

/**
 * Called from the email preview modal (both menu resend and dashboard resend flows).
 * Actually sends the submission acknowledgement email(s) for the given row after admin confirmation.
 * @param {number} rowIndex - 1-based row index in Submission Form
 */
function confirmAndSendSubmissionEmail(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width   = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;
  var email     = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  if (!email) throw new Error("No email for row " + rowIndex);
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var partNumRaw  = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var genId       = sysCols["SYS_MATCHED_GEN_ID"]  ? String(rowVals[sysCols["SYS_MATCHED_GEN_ID"]  - 1] || "").trim() : "";
  if (!partNumRaw) throw new Error("No participant number on row " + rowIndex + ". Reprocess first.");
  var competitionTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  var participantNums  = partNumRaw.split(/\s*,\s*/).filter(function(p)  { return p.length > 0; });
  var numByPrefix = {};
  for (var pi = 0; pi < participantNums.length; pi++) {
    var pp = participantNums[pi].split("-");
    if (pp.length >= 1) numByPrefix[pp[0]] = participantNums[pi];
  }
  var inlineImages;
  try { inlineImages = LogoService.getInlineImages(); } catch(e) { inlineImages = {}; }
  var emailsSent = 0;
  for (var ci = 0; ci < competitionTypes.length; ci++) {
    var compType = competitionTypes[ci].trim();
    var compMap  = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compType];
    if (!compMap) {
      var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
      for (var k = 0; k < keys.length; k++) {
        if (keys[k].toUpperCase() === compType.toUpperCase()) { compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]]; compType = keys[k]; break; }
      }
    }
    if (!compMap) continue;
    var partNum = pickParticipantNumFor_(compMap.key, participantNums, competitionTypes.length);
    if (!partNum) continue;
    var participantName = "";
    if (compMap.nameCol) { var nc = S[compMap.nameCol]; if (nc) participantName = String(rowVals[nc - 1] || "").trim(); }
    var result = {
      participantNum: partNum, competitionType: compType, matchedGenId: genId,
      participantName: participantName, email: email, status: "PROCESSED",
      piiResult: { flagged: false, matches: [] }, fileCount: 0
    };
    var emailSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + partNum + "]";
    MailApp.sendEmail({ to: email, subject: emailSubject, htmlBody: buildSubmissionConfirmationHtml_(result),
      inlineImages: inlineImages, name: SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME });
    emailsSent++;
    if (ci < competitionTypes.length - 1) pauseBetweenEmails_();
  }
  if (sysCols["SYS_CONFIRMATION_SENT"] && emailsSent > 0) {
    subSheet.getRange(rowIndex, sysCols["SYS_CONFIRMATION_SENT"]).setValue("YES");
  }
  AuditLogService.info("CONFIRM_SEND", "Row " + rowIndex + ": sent " + emailsSent + " email(s) to " + email + " after preview confirmation");
  return { success: true, count: emailsSent };
}

/**
 * Bulk resend submission confirmation emails for all rows where
 * SYS_CONFIRMATION_SENT is not "YES" (blank, error, or otherwise).
 */
function resendAllPendingSubmissionConfirmations() {
  var ui = SpreadsheetApp.getUi();
  var confirm = ui.alert(
    "📨 Resend All Unsent Confirmations",
    "This will resend the Submission Acknowledgement email to all participants " +
    "where the confirmation has NOT yet been sent (SYS_CONFIRMATION_SENT is blank).\n\n" +
    "Rows already marked YES will be skipped.\n\nContinue?",
    ui.ButtonSet.YES_NO
  );
  if (confirm !== ui.Button.YES) return;

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) { ui.alert("❌ Submission Form sheet not found."); return; }

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) { ui.alert("No submissions found."); return; }

  var confCol = sysCols["SYS_CONFIRMATION_SENT"];
  var numCol  = sysCols["SYS_PARTICIPANT_NUM"];
  var S = SYSTEM_CONFIG.COLS.SUB;
  var width = subSheet.getLastColumn();
  var allData = subSheet.getRange(2, 1, lastRow - 1, width).getValues();

  var sent = 0, skipped = 0, errors = 0;
  var inlineImages;
  try { inlineImages = LogoService.getInlineImages(); } catch (e) { inlineImages = {}; }

  for (var i = 0; i < allData.length; i++) {
    var row = i + 2;
    var rowVals = allData[i];

    // Skip if already confirmed
    var confVal = confCol ? String(rowVals[confCol - 1] || "").trim() : "";
    if (confVal === "YES") { skipped++; continue; }

    // Skip if no participant number (not yet processed)
    var partNumRaw = numCol ? String(rowVals[numCol - 1] || "").trim() : "";
    if (!partNumRaw) { skipped++; continue; }

    var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
    if (!email) { skipped++; continue; }

    var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
    var genId = sysCols["SYS_MATCHED_GEN_ID"] ? String(rowVals[sysCols["SYS_MATCHED_GEN_ID"] - 1] || "").trim() : "";

    var competitionTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
    var participantNums  = partNumRaw.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });

    var numByPrefix = {};
    for (var pi = 0; pi < participantNums.length; pi++) {
      var pParts = participantNums[pi].split("-");
      if (pParts.length >= 1) numByPrefix[pParts[0]] = participantNums[pi];
    }

    var emailsSentForRow = 0;
    try {
      for (var ci = 0; ci < competitionTypes.length; ci++) {
        var compType = competitionTypes[ci].trim();
        var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compType];
        if (!compMap) {
          var keys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
          for (var k = 0; k < keys.length; k++) {
            if (keys[k].toUpperCase() === compType.toUpperCase()) {
              compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[keys[k]];
              compType = keys[k];
              break;
            }
          }
        }
        if (!compMap) continue;

        var partNum = pickParticipantNumFor_(compMap.key, participantNums, competitionTypes.length);
        if (!partNum) continue;

        var participantName = "";
        if (compMap.nameCol) {
          var nc = S[compMap.nameCol];
          if (nc) participantName = String(rowVals[nc - 1] || "").trim();
        }

        var result = {
          participantNum: partNum,
          competitionType: compType,
          matchedGenId: genId,
          participantName: participantName,
          email: email,
          status: "PROCESSED",
          piiResult: { flagged: false, matches: [] },
          fileCount: 0
        };

        var emailSubject = SYSTEM_CONFIG.META.NAME + ": Submission Acknowledgement [" + partNum + "]";
        var emailHtml = buildSubmissionConfirmationHtml_(result);
        MailApp.sendEmail({
          to: email,
          subject: emailSubject,
          htmlBody: emailHtml,
          inlineImages: inlineImages,
          name: SYSTEM_CONFIG.ADMIN.EMAIL_SENDER_NAME
        });
        emailsSentForRow++;
        if (ci < competitionTypes.length - 1) Utilities.sleep(1000);
      }

      if (emailsSentForRow > 0) {
        if (confCol) subSheet.getRange(row, confCol).setValue("YES");
        sent++;
        AuditLogService.info("BULK_SUB_CONFIRM", "Row " + row + ": sent " + emailsSentForRow + " confirmations to " + email);
      } else {
        skipped++;
      }
    } catch (e) {
      AuditLogService.error("BULK_SUB_CONFIRM_ERR", "Row " + row + ": " + e);
      errors++;
    }

    // Rate limiting between participants
    if (i < allData.length - 1) pauseBetweenEmails_();
  }

  ui.alert(
    "✅ Bulk Resend Complete",
    "Emails sent: " + sent + "\n" +
    "Skipped (already sent or no participant number): " + skipped + "\n" +
    "Errors: " + errors,
    ui.ButtonSet.OK
  );
}

/**
 * Scans Submission Form for duplicate participant numbers (caused by the
 * comma-split regex bug) and repairs them:
 *   1. Find duplicates — any prefix-number appearing in 2+ rows
 *   2. Keep original on the earlier row; reassign a new unique number to later rows
 *   3. Rename corresponding Google Drive anon files to match the new number
 *   4. Update SYS_PARTICIPANT_NUM in the sheet
 *   5. Optionally resend the confirmation email to affected participants
 */
function fixDuplicateParticipantNumbers() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // ── Find Submission Form ───────────────────────────────────────────────
  var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  if (!subSheet) { ui.alert("❌ Submission Form sheet not found."); return; }

  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) { ui.alert("No submissions found."); return; }

  // ── Find SYS_PARTICIPANT_NUM column by scanning header row ──────────────
  var headerVals = subSheet.getRange(1, 1, 1, subSheet.getLastColumn()).getValues()[0];
  var numColIdx  = -1;
  for (var h = 0; h < headerVals.length; h++) {
    if (String(headerVals[h]).trim() === "SYS_PARTICIPANT_NUM") { numColIdx = h; break; }
  }
  if (numColIdx === -1) { ui.alert("❌ SYS_PARTICIPANT_NUM column header not found.\nRun System Builder first."); return; }
  var numCol = numColIdx + 1; // convert to 1-based column number
  // Also find SYS_ANON_FILE_IDS column so we can rename Drive files
  var anonColIdx = -1;
  for (var h = 0; h < headerVals.length; h++) {
    if (String(headerVals[h]).trim() === "SYS_ANON_FILE_IDS") { anonColIdx = h; break; }
  }
  var anonCol = anonColIdx >= 0 ? anonColIdx + 1 : 0; // 1-based, or 0 if not found

  SpreadsheetApp.getActiveSpreadsheet().toast("Scanning for duplicates…", "🔧 Fixer", -1);

  // ── Read the SYS_PARTICIPANT_NUM column (rows 2..lastRow) ───────────────
  // We keep a live copy (numData) that we update as we apply fixes,
  // so getNextNumber() always sees the latest state.
  var numData = subSheet.getRange(2, numCol, lastRow - 1, 1).getValues(); // [[val],[val],...]

  // ── Build map: participantNum → [{sheetRow, cellValue}] ─────────────────
  var numMap = {};
  for (var i = 0; i < numData.length; i++) {
    var sheetRow = i + 2;
    var cellVal  = String(numData[i][0] || "").trim();
    if (!cellVal) continue;
    var parts = cellVal.split(/\s*,\s*/);
    for (var p = 0; p < parts.length; p++) {
      var num = parts[p].trim();
      if (!num) continue;
      if (!numMap[num]) numMap[num] = [];
      numMap[num].push({ row: sheetRow, cell: cellVal });
    }
  }

  // ── Collect duplicates ──────────────────────────────────────────────────
  var duplicates = [];
  for (var num in numMap) {
    if (!numMap.hasOwnProperty(num)) continue;
    if (numMap[num].length < 2) continue;
    var entries = numMap[num].slice().sort(function(a, b) { return a.row - b.row; });
    duplicates.push({ num: num, keepRow: entries[0].row, fixRows: entries.slice(1) });
  }

  if (duplicates.length === 0) {
    ui.alert("✅ No Duplicates Found", "All participant numbers are unique!", ui.ButtonSet.OK);
    return;
  }

  // ── Show summary and ask for confirmation ────────────────────────────────
  var totalFixes = duplicates.reduce(function(n, d) { return n + d.fixRows.length; }, 0);
  var preview = "Found " + duplicates.length + " duplicate number(s) across " + totalFixes + " row(s):\n\n";
  var shown = Math.min(duplicates.length, 12);
  for (var d = 0; d < shown; d++) {
    var dup = duplicates[d];
    preview += "• " + dup.num + " — kept Row " + dup.keepRow + ", reassign: " + dup.fixRows.map(function(e){ return "Row " + e.row; }).join(", ") + "\n";
  }
  if (duplicates.length > shown) preview += "…and " + (duplicates.length - shown) + " more.\n";
  preview += "\nProceed with fix?";

  if (ui.alert("🔧 Duplicate Participant Numbers", preview, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  // ── Helper: find next available number for a given prefix ───────────────
  // Scans the LIVE numData array (updated after each fix) to get the true max.
  function getNextNumber(prefix) {
    var maxNum = 0;
    for (var i = 0; i < numData.length; i++) {
      var v = String(numData[i][0] || "").trim();
      if (!v) continue;
      var ps = v.split(/\s*,\s*/);
      for (var p = 0; p < ps.length; p++) {
        var pv = ps[p].trim();
        if (pv.indexOf(prefix + "-") === 0) {
          var n = parseInt(pv.split("-")[1], 10);
          if (!isNaN(n) && n > maxNum) maxNum = n;
        }
      }
    }
    var digits = (SYSTEM_CONFIG && SYSTEM_CONFIG.DEPERSONALIZATION && SYSTEM_CONFIG.DEPERSONALIZATION.COUNTER_DIGITS) ? SYSTEM_CONFIG.DEPERSONALIZATION.COUNTER_DIGITS : 4;
    var newSeq = String(maxNum + 1);
    while (newSeq.length < digits) newSeq = "0" + newSeq;
    return prefix + "-" + newSeq;
  }

  // ── Apply fixes ─────────────────────────────────────────────────────────
  var fixLog = [];
  var affectedRows = []; // for optional email resend

  for (var d = 0; d < duplicates.length; d++) {
    var dup    = duplicates[d];
    var oldNum = dup.num;
    var prefix = oldNum.split("-")[0];

    for (var f = 0; f < dup.fixRows.length; f++) {
      var entry = dup.fixRows[f];
      var row   = entry.row;

      // Generate new number (uses live numData so each call returns unique next value)
      var newNum = getNextNumber(prefix);

      // Read FRESH value from sheet (avoids stale allData)
      var currentCell = String(subSheet.getRange(row, numCol).getValue() || "").trim();
      var cellParts   = currentCell.split(/\s*,\s*/);
      var newParts    = cellParts.map(function(p) { return p.trim() === oldNum ? newNum : p.trim(); });
      var newCell     = newParts.join(", ");

      // Write to sheet
      subSheet.getRange(row, numCol).setValue(newCell);

      // Update live numData so getNextNumber sees this assignment immediately
      numData[row - 2][0] = newCell;

      // Rename Google Drive anon files: e.g. "FM-0017_video.mp4" → "FM-0024_video.mp4"
      var filesRenamed = 0;
      if (anonCol > 0) {
        var anonRaw = String(subSheet.getRange(row, anonCol).getValue() || "").trim();
        if (anonRaw) {
          var anonIds = anonRaw.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
          for (var a = 0; a < anonIds.length; a++) {
            try {
              var driveFile = DriveApp.getFileById(anonIds[a]);
              var fname = driveFile.getName();
              // Only rename files whose name starts with the old participant number
              if (fname.indexOf(oldNum + "_") === 0 || fname.indexOf(oldNum + ".") === 0 || fname === oldNum) {
                var newFname = fname.replace(oldNum, newNum);
                driveFile.setName(newFname);
                filesRenamed++;
                AuditLogService.info("FIX_DUP_FILE", "Row " + row + ": renamed \"" + fname + "\" → \"" + newFname + "\"");
              }
            } catch (fe) {
              AuditLogService.warn("FIX_DUP_FILE_ERR", "Row " + row + " file " + anonIds[a] + ": " + fe);
            }
          }
        }
      }

      fixLog.push("Row " + row + ": " + oldNum + " → " + newNum + " (was: \"" + currentCell + "\", now: \"" + newCell + "\")");
      affectedRows.push(row);

      AuditLogService.info("FIX_DUP", "Row " + row + ": " + oldNum + " → " + newNum);
    }
  }

  // CRITICAL: flush all setValue calls to Google Sheets before reading back
  SpreadsheetApp.flush();

  // ── Summary ──────────────────────────────────────────────────────────────
  var summary = "✅ Fixed " + fixLog.length + " row(s):\n\n" + fixLog.join("\n");

  if (affectedRows.length > 0) {
    var resend = ui.alert(
      "📧 Resend Confirmation Emails?",
      summary + "\n\nResend updated confirmation emails to affected participants?",
      ui.ButtonSet.YES_NO
    );
    if (resend === ui.Button.YES) {
      var sent = 0;
      for (var r = 0; r < affectedRows.length; r++) {
        try { dashResendConfirmation(affectedRows[r]); sent++; if (r < affectedRows.length - 1) pauseBetweenEmails_(); }
        catch (e) { AuditLogService.error("FIX_DUP_EMAIL", "Row " + affectedRows[r] + ": " + e); }
      }
      ui.alert("✅ Done", summary + "\n\nEmails sent: " + sent + "/" + affectedRows.length, ui.ButtonSet.OK);
    } else {
      ui.alert("✅ Fix Complete", summary, ui.ButtonSet.OK);
    }
  } else {
    ui.alert("✅ Fix Complete", summary, ui.ButtonSet.OK);
  }
}

/**
 * Drive ↔ Sheet Sync Audit.
 * Scans every row in Submission Form that has SYS_ANON_FILE_IDS entries.
 * For each Drive file, checks if its name starts with the currently assigned
 * participant number from SYS_PARTICIPANT_NUM. If not, renames the file to match.
 * Run this after fixing duplicate participant numbers or any manual number corrections.
 */
function auditAndSyncDriveFiles() {
  var ui = SpreadsheetApp.getUi();
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // ── Locate Submission Form ───────────────────────────────────────────────
  var subSheet = ss.getSheetByName(SYSTEM_CONFIG.SHEETS.SUBMISSIONS);
  if (!subSheet) { ui.alert("❌ Submission Form sheet not found."); return; }

  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) { ui.alert("No submissions found."); return; }

  // ── Find relevant columns by header ──────────────────────────────────────
  var headerVals = subSheet.getRange(1, 1, 1, subSheet.getLastColumn()).getValues()[0];
  function findCol(name) {
    for (var h = 0; h < headerVals.length; h++) {
      if (String(headerVals[h]).trim() === name) return h + 1; // 1-based
    }
    return 0;
  }
  var numCol  = findCol("SYS_PARTICIPANT_NUM");
  var anonCol = findCol("SYS_ANON_FILE_IDS");
  if (!numCol)  { ui.alert("❌ SYS_PARTICIPANT_NUM column not found."); return; }
  if (!anonCol) { ui.alert("❌ SYS_ANON_FILE_IDS column not found."); return; }

  ss.toast("Scanning rows…", "🔎 Drive Sync Audit", -1);

  // ── Read both columns at once ─────────────────────────────────────────────
  var numVals  = subSheet.getRange(2, numCol,  lastRow - 1, 1).getValues();
  var anonVals = subSheet.getRange(2, anonCol, lastRow - 1, 1).getValues();

  // ── Scan ──────────────────────────────────────────────────────────────────
  var toRename   = []; // {fileId, oldName, newName, row}
  var noAccess   = []; // {fileId, row, err}
  var alreadyOk  = 0;
  var skippedRows = 0;

  for (var i = 0; i < numVals.length; i++) {
    var sheetRow    = i + 2;
    var numRaw      = String(numVals[i][0]  || "").trim();
    var anonRaw     = String(anonVals[i][0] || "").trim();
    if (!numRaw || !anonRaw) { skippedRows++; continue; }

    // Build prefix → participantNum map for this row
    // e.g. "ES-0039, FM-0024" → { ES: "ES-0039", FM: "FM-0024" }
    var prefixMap = {};
    var parts = numRaw.split(/\s*,\s*/);
    for (var p = 0; p < parts.length; p++) {
      var pn = parts[p].trim();
      if (!pn) continue;
      var dash = pn.indexOf("-");
      if (dash > 0) prefixMap[pn.substring(0, dash)] = pn;
    }

    // Check each anon file
    var fileIds = anonRaw.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
    for (var f = 0; f < fileIds.length; f++) {
      var fileId = fileIds[f];
      try {
        var driveFile = DriveApp.getFileById(fileId);
        var fname     = driveFile.getName();

        // Detect which prefix this file belongs to by matching against file name
        var filePrefix = null;
        var filePrefixKeys = Object.keys(prefixMap);
        for (var pk = 0; pk < filePrefixKeys.length; pk++) {
          if (fname.indexOf(filePrefixKeys[pk] + "-") === 0) {
            filePrefix = filePrefixKeys[pk];
            break;
          }
        }
        if (!filePrefix) {
          // Try reading prefix from the file name itself (handles any prefix)
          var fnDash = fname.indexOf("-");
          if (fnDash > 0) {
            var fnPrefix = fname.substring(0, fnDash);
            if (prefixMap[fnPrefix]) filePrefix = fnPrefix;
          }
        }
        if (!filePrefix) { alreadyOk++; continue; } // can't determine — leave it

        var correctNum  = prefixMap[filePrefix]; // e.g. "FM-0024"
        var oldNum      = fname.substring(0, fname.indexOf("_") > 0 ? fname.indexOf("_") : fname.indexOf(".") > 0 ? fname.indexOf(".") : fname.length);

        if (oldNum === correctNum) {
          alreadyOk++;
        } else {
          // Need to rename: replace only the leading participant number portion
          var newName = fname.replace(oldNum, correctNum);
          toRename.push({ fileId: fileId, oldName: fname, newName: newName, row: sheetRow, oldNum: oldNum, newNum: correctNum });
        }
      } catch (e) {
        noAccess.push({ fileId: fileId, row: sheetRow, err: String(e) });
        AuditLogService.warn("DRIVE_SYNC_ERR", "Row " + sheetRow + " file " + fileId + ": " + e);
      }
    }
  }

  // ── Report preview ────────────────────────────────────────────────────────
  if (toRename.length === 0 && noAccess.length === 0) {
    ui.alert("✅ Drive in Sync",
      "All " + alreadyOk + " Drive file(s) checked are correctly named.\nNothing to rename.",
      ui.ButtonSet.OK);
    return;
  }

  var msg = "Drive Sync Audit Results:\n\n";
  if (toRename.length > 0) {
    msg += "📝 Files to rename: " + toRename.length + "\n";
    var shown = Math.min(toRename.length, 10);
    for (var r = 0; r < shown; r++) {
      msg += "  Row " + toRename[r].row + ": \"" + toRename[r].oldName + "\" → \"" + toRename[r].newName + "\"\n";
    }
    if (toRename.length > shown) msg += "  …and " + (toRename.length - shown) + " more\n";
  }
  if (noAccess.length > 0) {
    msg += "\n⚠️ Files inaccessible (skipped): " + noAccess.length + "\n";
    var shownErr = Math.min(noAccess.length, 5);
    for (var e = 0; e < shownErr; e++) {
      msg += "  Row " + noAccess[e].row + ": " + noAccess[e].fileId + "\n";
    }
  }
  msg += "\n✅ Already correct: " + alreadyOk;
  msg += "\n\nApply renames now?";

  if (ui.alert("🔎 Drive Sync Audit", msg, ui.ButtonSet.YES_NO) !== ui.Button.YES) return;

  // ── Apply renames ─────────────────────────────────────────────────────────
  var renamed = 0;
  var failed  = 0;
  ss.toast("Renaming " + toRename.length + " file(s)…", "🔄 Drive Sync", -1);

  for (var r = 0; r < toRename.length; r++) {
    try {
      var df = DriveApp.getFileById(toRename[r].fileId);
      df.setName(toRename[r].newName);
      renamed++;
      AuditLogService.info("DRIVE_SYNC_RENAMED",
        "Row " + toRename[r].row + ": \"" + toRename[r].oldName + "\" → \"" + toRename[r].newName + "\"");
    } catch (e2) {
      failed++;
      AuditLogService.error("DRIVE_SYNC_RENAME_ERR",
        "Row " + toRename[r].row + " \"" + toRename[r].oldName + "\": " + e2);
    }
  }

  SpreadsheetApp.flush();

  ui.alert("✅ Drive Sync Complete",
    "Renamed: " + renamed + "/" + toRename.length + " file(s)" +
    (failed > 0 ? "\n⚠️ Failed: " + failed + " (check Audit Log)" : "") +
    (noAccess.length > 0 ? "\n⚠️ Inaccessible (skipped): " + noAccess.length : "") +
    "\n✅ Already correct: " + alreadyOk,
    ui.ButtonSet.OK);
}

/**
 * Public wrapper so fixDuplicateParticipantNumbers can call
 * the private generateParticipantNumber_ inside DepersonalizationService.
 * We expose it via DepersonalizationService.generateNextParticipantNumber.
 */

/**
 * Auto-create anonymized Google Drive folders for all competition types.
 * Creates a parent folder with subfolders and stores IDs in Script Properties.
 */
function configureAnonFolders() {
  var ui = SpreadsheetApp.getUi();
  var props = PropertiesService.getScriptProperties();

  // Check if folders already exist
  var existingSpeech = props.getProperty("ANON_FOLDER_SPEECH") || "";
  if (existingSpeech) {
    var existing = {
      SPEECH: props.getProperty("ANON_FOLDER_SPEECH") || "(not set)",
      ESSAY: props.getProperty("ANON_FOLDER_ESSAY") || "(not set)",
      PHOTO: props.getProperty("ANON_FOLDER_PHOTO") || "(not set)",
      FILM: props.getProperty("ANON_FOLDER_FILM") || "(not set)"
    };
    var msg = "Anonymized folders already exist:\n";
    var ks = Object.keys(existing);
    for (var i = 0; i < ks.length; i++) {
      msg += "\n" + ks[i] + ": " + existing[ks[i]];
    }
    var confirm = ui.alert("Folders Already Exist", msg + "\n\nDo you want to recreate them? (Existing folders will NOT be deleted)", ui.ButtonSet.YES_NO);
    if (confirm !== ui.Button.YES) return;
  }

  try {
    // Create parent folder
    var parentName = SYSTEM_CONFIG.META.NAME + " - Anonymized Submissions";
    var parentFolder = DriveApp.createFolder(parentName);
    AuditLogService.info("ANON_FOLDER_CREATED", "Parent folder: " + parentName + " (" + parentFolder.getId() + ")");

    // Create competition subfolders
    var prefixes = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;
    var folderNames = {};
    getCompetitions_().forEach(function (c) { folderNames[c.key] = "[" + c.prefix + "] " + c.submissionName; });

    var created = {};
    var compKeys = Object.keys(folderNames);
    for (var j = 0; j < compKeys.length; j++) {
      var key = compKeys[j];
      var subFolder = parentFolder.createFolder(folderNames[key]);
      created[key] = subFolder.getId();
      props.setProperty("ANON_FOLDER_" + key, subFolder.getId());
      AuditLogService.info("ANON_FOLDER_CREATED", key + ": " + folderNames[key] + " (" + subFolder.getId() + ")");
    }

    // Also store parent folder ID
    props.setProperty("ANON_FOLDER_PARENT", parentFolder.getId());

    var successMsg = "✅ All anonymized folders created successfully!\n";
    successMsg += "\n📁 Parent: " + parentName;
    for (var k = 0; k < compKeys.length; k++) {
      successMsg += "\n   └─ " + folderNames[compKeys[k]];
    }
    successMsg += "\n\nFolder IDs saved to Script Properties.";
    successMsg += "\nThe system will automatically use these folders for file depersonalization.";
    successMsg += "\n\n📂 Open parent folder:";
    successMsg += "\nhttps://drive.google.com/drive/folders/" + parentFolder.getId();

    ui.alert("✅ Folders Created", successMsg, ui.ButtonSet.OK);
  } catch (e) {
    AuditLogService.error("ANON_FOLDER_ERR", "Failed to create folders: " + e);
    ui.alert("❌ Error", "Failed to create folders: " + e, ui.ButtonSet.OK);
  }
}

/**
 * Migrate anonymized files from old folders to the current configured folders.
 * Scans all processed submissions, finds files tracked in SYS_ANON_FILE_IDS,
 * and moves them to the correct competition subfolder (based on participant number prefix).
 */
function migrateAnonFiles() {
  var ui = SpreadsheetApp.getUi();
  var PREFIXES = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;

  // Check that current folders exist
  var currentFolders = {};
  var compKeys = Object.keys(PREFIXES);
  var missingFolders = [];
  for (var i = 0; i < compKeys.length; i++) {
    var folderId = getAnonFolderId_(compKeys[i]);
    if (folderId) {
      currentFolders[compKeys[i]] = folderId;
    } else {
      missingFolders.push(compKeys[i]);
    }
  }

  if (missingFolders.length > 0) {
    ui.alert("❌ Missing Folders", "No folder configured for: " + missingFolders.join(", ") + "\n\nRun " + getMenuPathText_("configureAnonFolders") + " first.", ui.ButtonSet.OK);
    return;
  }

  // Get all submissions with file IDs
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) { ui.alert("❌ Submission Form sheet not found."); return; }

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var lastRow = subSheet.getLastRow();
  if (lastRow < 2) { ui.alert("No submissions found."); return; }

  var anonCol = sysCols["SYS_ANON_FILE_IDS"];
  var numCol = sysCols["SYS_PARTICIPANT_NUM"];
  if (!anonCol || !numCol) { ui.alert("❌ SYS columns not found. Reprocess submissions first."); return; }

  // Build prefix → competition key reverse map
  var prefixToKey = {};
  for (var pk = 0; pk < compKeys.length; pk++) {
    prefixToKey[PREFIXES[compKeys[pk]]] = compKeys[pk];
  }

  // Scan all rows and collect file IDs with their competition keys
  var allFileIds = [];
  var fileToComp = {};
  for (var row = 2; row <= lastRow; row++) {
    var filesStr = String(subSheet.getRange(row, anonCol).getValue() || "").trim();
    var numsStr = String(subSheet.getRange(row, numCol).getValue() || "").trim();
    if (!filesStr || !numsStr) continue;

    var fileIds = filesStr.split(/\s*,\s*/).filter(function(f) { return f.length > 0; });
    var partNums = numsStr.split(/\s*,\s*/).filter(function(p) { return p.length > 0; });

    // Determine competition key from participant number prefix
    var rowCompKeys = [];
    for (var pn = 0; pn < partNums.length; pn++) {
      var pPrefix = partNums[pn].split("-")[0];
      rowCompKeys.push(prefixToKey[pPrefix] || null);
    }

    for (var fi = 0; fi < fileIds.length; fi++) {
      var fid = fileIds[fi];
      // Match file to competition by index, fallback to first
      var matchedKey = (fi < rowCompKeys.length && rowCompKeys[fi]) ? rowCompKeys[fi] : rowCompKeys[0];
      if (matchedKey) {
        allFileIds.push(fid);
        fileToComp[fid] = matchedKey;
      }
    }
  }

  if (allFileIds.length === 0) {
    ui.alert("No anonymized files found to migrate.");
    return;
  }

  var confirm = ui.alert(
    "📦 Migrate Anonymized Files",
    "Found " + allFileIds.length + " file(s) across all submissions.\n\n" +
    "This will MOVE files to the current configured folders:\n" +
    compKeys.map(function(k) { return "  " + k + ": " + currentFolders[k]; }).join("\n") +
    "\n\nFiles already in the correct folder will be skipped.\nContinue?",
    ui.ButtonSet.YES_NO
  );
  if (confirm !== ui.Button.YES) return;

  // Process migration
  var stats = { moved: 0, skipped: 0, errors: 0, byComp: {} };
  for (var ci = 0; ci < compKeys.length; ci++) stats.byComp[compKeys[ci]] = 0;

  for (var mi = 0; mi < allFileIds.length; mi++) {
    var fileId = allFileIds[mi];
    var compKey = fileToComp[fileId];
    var targetFolderId = currentFolders[compKey];
    if (!targetFolderId) { stats.errors++; continue; }

    try {
      var file = DriveApp.getFileById(fileId);

      // An anonymized file's name starts with its participant number ("SP-0001_video.mp4"),
      // which identifies its competition reliably. Matching files to competitions by their
      // position in the list misfiled competitions that have two files (Speech, Photo).
      var nameKey = prefixToKey[String(file.getName()).split("-")[0]];
      if (nameKey && currentFolders[nameKey]) {
        compKey = nameKey;
        targetFolderId = currentFolders[nameKey];
      }

      var parents = file.getParents();
      var alreadyInTarget = false;

      while (parents.hasNext()) {
        if (parents.next().getId() === targetFolderId) {
          alreadyInTarget = true;
          break;
        }
      }

      if (alreadyInTarget) {
        stats.skipped++;
        continue;
      }

      var targetFolder = DriveApp.getFolderById(targetFolderId);
      file.moveTo(targetFolder);
      stats.moved++;
      stats.byComp[compKey]++;
      AuditLogService.info("ANON_FILE_MIGRATED", "File " + fileId + " (" + file.getName() + ") → " + compKey + " folder");
    } catch (e) {
      stats.errors++;
      AuditLogService.error("ANON_FILE_MIGRATE_ERR", "File " + fileId + ": " + e);
    }
  }

  var summary = "📦 Migration Complete\n\n";
  summary += "✅ Moved: " + stats.moved + "\n";
  summary += "⏭️ Already in place: " + stats.skipped + "\n";
  if (stats.errors > 0) summary += "❌ Errors: " + stats.errors + "\n";
  summary += "\nBy competition:\n";
  for (var si = 0; si < compKeys.length; si++) {
    summary += "  " + compKeys[si] + ": " + stats.byComp[compKeys[si]] + " moved\n";
  }

  AuditLogService.info("ANON_MIGRATION_DONE", "Moved: " + stats.moved + ", Skipped: " + stats.skipped + ", Errors: " + stats.errors);
  ui.alert("📦 Migration Complete", summary, ui.ButtonSet.OK);
}

/**
 * Manually flag a selected submission row with a reason.
 * Sets SYS_SUB_STATUS to FLAGGED and records the reason and date.
 */
function flagSubmission() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  var S = SYSTEM_CONFIG.COLS.SUB;
  var email = Utils.normalizeEmail(rowVals[S.EMAIL - 1]);
  var partNum = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var currentStatus = sysCols["SYS_SUB_STATUS"] ? String(rowVals[sysCols["SYS_SUB_STATUS"] - 1] || "").trim() : "";

  // Show current info
  var info = "Row " + row + " | " + email;
  if (partNum) info += " | " + partNum;
  if (currentStatus === "FLAGGED") {
    var existingReason = sysCols["SYS_FLAG_REASON"] ? String(rowVals[sysCols["SYS_FLAG_REASON"] - 1] || "").trim() : "";
    info += "\n\n⚠️ Already flagged" + (existingReason ? ": " + existingReason : "");
  }

  // Prompt for reason
  var response = ui.prompt(
    "🚩 Flag Submission",
    info + "\n\nEnter the reason for flagging:\n(e.g., \"Real name visible in video\", \"PII in speech content\", \"Wrong file format\")",
    ui.ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== ui.Button.OK) return;

  var reason = response.getResponseText().trim();
  if (!reason) { ui.alert("❌ Reason is required."); return; }

  // Write flag data
  if (sysCols["SYS_SUB_STATUS"]) subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).setValue("FLAGGED");
  if (sysCols["SYS_FLAG_REASON"]) subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).setValue(reason);
  if (sysCols["SYS_FLAG_DATE"]) subSheet.getRange(row, sysCols["SYS_FLAG_DATE"]).setValue(Utils.nowTzString());

  AuditLogService.info("SUB_FLAGGED", "Row " + row + " (" + (partNum || email) + ") flagged: " + reason);

  var askSend = ui.alert(
    "🚩 Submission Flagged",
    "Row " + row + " has been flagged.\n\nReason: " + reason +
    "\n\nWould you like to send a correction request email to " + email + "?",
    ui.ButtonSet.YES_NO
  );
  if (askSend === ui.Button.YES) {
    sendCorrectionRequestEmail_(subSheet, sysCols, row, rowVals, reason);
    ui.alert("✅ Flagged and correction request sent to " + email);
  } else {
    ui.alert("✅ Submission flagged. No email sent.");
  }
}

/**
 * Remove the flag from a selected submission row.
 * Restores SYS_SUB_STATUS to PROCESSED and clears flag data.
 */
function unflagSubmission() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);

  var currentStatus = sysCols["SYS_SUB_STATUS"] ? String(subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).getValue() || "").trim() : "";
  if (currentStatus !== "FLAGGED") {
    ui.alert("ℹ️ Row " + row + " is not flagged (status: " + (currentStatus || "none") + ").");
    return;
  }

  var existingReason = sysCols["SYS_FLAG_REASON"] ? String(subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).getValue() || "").trim() : "";
  var confirm = ui.alert(
    "✅ Unflag Submission",
    "Remove flag from row " + row + "?" + (existingReason ? "\n\nCurrent reason: " + existingReason : "") +
    "\n\nStatus will be restored to PROCESSED.",
    ui.ButtonSet.YES_NO
  );
  if (confirm !== ui.Button.YES) return;

  if (sysCols["SYS_SUB_STATUS"]) subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).setValue("PROCESSED");
  if (sysCols["SYS_FLAG_REASON"]) subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).setValue("");
  if (sysCols["SYS_FLAG_DATE"]) subSheet.getRange(row, sysCols["SYS_FLAG_DATE"]).setValue("");

  AuditLogService.info("SUB_UNFLAGGED", "Row " + row + " unflagged (was: " + existingReason + ")");
  ui.alert("✅ Flag removed from row " + row + ". Status restored to PROCESSED.");
}

/**
 * Get details of all entries within a single submission row (for Entry Editor).
 * @param {number} rowIndex
 */
function getSubmissionEntryDetails(rowIndex) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");
  
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(rowIndex, 1, 1, width).getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;
  
  var email = String(rowVals[S.EMAIL - 1] || "").trim();
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  
  var partNumsRaw = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  var partNums = partNumsRaw.split(/\s*,\s*/).filter(function(n) { return n.length > 0; });

  var entries = [];
  var PREFIXES = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES;
  
  for (var i = 0; i < compTypes.length; i++) {
    var compName = compTypes[i];
    var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[compName];
    if (!compMap) continue; // Unrecognized
    
    // Find matching participant number based on prefix
    var expectedPrefix = PREFIXES[compMap.key];
    var pNum = "";
    for (var j = 0; j < partNums.length; j++) {
      if (partNums[j].indexOf(expectedPrefix + "-") === 0) {
        pNum = partNums[j];
        break;
      }
    }
    
    // Get basic details
    var name = compMap.nameCol ? String(rowVals[S[compMap.nameCol] - 1] || "").trim() : "";
    var region = compMap.regionCol ? String(rowVals[S[compMap.regionCol] - 1] || "").trim() : "";
    var school = compMap.schoolCol ? String(rowVals[S[compMap.schoolCol] - 1] || "").trim() : "";
    var title = compMap.titleCol ? String(rowVals[S[compMap.titleCol] - 1] || "").trim() : "";
    
    // Get file links (original uploaded files)
    var files = [];
    if (compMap.fileCols) {
      for (var f = 0; f < compMap.fileCols.length; f++) {
        var fileLink = String(rowVals[S[compMap.fileCols[f]] - 1] || "").trim();
        if (fileLink) files.push(fileLink);
      }
    }
    
    entries.push({
      competition: compName,
      key: compMap.key,
      participantNum: pNum || "Not Generated",
      name: name,
      region: region,
      school: school,
      title: title,
      files: files,
      canRemove: compTypes.length > 1 // Can only remove if there's more than 1 entry left
    });
  }

  return {
    success: true,
    data: {
      row: rowIndex,
      email: email,
      timestamp: String(rowVals[S.TIMESTAMP - 1] || ""),
      totalEntries: compTypes.length,
      entries: entries
    }
  };
}

/**
 * Remove a specific competition entry from a submission row.
 * Clears data columns, updates col E, removes participant numbers, and trashes anon files.
 * @param {number} rowIndex
 * @param {string} competitionName
 */
function removeSubmissionEntry(rowIndex, competitionName) {
  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  if (!subSheet) throw new Error("Submission Form sheet not found");

  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var range = subSheet.getRange(rowIndex, 1, 1, width);
  var rowVals = range.getValues()[0];
  var S = SYSTEM_CONFIG.COLS.SUB;
  
  // 1. Validate multiple entries exist
  var rawCompType = getSubmissionCompetitionTypes_(rowVals).join(", ");
  var compTypes = rawCompType.split(/\s*,\s*/).filter(function(c) { return c.length > 0; });
  if (compTypes.length <= 1) {
    throw new Error("Cannot remove the only remaining entry.");
  }
  
  // Find the exact name as it appears in the map (handle casing)
  var targetCompName = competitionName;
  var compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[competitionName];
  if (!compMap) {
    var mapKeys = Object.keys(SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP);
    for (var k = 0; k < mapKeys.length; k++) {
      if (mapKeys[k].toUpperCase() === competitionName.toUpperCase()) {
        targetCompName = mapKeys[k];
        compMap = SYSTEM_CONFIG.SUBMISSION_COMPETITION_MAP[targetCompName];
        break;
      }
    }
  }
  if (!compMap) throw new Error("Unrecognized competition: " + competitionName);

  // 2. Remove from COMPETITION_TYPE list
  var newCompTypes = [];
  for (var i = 0; i < compTypes.length; i++) {
    if (compTypes[i].toUpperCase() !== targetCompName.toUpperCase()) {
      newCompTypes.push(compTypes[i]);
    }
  }
  rowVals[S.COMPETITION_TYPE - 1] = newCompTypes.join(", ");
  
  // 3. Clear the data columns for this competition
  var keysToClear = [
    compMap.nameCol, compMap.regionCol, compMap.schoolCol, compMap.adviserCol, 
    compMap.facebookCol, compMap.contactCol, compMap.titleCol
  ];
  if (compMap.fileCols) {
    for (var fc = 0; fc < compMap.fileCols.length; fc++) keysToClear.push(compMap.fileCols[fc]);
  }
  
  for (var c = 0; c < keysToClear.length; c++) {
    var colKey = keysToClear[c];
    if (colKey && S[colKey]) {
      rowVals[S[colKey] - 1] = "";
    }
  }
  
  // 4. Handle Participant Numbers (SYS_PARTICIPANT_NUM)
  var pPrefix = SYSTEM_CONFIG.DEPERSONALIZATION.PREFIXES[compMap.key];
  var removedPNum = "";
  var partNumsRaw = sysCols["SYS_PARTICIPANT_NUM"] ? String(rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] || "").trim() : "";
  if (partNumsRaw) {
    var pNums = partNumsRaw.split(/\s*,\s*/).filter(function(n) { return n.length > 0; });
    var newPNums = [];
    for (var n = 0; n < pNums.length; n++) {
      if (pNums[n].indexOf(pPrefix + "-") === 0) {
        removedPNum = pNums[n];
      } else {
        newPNums.push(pNums[n]);
      }
    }
    if (sysCols["SYS_PARTICIPANT_NUM"]) {
      rowVals[sysCols["SYS_PARTICIPANT_NUM"] - 1] = newPNums.join(", ");
    }
  }
  
  // 5. Cleanup Anonymized Files (SYS_ANON_FILE_IDS)
  var anonIdsRaw = sysCols["SYS_ANON_FILE_IDS"] ? String(rowVals[sysCols["SYS_ANON_FILE_IDS"] - 1] || "").trim() : "";
  var trashedCount = 0;
  if (anonIdsRaw && removedPNum) {
    var anonIds = anonIdsRaw.split(/\s*,\s*/).filter(function(id) { return id.length > 0; });
    var keptIds = [];
    var removedIds = [];
    
    // Finding file ownership via DriveApp is slow, so we check if the filename starts with the removed participant number
    for (var a = 0; a < anonIds.length; a++) {
      try {
        var f = DriveApp.getFileById(anonIds[a]);
        if (f.getName().indexOf(removedPNum + "_") === 0 || f.getName().indexOf(removedPNum + ".") === 0) {
          f.setTrashed(true);
          trashedCount++;
          removedIds.push(anonIds[a]);
        } else {
          keptIds.push(anonIds[a]);
        }
      } catch (e) {
        // If file doesn't exist or no permission, assume it stays (or is already gone)
        keptIds.push(anonIds[a]);
      }
    }
    if (sysCols["SYS_ANON_FILE_IDS"]) {
      rowVals[sysCols["SYS_ANON_FILE_IDS"] - 1] = keptIds.join(", ");
    }
  }
  
  // Write everything back to the sheet
  range.setValues([rowVals]);
  
  // Audit log
  var email = String(rowVals[S.EMAIL - 1] || "").trim();
  AuditLogService.info("SUB_REMOVE_ENTRY", "Row " + rowIndex + " (" + email + "): Removed " + targetCompName + " (" + (removedPNum || "No ID") + "). Trashed " + trashedCount + " anon file(s).");
  
  return { 
    success: true, 
    removedCompetition: targetCompName,
    removedParticipantNum: removedPNum,
    remainingEntries: newCompTypes.length
  };
}

/**
 * Send a correction request email for a selected flagged submission.
 * Can be used standalone or called from flagSubmission.
 */
function sendCorrectionRequest() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  if (sheet.getName() !== SYSTEM_CONFIG.SHEETS.SUBMISSIONS) {
    ui.alert("❌ Please select a row on the '" + SYSTEM_CONFIG.SHEETS.SUBMISSIONS + "' sheet.");
    return;
  }
  var row = SpreadsheetApp.getActiveRange().getRow();
  if (row < 2) { ui.alert("❌ Select a data row."); return; }

  var repo = new SheetRepository();
  var subSheet = repo.getSubmissionSheet();
  var sysCols = ColumnManager.ensureSysColsOnSubmissions(subSheet);
  var width = subSheet.getLastColumn();
  var rowVals = subSheet.getRange(row, 1, 1, width).getValues()[0];

  var reason = sysCols["SYS_FLAG_REASON"] ? String(rowVals[sysCols["SYS_FLAG_REASON"] - 1] || "").trim() : "";
  if (!reason) {
    var response = ui.prompt(
      "📨 Send Correction Request",
      "No flag reason found. Enter the issue to communicate to the participant:",
      ui.ButtonSet.OK_CANCEL
    );
    if (response.getSelectedButton() !== ui.Button.OK) return;
    reason = response.getResponseText().trim();
    if (!reason) { ui.alert("❌ Reason is required."); return; }
    // Also flag the row if not already flagged
    if (sysCols["SYS_SUB_STATUS"]) subSheet.getRange(row, sysCols["SYS_SUB_STATUS"]).setValue("FLAGGED");
    if (sysCols["SYS_FLAG_REASON"]) subSheet.getRange(row, sysCols["SYS_FLAG_REASON"]).setValue(reason);
    if (sysCols["SYS_FLAG_DATE"]) subSheet.getRange(row, sysCols["SYS_FLAG_DATE"]).setValue(Utils.nowTzString());
  }

  sendCorrectionRequestEmail_(subSheet, sysCols, row, rowVals, reason);
  ui.alert("✅ Correction request email sent.");
}

/**
