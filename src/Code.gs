      '      <td width="45%" align="center" valign="top" style="padding:0;"><div style="border-bottom:1px solid #000;width:90%;margin:0 auto 5px auto;"></div><p style="margin:0;font-weight:bold;font-size:11px;text-transform:uppercase;">__VERIFIER_2__</p><p style="margin:2px 0 0 0;font-size:10px;color:#555;">UPLB Sociology Society<br>Finance Committee Head</p></td>' +
      '    </tr>' +
      '  </table>' +
      '</div>' +
      '</div></div></body></html>';
  }

  function getCommonLogos_(options) {
    if (options.preview) {
      return LogoService.getPreviewDataUrls(); // returns {uplb: 'data...', husay: 'data...'}
    }
    return { uplb: "cid:uplb_logo", husay: "cid:husay_logo" };
  }

  // ---- Group receipt HTML (Master Transaction) ----
  // Generates a personalized AR for a specific participant within the group
  function buildGroupReceiptHtml_(groupObj, participant, options) {
    options = options || {};
    participant = participant || groupObj.participants[0];

    // Use the INDIVIDUAL AR template as the base
    var html = EmailBuilder.receiptTemplateHtml_();

    // ---- Logos ----
    var uplbSrc = "cid:uplb_logo";
    var husaySrc = "cid:husay_logo";
    if (options.preview) {
      var urls = LogoService.getPreviewDataUrls();
      uplbSrc = urls.uplb || "";
      husaySrc = urls.husay || "";
    }

    // ---- Determine primary participant info ----
    var primaryParticipant = null;
    for (var pi = 0; pi < groupObj.participants.length; pi++) {
      if (String(groupObj.participants[pi].role || "").toUpperCase().indexOf("PRIMARY") >= 0) {
        primaryParticipant = groupObj.participants[pi];
        break;
      }
    }
    if (!primaryParticipant) primaryParticipant = groupObj.participants[0];
    var isPrimary = (participant.email === primaryParticipant.email);
    var primaryName = primaryParticipant.name || primaryParticipant.email || "";

    // ---- Fill basic info placeholders ----
    var displayGenId = participant.genId || "â€”";
    html = html.split("__GEN_ID__").join(EmailBuilder.escapeHtml_(displayGenId));
    html = html.split("__DATE_VERIFIED__").join(EmailBuilder.escapeHtml_(options.paidAt ? Utils.formatDate(options.paidAt) : Utils.formatDate(new Date())));
    html = html.split("__HEADER_TITLE__").join("ACKNOWLEDGEMENT RECEIPT");
    html = html.split("__NAME__").join(EmailBuilder.escapeHtml_(primaryName));
    html = html.split("__SCHOOL__").join("");
    html = html.split("__PAYMODE__").join(EmailBuilder.escapeHtml_(options.payRef || "Group Payment"));

    // ---- Group ID row (shows Group ID below Receipt No.) ----
    var groupIdRowHtml = '  <tr><th align="left" style="background:#f8fafc;padding:10px 12px;border:1px solid #e6e8ec;">Group ID</th><td style="padding:10px 12px;border:1px solid #e6e8ec;">' + EmailBuilder.escapeHtml_(groupObj.groupId) + '</td></tr>';
    html = html.split("__GROUP_ID_ROW__").join(groupIdRowHtml);

    // ---- Logos ----
    html = html.split("__UPLB_LOGO_SRC__").join(uplbSrc);
    html = html.split("__HUSAY_LOGO_SRC__").join(husaySrc);

    // ---- Breakdown: aggregate competitions across all group participants ----
    var compCounts = {};
    var compOrder = [];
    for (var ci = 0; ci < groupObj.participants.length; ci++) {
      var pComps = String(groupObj.participants[ci].competitions || "").split(",");
      for (var cj = 0; cj < pComps.length; cj++) {
        var comp = pComps[cj].trim();
        if (!comp) continue;
        if (!compCounts[comp]) { compCounts[comp] = 0; compOrder.push(comp); }
        compCounts[comp]++;
      }
    }

    var itemRows = "";
    var subtotal = 0;
    for (var ck = 0; ck < compOrder.length; ck++) {
      var comp = compOrder[ck];
      var count = compCounts[comp];
      var unitPrice = Number(SYSTEM_CONFIG.PRICING.SINGLE[comp] || 0);
      if (!unitPrice) continue;
      var lineTotal = unitPrice * count;
      subtotal += lineTotal;
      itemRows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + EmailBuilder.escapeHtml_(comp) + ' (&times;' + count + ')</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + EmailBuilder.fmtMoney2_(lineTotal) + '</td>' +
        '</tr>';
    }

    // Subtotal row
    if (compOrder.length > 1) {
      itemRows += '<tr style="border-top:1px solid #ccc;">' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;font-weight:bold;">Subtotal</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;font-weight:bold;">' + EmailBuilder.fmtMoney2_(subtotal) + '</td>' +
        '</tr>';
    }

    // Group discount = subtotal of individual prices minus the actual merged total
    var groupDiscount = subtotal - groupObj.total;
    if (groupDiscount > 0) {
      itemRows += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;color:#dc2626;font-weight:bold;">Less: Group Bundle Adjustment</td>' +
        '<td align="right" style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;color:#dc2626;font-weight:bold;">-' + EmailBuilder.fmtMoney2_(groupDiscount) + '</td>' +
        '</tr>';
    }

    if (!itemRows) {
      itemRows = '<tr><td colspan="2" style="padding:10px 12px;font-size:13px;">Registration Fee (Group)</td></tr>';
    }

    html = html.split("__ITEM_ROWS__").join(itemRows);
    html = html.split("__TOTAL_PAID__").join(EmailBuilder.escapeHtml_(Utils.formatCurrency(groupObj.total)));

    // ---- Group Participant Breakdown table ----
    var gpbHtml = '<h3 style="font-size:14px;font-weight:bold;margin:20px 0 10px 0;">Group Participant Breakdown</h3>' +
      '<table class="breakdown-table" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e6e8ec;border-collapse:collapse;font-size:13px;">' +
      '  <thead><tr style="background-color:#1E4FB8;">' +
      '    <th align="left" style="color:#ffffff;padding:10px 12px;font-size:13px;font-weight:bold;">Participant Name / ID</th>' +
      '    <th align="left" style="color:#ffffff;padding:10px 12px;font-size:13px;font-weight:bold;">Competitions</th>' +
      '  </tr></thead><tbody>';

    for (var gi = 0; gi < groupObj.participants.length; gi++) {
      var gp = groupObj.participants[gi];
      var gpLabel = EmailBuilder.escapeHtml_(gp.name || "") + (gp.genId ? '<br><span style="color:#666;font-size:11px;">' + EmailBuilder.escapeHtml_(gp.genId) + '</span>' : '');
      var gpComps = EmailBuilder.escapeHtml_(gp.competitions || "\u2014");
      gpbHtml += '<tr>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + gpLabel + '</td>' +
        '<td style="padding:10px 12px;border-bottom:1px solid #e6e8ec;font-size:13px;">' + gpComps + '</td>' +
        '</tr>';
    }

    gpbHtml += '</tbody>' +
      '<tfoot><tr style="border-top:2px solid #e6e8ec;">' +
      '  <td align="right" style="padding:12px;font-size:13px;font-weight:bold;">TOTAL GROUP PAID:</td>' +
      '  <td align="right" style="padding:12px;font-size:16px;font-weight:bold;color:#1E4FB8;">' + Utils.formatCurrency(groupObj.total) + '</td>' +
      '</tr></tfoot></table>';

    html = html.split("__GROUP_BREAKDOWN__").join(gpbHtml);

    // ---- Verifiers ----
    html = html.split("__VERIFIER_1__").join(EmailBuilder.escapeHtml_(SYSTEM_CONFIG.ADMIN.VERIFIERS.FINANCE_HEAD));
    html = html.split("__VERIFIER_2__").join(EmailBuilder.escapeHtml_(SYSTEM_CONFIG.ADMIN.VERIFIERS.ORG_FINANCE_HEAD));

    // ---- Build Email Spiel (personalized per participant) ----
    var emailSpiel = "";
    if (SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL && SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL.ENABLED) {
      var spielConfig = SYSTEM_CONFIG.ADMIN.OR_EMAIL_SPIEL;
      var spielTitle = spielConfig.TITLE || "IMPORTANT PARTICIPANT INFORMATION";

      emailSpiel = '<h3 style="font-size:14px;font-weight:bold;margin:20px 0 10px 0;">' + spielTitle + '</h3>';

      // Personalized greeting
      emailSpiel += '<p style="font-size:14px;margin:15px 0;">Dear <b>' + EmailBuilder.escapeHtml_(participant.name || participant.email || "") + '</b>,</p>';

      if (isPrimary) {
        emailSpiel += '<p style="font-size:14px;margin:15px 0;">We have successfully confirmed the <b>combined group payment</b> of <b>' + Utils.formatCurrency(groupObj.total) + '</b> for your group (<b>' + EmailBuilder.escapeHtml_(groupObj.groupId) + '</b>).</p>';
      } else {
        emailSpiel += '<p style="font-size:14px;margin:15px 0;">You have been registered under the primary contact <b>' + EmailBuilder.escapeHtml_(primaryName) + '</b> as part of group <b>' + EmailBuilder.escapeHtml_(groupObj.groupId) + '</b>. The combined group payment of <b>' + Utils.formatCurrency(groupObj.total) + '</b> has been successfully confirmed.</p>';
      }

      // This participant's own competitions
      var myComps = participant.competitions ? participant.competitions.split(",") : [];
      if (myComps.length > 0) {
        emailSpiel += '<p style="font-size:14px;margin:15px 0;">You are officially registered in the following competition/s:</p>';
        emailSpiel += '<ul style="margin:10px 0 10px 20px;padding:0;">';
        for (var mc = 0; mc < myComps.length; mc++) {
          var cn = String(myComps[mc] || "").trim();
          if (cn) {
            var displayLabel = EmailBuilder.canonicalToDisplayLabel_ ? EmailBuilder.canonicalToDisplayLabel_(cn) : cn;
            emailSpiel += '<li style="margin:5px 0;">' + EmailBuilder.escapeHtml_(displayLabel) + '</li>';
          }
        }
        emailSpiel += '</ul>';
      }

      // Referral code
      emailSpiel += '<p style="font-size:13px;color:#555;margin:15px 0;">Under this message, you will also be provided by a unique referral code, which your friends or colleagues can use upon their registration to avail our discounted offers.</p>';
      emailSpiel += '<h4 style="font-size:14px;font-weight:bold;margin:20px 0 10px 0;">REFERRAL CODE</h4>';
      emailSpiel += '<div style="background:#f3f4f6;border:1px dashed #cbd5e1;padding:12px;border-radius:10px;font-family:monospace;font-size:14px;word-break:break-word;">' + EmailBuilder.escapeHtml_(displayGenId) + '</div>';
      emailSpiel += '<div style="height:1px;background:#e6e8ec;margin:15px 0;"></div>';

      // Content paragraphs
      if (spielConfig.CONTENT) {
        spielConfig.CONTENT.forEach(function(line) {
          emailSpiel += (line === "") ? '<br>' : '<p style="font-size:14px;margin:8px 0;line-height:1.5;">' + line + '</p>';
        });
      }

      if (spielConfig.CONFIDENTIALITY_NOTE) {
        emailSpiel += '<div style="background:#fff7ed;border:1px solid #fed7aa;padding:12px;border-radius:10px;font-size:13px;margin:15px 0;"><b>Confidentiality reminder:</b> ' + spielConfig.CONFIDENTIALITY_NOTE + '</div>';
      }

      // Submission form
      emailSpiel += '<h4 style="font-size:14px;font-weight:bold;margin:15px 0 8px 0;">Official Submission Form</h4>';
      if (spielConfig.SUBMISSION_INTRO) {
        emailSpiel += '<p style="font-size:14px;margin:8px 0;line-height:1.5;">' + spielConfig.SUBMISSION_INTRO + '</p>';
      }
      if (spielConfig.SUBMISSION_FORM_LINK) {
        emailSpiel += '<p style="margin:12px 0;"><a class="btn-link" href="' + spielConfig.SUBMISSION_FORM_LINK + '" target="_blank" style="display:inline-block;padding:12px 16px;border-radius:10px;background:#1d4ed8;color:#fff;text-decoration:none;font-weight:bold;font-size:13px;">SUBMISSION FORM FOR 4TH HUSAY NG SOKSAY</a></p>';
      }
      if (spielConfig.SUBMISSION_DEADLINE) {
        emailSpiel += '<p style="font-size:14px;margin:12px 0;"><b>DEADLINE FOR ALL SUBMISSIONS:</b> ' + spielConfig.SUBMISSION_DEADLINE + '</p>';
      }

      // Primer
      if (spielConfig.PRIMER_INTRO) {
        emailSpiel += '<p style="font-size:14px;margin:12px 0;line-height:1.5;">' + spielConfig.PRIMER_INTRO + '</p>';
      }
      if (spielConfig.EVENT_PRIMER_LINK) {
        emailSpiel += '<p style="margin:12px 0;"><a class="btn-link" href="' + spielConfig.EVENT_PRIMER_LINK + '" target="_blank" style="display:inline-block;padding:12px 16px;border-radius:10px;background:#0f172a;color:#fff;text-decoration:none;font-weight:bold;font-size:13px;">4TH Husay Ng Soksay Event Primer</a></p>';
      }

      // Closing
      if (spielConfig.CLOSING) {
        emailSpiel += '<p style="font-size:14px;margin:15px 0;line-height:1.5;">' + spielConfig.CLOSING + '</p>';
      }

      // Contact Section
      var contactConfig = spielConfig.CONTACT || {};
      emailSpiel += '<div style="height:1px;background:#e6e8ec;margin:15px 0;"></div>';
      emailSpiel += '<h4 style="font-size:14px;font-weight:bold;margin:15px 0 8px 0;">Contact</h4>';
      emailSpiel += '<p style="font-size:13px;color:#555;line-height:1.6;">' +
        'For any questions, clarifications, and news updates about the events please reach out to us on:<br>' +
        'Email: <b>' + EmailBuilder.escapeHtml_(contactConfig.EMAIL || 'husayngsoksayteam@gmail.com') + '</b><br>' +
        'Facebook: ' + EmailBuilder.escapeHtml_(contactConfig.FACEBOOK || 'Husay Ng Soksay - UPLB Sociology Society') + '<br>' +
        'Instagram: <b>' + EmailBuilder.escapeHtml_(contactConfig.INSTAGRAM || '@husayngsoksay') + '</b>' +
        '</p>';

      var signOff = spielConfig.SIGN_OFF || "Para sa malayang mga kwento,<br><b>The Husay Ng Soksay Team</b>";
      emailSpiel += '<p style="font-size:13px;margin-top:15px;">' + signOff + '</p>';
    }

    html = html.split("__EMAIL_SPIEL__").join(emailSpiel);

    return html;
  }


    // ---- Group Registration Received HTML (Premium) ----
  // Generates a personalized Registration Received email for each group participant
  // Follows the same format as individual buildRegistrationConfirmedHtml + group additions
  function buildGroupRegReceivedHtml_(groupObj, participant, options) {
    options = options || {};
    var logos = getCommonLogos_(options);
    var headerBlock = getHeaderBlock_(logos.uplb, logos.husay);
    var HEADER_BLUE = "#1E4FB8";

    var name = EmailBuilder.escapeHtml_(participant.name || "");
    var genId = EmailBuilder.escapeHtml_(participant.genId || "");

    // Pricing - use the actual group merged total (not individual recalculation)
    var bundleFee = Utils.formatCurrencyShort(groupObj.total);

    // Discounts
    var refDiscountVal = Number(participant.refDiscount || 0);
    var referralDiscountStr = refDiscountVal > 0 ? Utils.formatCurrencyShort(-refDiscountVal) : Utils.formatCurrencyShort(0);
    var couponDiscVal = Number(participant.couponDiscount || 0);
    var couponDisc = Utils.formatCurrencyShort(-Math.abs(couponDiscVal));
    var totalDue = Utils.formatCurrencyShort(groupObj.total);

    // Coupon and referral lines
    var couponCode = String(participant.couponCode || "").trim();
    var couponText = couponCode ? couponCode : "NO COUPON USED";
    var couponLine =
      '<div style="text-align:right;font-size:12px;color:#666666;margin-top:-10px;margin-bottom:18px;">' +
      'COUPON APPLIED: <strong>' + EmailBuilder.escapeHtml_(couponText) + '</strong>' +
      '</div>';

    var refCode = String(participant.refCodeUsed || "").trim();
    var refLine = refCode
      ? '<div style="text-align:right;font-size:12px;color:#666666;margin-bottom:18px;">' +
        'REFERRAL CODE USED: <strong>' + EmailBuilder.escapeHtml_(refCode) + '</strong>' +
        '</div>'
      : '';

    // Determine primary
    var isPrimary = participant.role && String(participant.role).toUpperCase().indexOf("PRIMARY") === 0;
    var primaryName = "";
    if (!isPrimary) {
      var prim = groupObj.participants.filter(function (p) {
        return String(p.role || "").toUpperCase().indexOf("PRIMARY") === 0;
      })[0];
      primaryName = prim ? prim.name : "";
