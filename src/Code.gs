/**
 * Resend all pending referral notifications (V19.1)
 * Sends notifications to referrers who have referrals but no tracked notification
 */
function resendAllPendingReferralNotifications() {
  var ui = SpreadsheetApp.getUi();
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Scanning for pending referral notifications...", "🔗 Checking", -1);
  
  var report = EmailManager.getEmailStatusReport();
  
  if (!report.success) {
    SpreadsheetApp.getActiveSpreadsheet().toast("Error!", "❌", 3);
    ui.alert("❌ Error", report.error, ui.ButtonSet.OK);
    return;
  }
  
  // Find participants with referrals but pending/unknown notification status
  var pendingReferrers = report.participants.filter(function(p) {
    return p.refCount > 0 && p.referralNotif.status !== "SENT";
  });
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Found " + pendingReferrers.length + " pending", "🔗", 3);
  
  if (pendingReferrers.length === 0) {
    ui.alert("✅ All Clear!",
      "No pending referral notifications found.\n\n" +
      "All referrers have been notified!",
      ui.ButtonSet.OK);
    return;
  }
  
  var message = "Found " + pendingReferrers.length + " referrer(s) with pending notifications:\n\n";
  for (var i = 0; i < Math.min(pendingReferrers.length, 5); i++) {
    var p = pendingReferrers[i];
    message += "• " + p.name + " (" + p.refCount + " referral" + (p.refCount > 1 ? "s" : "") + ")\n";
  }
  if (pendingReferrers.length > 5) {
    message += "... and " + (pendingReferrers.length - 5) + " more\n";
  }
  message += "\nSend referral success notifications to all of them?";
  
  var confirm = ui.alert("🔗 Resend Referral Notifications", message, ui.ButtonSet.YES_NO);
  
  if (confirm !== ui.Button.YES) return;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending " + pendingReferrers.length + " notifications... Please wait.", "🔗 Processing", -1);
  
  var sent = 0;
  var failed = 0;
  var skipped = 0;
  var errors = [];
  
  for (var j = 0; j < pendingReferrers.length; j++) {
    var referrer = pendingReferrers[j];
    try {
      var result = EmailManager.resendReferralNotification(referrer.genId, true);
      if (result.success) {
        sent++;
      } else if (result.skipped) {
        skipped++;
      } else {
        failed++;
        errors.push(referrer.name + ": " + (result.error || result.reason || "Unknown"));
      }
    } catch (e) {
      failed++;
      errors.push(referrer.name + ": " + String(e));
    }
    
    // Rate limiting delay
    if (j < pendingReferrers.length - 1) {
      Utilities.sleep(1500);
    }
  }
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Complete!", "🔗 Done", 3);
  
  var resultMsg = "═══════════════════════════════════\n";
  resultMsg += "🔗 REFERRAL NOTIFICATIONS COMPLETE\n";
  resultMsg += "═══════════════════════════════════\n\n";
  resultMsg += "Total Processed: " + pendingReferrers.length + "\n";
  resultMsg += "✅ Sent: " + sent + "\n";
  resultMsg += "⏭️ Skipped: " + skipped + "\n";
  resultMsg += "❌ Failed: " + failed + "\n";
  
  if (errors.length > 0) {
    resultMsg += "\nErrors:\n";
    for (var k = 0; k < Math.min(errors.length, 5); k++) {
      resultMsg += "• " + errors[k] + "\n";
    }
  }
  
  ui.alert("🔗 Results", resultMsg, ui.ButtonSet.OK);
  
  AuditLogService.info("REFNOTIF_BULK_RESEND", 
    "Bulk referral notification: sent=" + sent + ", skipped=" + skipped + ", failed=" + failed);
}

/**
 * Resend referral notification for selected row (V19.1)
 */
function resendSelectedRowReferralNotification() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var row = SpreadsheetApp.getActiveRange().getRow();
  
  if (row < 2) {
    ui.alert("⚠️ Invalid Selection", "Please select a data row (not the header).", ui.ButtonSet.OK);
    return;
  }
  
  var sheetName = sheet.getName();
  var email = "";
  var genId = "";
  var name = "";
  var refCount = 0;
  
  if (sheetName === SYSTEM_CONFIG.SHEETS.REGISTRATION) {
    email = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.EMAIL).getValue();
    genId = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.GEN_ID).getValue();
    name = sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.NAME).getValue();
    refCount = Number(sheet.getRange(row, SYSTEM_CONFIG.COLS.REG.REF_COUNT).getValue() || 0);
  } else if (sheetName === SYSTEM_CONFIG.SHEETS.FINANCE) {
    var finCols = ColumnManager.getFinanceCols(sheet);
    email = sheet.getRange(row, finCols.Email).getValue();
    genId = sheet.getRange(row, finCols.GenId).getValue();
    name = sheet.getRange(row, finCols.Name).getValue();
    refCount = Number(sheet.getRange(row, finCols.RefCount).getValue() || 0);
  } else {
    ui.alert("⚠️ Wrong Sheet", 
      "Please select a row in:\n• " + SYSTEM_CONFIG.SHEETS.REGISTRATION + "\n• " + SYSTEM_CONFIG.SHEETS.FINANCE,
      ui.ButtonSet.OK);
    return;
  }
  
  email = Utils.normalizeEmail(email);
  
  if (!email || !genId) {
    ui.alert("⚠️ Missing Data", "Could not find email or Gen ID in selected row.", ui.ButtonSet.OK);
    return;
  }
  
  if (refCount === 0) {
    ui.alert("⚠️ No Referrals",
      name + " has no successful referrals.\n\n" +
      "Referral notifications are only sent to people who have referred others.",
      ui.ButtonSet.OK);
    return;
  }
  
  // Check current status
  var currentStatus = EmailManager.verifyEmailSent(genId, "REFERRAL_SUCCESS");
  
  var statusText = currentStatus.sent 
    ? "✅ Already sent on " + currentStatus.sentAt
    : "⚠️ Not tracked / Not sent";
  
  var confirm = ui.alert("🔗 Resend Referral Notification",
    "Referrer: " + name + "\n" +
    "Email: " + email + "\n" +
    "Referral Count: " + refCount + "\n" +
    "Current Status: " + statusText + "\n\n" +
    "Send referral success notification?\n" +
    "(This will notify them about their " + refCount + " successful referral" + (refCount > 1 ? "s" : "") + ")",
    ui.ButtonSet.YES_NO);
  
  if (confirm !== ui.Button.YES) return;
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Sending notification to " + name + "...", "🔗 Processing", -1);
  
  var result = EmailManager.resendReferralNotification(genId, true);
  
  SpreadsheetApp.getActiveSpreadsheet().toast("Done!", "🔗", 3);
  
  if (result.success) {
    ui.alert("✅ Notification Sent",
      "Referral notification sent to:\n" + name + " (" + email + ")\n\n" +
      "They have been notified about their " + refCount + " successful referral" + (refCount > 1 ? "s" : "") + ".",
      ui.ButtonSet.OK);
  } else if (result.skipped) {
    ui.alert("⏭️ Notification Skipped",
      "Notification was skipped.\n\nReason: " + (result.reason || "Duplicate prevention"),
      ui.ButtonSet.OK);
  } else {
    ui.alert("❌ Notification Failed",
      "Failed to send notification to " + name + "\n\nError: " + (result.error || result.reason || "Unknown error"),
      ui.ButtonSet.OK);
  }
}

