var TriggerGuard = (function () {
  var KEY = "HNS_MUTE_ONEDIT";
  function isMuted() {
    try {
      var cache = CacheService.getScriptCache();
      return cache.get(KEY) === "1";
    } catch (e) {
      return false;
    }
  }
  function mute(fn) {
    var cache = null;
    try { cache = CacheService.getScriptCache(); } catch (e) {}
    if (cache) cache.put(KEY, "1", 8);
    try { return fn(); }
    finally { try { if (cache) cache.remove(KEY); } catch (e2) {} }
  }
  return { isMuted: isMuted, mute: mute };
})();

