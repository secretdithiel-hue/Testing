    // Personalized greeting text
    var greetingText = "";
    if (isPrimary) {
      greetingText = 'We have received the <b>combined group registration</b> for your group (<b>' + EmailBuilder.escapeHtml_(groupObj.groupId) + '</b>).';
    } else {
      greetingText = 'You have been registered under primary contact <b>' + EmailBuilder.escapeHtml_(primaryName) + '</b> as part of group <b>' + EmailBuilder.escapeHtml_(groupObj.groupId) + '</b>. Registration received!';
    }

    // Group Participant Breakdown table
    var gpbHtml = '<div style="margin-top:20px;border-top:1px solid #dddddd;padding-top:15px;">' +
      '<div style="font-size:14px;font-weight:bold;margin-bottom:10px;">Group Participant Breakdown</div>' +
      '<table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:10px;">' +
      '<thead><tr style="background-color:' + HEADER_BLUE + ';">' +
      '<th align="left" style="color:#ffffff;padding:8px 10px;font-size:12px;font-weight:bold;">Participant Name / ID</th>' +
      '<th align="left" style="color:#ffffff;padding:8px 10px;font-size:12px;font-weight:bold;">Competitions</th>' +
      '</tr></thead><tbody>';

    for (var gi = 0; gi < groupObj.participants.length; gi++) {
      var gp = groupObj.participants[gi];
      var gpLabel = EmailBuilder.escapeHtml_(gp.name || "") + (gp.genId ? '<br><span style="color:#666;font-size:11px;">' + EmailBuilder.escapeHtml_(gp.genId) + '</span>' : '');
      var gpComps = EmailBuilder.escapeHtml_(gp.competitions || "\u2014");
      gpbHtml += '<tr>' +
        '<td style="padding:8px 10px;border-bottom:1px solid #e6e8ec;font-size:12px;">' + gpLabel + '</td>' +
        '<td style="padding:8px 10px;border-bottom:1px solid #e6e8ec;font-size:12px;">' + gpComps + '</td>' +
        '</tr>';
    }

    gpbHtml += '</tbody>' +
      '<tfoot><tr style="border-top:2px solid #dddddd;">' +
      '<td align="right" style="padding:10px;font-size:13px;font-weight:bold;">TOTAL GROUP DUE:</td>' +
      '<td align="right" style="padding:10px;font-size:15px;font-weight:bold;color:' + HEADER_BLUE + ';">' + Utils.formatCurrency(groupObj.total) + '</td>' +
      '</tr></tfoot></table></div>';

    return (
      '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Registration Received</title>' +
      '<style>' +
      '  @media only screen and (max-width: 600px) {' +
      '    .email-container { width: 100% !important; }' +
      '    .email-content { padding: 15px !important; }' +
      '    .header-title { font-size: 18px !important; }' +
      '    .header-logo { max-width: 55px !important; }' +
      '    .referral-box { padding: 12px !important; }' +
      '    .referral-code { font-size: 20px !important; }' +
      '  }' +
      '</style>' +
